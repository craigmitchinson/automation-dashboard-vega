{
  "index_patterns": [
    "ia-cost-daily*"
  ],
  "priority": 200,
  "template": {
    "settings": {
      "number_of_shards": 1
    },
    "mappings": {
      "dynamic": "strict",
      "properties": {
        "@timestamp": {
          "type": "date"
        },
        "date": {
          "type": "date",
          "format": "yyyy-MM-dd"
        },
        "pool": {
          "type": "keyword"
        },
        "pool_type": {
          "type": "keyword"
        },
        "spoke": {
          "properties": {
            "name": {
              "type": "keyword"
            }
          }
        },
        "people_gbp": {
          "type": "double"
        },
        "infra_gbp": {
          "type": "double"
        },
        "total_gbp": {
          "type": "double"
        },
        "worktime_sec": {
          "type": "long"
        },
        "estate_worktime_sec": {
          "type": "long"
        },
        "cost_per_bot_sec": {
          "type": "double"
        },
        "working_days_per_year": {
          "type": "double"
        },
        "productive_hours_per_day": {
          "type": "double"
        },
        "working_days_per_year_offshore": {
          "type": "double"
        },
        "productive_hours_per_day_offshore": {
          "type": "double"
        }
      }
    }
  },
  "_meta": {
    "description": "IA automation dashboards: see docs/LOGSTASH.md and docs/JOBS.md"
  }
}