# IA dashboards: the scheduled jobs. Copy the jobs/ folder and logstash/reference.json to /opt/ia.
# Python 3.9+. The cost job needs `pip install requests`; the service checks need nothing extra.
# Keep the API key in the host's secret store, not in this file.

IA_ES_URL=https://your-cluster:9200
IA_KIBANA_URL=https://your-kibana
# IA_ES_API_KEY=...   (read on the Blue Prism index and ia-*, write on ia-*)

# Cost job (required for £ figures): 02:30 daily, after the night's ingest.
30 2 * * *   cd /opt/ia && python3 stamp_costs.py --reference reference.json >> /var/log/ia/cost-job.log 2>&1

# Service checks (optional, for alerts): every 15 minutes.
*/15 * * * * cd /opt/ia && python3 service_checks.py >> /var/log/ia/service-checks.log 2>&1
