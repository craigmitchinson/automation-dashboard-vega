{
  "$schema": "https://vega.github.io/schema/vega/v5.json",
  "description": "IA · Process detail · Daily flow. Generated by vega/build.mjs from vega/panels/process-detail.mjs, do not edit by hand.",
  "autosize": {
    "type": "fit",
    "contains": "padding"
  },
  "padding": 0,
  "config": {
    "background": "#FFFFFF",
    "padding": 0,
    "font": "Inter, 'Segoe UI', system-ui, -apple-system, sans-serif",
    "text": {
      "font": "Inter, 'Segoe UI', system-ui, -apple-system, sans-serif",
      "fill": "#0F4D43",
      "fontSize": 12
    },
    "axis": {
      "gridColor": "#E6E8E2",
      "labelFont": "'Roboto Mono', Menlo, Consolas, monospace",
      "labelFontSize": 10,
      "labelColor": "#5F6E69",
      "titleFont": "'Roboto Mono', Menlo, Consolas, monospace",
      "titleColor": "#5F6E69",
      "titleFontSize": 10,
      "titleFontWeight": 400,
      "domain": false,
      "ticks": false,
      "gridWidth": 1,
      "labelPadding": 6
    },
    "style": {
      "guide-label": {
        "font": "'Roboto Mono', Menlo, Consolas, monospace"
      }
    },
    "view": {
      "stroke": null
    },
    "kibana": {
      "renderer": "svg",
      "hideWarnings": true
    }
  },
  "signals": [
    {
      "name": "ndays",
      "update": "length(data('win'))"
    },
    {
      "name": "lo",
      "update": "ndays ? data('win')[0].key : 0"
    },
    {
      "name": "hi",
      "update": "ndays ? data('win')[ndays - 1].key : 0"
    },
    {
      "name": "plo",
      "update": "lo - ndays * 86400000"
    },
    {
      "name": "phi",
      "update": "lo - 86400000"
    },
    {
      "name": "headerRight",
      "value": 0
    },
    {
      "name": "top",
      "value": 58
    },
    {
      "name": "cw",
      "update": "width - 32"
    },
    {
      "name": "ch",
      "update": "height - top - 16"
    },
    {
      "name": "grain",
      "value": "weekly",
      "on": [
        {
          "events": "@seg_grain_0:click",
          "update": "'daily'"
        },
        {
          "events": "@seg_grain_1:click",
          "update": "'weekly'"
        },
        {
          "events": "@seg_grain_2:click",
          "update": "'monthly'"
        }
      ]
    },
    {
      "name": "chart_ymax",
      "update": "max(extent(pluck(data('pseries'), 'c'))[1] || 0, extent(pluck(data('pseries'), 'b'))[1] || 0, extent(pluck(data('pseries'), 's'))[1] || 0, 0)"
    }
  ],
  "data": [
    {
      "name": "procs_raw",
      "url": {
        "index": "ia-reference",
        "body": {
          "size": 500,
          "query": {
            "term": {
              "doc_type": "process"
            }
          }
        }
      },
      "format": {
        "property": "hits.hits"
      }
    },
    {
      "name": "procs",
      "source": "procs_raw",
      "transform": [
        {
          "type": "formula",
          "as": "name",
          "expr": "datum._source.process.name"
        },
        {
          "type": "formula",
          "as": "pid",
          "expr": "datum._source.process.id"
        },
        {
          "type": "formula",
          "as": "acronym",
          "expr": "datum._source.process.acronym"
        },
        {
          "type": "formula",
          "as": "spoke",
          "expr": "datum._source.spoke.name"
        },
        {
          "type": "formula",
          "as": "spokeColor",
          "expr": "datum._source.spoke.color"
        },
        {
          "type": "formula",
          "as": "proposition",
          "expr": "datum._source.proposition.name"
        },
        {
          "type": "formula",
          "as": "queue",
          "expr": "datum._source.primary_queue"
        },
        {
          "type": "formula",
          "as": "queues",
          "expr": "join(datum._source.queues, ' → ')"
        },
        {
          "type": "formula",
          "as": "description",
          "expr": "datum._source.process.description"
        },
        {
          "type": "formula",
          "as": "tags",
          "expr": "datum._source.process.tags"
        },
        {
          "type": "formula",
          "as": "smv",
          "expr": "datum._source.process.smv_minutes"
        },
        {
          "type": "formula",
          "as": "grade",
          "expr": "datum._source.process.grade"
        },
        {
          "type": "formula",
          "as": "gradeName",
          "expr": "datum._source.process.grade_name"
        },
        {
          "type": "formula",
          "as": "rate",
          "expr": "datum._source.process.current_rate_gbp"
        },
        {
          "type": "formula",
          "as": "slaHours",
          "expr": "datum._source.process.sla_hours"
        }
      ]
    },
    {
      "name": "bp_raw",
      "url": {
        "%context%": true,
        "%timefield%": "@timestamp",
        "index": "ia-workqueue-items",
        "body": {
          "size": 0,
          "aggs": {
            "m": {
              "filter": {
                "term": {
                  "mapped": true
                }
              },
              "aggs": {
                "p": {
                  "terms": {
                    "field": "process.name",
                    "size": 100
                  },
                  "aggs": {
                    "a": {
                      "sum": {
                        "field": "n.attempt"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      },
      "format": {
        "property": "aggregations.m.p.buckets"
      }
    },
    {
      "name": "bp",
      "source": "bp_raw",
      "transform": [
        {
          "type": "formula",
          "as": "name",
          "expr": "datum.key"
        },
        {
          "type": "formula",
          "as": "a",
          "expr": "datum['a'].value"
        },
        {
          "type": "lookup",
          "from": "procs",
          "key": "name",
          "fields": [
            "name"
          ],
          "as": [
            "ref"
          ]
        },
        {
          "type": "formula",
          "as": "spoke",
          "expr": "datum.ref ? datum.ref.spoke : ''"
        },
        {
          "type": "formula",
          "as": "spokeColor",
          "expr": "datum.ref ? datum.ref.spokeColor : '#5F6E69'"
        },
        {
          "type": "formula",
          "as": "queue",
          "expr": "datum.ref ? datum.ref.queue : ''"
        },
        {
          "type": "formula",
          "as": "proposition",
          "expr": "datum.ref ? datum.ref.proposition : ''"
        },
        {
          "type": "formula",
          "as": "slaHours",
          "expr": "datum.ref ? datum.ref.slaHours : null"
        }
      ]
    },
    {
      "name": "raw",
      "url": {
        "index": "ia-workqueue-items",
        "body": {
          "size": 0,
          "query": {
            "bool": {
              "must": [
                "%dashboard_context-must_clause%",
                {
                  "range": {
                    "@timestamp": {
                      "gte": {
                        "%timefilter%": "min",
                        "shift": -732,
                        "unit": "day"
                      },
                      "lte": {
                        "%timefilter%": "max"
                      },
                      "format": "epoch_millis"
                    }
                  }
                },
                {
                  "term": {
                    "mapped": true
                  }
                }
              ],
              "filter": [
                "%dashboard_context-filter_clause%"
              ],
              "must_not": [
                "%dashboard_context-must_not_clause%"
              ]
            }
          },
          "aggs": {
            "win": {
              "filter": {
                "range": {
                  "@timestamp": {
                    "%timefilter%": true
                  }
                }
              },
              "aggs": {
                "d": {
                  "date_histogram": {
                    "field": "@timestamp",
                    "fixed_interval": "1d",
                    "min_doc_count": 0,
                    "extended_bounds": {
                      "min": {
                        "%timefilter%": "min"
                      },
                      "max": {
                        "%timefilter%": "max"
                      }
                    }
                  }
                }
              }
            },
            "days": {
              "date_histogram": {
                "field": "@timestamp",
                "fixed_interval": "1d",
                "min_doc_count": 1
              },
              "aggs": {
                "c": {
                  "sum": {
                    "field": "n.completed"
                  }
                },
                "b": {
                  "sum": {
                    "field": "n.business"
                  }
                },
                "s": {
                  "sum": {
                    "field": "n.system"
                  }
                }
              }
            }
          }
        }
      },
      "format": {
        "property": "aggregations"
      }
    },
    {
      "name": "win",
      "source": "raw",
      "transform": [
        {
          "type": "flatten",
          "fields": [
            "win.d.buckets"
          ],
          "as": [
            "_bk"
          ]
        },
        {
          "type": "formula",
          "as": "key",
          "expr": "datum._bk.key"
        },
        {
          "type": "formula",
          "as": "n",
          "expr": "datum._bk.doc_count"
        },
        {
          "type": "project",
          "fields": [
            "key",
            "n"
          ]
        }
      ]
    },
    {
      "name": "days",
      "source": "raw",
      "transform": [
        {
          "type": "flatten",
          "fields": [
            "days.buckets"
          ],
          "as": [
            "_bk"
          ]
        },
        {
          "type": "formula",
          "as": "key",
          "expr": "datum._bk.key"
        },
        {
          "type": "formula",
          "as": "n",
          "expr": "datum._bk.doc_count"
        },
        {
          "type": "formula",
          "as": "c",
          "expr": "datum._bk[\"c\"] ? (datum._bk[\"c\"].value || 0) : 0"
        },
        {
          "type": "formula",
          "as": "b",
          "expr": "datum._bk[\"b\"] ? (datum._bk[\"b\"].value || 0) : 0"
        },
        {
          "type": "formula",
          "as": "s",
          "expr": "datum._bk[\"s\"] ? (datum._bk[\"s\"].value || 0) : 0"
        },
        {
          "type": "project",
          "fields": [
            "key",
            "n",
            "c",
            "b",
            "s"
          ]
        }
      ]
    },
    {
      "name": "series",
      "source": "win",
      "transform": [
        {
          "type": "lookup",
          "from": "days",
          "key": "key",
          "fields": [
            "key"
          ],
          "as": [
            "d"
          ]
        },
        {
          "type": "formula",
          "as": "t",
          "expr": "datum.key"
        },
        {
          "type": "formula",
          "as": "c",
          "expr": "datum.d ? datum.d.c : 0"
        },
        {
          "type": "formula",
          "as": "b",
          "expr": "datum.d ? datum.d.b : 0"
        },
        {
          "type": "formula",
          "as": "s",
          "expr": "datum.d ? datum.d.s : 0"
        }
      ]
    },
    {
      "name": "tot",
      "source": "days",
      "transform": [
        {
          "type": "formula",
          "as": "cur_c",
          "expr": "datum.key >= lo && datum.key <= hi ? datum.c : 0"
        },
        {
          "type": "formula",
          "as": "prev_c",
          "expr": "datum.key >= plo && datum.key <= phi ? datum.c : 0"
        },
        {
          "type": "formula",
          "as": "cur_b",
          "expr": "datum.key >= lo && datum.key <= hi ? datum.b : 0"
        },
        {
          "type": "formula",
          "as": "prev_b",
          "expr": "datum.key >= plo && datum.key <= phi ? datum.b : 0"
        },
        {
          "type": "formula",
          "as": "cur_s",
          "expr": "datum.key >= lo && datum.key <= hi ? datum.s : 0"
        },
        {
          "type": "formula",
          "as": "prev_s",
          "expr": "datum.key >= plo && datum.key <= phi ? datum.s : 0"
        },
        {
          "type": "aggregate",
          "ops": [
            "sum",
            "sum",
            "sum",
            "sum",
            "sum",
            "sum"
          ],
          "fields": [
            "cur_c",
            "prev_c",
            "cur_b",
            "prev_b",
            "cur_s",
            "prev_s"
          ],
          "as": [
            "cur_c",
            "prev_c",
            "cur_b",
            "prev_b",
            "cur_s",
            "prev_s"
          ]
        }
      ]
    },
    {
      "name": "ref_rel",
      "url": {
        "index": "ia-reference",
        "body": {
          "size": 500,
          "query": {
            "term": {
              "doc_type": "release"
            }
          }
        }
      },
      "format": {
        "property": "hits.hits"
      }
    },
    {
      "name": "rel",
      "source": "ref_rel",
      "transform": [
        {
          "type": "formula",
          "as": "t",
          "expr": "toDate(datum._source.release.date)"
        },
        {
          "type": "formula",
          "as": "process",
          "expr": "datum._source.release.process"
        },
        {
          "type": "formula",
          "as": "label",
          "expr": "datum._source.release.title + ' · ' + (datum.process || 'estate-wide')"
        },
        {
          "type": "filter",
          "expr": "!datum.process || (length(data('bp')) === 1 && datum.process === data('bp')[0].name)"
        },
        {
          "type": "project",
          "fields": [
            "t",
            "process",
            "label"
          ]
        }
      ]
    },
    {
      "name": "flow",
      "source": "series",
      "transform": [
        {
          "type": "formula",
          "as": "g",
          "expr": "grain === 'monthly' ? utc(utcyear(datum.t), utcmonth(datum.t), 1) : grain === 'weekly' ? datum.t - ((utcday(datum.t) + 6) % 7) * 86400000 : datum.t"
        },
        {
          "type": "aggregate",
          "groupby": [
            "g"
          ],
          "ops": [
            "sum",
            "sum",
            "sum"
          ],
          "fields": [
            "c",
            "b",
            "s"
          ],
          "as": [
            "c",
            "b",
            "s"
          ]
        },
        {
          "type": "formula",
          "as": "t",
          "expr": "datum.g"
        },
        {
          "type": "collect",
          "sort": {
            "field": "t"
          }
        }
      ]
    },
    {
      "name": "pseries",
      "source": "flow",
      "transform": [
        {
          "type": "filter",
          "expr": "length(data('bp')) === 1"
        }
      ]
    },
    {
      "name": "chart_mk",
      "source": "rel",
      "transform": [
        {
          "type": "filter",
          "expr": "length(data('pseries')) && datum.t >= extent(pluck(data('pseries'), 't'))[0] && datum.t <= extent(pluck(data('pseries'), 't'))[1]"
        }
      ]
    }
  ],
  "scales": [
    {
      "name": "chart_x",
      "type": "utc",
      "domain": {
        "data": "pseries",
        "field": "t"
      },
      "range": [
        0,
        {
          "signal": "cw - 44"
        }
      ]
    },
    {
      "name": "chart_y",
      "type": "linear",
      "domain": {
        "signal": "[0, max(0, chart_ymax)]"
      },
      "range": [
        {
          "signal": "ch - 22"
        },
        0
      ],
      "nice": true,
      "zero": true
    }
  ],
  "marks": [
    {
      "type": "text",
      "name": "frame_title",
      "encode": {
        "update": {
          "x": {
            "value": 16
          },
          "y": {
            "value": 18
          },
          "baseline": {
            "value": "top"
          },
          "font": {
            "value": "'Roboto Mono', Menlo, Consolas, monospace"
          },
          "fontSize": {
            "value": 11
          },
          "fontWeight": {
            "value": 600
          },
          "fill": {
            "value": "#0F4D43"
          },
          "text": {
            "signal": "'FLOW'"
          },
          "limit": {
            "signal": "width - 32"
          }
        }
      }
    },
    {
      "type": "text",
      "encode": {
        "update": {
          "x": {
            "signal": "16 + length('FLOW') * 6.9 + 10"
          },
          "y": {
            "value": 17
          },
          "baseline": {
            "value": "top"
          },
          "font": {
            "value": "Inter, 'Segoe UI', system-ui, -apple-system, sans-serif"
          },
          "fontSize": {
            "value": 12
          },
          "fill": {
            "value": "#5F6E69"
          },
          "text": {
            "value": "Outcomes for this process · ◆ a release or change"
          },
          "limit": {
            "signal": "width - 42 - length('FLOW') * 6.9 - 0 - headerRight"
          }
        }
      }
    },
    {
      "type": "rect",
      "encode": {
        "update": {
          "x": {
            "signal": "16"
          },
          "y": {
            "value": 36
          },
          "width": {
            "value": 11
          },
          "height": {
            "value": 11
          },
          "cornerRadius": {
            "value": 3
          },
          "fill": {
            "value": "#0F4D43"
          }
        }
      }
    },
    {
      "type": "text",
      "encode": {
        "update": {
          "x": {
            "signal": "16 + 17"
          },
          "y": {
            "value": 41.5
          },
          "baseline": {
            "value": "middle"
          },
          "font": {
            "value": "Inter, 'Segoe UI', system-ui, -apple-system, sans-serif"
          },
          "fontSize": {
            "value": 12
          },
          "fill": {
            "value": "#5F6E69"
          },
          "text": {
            "value": "Completed"
          }
        }
      }
    },
    {
      "type": "rect",
      "encode": {
        "update": {
          "x": {
            "signal": "103"
          },
          "y": {
            "value": 36
          },
          "width": {
            "value": 11
          },
          "height": {
            "value": 11
          },
          "cornerRadius": {
            "value": 3
          },
          "fill": {
            "value": "#B9852C"
          }
        }
      }
    },
    {
      "type": "text",
      "encode": {
        "update": {
          "x": {
            "signal": "103 + 17"
          },
          "y": {
            "value": 41.5
          },
          "baseline": {
            "value": "middle"
          },
          "font": {
            "value": "Inter, 'Segoe UI', system-ui, -apple-system, sans-serif"
          },
          "fontSize": {
            "value": 12
          },
          "fill": {
            "value": "#5F6E69"
          },
          "text": {
            "value": "Business"
          }
        }
      }
    },
    {
      "type": "rect",
      "encode": {
        "update": {
          "x": {
            "signal": "184"
          },
          "y": {
            "value": 36
          },
          "width": {
            "value": 11
          },
          "height": {
            "value": 11
          },
          "cornerRadius": {
            "value": 3
          },
          "fill": {
            "value": "#B6462F"
          }
        }
      }
    },
    {
      "type": "text",
      "encode": {
        "update": {
          "x": {
            "signal": "184 + 17"
          },
          "y": {
            "value": 41.5
          },
          "baseline": {
            "value": "middle"
          },
          "font": {
            "value": "Inter, 'Segoe UI', system-ui, -apple-system, sans-serif"
          },
          "fontSize": {
            "value": 12
          },
          "fill": {
            "value": "#5F6E69"
          },
          "text": {
            "value": "System"
          }
        }
      }
    },
    {
      "type": "rect",
      "encode": {
        "update": {
          "x": {
            "signal": "width - 16 - 171"
          },
          "y": {
            "value": 12
          },
          "width": {
            "value": 171
          },
          "height": {
            "value": 24
          },
          "cornerRadius": {
            "value": 12
          },
          "fill": {
            "value": "#F7F6F2"
          },
          "stroke": {
            "value": "#D6D9D2"
          }
        }
      }
    },
    {
      "type": "rect",
      "name": "seg_grain_0",
      "encode": {
        "update": {
          "x": {
            "signal": "width - 16 - 171 + 3"
          },
          "y": {
            "value": 14
          },
          "width": {
            "value": 49
          },
          "height": {
            "value": 20
          },
          "cornerRadius": {
            "value": 10
          },
          "fill": {
            "signal": "grain === 'daily' ? '#DCE8E0' : 'transparent'"
          },
          "stroke": {
            "value": "transparent"
          },
          "cursor": {
            "value": "pointer"
          }
        }
      }
    },
    {
      "type": "text",
      "interactive": false,
      "encode": {
        "update": {
          "x": {
            "signal": "width - 16 - 171 + 3 + 24.5"
          },
          "y": {
            "value": 24
          },
          "align": {
            "value": "center"
          },
          "baseline": {
            "value": "middle"
          },
          "font": {
            "value": "Inter, 'Segoe UI', system-ui, -apple-system, sans-serif"
          },
          "fontSize": {
            "value": 11.5
          },
          "fontWeight": {
            "signal": "grain === 'daily' ? 600 : 'normal'"
          },
          "fill": {
            "signal": "grain === 'daily' ? '#0F4D43' : '#5F6E69'"
          },
          "text": {
            "value": "Daily"
          }
        }
      }
    },
    {
      "type": "rect",
      "name": "seg_grain_1",
      "encode": {
        "update": {
          "x": {
