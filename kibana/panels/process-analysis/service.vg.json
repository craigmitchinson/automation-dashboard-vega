{
  "$schema": "https://vega.github.io/schema/vega/v5.json",
  "description": "IA · Process Analysis · SLA and first time. Generated by vega/build.mjs from vega/panels/process-analysis.mjs, do not edit by hand.",
  "autosize": {
    "type": "fit",
    "contains": "padding"
  },
  "padding": 0,
  "config": {
    "background": "#FFFFFF",
    "padding": 0,
    "font": "Inter, 'Segoe UI', system-ui, -apple-system, sans-serif",
    "text": {
      "font": "Inter, 'Segoe UI', system-ui, -apple-system, sans-serif",
      "fill": "#0F4D43",
      "fontSize": 12
    },
    "axis": {
      "gridColor": "#E6E8E2",
      "labelFont": "'Roboto Mono', Menlo, Consolas, monospace",
      "labelFontSize": 10,
      "labelColor": "#5F6E69",
      "titleFont": "'Roboto Mono', Menlo, Consolas, monospace",
      "titleColor": "#5F6E69",
      "titleFontSize": 10,
      "titleFontWeight": 400,
      "domain": false,
      "ticks": false,
      "gridWidth": 1,
      "labelPadding": 6
    },
    "style": {
      "guide-label": {
        "font": "'Roboto Mono', Menlo, Consolas, monospace"
      }
    },
    "view": {
      "stroke": null
    },
    "kibana": {
      "renderer": "svg",
      "hideWarnings": true
    }
  },
  "signals": [
    {
      "name": "ndays",
      "update": "length(data('win'))"
    },
    {
      "name": "lo",
      "update": "ndays ? data('win')[0].key : 0"
    },
    {
      "name": "hi",
      "update": "ndays ? data('win')[ndays - 1].key : 0"
    },
    {
      "name": "plo",
      "update": "lo - ndays * 86400000"
    },
    {
      "name": "phi",
      "update": "lo - 86400000"
    },
    {
      "name": "headerRight",
      "value": 0
    },
    {
      "name": "top",
      "value": 58
    },
    {
      "name": "cw",
      "update": "width - 32"
    },
    {
      "name": "ch",
      "update": "height - top - 16"
    },
    {
      "name": "grain",
      "value": "weekly",
      "on": [
        {
          "events": "@seg_grain_0:click",
          "update": "'daily'"
        },
        {
          "events": "@seg_grain_1:click",
          "update": "'weekly'"
        },
        {
          "events": "@seg_grain_2:click",
          "update": "'monthly'"
        }
      ]
    },
    {
      "name": "chart_ymax",
      "update": "max(extent(pluck(data('slaf'), 'slaP'))[1] || 0, extent(pluck(data('slaf'), 'firstP'))[1] || 0, 0)"
    }
  ],
  "data": [
    {
      "name": "raw",
      "url": {
        "index": "ia-workqueue-items",
        "body": {
          "size": 0,
          "query": {
            "bool": {
              "must": [
                "%dashboard_context-must_clause%",
                {
                  "range": {
                    "@timestamp": {
                      "gte": {
                        "%timefilter%": "min",
                        "shift": -732,
                        "unit": "day"
                      },
                      "lte": {
                        "%timefilter%": "max"
                      },
                      "format": "epoch_millis"
                    }
                  }
                },
                {
                  "term": {
                    "mapped": true
                  }
                }
              ],
              "filter": [
                "%dashboard_context-filter_clause%"
              ],
              "must_not": [
                "%dashboard_context-must_not_clause%"
              ]
            }
          },
          "aggs": {
            "win": {
              "filter": {
                "range": {
                  "@timestamp": {
                    "%timefilter%": true
                  }
                }
              },
              "aggs": {
                "d": {
                  "date_histogram": {
                    "field": "@timestamp",
                    "fixed_interval": "1d",
                    "min_doc_count": 0,
                    "extended_bounds": {
                      "min": {
                        "%timefilter%": "min"
                      },
                      "max": {
                        "%timefilter%": "max"
                      }
                    }
                  }
                }
              }
            },
            "days": {
              "date_histogram": {
                "field": "@timestamp",
                "fixed_interval": "1d",
                "min_doc_count": 1
              },
              "aggs": {
                "c": {
                  "sum": {
                    "field": "n.completed"
                  }
                },
                "a": {
                  "sum": {
                    "field": "n.attempt"
                  }
                },
                "sl": {
                  "sum": {
                    "field": "n.in_sla"
                  }
                },
                "ta": {
                  "sum": {
                    "field": "turnaround_sec"
                  }
                },
                "f1": {
                  "sum": {
                    "field": "n.first"
                  }
                },
                "fo": {
                  "sum": {
                    "field": "n.first_ok"
                  }
                }
              }
            }
          }
        }
      },
      "format": {
        "property": "aggregations"
      }
    },
    {
      "name": "win",
      "source": "raw",
      "transform": [
        {
          "type": "flatten",
          "fields": [
            "win.d.buckets"
          ],
          "as": [
            "_bk"
          ]
        },
        {
          "type": "formula",
          "as": "key",
          "expr": "datum._bk.key"
        },
        {
          "type": "formula",
          "as": "n",
          "expr": "datum._bk.doc_count"
        },
        {
          "type": "project",
          "fields": [
            "key",
            "n"
          ]
        }
      ]
    },
    {
      "name": "days",
      "source": "raw",
      "transform": [
        {
          "type": "flatten",
          "fields": [
            "days.buckets"
          ],
          "as": [
            "_bk"
          ]
        },
        {
          "type": "formula",
          "as": "key",
          "expr": "datum._bk.key"
        },
        {
          "type": "formula",
          "as": "n",
          "expr": "datum._bk.doc_count"
        },
        {
          "type": "formula",
          "as": "c",
          "expr": "datum._bk[\"c\"] ? (datum._bk[\"c\"].value || 0) : 0"
        },
        {
          "type": "formula",
          "as": "a",
          "expr": "datum._bk[\"a\"] ? (datum._bk[\"a\"].value || 0) : 0"
        },
        {
          "type": "formula",
          "as": "sl",
          "expr": "datum._bk[\"sl\"] ? (datum._bk[\"sl\"].value || 0) : 0"
        },
        {
          "type": "formula",
          "as": "ta",
          "expr": "datum._bk[\"ta\"] ? (datum._bk[\"ta\"].value || 0) : 0"
        },
        {
          "type": "formula",
          "as": "f1",
          "expr": "datum._bk[\"f1\"] ? (datum._bk[\"f1\"].value || 0) : 0"
        },
        {
          "type": "formula",
          "as": "fo",
          "expr": "datum._bk[\"fo\"] ? (datum._bk[\"fo\"].value || 0) : 0"
        },
        {
          "type": "project",
          "fields": [
            "key",
            "n",
            "c",
            "a",
            "sl",
            "ta",
            "f1",
            "fo"
          ]
        }
      ]
    },
    {
      "name": "series",
      "source": "win",
      "transform": [
        {
          "type": "lookup",
          "from": "days",
          "key": "key",
          "fields": [
            "key"
          ],
          "as": [
            "d"
          ]
        },
        {
          "type": "formula",
          "as": "t",
          "expr": "datum.key"
        },
        {
          "type": "formula",
          "as": "c",
          "expr": "datum.d ? datum.d.c : 0"
        },
        {
          "type": "formula",
          "as": "a",
          "expr": "datum.d ? datum.d.a : 0"
        },
        {
          "type": "formula",
          "as": "sl",
          "expr": "datum.d ? datum.d.sl : 0"
        },
        {
          "type": "formula",
          "as": "ta",
          "expr": "datum.d ? datum.d.ta : 0"
        },
        {
          "type": "formula",
          "as": "f1",
          "expr": "datum.d ? datum.d.f1 : 0"
        },
        {
          "type": "formula",
          "as": "fo",
          "expr": "datum.d ? datum.d.fo : 0"
        }
      ]
    },
    {
      "name": "tot",
      "source": "days",
      "transform": [
        {
          "type": "formula",
          "as": "cur_c",
          "expr": "datum.key >= lo && datum.key <= hi ? datum.c : 0"
        },
        {
          "type": "formula",
          "as": "prev_c",
          "expr": "datum.key >= plo && datum.key <= phi ? datum.c : 0"
        },
        {
          "type": "formula",
          "as": "cur_a",
          "expr": "datum.key >= lo && datum.key <= hi ? datum.a : 0"
        },
        {
          "type": "formula",
          "as": "prev_a",
          "expr": "datum.key >= plo && datum.key <= phi ? datum.a : 0"
        },
        {
          "type": "formula",
          "as": "cur_sl",
          "expr": "datum.key >= lo && datum.key <= hi ? datum.sl : 0"
        },
        {
          "type": "formula",
          "as": "prev_sl",
          "expr": "datum.key >= plo && datum.key <= phi ? datum.sl : 0"
        },
        {
          "type": "formula",
          "as": "cur_ta",
          "expr": "datum.key >= lo && datum.key <= hi ? datum.ta : 0"
        },
        {
          "type": "formula",
          "as": "prev_ta",
          "expr": "datum.key >= plo && datum.key <= phi ? datum.ta : 0"
        },
        {
          "type": "formula",
          "as": "cur_f1",
          "expr": "datum.key >= lo && datum.key <= hi ? datum.f1 : 0"
        },
        {
          "type": "formula",
          "as": "prev_f1",
          "expr": "datum.key >= plo && datum.key <= phi ? datum.f1 : 0"
        },
        {
          "type": "formula",
          "as": "cur_fo",
          "expr": "datum.key >= lo && datum.key <= hi ? datum.fo : 0"
        },
        {
          "type": "formula",
          "as": "prev_fo",
          "expr": "datum.key >= plo && datum.key <= phi ? datum.fo : 0"
        },
        {
          "type": "aggregate",
          "ops": [
            "sum",
            "sum",
            "sum",
            "sum",
            "sum",
            "sum",
            "sum",
            "sum",
            "sum",
            "sum",
            "sum",
            "sum"
          ],
          "fields": [
            "cur_c",
            "prev_c",
            "cur_a",
            "prev_a",
            "cur_sl",
            "prev_sl",
            "cur_ta",
            "prev_ta",
            "cur_f1",
            "prev_f1",
            "cur_fo",
            "prev_fo"
          ],
          "as": [
            "cur_c",
            "prev_c",
            "cur_a",
            "prev_a",
            "cur_sl",
            "prev_sl",
            "cur_ta",
            "prev_ta",
            "cur_f1",
            "prev_f1",
            "cur_fo",
            "prev_fo"
          ]
        }
      ]
    },
    {
      "name": "ref_rel",
      "url": {
        "index": "ia-reference",
        "body": {
          "size": 500,
          "query": {
            "term": {
              "doc_type": "release"
            }
          }
        }
      },
      "format": {
        "property": "hits.hits"
      }
    },
    {
      "name": "rel",
      "source": "ref_rel",
      "transform": [
        {
          "type": "formula",
          "as": "t",
          "expr": "toDate(datum._source.release.date)"
        },
        {
          "type": "formula",
          "as": "process",
          "expr": "datum._source.release.process"
        },
        {
          "type": "formula",
          "as": "label",
          "expr": "datum._source.release.title + ' · ' + (datum.process || 'estate-wide')"
        },
        {
          "type": "filter",
          "expr": "true"
        },
        {
          "type": "project",
          "fields": [
            "t",
            "process",
            "label"
          ]
        }
      ]
    },
    {
      "name": "flow",
      "source": "series",
      "transform": [
        {
          "type": "formula",
          "as": "g",
          "expr": "grain === 'monthly' ? utc(utcyear(datum.t), utcmonth(datum.t), 1) : grain === 'weekly' ? datum.t - ((utcday(datum.t) + 6) % 7) * 86400000 : datum.t"
        },
        {
          "type": "aggregate",
          "groupby": [
            "g"
          ],
          "ops": [
            "sum",
            "sum",
            "sum",
            "sum",
            "sum"
          ],
          "fields": [
            "c",
            "a",
            "sl",
            "f1",
            "fo"
          ],
          "as": [
            "c",
            "a",
            "sl",
            "f1",
            "fo"
          ]
        },
        {
          "type": "formula",
          "as": "t",
          "expr": "datum.g"
        },
        {
          "type": "collect",
          "sort": {
            "field": "t"
          }
        }
      ]
    },
    {
      "name": "slaf",
      "source": "flow",
      "transform": [
        {
          "type": "formula",
          "as": "slaP",
          "expr": "datum.c ? datum.sl / datum.c * 100 : null"
        },
        {
          "type": "formula",
          "as": "firstP",
          "expr": "datum.f1 ? datum.fo / datum.f1 * 100 : null"
        }
      ]
    },
    {
      "name": "chart_mk",
      "source": "rel",
      "transform": [
        {
          "type": "filter",
          "expr": "length(data('slaf')) && datum.t >= extent(pluck(data('slaf'), 't'))[0] && datum.t <= extent(pluck(data('slaf'), 't'))[1]"
        }
      ]
    }
  ],
  "scales": [
    {
      "name": "chart_x",
      "type": "utc",
      "domain": {
        "data": "slaf",
        "field": "t"
      },
      "range": [
        0,
        {
          "signal": "cw - 44"
        }
      ]
    },
    {
      "name": "chart_y",
      "type": "linear",
      "domain": {
        "signal": "[max(0, floor(min(extent(pluck(data('slaf'), 'slaP'))[0] || 0, extent(pluck(data('slaf'), 'firstP'))[0] || 0) / 5) * 5 - 5), 100]"
      },
      "range": [
        {
          "signal": "ch - 22"
        },
        0
      ],
      "nice": true,
      "zero": false
    }
  ],
  "marks": [
    {
      "type": "text",
      "name": "frame_title",
      "encode": {
        "update": {
          "x": {
            "value": 16
          },
          "y": {
            "value": 18
          },
          "baseline": {
            "value": "top"
          },
          "font": {
            "value": "'Roboto Mono', Menlo, Consolas, monospace"
          },
          "fontSize": {
            "value": 11
          },
          "fontWeight": {
            "value": 600
          },
          "fill": {
            "value": "#0F4D43"
          },
          "text": {
            "signal": "'SLA AND FIRST TIME'"
          },
          "limit": {
            "signal": "width - 32"
          }
        }
      }
    },
    {
      "type": "text",
      "encode": {
        "update": {
          "x": {
            "signal": "16 + length('SLA AND FIRST TIME') * 6.9 + 10"
          },
          "y": {
            "value": 17
          },
          "baseline": {
            "value": "top"
          },
          "font": {
            "value": "Inter, 'Segoe UI', system-ui, -apple-system, sans-serif"
          },
          "fontSize": {
            "value": 12
          },
          "fill": {
            "value": "#5F6E69"
          },
          "text": {
            "signal": "(isValid(((length(data('tot')) ? data('tot')[0].cur_sl : 0) / max(1, (length(data('tot')) ? data('tot')[0].cur_c : 0)))) && isFinite(((length(data('tot')) ? data('tot')[0].cur_sl : 0) / max(1, (length(data('tot')) ? data('tot')[0].cur_c : 0)))) ? format(((length(data('tot')) ? data('tot')[0].cur_sl : 0) / max(1, (length(data('tot')) ? data('tot')[0].cur_c : 0))) * 100, '.1f') + '%' : '–') + ' in SLA · ' + ((length(data('tot')) ? data('tot')[0].cur_ta : 0) / max(1, (length(data('tot')) ? data('tot')[0].cur_a : 0)) < 3600 ? round((length(data('tot')) ? data('tot')[0].cur_ta : 0) / max(1, (length(data('tot')) ? data('tot')[0].cur_a : 0)) / 60) + ' min' : format((length(data('tot')) ? data('tot')[0].cur_ta : 0) / max(1, (length(data('tot')) ? data('tot')[0].cur_a : 0)) / 3600, '.1f') + ' h') + ' turnaround · ' + (isValid(((length(data('tot')) ? data('tot')[0].cur_fo : 0) / max(1, (length(data('tot')) ? data('tot')[0].cur_f1 : 0)))) && isFinite(((length(data('tot')) ? data('tot')[0].cur_fo : 0) / max(1, (length(data('tot')) ? data('tot')[0].cur_f1 : 0)))) ? format(((length(data('tot')) ? data('tot')[0].cur_fo : 0) / max(1, (length(data('tot')) ? data('tot')[0].cur_f1 : 0))) * 100, '.1f') + '%' : '–') + ' first time'"
          },
          "limit": {
            "signal": "width - 42 - length('SLA AND FIRST TIME') * 6.9 - 0 - headerRight"
          }
        }
      }
    },
    {
      "type": "rect",
      "encode": {
        "update": {
          "x": {
            "signal": "16"
          },
          "y": {
            "value": 36
          },
          "width": {
            "value": 11
          },
          "height": {
            "value": 11
          },
          "cornerRadius": {
            "value": 3
          },
          "fill": {
            "value": "#0F4D43"
          }
        }
      }
    },
    {
      "type": "text",
      "encode": {
        "update": {
          "x": {
            "signal": "16 + 17"
          },
          "y": {
            "value": 41.5
          },
          "baseline": {
            "value": "middle"
          },
          "font": {
            "value": "Inter, 'Segoe UI', system-ui, -apple-system, sans-serif"
          },
          "fontSize": {
            "value": 12
          },
          "fill": {
            "value": "#5F6E69"
          },
          "text": {
            "value": "Within SLA"
          }
        }
      }
    },
    {
      "type": "rect",
      "encode": {
        "update": {
          "x": {
            "signal": "109"
          },
          "y": {
            "value": 36
          },
          "width": {
            "value": 11
          },
          "height": {
            "value": 11
          },
          "cornerRadius": {
            "value": 3
          },
          "fill": {
            "value": "#B9852C"
          }
        }
      }
    },
    {
      "type": "text",
      "encode": {
        "update": {
          "x": {
            "signal": "109 + 17"
          },
          "y": {
            "value": 41.5
          },
          "baseline": {
            "value": "middle"
          },
          "font": {
            "value": "Inter, 'Segoe UI', system-ui, -apple-system, sans-serif"
          },
          "fontSize": {
            "value": 12
          },
          "fill": {
            "value": "#5F6E69"
          },
          "text": {
            "value": "First-time success"
          }
        }
      }
    },
    {
      "type": "rect",
      "encode": {
        "update": {
          "x": {
            "signal": "width - 16 - 171"
          },
          "y": {
            "value": 12
          },
          "width": {
            "value": 171
          },
          "height": {
            "value": 24
          },
          "cornerRadius": {
            "value": 12
          },
          "fill": {
            "value": "#F7F6F2"
          },
          "stroke": {
            "value": "#D6D9D2"
          }
        }
      }
    },
    {
      "type": "rect",
      "name": "seg_grain_0",
      "encode": {
        "update": {
          "x": {
            "signal": "width - 16 - 171 + 3"
          },
          "y": {
            "value": 14
          },
          "width": {
            "value": 49
          },
          "height": {
            "value": 20
          },
          "cornerRadius": {
            "value": 10
          },
          "fill": {
            "signal": "grain === 'daily' ? '#DCE8E0' : 'transparent'"
          },
          "stroke": {
            "value": "transparent"
          },
          "cursor": {
            "value": "pointer"
          }
        }
      }
    },
    {
      "type": "text",
      "interactive": false,
      "encode": {
        "update": {
          "x": {
            "signal": "width - 16 - 171 + 3 + 24.5"
          },
          "y": {
            "value": 24
          },
          "align": {
            "value": "center"
          },
          "baseline": {
            "value": "middle"
          },
          "font": {
            "value": "Inter, 'Segoe UI', system-ui, -apple-system, sans-serif"
          },
