          }
        }
      }
    },
    {
      "type": "rect",
      "name": "seg_grain_1",
      "encode": {
        "update": {
          "x": {
            "signal": "width - 16 - 171 + 52"
          },
          "y": {
            "value": 14
          },
          "width": {
            "value": 55
          },
          "height": {
            "value": 20
          },
          "cornerRadius": {
            "value": 10
          },
          "fill": {
