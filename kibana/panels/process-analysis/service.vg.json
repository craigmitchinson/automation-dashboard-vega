          },
          "stroke": {
            "value": "transparent"
          },
          "cursor": {
            "value": "pointer"
          }
        }
      }
    },
    {
      "type": "text",
      "interactive": false,
      "encode": {
        "update": {
          "x": {
            "signal": "width - 16 - 171 + 52 + 27.5"
          },
          "y": {
            "value": 24
          },
          "align": {
            "value": "center"
          },
          "baseline": {
            "value": "middle"
