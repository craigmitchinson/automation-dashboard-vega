{
  "$schema": "https://vega.github.io/schema/vega/v5.json",
  "description": "IA · Process Analysis · Process performance. Generated by vega/build.mjs from vega/panels/process-analysis.mjs, do not edit by hand.",
  "autosize": {
    "type": "fit",
    "contains": "padding"
  },
  "padding": 0,
  "config": {
    "background": "#FFFFFF",
    "padding": 0,
    "font": "Inter, 'Segoe UI', system-ui, -apple-system, sans-serif",
    "text": {
      "font": "Inter, 'Segoe UI', system-ui, -apple-system, sans-serif",
      "fill": "#0F4D43",
      "fontSize": 12
    },
    "axis": {
      "gridColor": "#E6E8E2",
      "labelFont": "'Roboto Mono', Menlo, Consolas, monospace",
      "labelFontSize": 10,
      "labelColor": "#5F6E69",
      "titleFont": "'Roboto Mono', Menlo, Consolas, monospace",
      "titleColor": "#5F6E69",
      "titleFontSize": 10,
      "titleFontWeight": 400,
      "domain": false,
      "ticks": false,
      "gridWidth": 1,
      "labelPadding": 6
    },
    "style": {
      "guide-label": {
        "font": "'Roboto Mono', Menlo, Consolas, monospace"
      }
    },
    "view": {
      "stroke": null
    },
    "kibana": {
      "renderer": "svg",
      "hideWarnings": true
    }
  },
  "signals": [
    {
      "name": "headerRight",
      "value": 0
    },
    {
      "name": "top",
      "value": 42
    },
    {
      "name": "cw",
      "update": "width - 32"
    },
    {
      "name": "ch",
      "update": "height - top - 16"
    },
    {
      "name": "metric",
      "value": "sla",
      "on": [
        {
          "events": "@seg_metric_0:click",
          "update": "'sla'"
        },
        {
          "events": "@seg_metric_1:click",
          "update": "'turn'"
        },
        {
          "events": "@seg_metric_2:click",
          "update": "'first'"
        },
        {
          "events": "@seg_metric_3:click",
          "update": "'time'"
        },
        {
          "events": "@seg_metric_4:click",
          "update": "'throughput'"
        },
        {
          "events": "@seg_metric_5:click",
          "update": "'exrate'"
        }
      ]
    },
    {
      "name": "pick",
      "on": [
        {
          "events": "@hb_row:click",
          "update": "kibanaAddFilter({'match_phrase': {'process.name': datum.label}}, 'ia-workqueue-items*')"
        }
      ]
    },
    {
      "name": "hb_fit",
      "update": "max(1, floor((ch - 34) / 25))"
    }
  ],
  "data": [
    {
      "name": "procs_raw",
      "url": {
        "index": "ia-reference",
        "body": {
          "size": 500,
          "query": {
            "term": {
              "doc_type": "process"
            }
          }
        }
      },
      "format": {
        "property": "hits.hits"
      }
    },
    {
      "name": "procs",
      "source": "procs_raw",
      "transform": [
        {
          "type": "formula",
          "as": "name",
          "expr": "datum._source.process.name"
        },
        {
          "type": "formula",
          "as": "pid",
          "expr": "datum._source.process.id"
        },
        {
          "type": "formula",
          "as": "acronym",
          "expr": "datum._source.process.acronym"
        },
        {
          "type": "formula",
          "as": "spoke",
          "expr": "datum._source.spoke.name"
        },
        {
          "type": "formula",
          "as": "spokeColor",
          "expr": "datum._source.spoke.color"
        },
        {
          "type": "formula",
          "as": "proposition",
          "expr": "datum._source.proposition.name"
        },
        {
          "type": "formula",
          "as": "queue",
          "expr": "datum._source.primary_queue"
        },
        {
          "type": "formula",
          "as": "queues",
          "expr": "join(datum._source.queues, ' → ')"
        },
        {
          "type": "formula",
          "as": "description",
          "expr": "datum._source.process.description"
        },
        {
          "type": "formula",
          "as": "tags",
          "expr": "datum._source.process.tags"
        },
        {
          "type": "formula",
          "as": "smv",
          "expr": "datum._source.process.smv_minutes"
        },
        {
          "type": "formula",
          "as": "grade",
          "expr": "datum._source.process.grade"
        },
        {
          "type": "formula",
          "as": "gradeName",
          "expr": "datum._source.process.grade_name"
        },
        {
          "type": "formula",
          "as": "rate",
          "expr": "datum._source.process.current_rate_gbp"
        },
        {
          "type": "formula",
          "as": "rateOff",
          "expr": "datum._source.process.current_rate_offshore_gbp"
        },
        {
          "type": "formula",
          "as": "offShare",
          "expr": "datum._source.process.offshore_share || 0"
        },
        {
          "type": "formula",
          "as": "slaHours",
          "expr": "datum._source.process.sla_hours"
        }
      ]
    },
    {
      "name": "bp_raw",
      "url": {
        "index": "ia-workqueue-items",
        "body": {
          "size": 0,
          "query": {
            "bool": {
              "must": [
                "%dashboard_context-must_clause%",
                {
                  "range": {
                    "outcome_date": {
                      "gt": {
                        "%timefilter%": "min",
                        "shift": -23,
                        "unit": "hour"
                      },
                      "format": "epoch_millis"
                    }
                  }
                },
                {
                  "range": {
                    "@timestamp": {
                      "lte": {
                        "%timefilter%": "max"
                      },
                      "format": "epoch_millis"
                    }
                  }
                }
              ],
              "filter": [
                "%dashboard_context-filter_clause%"
              ],
              "must_not": [
                "%dashboard_context-must_not_clause%"
              ]
            }
          },
          "aggs": {
            "m": {
              "filter": {
                "term": {
                  "mapped": true
                }
              },
              "aggs": {
                "p": {
                  "terms": {
                    "field": "process.name",
                    "size": 100
                  },
                  "aggs": {
                    "c": {
                      "sum": {
                        "field": "n.completed"
                      }
                    },
                    "a": {
                      "sum": {
                        "field": "n.attempt"
                      }
                    },
                    "e": {
                      "sum": {
                        "field": "n.exception"
                      }
                    },
                    "cw": {
                      "sum": {
                        "field": "worktime_completed_sec"
                      }
                    },
                    "ta": {
                      "sum": {
                        "field": "turnaround_sec"
                      }
                    },
                    "sl": {
                      "sum": {
                        "field": "n.in_sla"
                      }
                    },
                    "f1": {
                      "sum": {
                        "field": "n.first"
                      }
                    },
                    "fo": {
                      "sum": {
                        "field": "n.first_ok"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      },
      "format": {
        "property": "aggregations.m.p.buckets"
      }
    },
    {
      "name": "bp",
      "source": "bp_raw",
      "transform": [
        {
          "type": "formula",
          "as": "name",
          "expr": "datum.key"
        },
        {
          "type": "formula",
          "as": "c",
          "expr": "datum['c'].value"
        },
        {
          "type": "formula",
          "as": "a",
          "expr": "datum['a'].value"
        },
        {
          "type": "formula",
          "as": "e",
          "expr": "datum['e'].value"
        },
        {
          "type": "formula",
          "as": "cw",
          "expr": "datum['cw'].value"
        },
        {
          "type": "formula",
          "as": "ta",
          "expr": "datum['ta'].value"
        },
        {
          "type": "formula",
          "as": "sl",
          "expr": "datum['sl'].value"
        },
        {
          "type": "formula",
          "as": "f1",
          "expr": "datum['f1'].value"
        },
        {
          "type": "formula",
          "as": "fo",
          "expr": "datum['fo'].value"
        },
        {
          "type": "lookup",
          "from": "procs",
          "key": "name",
          "fields": [
            "name"
          ],
          "as": [
            "ref"
          ]
        },
        {
          "type": "formula",
          "as": "spoke",
          "expr": "datum.ref ? datum.ref.spoke : ''"
        },
        {
          "type": "formula",
          "as": "spokeColor",
          "expr": "datum.ref ? datum.ref.spokeColor : '#5F6E69'"
        },
        {
          "type": "formula",
          "as": "queue",
          "expr": "datum.ref ? datum.ref.queue : ''"
        },
        {
          "type": "formula",
          "as": "proposition",
          "expr": "datum.ref ? datum.ref.proposition : ''"
        },
        {
          "type": "formula",
          "as": "slaHours",
          "expr": "datum.ref ? datum.ref.slaHours : null"
        }
      ]
    },
    {
      "name": "bars",
      "source": "bp",
      "transform": [
        {
          "type": "formula",
          "as": "label",
          "expr": "datum.name"
        },
        {
          "type": "formula",
          "as": "cycle",
          "expr": "datum.c ? datum.cw / datum.c : 0"
        },
        {
          "type": "formula",
          "as": "turn",
          "expr": "datum.a ? datum.ta / datum.a : 0"
        },
        {
          "type": "formula",
          "as": "slaP",
          "expr": "datum.c ? 1 - datum.sl / datum.c : null"
        },
        {
          "type": "formula",
          "as": "firstP",
          "expr": "datum.f1 ? 1 - datum.fo / datum.f1 : null"
        },
        {
          "type": "formula",
          "as": "rate",
          "expr": "datum.a ? datum.e / datum.a * 100 : 0"
        },
        {
          "type": "formula",
          "as": "value",
          "expr": "metric === 'sla' ? datum.slaP : metric === 'turn' ? datum.turn : metric === 'first' ? datum.firstP : metric === 'time' ? datum.cycle : metric === 'throughput' ? datum.c : datum.rate"
        },
        {
          "type": "formula",
          "as": "display",
          "expr": "metric === 'sla' ? (isValid((datum.slaP)) && isFinite((datum.slaP)) ? format((datum.slaP) * 100, '.1f') + '%' : '–') : metric === 'turn' ? (datum.turn < 3600 ? round(datum.turn / 60) + ' min' : format(datum.turn / 3600, '.1f') + ' h') : metric === 'first' ? (isValid((datum.firstP)) && isFinite((datum.firstP)) ? format((datum.firstP) * 100, '.1f') + '%' : '–') : metric === 'time' ? (isValid((datum.cycle)) && isFinite((datum.cycle)) ? (round((datum.cycle)) < 60 ? round(max(0, (datum.cycle))) + 's' : round((datum.cycle)) < 3600 ? floor(round((datum.cycle)) / 60) + 'm ' + pad('' + (round((datum.cycle)) % 60), 2, '0', 'left') + 's' : floor(round((datum.cycle)) / 3600) + 'h ' + pad('' + floor((round((datum.cycle)) % 3600) / 60), 2, '0', 'left') + 'm') : '–') : metric === 'throughput' ? (isValid((datum.c)) && isFinite((datum.c)) ? (abs((datum.c)) >= 1e6 ? format((datum.c) / 1e6, abs((datum.c)) >= 1e7 ? '.0f' : '.1f') + 'M' : abs((datum.c)) >= 1e3 ? format((datum.c) / 1e3, abs((datum.c)) >= 1e4 ? '.0f' : '.1f') + 'k' : format((datum.c), '.0f')) : '–') : format(datum.rate, '.1f') + '%'"
        },
        {
          "type": "formula",
          "as": "sub",
          "expr": "metric === 'sla' ? 'SLA ' + datum.slaHours + ' h' : metric === 'time' ? (isValid((datum.c)) && isFinite((datum.c)) ? (abs((datum.c)) >= 1e6 ? format((datum.c) / 1e6, abs((datum.c)) >= 1e7 ? '.0f' : '.1f') + 'M' : abs((datum.c)) >= 1e3 ? format((datum.c) / 1e3, abs((datum.c)) >= 1e4 ? '.0f' : '.1f') + 'k' : format((datum.c), '.0f')) : '–') + ' completed' : metric === 'turn' ? (isValid((datum.a)) && isFinite((datum.a)) ? (abs((datum.a)) >= 1e6 ? format((datum.a) / 1e6, abs((datum.a)) >= 1e7 ? '.0f' : '.1f') + 'M' : abs((datum.a)) >= 1e3 ? format((datum.a) / 1e3, abs((datum.a)) >= 1e4 ? '.0f' : '.1f') + 'k' : format((datum.a), '.0f')) : '–') + ' attempts' : metric === 'exrate' ? (isValid((datum.e)) && isFinite((datum.e)) ? format((datum.e), ',.0f') : '–') + ' exc' : ''"
        },
        {
          "type": "formula",
          "as": "color",
          "expr": "metric === 'exrate' || metric === 'sla' ? '#B6462F' : metric === 'first' ? '#B9852C' : '#0F4D43'"
        },
        {
          "type": "collect",
          "sort": {
            "field": [
              "value",
              "label"
            ],
            "order": [
              "descending",
              "ascending"
            ]
          }
        }
      ]
    },
    {
      "name": "hb_rows",
      "source": "bars",
      "transform": [
        {
          "type": "window",
          "ops": [
            "row_number"
          ],
          "as": [
            "rank"
          ]
        },
        {
          "type": "filter",
          "expr": "datum.rank <= hb_fit"
        }
      ]
    }
  ],
  "scales": [
    {
      "name": "hb_x",
      "type": "linear",
      "domain": {
        "signal": "length(data('bars')) ? extent(pluck(data('bars'), 'value')) : [0, 1]"
      },
      "range": [
        0,
        {
          "signal": "cw - 250"
        }
      ],
      "zero": true,
      "nice": false
    }
  ],
  "marks": [
    {
      "type": "text",
      "name": "frame_title",
      "encode": {
        "update": {
          "x": {
            "value": 16
          },
          "y": {
            "value": 18
          },
          "baseline": {
            "value": "top"
          },
          "font": {
            "value": "'Roboto Mono', Menlo, Consolas, monospace"
          },
          "fontSize": {
            "value": 11
          },
          "fontWeight": {
            "value": 600
          },
          "fill": {
            "value": "#0F4D43"
          },
          "text": {
            "signal": "'PROCESS PERFORMANCE'"
          },
          "limit": {
            "signal": "width - 32"
          }
        }
      }
    },
    {
      "type": "text",
      "encode": {
        "update": {
          "x": {
            "signal": "16 + length('PROCESS PERFORMANCE') * 6.9 + 10"
          },
          "y": {
            "value": 17
          },
          "baseline": {
            "value": "top"
          },
          "font": {
            "value": "Inter, 'Segoe UI', system-ui, -apple-system, sans-serif"
          },
          "fontSize": {
            "value": 12
          },
          "fill": {
            "value": "#5F6E69"
          },
          "text": {
            "signal": "({'sla':'Completed outside SLA, worst first','turn':'Loaded to outcome, longest first','first':'Not done first time, worst first','time':'Bot runtime per completed item','throughput':'Items completed','exrate':'Attempts ending in an exception'})[metric]"
          },
          "limit": {
            "signal": "width - 42 - length('PROCESS PERFORMANCE') * 6.9 - 0 - headerRight"
          }
        }
      }
    },
    {
      "type": "rect",
      "encode": {
        "update": {
          "x": {
            "signal": "width - 16 - 526"
          },
          "y": {
            "value": 40
