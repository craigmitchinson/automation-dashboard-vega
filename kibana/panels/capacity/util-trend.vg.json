    {
      "name": "lic_raw",
      "url": {
        "index": "ia-vdi-daily",
        "body": {
          "size": 0,
          "query": {
            "range": {
              "@timestamp": {
                "gt": {
                  "%timefilter%": "min",
                  "shift": -23,
                  "unit": "hour"
                },
                "lte": {
                  "%timefilter%": "max"
                },
                "format": "epoch_millis"
              }
            }
          },
          "aggs": {
            "d": {
              "date_histogram": {
                "field": "@timestamp",
                "fixed_interval": "1d",
                "min_doc_count": 0
              },
              "aggs": {
                "r": {
                  "terms": {
                    "field": "resource.name",
                    "size": 500
                  },
                  "aggs": {
                    "h": {
                      "sum": {
                        "field": "operating_hours"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      },
      "format": {
        "property": "aggregations.d.buckets"
      }
    },
    {
      "name": "lic",
      "source": "lic_raw",
      "transform": [
        {
          "type": "flatten",
          "fields": [
            "r.buckets"
          ],
          "as": [
            "g"
          ]
        },
        {
          "type": "filter",
          "expr": "indexof(pluck(data('vdis'), 'name'), datum.g.key) >= 0"
        },
        {
          "type": "formula",
          "as": "h",
          "expr": "datum.g.h.value"
        },
        {
          "type": "aggregate",
          "groupby": [
            "key"
          ],
          "ops": [
            "sum"
          ],
          "fields": [
            "h"
          ],
          "as": [
            "h"
          ]
        }
      ]
    },
    {
      "name": "cap",
      "source": "series",
      "transform": [
        {
          "type": "lookup",
          "from": "lic",
          "key": "key",
          "fields": [
            "t"
          ],
          "values": [
            "h"
          ],
          "as": [
            "lic"
          ],
          "default": 0
        },
        {
          "type": "formula",
          "as": "g",
          "expr": "cgrain === 'monthly' ? utc(utcyear(datum.t), utcmonth(datum.t), 1) : cgrain === 'weekly' ? datum.t - ((utcday(datum.t) + 6) % 7) * 86400000 : datum.t"
        },
        {
          "type": "aggregate",
          "groupby": [
            "g"
          ],
          "ops": [
            "sum",
            "sum",
            "sum",
            "count"
          ],
          "fields": [
            "w",
            "a",
            "lic",
            "t"
          ],
          "as": [
            "w",
            "a",
            "lic",
            "days"
          ]
        },
        {
          "type": "formula",
          "as": "t",
          "expr": "datum.g"
        },
        {
          "type": "formula",
          "as": "util",
          "expr": "datum.lic ? datum.w / 3600 / datum.lic * 100 : null"
        },
        {
          "type": "formula",
          "as": "need",
          "expr": "datum.days ? datum.w / 3600 / (datum.days * opH) : 0"
        },
        {
          "type": "formula",
          "as": "have",
          "expr": "datum.days ? datum.lic / (datum.days * opH) : 0"
        },
        {
          "type": "collect",
          "sort": {
            "field": "t"
          }
        }
      ]
    }
