{
  "$schema": "https://vega.github.io/schema/vega/v5.json",
  "description": "IA · VDI & Capacity · Utilisation over time. Generated by vega/build.mjs from vega/panels/capacity.mjs, do not edit by hand.",
  "autosize": {
    "type": "fit",
    "contains": "padding"
  },
  "padding": 0,
  "config": {
    "background": "#FFFFFF",
    "padding": 0,
    "font": "Inter, 'Segoe UI', system-ui, -apple-system, sans-serif",
    "text": {
      "font": "Inter, 'Segoe UI', system-ui, -apple-system, sans-serif",
      "fill": "#0F4D43",
      "fontSize": 12
    },
    "axis": {
      "gridColor": "#E6E8E2",
      "labelFont": "'Roboto Mono', Menlo, Consolas, monospace",
      "labelFontSize": 10,
      "labelColor": "#5F6E69",
      "titleFont": "'Roboto Mono', Menlo, Consolas, monospace",
      "titleColor": "#5F6E69",
      "titleFontSize": 10,
      "titleFontWeight": 400,
      "domain": false,
      "ticks": false,
      "gridWidth": 1,
      "labelPadding": 6
    },
    "style": {
      "guide-label": {
        "font": "'Roboto Mono', Menlo, Consolas, monospace"
      }
    },
    "view": {
      "stroke": null
    },
    "kibana": {
      "renderer": "svg",
      "hideWarnings": true
    }
  },
  "signals": [
    {
      "name": "oneSpoke",
      "update": "length(data('scope_spokes')) === 1 ? data('scope_spokes')[0].key : ''"
    },
    {
      "name": "tgt_completionPct",
      "update": "oneSpoke && indexof(pluck(data('tg'), 'k'), 'spoke|' + oneSpoke + '|completionPct') >= 0 ? data('tg')[indexof(pluck(data('tg'), 'k'), 'spoke|' + oneSpoke + '|completionPct')].v : (indexof(pluck(data('tg'), 'k'), 'global|completionPct') >= 0 ? data('tg')[indexof(pluck(data('tg'), 'k'), 'global|completionPct')].v : 0.95)"
    },
    {
      "name": "tgt_exceptionRate",
      "update": "oneSpoke && indexof(pluck(data('tg'), 'k'), 'spoke|' + oneSpoke + '|exceptionRate') >= 0 ? data('tg')[indexof(pluck(data('tg'), 'k'), 'spoke|' + oneSpoke + '|exceptionRate')].v : (indexof(pluck(data('tg'), 'k'), 'global|exceptionRate') >= 0 ? data('tg')[indexof(pluck(data('tg'), 'k'), 'global|exceptionRate')].v : 0.06)"
    },
    {
      "name": "tgt_systemRate",
      "update": "oneSpoke && indexof(pluck(data('tg'), 'k'), 'spoke|' + oneSpoke + '|systemRate') >= 0 ? data('tg')[indexof(pluck(data('tg'), 'k'), 'spoke|' + oneSpoke + '|systemRate')].v : (indexof(pluck(data('tg'), 'k'), 'global|systemRate') >= 0 ? data('tg')[indexof(pluck(data('tg'), 'k'), 'global|systemRate')].v : 0.03)"
    },
    {
      "name": "tgt_costPerCase",
      "update": "oneSpoke && indexof(pluck(data('tg'), 'k'), 'spoke|' + oneSpoke + '|costPerCase') >= 0 ? data('tg')[indexof(pluck(data('tg'), 'k'), 'spoke|' + oneSpoke + '|costPerCase')].v : (indexof(pluck(data('tg'), 'k'), 'global|costPerCase') >= 0 ? data('tg')[indexof(pluck(data('tg'), 'k'), 'global|costPerCase')].v : 9)"
    },
    {
      "name": "tgt_utilMin",
      "update": "oneSpoke && indexof(pluck(data('tg'), 'k'), 'spoke|' + oneSpoke + '|utilMin') >= 0 ? data('tg')[indexof(pluck(data('tg'), 'k'), 'spoke|' + oneSpoke + '|utilMin')].v : (indexof(pluck(data('tg'), 'k'), 'global|utilMin') >= 0 ? data('tg')[indexof(pluck(data('tg'), 'k'), 'global|utilMin')].v : 0.15)"
    },
    {
      "name": "tgt_utilMax",
      "update": "oneSpoke && indexof(pluck(data('tg'), 'k'), 'spoke|' + oneSpoke + '|utilMax') >= 0 ? data('tg')[indexof(pluck(data('tg'), 'k'), 'spoke|' + oneSpoke + '|utilMax')].v : (indexof(pluck(data('tg'), 'k'), 'global|utilMax') >= 0 ? data('tg')[indexof(pluck(data('tg'), 'k'), 'global|utilMax')].v : 0.6)"
    },
    {
      "name": "tgt_vdiStaleDays",
      "update": "oneSpoke && indexof(pluck(data('tg'), 'k'), 'spoke|' + oneSpoke + '|vdiStaleDays') >= 0 ? data('tg')[indexof(pluck(data('tg'), 'k'), 'spoke|' + oneSpoke + '|vdiStaleDays')].v : (indexof(pluck(data('tg'), 'k'), 'global|vdiStaleDays') >= 0 ? data('tg')[indexof(pluck(data('tg'), 'k'), 'global|vdiStaleDays')].v : 14)"
    },
    {
      "name": "cfg_fyStart",
      "update": "length(data('ref_config')) ? data('ref_config')[0]._source.fiscal_year_start_month : 4"
    },
    {
      "name": "cfg_warn",
      "update": "length(data('ref_config')) ? data('ref_config')[0]._source.warn_margin : 0.1"
    },
    {
      "name": "allSpokes",
      "update": "length(data('scope_all')) >= (length(data('ref_spoke_count')) ? data('ref_spoke_count')[0].value : 99)"
    },
    {
      "name": "nActive",
      "update": "length(data('vdi_tot')) ? data('vdi_tot')[0].nActive : 0"
    },
    {
      "name": "nAll",
      "update": "length(data('vdi_tot')) ? data('vdi_tot')[0].nAll : 0"
    },
    {
      "name": "sumAvail",
      "update": "length(data('vdi_tot')) ? data('vdi_tot')[0].sumAvail : 0"
    },
    {
      "name": "sumActive",
      "update": "length(data('vdi_tot')) ? data('vdi_tot')[0].sumActive : 0"
    },
    {
      "name": "sumIdle",
      "update": "length(data('vdi_tot')) ? data('vdi_tot')[0].sumIdle : 0"
    },
    {
      "name": "sumCost",
      "update": "length(data('vdi_tot')) ? data('vdi_tot')[0].sumCost : 0"
    },
    {
      "name": "avgUtil",
      "update": "sumAvail ? sumActive / sumAvail : 0"
    },
    {
      "name": "ndays",
      "update": "length(data('win'))"
    },
    {
      "name": "lo",
      "update": "ndays ? data('win')[0].key : 0"
    },
    {
      "name": "hi",
      "update": "ndays ? data('win')[ndays - 1].key : 0"
    },
    {
      "name": "plo",
      "update": "lo - ndays * 86400000"
    },
    {
      "name": "phi",
      "update": "lo - 86400000"
    },
    {
      "name": "opH",
      "update": "length(data('ref_config')) ? data('ref_config')[0]._source.vdi_operating_hours : 20"
    },
    {
      "name": "headerRight",
      "value": 0
    },
    {
      "name": "top",
      "value": 42
    },
    {
      "name": "cw",
      "update": "width - 32"
    },
    {
      "name": "ch",
      "update": "height - top - 16"
    },
    {
      "name": "cgrain",
      "value": "weekly",
      "on": [
        {
          "events": "@seg_cgrain_0:click",
          "update": "'daily'"
        },
        {
          "events": "@seg_cgrain_1:click",
          "update": "'weekly'"
        },
        {
          "events": "@seg_cgrain_2:click",
          "update": "'monthly'"
        }
      ]
    },
    {
      "name": "ut_ymax",
      "update": "max(extent(pluck(data('cap'), 'util'))[1] || 0, tgt_utilMax * 100, tgt_utilMin * 100)"
    }
  ],
  "data": [
    {
      "name": "ref_targets",
      "url": {
        "index": "ia-reference",
        "body": {
          "size": 200,
          "query": {
            "term": {
              "doc_type": "target"
            }
          }
        }
      },
      "format": {
        "property": "hits.hits"
      }
    },
    {
      "name": "tg",
      "source": "ref_targets",
      "transform": [
        {
          "type": "formula",
          "as": "k",
          "expr": "datum._source.scope === 'global' ? 'global|' + datum._source.metric : datum._source.scope + '|' + datum._source.scope_id + '|' + datum._source.metric"
        },
        {
          "type": "formula",
          "as": "v",
          "expr": "datum._source.value"
        }
      ]
    },
    {
      "name": "ref_config",
      "url": {
        "index": "ia-reference",
        "body": {
          "size": 1,
          "query": {
            "term": {
              "doc_type": "config"
            }
          }
        }
      },
      "format": {
        "property": "hits.hits"
      }
    },
    {
      "name": "scope_spokes",
      "url": {
        "index": "ia-workqueue-items",
        "body": {
          "size": 0,
          "query": {
            "bool": {
              "must": [
                "%dashboard_context-must_clause%",
                {
                  "range": {
                    "outcome_date": {
                      "gt": {
                        "%timefilter%": "min",
                        "shift": -23,
                        "unit": "hour"
                      },
                      "format": "epoch_millis"
                    }
                  }
                },
                {
                  "range": {
                    "@timestamp": {
                      "lte": {
                        "%timefilter%": "max"
                      },
                      "format": "epoch_millis"
                    }
                  }
                }
              ],
              "filter": [
                "%dashboard_context-filter_clause%"
              ],
              "must_not": [
                "%dashboard_context-must_not_clause%"
              ]
            }
          },
          "aggs": {
            "m": {
              "filter": {
                "term": {
                  "mapped": true
                }
              },
              "aggs": {
                "s": {
                  "terms": {
                    "field": "spoke.name",
                    "size": 2
                  }
                }
              }
            }
          }
        }
      },
      "format": {
        "property": "aggregations.m.s.buckets"
      }
    },
    {
      "name": "act_raw",
      "url": {
        "index": "ia-workqueue-items",
        "body": {
          "size": 0,
          "query": {
            "bool": {
              "must": [
                "%dashboard_context-must_clause%",
                {
                  "range": {
                    "outcome_date": {
                      "gt": {
                        "%timefilter%": "min",
                        "shift": -23,
                        "unit": "hour"
                      },
                      "format": "epoch_millis"
                    }
                  }
                },
                {
                  "range": {
                    "@timestamp": {
                      "lte": {
                        "%timefilter%": "max"
                      },
                      "format": "epoch_millis"
                    }
                  }
                }
              ],
              "filter": [
                "%dashboard_context-filter_clause%"
              ],
              "must_not": [
                "%dashboard_context-must_not_clause%"
              ]
            }
          },
          "aggs": {
            "m": {
              "filter": {
                "bool": {
                  "filter": [
                    {
                      "term": {
                        "mapped": true
                      }
                    },
                    {
                      "exists": {
                        "field": "resource.name"
                      }
                    }
                  ]
                }
              },
              "aggs": {
                "r": {
                  "terms": {
                    "field": "resource.name",
                    "size": 500
                  },
                  "aggs": {
                    "att": {
                      "sum": {
                        "field": "n.attempt"
                      }
                    },
                    "w": {
                      "sum": {
                        "field": "worktime_sec"
                      }
                    },
                    "ec": {
                      "sum": {
                        "field": "cost.estate_gbp"
                      }
                    },
                    "np": {
                      "cardinality": {
                        "field": "process.name"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      },
      "format": {
        "property": "aggregations.m.r.buckets"
      }
    },
    {
      "name": "scope_all",
      "url": {
        "index": "ia-workqueue-items",
        "body": {
          "size": 0,
          "query": {
            "bool": {
              "must": [
                "%dashboard_context-must_clause%",
                {
                  "range": {
                    "outcome_date": {
                      "gt": {
                        "%timefilter%": "min",
                        "shift": -23,
                        "unit": "hour"
                      },
                      "format": "epoch_millis"
                    }
                  }
                },
                {
                  "range": {
                    "@timestamp": {
                      "lte": {
                        "%timefilter%": "max"
                      },
                      "format": "epoch_millis"
                    }
                  }
                }
              ],
              "filter": [
                "%dashboard_context-filter_clause%"
              ],
              "must_not": [
                "%dashboard_context-must_not_clause%"
              ]
            }
          },
          "aggs": {
            "m": {
              "filter": {
                "term": {
                  "mapped": true
                }
              },
              "aggs": {
                "s": {
                  "terms": {
                    "field": "spoke.name",
                    "size": 100
                  }
                }
              }
            }
          }
        }
      },
      "format": {
        "property": "aggregations.m.s.buckets"
      }
    },
    {
      "name": "avail_raw",
      "url": {
        "index": "ia-vdi-daily",
        "body": {
          "size": 0,
          "query": {
            "range": {
              "@timestamp": {
                "gt": {
                  "%timefilter%": "min",
                  "shift": -23,
                  "unit": "hour"
                },
                "lte": {
                  "%timefilter%": "max"
                },
                "format": "epoch_millis"
              }
            }
          },
          "aggs": {
            "r": {
              "terms": {
                "field": "resource.name",
                "size": 500
              },
              "aggs": {
                "h": {
                  "sum": {
                    "field": "operating_hours"
                  }
                },
                "o": {
                  "terms": {
                    "field": "resource.owner_spoke",
                    "size": 1
                  }
                }
              }
            }
          }
        }
      },
      "format": {
        "property": "aggregations.r.buckets"
      }
    },
    {
      "name": "ref_spoke_count",
      "url": {
        "index": "ia-reference",
        "body": {
          "size": 0,
          "query": {
            "term": {
              "doc_type": "spoke"
            }
          }
        }
      },
      "format": {
        "property": "hits.total"
      }
    },
    {
      "name": "vdis",
      "source": "avail_raw",
      "transform": [
        {
          "type": "formula",
          "as": "name",
          "expr": "datum.key"
        },
        {
          "type": "formula",
          "as": "spoke",
          "expr": "datum.o.buckets[0].key"
        },
        {
          "type": "formula",
          "as": "availableHours",
          "expr": "datum.h.value"
        },
        {
          "type": "lookup",
          "from": "act_raw",
          "key": "key",
          "fields": [
            "key"
          ],
          "as": [
            "a"
          ]
        },
        {
          "type": "formula",
          "as": "cases",
          "expr": "datum.a ? datum.a.att.value : 0"
        },
        {
          "type": "formula",
          "as": "activeHours",
          "expr": "datum.a ? datum.a.w.value / 3600 : 0"
        },
        {
          "type": "formula",
          "as": "cost",
          "expr": "datum.a ? datum.a.ec.value : 0"
        },
        {
          "type": "formula",
          "as": "processes",
          "expr": "datum.a ? datum.a.np.value : 0"
        },
        {
          "type": "formula",
          "as": "idleHours",
          "expr": "max(0, datum.availableHours - datum.activeHours)"
        },
        {
          "type": "formula",
          "as": "idlePct",
          "expr": "datum.availableHours ? datum.idleHours / datum.availableHours : 0"
        },
        {
          "type": "formula",
          "as": "utilPct",
          "expr": "datum.availableHours ? min(1, datum.activeHours / datum.availableHours) : 0"
        },
        {
          "type": "filter",
          "expr": "(datum.availableHours > 0 || datum.cases > 0) && (datum.cases > 0 || allSpokes || indexof(pluck(data('scope_all'), 'key'), datum.spoke) >= 0)"
        }
      ]
    },
    {
      "name": "vdi_tot",
      "source": "vdis",
      "transform": [
        {
          "type": "formula",
          "as": "on",
          "expr": "datum.cases > 0 ? 1 : 0"
        },
        {
          "type": "formula",
          "as": "av",
          "expr": "datum.cases > 0 ? datum.availableHours : 0"
        },
        {
          "type": "formula",
          "as": "ac",
          "expr": "datum.cases > 0 ? datum.activeHours : 0"
        },
        {
          "type": "formula",
          "as": "id",
          "expr": "datum.cases > 0 ? datum.idleHours : 0"
        },
        {
          "type": "aggregate",
          "ops": [
            "sum",
            "count",
            "sum",
            "sum",
            "sum",
            "sum"
          ],
          "fields": [
            "on",
            "name",
            "av",
            "ac",
            "id",
            "cost"
          ],
          "as": [
            "nActive",
            "nAll",
            "sumAvail",
            "sumActive",
            "sumIdle",
            "sumCost"
          ]
        }
      ]
    },
    {
      "name": "raw",
      "url": {
        "index": "ia-workqueue-items",
        "body": {
          "size": 0,
          "query": {
            "bool": {
              "must": [
                "%dashboard_context-must_clause%",
                {
                  "range": {
                    "@timestamp": {
                      "gte": {
                        "%timefilter%": "min",
                        "shift": -732,
                        "unit": "day"
                      },
                      "lte": {
                        "%timefilter%": "max"
                      },
                      "format": "epoch_millis"
                    }
                  }
                },
                {
                  "term": {
                    "mapped": true
                  }
                }
              ],
              "filter": [
                "%dashboard_context-filter_clause%"
              ],
              "must_not": [
                "%dashboard_context-must_not_clause%"
              ]
            }
          },
          "aggs": {
            "win": {
              "filter": {
                "range": {
                  "@timestamp": {
                    "gte": {
                      "%timefilter%": "min",
                      "shift": 1,
                      "unit": "hour"
                    },
                    "lte": {
                      "%timefilter%": "max"
                    },
                    "format": "epoch_millis"
                  }
                }
              },
              "aggs": {
                "d": {
                  "date_histogram": {
                    "field": "@timestamp",
                    "fixed_interval": "1d",
                    "min_doc_count": 0,
                    "extended_bounds": {
                      "min": {
                        "%timefilter%": "min",
                        "shift": 1,
                        "unit": "hour"
                      },
                      "max": {
                        "%timefilter%": "max"
                      }
                    }
                  }
                }
              }
            },
            "days": {
              "date_histogram": {
                "field": "@timestamp",
                "fixed_interval": "1d",
                "min_doc_count": 1
              },
              "aggs": {
                "w": {
                  "sum": {
                    "field": "worktime_sec"
                  }
                },
                "a": {
                  "sum": {
                    "field": "n.attempt"
                  }
                }
              }
            }
          }
        }
      },
      "format": {
        "property": "aggregations"
      }
    },
    {
      "name": "win",
      "source": "raw",
      "transform": [
        {
          "type": "flatten",
          "fields": [
            "win.d.buckets"
          ],
          "as": [
            "_bk"
          ]
        },
        {
          "type": "formula",
          "as": "key",
          "expr": "datum._bk.key"
        },
        {
          "type": "formula",
          "as": "n",
          "expr": "datum._bk.doc_count"
        },
        {
          "type": "project",
          "fields": [
            "key",
            "n"
          ]
        }
      ]
    },
    {
      "name": "days",
      "source": "raw",
      "transform": [
        {
          "type": "flatten",
          "fields": [
            "days.buckets"
          ],
          "as": [
            "_bk"
          ]
        },
        {
          "type": "formula",
          "as": "key",
          "expr": "datum._bk.key"
        },
        {
          "type": "formula",
          "as": "n",
          "expr": "datum._bk.doc_count"
        },
        {
          "type": "formula",
          "as": "w",
          "expr": "datum._bk[\"w\"] ? (datum._bk[\"w\"].value || 0) : 0"
        },
        {
          "type": "formula",
          "as": "a",
          "expr": "datum._bk[\"a\"] ? (datum._bk[\"a\"].value || 0) : 0"
        },
        {
          "type": "project",
          "fields": [
            "key",
            "n",
            "w",
            "a"
          ]
        }
      ]
    },
    {
      "name": "series",
      "source": "win",
      "transform": [
        {
          "type": "lookup",
          "from": "days",
          "key": "key",
          "fields": [
            "key"
          ],
          "as": [
            "d"
          ]
        },
        {
          "type": "formula",
          "as": "t",
          "expr": "datum.key"
        },
        {
          "type": "formula",
          "as": "w",
          "expr": "datum.d ? datum.d.w : 0"
        },
        {
          "type": "formula",
          "as": "a",
          "expr": "datum.d ? datum.d.a : 0"
        }
      ]
    },
    {
      "name": "tot",
      "source": "days",
      "transform": [
        {
          "type": "formula",
          "as": "cur_w",
          "expr": "datum.key >= lo && datum.key <= hi ? datum.w : 0"
        },
        {
          "type": "formula",
          "as": "prev_w",
          "expr": "datum.key >= plo && datum.key <= phi ? datum.w : 0"
        },
        {
          "type": "formula",
          "as": "cur_a",
          "expr": "datum.key >= lo && datum.key <= hi ? datum.a : 0"
        },
        {
          "type": "formula",
          "as": "prev_a",
          "expr": "datum.key >= plo && datum.key <= phi ? datum.a : 0"
        },
        {
          "type": "aggregate",
          "ops": [
            "sum",
            "sum",
            "sum",
            "sum"
          ],
          "fields": [
            "cur_w",
            "prev_w",
            "cur_a",
            "prev_a"
          ],
          "as": [
            "cur_w",
            "prev_w",
            "cur_a",
            "prev_a"
          ]
        }
