{
  "$schema": "https://vega.github.io/schema/vega/v5.json",
  "description": "IA · Value & Finance · Colleague time. Generated by vega/build.mjs from vega/panels/value-finance.mjs, do not edit by hand.",
  "autosize": {
    "type": "fit",
    "contains": "padding"
  },
  "padding": 0,
  "config": {
    "background": "#FFFFFF",
    "padding": 0,
    "font": "Inter, 'Segoe UI', system-ui, -apple-system, sans-serif",
    "text": {
      "font": "Inter, 'Segoe UI', system-ui, -apple-system, sans-serif",
      "fill": "#0F4D43",
      "fontSize": 12
    },
    "axis": {
      "gridColor": "#E6E8E2",
      "labelFont": "'Roboto Mono', Menlo, Consolas, monospace",
      "labelFontSize": 10,
      "labelColor": "#5F6E69",
      "titleFont": "'Roboto Mono', Menlo, Consolas, monospace",
      "titleColor": "#5F6E69",
      "titleFontSize": 10,
      "titleFontWeight": 400,
      "domain": false,
      "ticks": false,
      "gridWidth": 1,
      "labelPadding": 6
    },
    "style": {
      "guide-label": {
        "font": "'Roboto Mono', Menlo, Consolas, monospace"
      }
    },
    "view": {
      "stroke": null
    },
    "kibana": {
      "renderer": "svg",
      "hideWarnings": true
    }
  },
  "signals": [
    {
      "name": "wd",
      "update": "length(data('wdph')) ? data('wdph')[0]._source.working_days_per_year : 252"
    },
    {
      "name": "ph",
      "update": "length(data('wdph')) ? data('wdph')[0]._source.productive_hours_per_day : 7.5"
    },
    {
      "name": "fgrain",
      "value": "weekly",
      "on": [
        {
          "events": "@seg_fgrain_0:click",
          "update": "'weekly'"
        },
        {
          "events": "@seg_fgrain_1:click",
          "update": "'monthly'"
        }
      ]
    },
    {
      "name": "ftT",
      "update": "length(data('ft_tot')) ? data('ft_tot')[0] : {h: 0, rh: 0, rw: 0, days: 0}"
    },
    {
      "name": "headerRight",
      "value": 0
    },
    {
      "name": "top",
      "value": 58
    },
    {
      "name": "cw",
      "update": "width - 32"
    },
    {
      "name": "ch",
      "update": "height - top - 16"
    },
    {
      "name": "ftc_ymax",
      "update": "max(extent(pluck(data('ft'), 'fte'))[1] || 0, extent(pluck(data('ft'), 'fteBack'))[1] || 0, 0)"
    }
  ],
  "data": [
    {
      "name": "wdph",
      "url": {
        "index": "ia-cost-daily",
        "body": {
          "size": 1,
          "query": {
            "bool": {
              "filter": [
                {
                  "term": {
                    "pool": "HUB"
                  }
                },
                {
                  "range": {
                    "@timestamp": {
                      "lte": {
                        "%timefilter%": "max"
                      },
                      "format": "epoch_millis"
                    }
                  }
                }
              ]
            }
          },
          "sort": [
            {
              "@timestamp": {
                "order": "desc"
              }
            }
          ]
        }
      },
      "format": {
        "property": "hits.hits"
      }
    },
    {
      "name": "ft_raw",
      "url": {
        "index": "ia-workqueue-items",
        "body": {
          "size": 0,
          "query": {
            "bool": {
              "must": [
                "%dashboard_context-must_clause%",
                {
                  "range": {
                    "@timestamp": {
                      "gte": {
                        "%timefilter%": "min"
                      },
                      "lte": {
                        "%timefilter%": "max"
                      },
                      "format": "epoch_millis"
                    }
                  }
                },
                {
                  "term": {
                    "mapped": true
                  }
                }
              ],
              "filter": [
                "%dashboard_context-filter_clause%"
              ],
              "must_not": [
                "%dashboard_context-must_not_clause%"
              ]
            }
          },
          "aggs": {
            "win": {
              "filter": {
                "range": {
                  "@timestamp": {
                    "%timefilter%": true
                  }
                }
              },
              "aggs": {
                "d": {
                  "date_histogram": {
                    "field": "@timestamp",
                    "fixed_interval": "1d",
                    "min_doc_count": 0,
                    "extended_bounds": {
                      "min": {
                        "%timefilter%": "min"
                      },
                      "max": {
                        "%timefilter%": "max"
                      }
                    }
                  }
                }
              }
            },
            "d": {
              "date_histogram": {
                "field": "@timestamp",
                "fixed_interval": "1d",
                "min_doc_count": 1
              },
              "aggs": {
                "h": {
                  "sum": {
                    "field": "value.hours_saved"
                  }
                },
                "biz": {
                  "filter": {
                    "term": {
                      "n.business": 1
                    }
                  },
                  "aggs": {
                    "rh": {
                      "sum": {
                        "field": "value.rework_hours"
                      }
                    },
                    "rw": {
                      "sum": {
                        "field": "value.rework_gbp"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      },
      "format": {
        "property": "aggregations"
      }
    },
    {
      "name": "ft_win",
      "source": "ft_raw",
      "transform": [
        {
          "type": "flatten",
          "fields": [
            "win.d.buckets"
          ],
          "as": [
            "_bk"
          ]
        },
        {
          "type": "formula",
          "as": "key",
          "expr": "datum._bk.key"
        },
        {
          "type": "formula",
          "as": "n",
          "expr": "datum._bk.doc_count"
        },
        {
          "type": "project",
          "fields": [
            "key",
            "n"
          ]
        }
      ]
    },
    {
      "name": "ft_d",
      "source": "ft_raw",
      "transform": [
        {
          "type": "flatten",
          "fields": [
            "d.buckets"
          ],
          "as": [
            "_bk"
          ]
        },
        {
          "type": "formula",
          "as": "key",
          "expr": "datum._bk.key"
        },
        {
          "type": "formula",
          "as": "n",
          "expr": "datum._bk.doc_count"
        },
        {
          "type": "formula",
          "as": "h",
          "expr": "datum._bk[\"h\"] ? (datum._bk[\"h\"].value || 0) : 0"
        },
        {
          "type": "formula",
          "as": "rh",
          "expr": "datum._bk.biz.rh.value || 0"
        },
        {
          "type": "formula",
          "as": "rw",
          "expr": "datum._bk.biz.rw.value || 0"
        },
        {
          "type": "project",
          "fields": [
            "key",
            "n",
            "h",
            "rh",
            "rw"
          ]
        }
      ]
    },
    {
      "name": "ft",
      "source": "ft_win",
      "transform": [
        {
          "type": "lookup",
          "from": "ft_d",
          "key": "key",
          "fields": [
            "key"
          ],
          "values": [
            "h",
            "rh",
            "rw"
          ],
          "default": 0
        },
        {
          "type": "formula",
          "as": "g",
          "expr": "fgrain === 'monthly' ? utc(utcyear(datum.key), utcmonth(datum.key), 1) : datum.key - ((utcday(datum.key) + 6) % 7) * 86400000"
        },
        {
          "type": "aggregate",
          "groupby": [
            "g"
          ],
          "ops": [
            "sum",
            "sum",
            "sum",
            "count"
          ],
          "fields": [
            "h",
            "rh",
            "rw",
            "key"
          ],
          "as": [
            "h",
            "rh",
            "rw",
            "days"
          ]
        },
        {
          "type": "formula",
          "as": "t",
          "expr": "datum.g"
        },
        {
          "type": "formula",
          "as": "fte",
          "expr": "(datum.days > 0 ? (datum.h) / (datum.days * (wd / 365.25) * ph) : 0)"
        },
        {
          "type": "formula",
          "as": "fteBack",
          "expr": "(datum.days > 0 ? (datum.rh) / (datum.days * (wd / 365.25) * ph) : 0)"
        },
        {
          "type": "collect",
          "sort": {
            "field": "t"
          }
        }
      ]
    },
    {
      "name": "ft_tot",
      "source": "ft",
      "transform": [
        {
          "type": "aggregate",
          "ops": [
            "sum",
            "sum",
            "sum",
            "sum"
          ],
          "fields": [
            "h",
            "rh",
            "rw",
            "days"
          ],
          "as": [
            "h",
            "rh",
            "rw",
            "days"
          ]
        }
      ]
    }
  ],
  "scales": [
    {
      "name": "ftc_x",
      "type": "utc",
      "domain": {
        "data": "ft",
        "field": "t"
      },
      "range": [
        0,
        {
          "signal": "cw - 44"
        }
      ]
    },
    {
      "name": "ftc_y",
      "type": "linear",
      "domain": {
        "signal": "[0, max(0, ftc_ymax)]"
      },
      "range": [
        {
          "signal": "ch - 22"
        },
        0
      ],
      "nice": true,
      "zero": true
    }
  ],
  "marks": [
    {
      "type": "rect",
      "encode": {
        "update": {
          "x": {
            "signal": "width - 16 - 122"
          },
          "y": {
            "value": 12
          },
          "width": {
            "value": 122
          },
          "height": {
            "value": 24
          },
          "cornerRadius": {
            "value": 12
          },
          "fill": {
            "value": "#F7F6F2"
          },
          "stroke": {
            "value": "#D6D9D2"
          }
        }
      }
    },
    {
      "type": "rect",
      "name": "seg_fgrain_0",
      "encode": {
        "update": {
          "x": {
            "signal": "width - 16 - 122 + 3"
          },
          "y": {
            "value": 14
          },
          "width": {
            "value": 55
          },
          "height": {
            "value": 20
          },
          "cornerRadius": {
            "value": 10
          },
          "fill": {
            "signal": "fgrain === 'weekly' ? '#DCE8E0' : 'transparent'"
          },
          "stroke": {
            "value": "transparent"
          },
          "cursor": {
            "value": "pointer"
          }
        }
      }
    },
    {
      "type": "text",
      "interactive": false,
      "encode": {
        "update": {
          "x": {
            "signal": "width - 16 - 122 + 3 + 27.5"
          },
          "y": {
            "value": 24
          },
          "align": {
            "value": "center"
          },
          "baseline": {
            "value": "middle"
          },
          "font": {
            "value": "Inter, 'Segoe UI', system-ui, -apple-system, sans-serif"
          },
          "fontSize": {
            "value": 11.5
          },
          "fontWeight": {
            "signal": "fgrain === 'weekly' ? 600 : 'normal'"
          },
          "fill": {
            "signal": "fgrain === 'weekly' ? '#0F4D43' : '#5F6E69'"
          },
          "text": {
            "value": "Weekly"
          }
        }
      }
    },
    {
      "type": "rect",
      "name": "seg_fgrain_1",
      "encode": {
        "update": {
          "x": {
            "signal": "width - 16 - 122 + 58"
          },
          "y": {
            "value": 14
          },
          "width": {
            "value": 61
          },
          "height": {
            "value": 20
          },
          "cornerRadius": {
            "value": 10
          },
          "fill": {
            "signal": "fgrain === 'monthly' ? '#DCE8E0' : 'transparent'"
          },
          "stroke": {
            "value": "transparent"
          },
          "cursor": {
            "value": "pointer"
          }
        }
      }
    },
    {
      "type": "text",
      "interactive": false,
      "encode": {
        "update": {
          "x": {
            "signal": "width - 16 - 122 + 58 + 30.5"
          },
          "y": {
            "value": 24
          },
          "align": {
            "value": "center"
          },
          "baseline": {
            "value": "middle"
          },
          "font": {
            "value": "Inter, 'Segoe UI', system-ui, -apple-system, sans-serif"
          },
          "fontSize": {
            "value": 11.5
          },
          "fontWeight": {
            "signal": "fgrain === 'monthly' ? 600 : 'normal'"
          },
          "fill": {
            "signal": "fgrain === 'monthly' ? '#0F4D43' : '#5F6E69'"
          },
          "text": {
            "value": "Monthly"
          }
        }
      }
    },
    {
      "type": "text",
      "name": "frame_title",
      "encode": {
        "update": {
          "x": {
            "value": 16
          },
          "y": {
            "value": 18
          },
          "baseline": {
            "value": "top"
          },
          "font": {
            "value": "'Roboto Mono', Menlo, Consolas, monospace"
          },
          "fontSize": {
            "value": 11
          },
          "fontWeight": {
            "value": 600
          },
          "fill": {
            "value": "#0F4D43"
          },
          "text": {
            "signal": "'COLLEAGUE TIME'"
          },
          "limit": {
            "signal": "width - 32"
          }
        }
      }
    },
    {
      "type": "text",
      "encode": {
        "update": {
          "x": {
            "signal": "16 + length('COLLEAGUE TIME') * 6.9 + 10"
          },
          "y": {
            "value": 17
          },
          "baseline": {
            "value": "top"
          },
          "font": {
            "value": "Inter, 'Segoe UI', system-ui, -apple-system, sans-serif"
          },
          "fontSize": {
            "value": 12
          },
          "fill": {
            "value": "#5F6E69"
          },
          "text": {
            "signal": "format((ftT.days > 0 ? (ftT.h) / (ftT.days * (wd / 365.25) * ph) : 0), '.1f') + ' FTE released · ' + format((ftT.days > 0 ? (ftT.rh) / (ftT.days * (wd / 365.25) * ph) : 0), '.1f') + ' FTE handed back by business exceptions, worth ' + (isValid((ftT.rw)) && isFinite((ftT.rw)) ? ((ftT.rw) < 0 ? '-' : '') + '£' + (abs((ftT.rw)) >= 1e6 ? format(abs((ftT.rw)) / 1e6, '.1f') + 'M' : abs((ftT.rw)) >= 1e3 ? format(abs((ftT.rw)) / 1e3, '.1f') + 'k' : format(round(abs((ftT.rw))), ',')) : '–')"
          },
          "limit": {
            "signal": "width - 42 - length('COLLEAGUE TIME') * 6.9 - 0 - headerRight"
          }
        }
      }
    },
    {
      "type": "rect",
      "encode": {
        "update": {
          "x": {
            "signal": "16"
          },
          "y": {
            "value": 36
          },
          "width": {
            "value": 11
          },
          "height": {
            "value": 11
          },
          "cornerRadius": {
            "value": 3
          },
          "fill": {
            "value": "#0B8A6B"
          }
        }
      }
    },
    {
      "type": "text",
      "encode": {
        "update": {
          "x": {
            "signal": "16 + 17"
          },
          "y": {
            "value": 41.5
          },
          "baseline": {
            "value": "middle"
          },
          "font": {
            "value": "Inter, 'Segoe UI', system-ui, -apple-system, sans-serif"
          },
          "fontSize": {
            "value": 12
          },
          "fill": {
            "value": "#5F6E69"
          },
          "text": {
            "value": "FTE released"
          }
        }
      }
    },
    {
      "type": "rect",
      "encode": {
        "update": {
          "x": {
            "signal": "121"
          },
          "y": {
            "value": 36
          },
          "width": {
            "value": 11
          },
          "height": {
            "value": 11
          },
          "cornerRadius": {
            "value": 3
          },
          "fill": {
            "value": "#B9852C"
          }
        }
      }
    },
    {
      "type": "text",
      "encode": {
        "update": {
          "x": {
            "signal": "121 + 17"
          },
          "y": {
            "value": 41.5
          },
          "baseline": {
            "value": "middle"
          },
          "font": {
            "value": "Inter, 'Segoe UI', system-ui, -apple-system, sans-serif"
          },
          "fontSize": {
            "value": 12
          },
          "fill": {
            "value": "#5F6E69"
          },
          "text": {
            "value": "FTE handed back"
          }
        }
      }
    },
    {
      "type": "group",
      "name": "ftc",
      "encode": {
        "update": {
          "x": {
            "value": 60
          },
          "y": {
            "signal": "top"
          },
          "width": {
            "signal": "cw - 44"
          },
          "height": {
            "signal": "ch - 22"
          }
        }
      },
      "axes": [
        {
          "scale": "ftc_y",
          "orient": "left",
          "grid": true,
          "tickCount": 5,
          "labelPadding": 8,
          "encode": {
            "labels": {
              "update": {
                "text": {
                  "signal": "format(datum.value, '.0f')"
                }
              }
            },
            "grid": {
              "update": {}
            },
            "ticks": {
              "update": {}
            },
            "domain": {
              "update": {}
            }
          },
          "zindex": 0
        },
        {
          "scale": "ftc_x",
          "orient": "bottom",
          "tickCount": {
            "signal": "min(10, max(2, floor((cw - 44) / 70)))"
          },
          "labelOverlap": true,
          "labelPadding": 6,
          "encode": {
            "labels": {
              "update": {
                "text": {
                  "signal": "fgrain === 'monthly' ? utcFormat((datum.value), '%b %y') : utcFormat((datum.value), '%d %b')"
                }
              }
            },
            "ticks": {
              "update": {}
            },
            "domain": {
              "update": {}
            }
          }
        }
      ],
      "marks": [
        {
          "type": "area",
          "from": {
            "data": "ft"
          },
          "encode": {
            "update": {
              "x": {
                "scale": "ftc_x",
                "field": "t"
              },
              "y": {
                "scale": "ftc_y",
                "field": "fte"
              },
              "y2": {
                "signal": "ch - 22"
              },
              "fill": {
                "value": "#0B8A6B"
              },
              "fillOpacity": {
                "value": 0.07
              },
              "interpolate": {
                "value": "linear"
              }
            }
          }
        },
        {
          "type": "area",
          "from": {
            "data": "ft"
          },
          "encode": {
            "update": {
              "x": {
                "scale": "ftc_x",
                "field": "t"
              },
              "y": {
                "scale": "ftc_y",
                "field": "fteBack"
              },
              "y2": {
                "signal": "ch - 22"
              },
              "fill": {
                "value": "#B9852C"
              },
              "fillOpacity": {
                "value": 0.07
              },
              "interpolate": {
                "value": "linear"
              }
            }
          }
        },
        {
          "type": "line",
          "from": {
            "data": "ft"
          },
          "encode": {
            "update": {
              "x": {
                "scale": "ftc_x",
                "field": "t"
              },
              "y": {
                "scale": "ftc_y",
                "field": "fte"
              },
              "stroke": {
                "value": "#0B8A6B"
              },
              "strokeWidth": {
                "value": 2
              },
              "strokeJoin": {
                "value": "round"
              },
              "interpolate": {
                "value": "linear"
              },
              "defined": {
                "signal": "isValid(datum['fte'])"
              }
            }
          }
        },
        {
          "type": "line",
          "from": {
            "data": "ft"
          },
          "encode": {
            "update": {
              "x": {
                "scale": "ftc_x",
                "field": "t"
              },
              "y": {
                "scale": "ftc_y",
                "field": "fteBack"
              },
              "stroke": {
                "value": "#B9852C"
              },
              "strokeWidth": {
                "value": 2
              },
              "strokeJoin": {
                "value": "round"
              },
              "interpolate": {
                "value": "linear"
              },
              "defined": {
                "signal": "isValid(datum['fteBack'])"
              }
            }
          }
        },
        {
          "type": "rect",
          "name": "ftc_hover",
          "from": {
            "data": "ft"
          },
          "encode": {
            "update": {
              "x": {
                "signal": "scale('ftc_x', datum.t) - max(2, (cw - 44) / max(1, length(data('ft'))) / 2)"
              },
              "width": {
                "signal": "max(4, (cw - 44) / max(1, length(data('ft'))))"
              },
              "y": {
                "value": 0
              },
              "y2": {
                "signal": "ch - 22"
              },
              "fill": {
                "value": "#0F4D43"
              },
              "fillOpacity": {
                "value": 0
              },
              "tooltip": {
                "signal": "{'Date': fgrain === 'monthly' ? utcFormat((datum.t), '%b %y') : 'w/c ' + utcFormat((datum.t), '%-d %b %Y'), 'FTE released': format(datum['fte'], '.1f') + ' FTE', 'FTE handed back': format(datum['fteBack'], '.1f') + ' FTE'}"
              }
            },
            "hover": {
              "fillOpacity": {
                "value": 0.06
              }
            }
          }
        }
      ]
    }
  ]
}
