{
  "$schema": "https://vega.github.io/schema/vega/v5.json",
  "description": "IA · Value & Finance · Value KPIs. Generated by vega/build.mjs from vega/panels/value-finance.mjs, do not edit by hand.",
  "autosize": {
    "type": "fit",
    "contains": "padding"
  },
  "padding": 0,
  "config": {
    "background": "#FFFFFF",
    "padding": 0,
    "font": "Inter, 'Segoe UI', system-ui, -apple-system, sans-serif",
    "text": {
      "font": "Inter, 'Segoe UI', system-ui, -apple-system, sans-serif",
      "fill": "#0F4D43",
      "fontSize": 12
    },
    "axis": {
      "gridColor": "#E6E8E2",
      "labelFont": "'Roboto Mono', Menlo, Consolas, monospace",
      "labelFontSize": 10,
      "labelColor": "#5F6E69",
      "titleFont": "'Roboto Mono', Menlo, Consolas, monospace",
      "titleColor": "#5F6E69",
      "titleFontSize": 10,
      "titleFontWeight": 400,
      "domain": false,
      "ticks": false,
      "gridWidth": 1,
      "labelPadding": 6
    },
    "style": {
      "guide-label": {
        "font": "'Roboto Mono', Menlo, Consolas, monospace"
      }
    },
    "view": {
      "stroke": null
    },
    "kibana": {
      "renderer": "svg",
      "hideWarnings": true
    }
  },
  "signals": [
    {
      "name": "ndays",
      "update": "length(data('win'))"
    },
    {
      "name": "lo",
      "update": "ndays ? data('win')[0].key : 0"
    },
    {
      "name": "hi",
      "update": "ndays ? data('win')[ndays - 1].key : 0"
    },
    {
      "name": "plo",
      "update": "lo - ndays * 86400000"
    },
    {
      "name": "phi",
      "update": "lo - 86400000"
    },
    {
      "name": "oneSpoke",
      "update": "length(data('scope_spokes')) === 1 ? data('scope_spokes')[0].key : ''"
    },
    {
      "name": "tgt_completionPct",
      "update": "oneSpoke && indexof(pluck(data('tg'), 'k'), 'spoke|' + oneSpoke + '|completionPct') >= 0 ? data('tg')[indexof(pluck(data('tg'), 'k'), 'spoke|' + oneSpoke + '|completionPct')].v : (indexof(pluck(data('tg'), 'k'), 'global|completionPct') >= 0 ? data('tg')[indexof(pluck(data('tg'), 'k'), 'global|completionPct')].v : 0.95)"
    },
    {
      "name": "tgt_exceptionRate",
      "update": "oneSpoke && indexof(pluck(data('tg'), 'k'), 'spoke|' + oneSpoke + '|exceptionRate') >= 0 ? data('tg')[indexof(pluck(data('tg'), 'k'), 'spoke|' + oneSpoke + '|exceptionRate')].v : (indexof(pluck(data('tg'), 'k'), 'global|exceptionRate') >= 0 ? data('tg')[indexof(pluck(data('tg'), 'k'), 'global|exceptionRate')].v : 0.06)"
    },
    {
      "name": "tgt_systemRate",
      "update": "oneSpoke && indexof(pluck(data('tg'), 'k'), 'spoke|' + oneSpoke + '|systemRate') >= 0 ? data('tg')[indexof(pluck(data('tg'), 'k'), 'spoke|' + oneSpoke + '|systemRate')].v : (indexof(pluck(data('tg'), 'k'), 'global|systemRate') >= 0 ? data('tg')[indexof(pluck(data('tg'), 'k'), 'global|systemRate')].v : 0.03)"
    },
    {
      "name": "tgt_costPerCase",
      "update": "oneSpoke && indexof(pluck(data('tg'), 'k'), 'spoke|' + oneSpoke + '|costPerCase') >= 0 ? data('tg')[indexof(pluck(data('tg'), 'k'), 'spoke|' + oneSpoke + '|costPerCase')].v : (indexof(pluck(data('tg'), 'k'), 'global|costPerCase') >= 0 ? data('tg')[indexof(pluck(data('tg'), 'k'), 'global|costPerCase')].v : 9)"
    },
    {
      "name": "tgt_utilMin",
      "update": "oneSpoke && indexof(pluck(data('tg'), 'k'), 'spoke|' + oneSpoke + '|utilMin') >= 0 ? data('tg')[indexof(pluck(data('tg'), 'k'), 'spoke|' + oneSpoke + '|utilMin')].v : (indexof(pluck(data('tg'), 'k'), 'global|utilMin') >= 0 ? data('tg')[indexof(pluck(data('tg'), 'k'), 'global|utilMin')].v : 0.15)"
    },
    {
      "name": "tgt_utilMax",
      "update": "oneSpoke && indexof(pluck(data('tg'), 'k'), 'spoke|' + oneSpoke + '|utilMax') >= 0 ? data('tg')[indexof(pluck(data('tg'), 'k'), 'spoke|' + oneSpoke + '|utilMax')].v : (indexof(pluck(data('tg'), 'k'), 'global|utilMax') >= 0 ? data('tg')[indexof(pluck(data('tg'), 'k'), 'global|utilMax')].v : 0.6)"
    },
    {
      "name": "tgt_vdiStaleDays",
      "update": "oneSpoke && indexof(pluck(data('tg'), 'k'), 'spoke|' + oneSpoke + '|vdiStaleDays') >= 0 ? data('tg')[indexof(pluck(data('tg'), 'k'), 'spoke|' + oneSpoke + '|vdiStaleDays')].v : (indexof(pluck(data('tg'), 'k'), 'global|vdiStaleDays') >= 0 ? data('tg')[indexof(pluck(data('tg'), 'k'), 'global|vdiStaleDays')].v : 14)"
    },
    {
      "name": "cfg_fyStart",
      "update": "length(data('ref_config')) ? data('ref_config')[0]._source.fiscal_year_start_month : 4"
    },
    {
      "name": "cfg_warn",
      "update": "length(data('ref_config')) ? data('ref_config')[0]._source.warn_margin : 0.1"
    },
    {
      "name": "wd",
      "update": "length(data('wdph')) ? data('wdph')[0]._source.working_days_per_year : 252"
    },
    {
      "name": "ph",
      "update": "length(data('wdph')) ? data('wdph')[0]._source.productive_hours_per_day : 7.5"
    }
  ],
  "data": [
    {
      "name": "raw",
      "url": {
        "index": "ia-workqueue-items",
        "body": {
          "size": 0,
          "query": {
            "bool": {
              "must": [
                "%dashboard_context-must_clause%",
                {
                  "range": {
                    "@timestamp": {
                      "gte": {
                        "%timefilter%": "min",
                        "shift": -732,
                        "unit": "day"
                      },
                      "lte": {
                        "%timefilter%": "max"
                      },
                      "format": "epoch_millis"
                    }
                  }
                },
                {
                  "term": {
                    "mapped": true
                  }
                }
              ],
              "filter": [
                "%dashboard_context-filter_clause%"
              ],
              "must_not": [
                "%dashboard_context-must_not_clause%"
              ]
            }
          },
          "aggs": {
            "win": {
              "filter": {
                "range": {
                  "@timestamp": {
                    "%timefilter%": true
                  }
                }
              },
              "aggs": {
                "d": {
                  "date_histogram": {
                    "field": "@timestamp",
                    "fixed_interval": "1d",
                    "min_doc_count": 0,
                    "extended_bounds": {
                      "min": {
                        "%timefilter%": "min"
                      },
                      "max": {
                        "%timefilter%": "max"
                      }
                    }
                  }
                }
              }
            },
            "days": {
              "date_histogram": {
                "field": "@timestamp",
                "fixed_interval": "1d",
                "min_doc_count": 1
              },
              "aggs": {
                "c": {
                  "sum": {
                    "field": "n.completed"
                  }
                },
                "h": {
                  "sum": {
                    "field": "value.hours_saved"
                  }
                },
                "gb": {
                  "sum": {
                    "field": "value.benefit_gbp"
                  }
                },
                "ec": {
                  "sum": {
                    "field": "cost.estate_gbp"
                  }
                }
              }
            }
          }
        }
      },
      "format": {
        "property": "aggregations"
      }
    },
    {
      "name": "win",
      "source": "raw",
      "transform": [
        {
          "type": "flatten",
          "fields": [
            "win.d.buckets"
          ],
          "as": [
            "_bk"
          ]
        },
        {
          "type": "formula",
          "as": "key",
          "expr": "datum._bk.key"
        },
        {
          "type": "formula",
          "as": "n",
          "expr": "datum._bk.doc_count"
        },
        {
          "type": "project",
          "fields": [
            "key",
            "n"
          ]
        }
      ]
    },
    {
      "name": "days",
      "source": "raw",
      "transform": [
        {
          "type": "flatten",
          "fields": [
            "days.buckets"
          ],
          "as": [
            "_bk"
          ]
        },
        {
          "type": "formula",
          "as": "key",
          "expr": "datum._bk.key"
        },
        {
          "type": "formula",
          "as": "n",
          "expr": "datum._bk.doc_count"
        },
        {
          "type": "formula",
          "as": "c",
          "expr": "datum._bk[\"c\"] ? (datum._bk[\"c\"].value || 0) : 0"
        },
        {
          "type": "formula",
          "as": "h",
          "expr": "datum._bk[\"h\"] ? (datum._bk[\"h\"].value || 0) : 0"
        },
        {
          "type": "formula",
          "as": "gb",
          "expr": "datum._bk[\"gb\"] ? (datum._bk[\"gb\"].value || 0) : 0"
        },
        {
          "type": "formula",
          "as": "ec",
          "expr": "datum._bk[\"ec\"] ? (datum._bk[\"ec\"].value || 0) : 0"
        },
        {
          "type": "project",
          "fields": [
            "key",
            "n",
            "c",
            "h",
            "gb",
            "ec"
          ]
        }
      ]
    },
    {
      "name": "series",
      "source": "win",
      "transform": [
        {
          "type": "lookup",
          "from": "days",
          "key": "key",
          "fields": [
            "key"
          ],
          "as": [
            "d"
          ]
        },
        {
          "type": "formula",
          "as": "t",
          "expr": "datum.key"
        },
        {
          "type": "formula",
          "as": "c",
          "expr": "datum.d ? datum.d.c : 0"
        },
        {
          "type": "formula",
          "as": "h",
          "expr": "datum.d ? datum.d.h : 0"
        },
        {
          "type": "formula",
          "as": "gb",
          "expr": "datum.d ? datum.d.gb : 0"
        },
        {
          "type": "formula",
          "as": "ec",
          "expr": "datum.d ? datum.d.ec : 0"
        }
      ]
    },
    {
      "name": "tot",
      "source": "days",
      "transform": [
        {
          "type": "formula",
          "as": "cur_c",
          "expr": "datum.key >= lo && datum.key <= hi ? datum.c : 0"
        },
        {
          "type": "formula",
          "as": "prev_c",
          "expr": "datum.key >= plo && datum.key <= phi ? datum.c : 0"
        },
        {
          "type": "formula",
          "as": "cur_h",
          "expr": "datum.key >= lo && datum.key <= hi ? datum.h : 0"
        },
        {
          "type": "formula",
          "as": "prev_h",
          "expr": "datum.key >= plo && datum.key <= phi ? datum.h : 0"
        },
        {
          "type": "formula",
          "as": "cur_gb",
          "expr": "datum.key >= lo && datum.key <= hi ? datum.gb : 0"
        },
        {
          "type": "formula",
          "as": "prev_gb",
          "expr": "datum.key >= plo && datum.key <= phi ? datum.gb : 0"
        },
        {
          "type": "formula",
          "as": "cur_ec",
          "expr": "datum.key >= lo && datum.key <= hi ? datum.ec : 0"
        },
        {
          "type": "formula",
          "as": "prev_ec",
          "expr": "datum.key >= plo && datum.key <= phi ? datum.ec : 0"
        },
        {
          "type": "aggregate",
          "ops": [
            "sum",
            "sum",
            "sum",
            "sum",
            "sum",
            "sum",
            "sum",
            "sum"
          ],
          "fields": [
            "cur_c",
            "prev_c",
            "cur_h",
            "prev_h",
            "cur_gb",
            "prev_gb",
            "cur_ec",
            "prev_ec"
          ],
          "as": [
            "cur_c",
            "prev_c",
            "cur_h",
            "prev_h",
            "cur_gb",
            "prev_gb",
            "cur_ec",
            "prev_ec"
          ]
        }
      ]
    },
    {
      "name": "ref_targets",
      "url": {
        "index": "ia-reference",
        "body": {
          "size": 200,
          "query": {
            "term": {
              "doc_type": "target"
            }
          }
        }
      },
      "format": {
        "property": "hits.hits"
      }
    },
    {
      "name": "tg",
      "source": "ref_targets",
      "transform": [
        {
          "type": "formula",
          "as": "k",
          "expr": "datum._source.scope === 'global' ? 'global|' + datum._source.metric : datum._source.scope + '|' + datum._source.scope_id + '|' + datum._source.metric"
        },
        {
          "type": "formula",
          "as": "v",
          "expr": "datum._source.value"
        }
      ]
    },
    {
      "name": "ref_config",
      "url": {
        "index": "ia-reference",
        "body": {
          "size": 1,
          "query": {
            "term": {
              "doc_type": "config"
            }
          }
        }
      },
      "format": {
        "property": "hits.hits"
      }
    },
    {
      "name": "scope_spokes",
      "url": {
        "%context%": true,
        "%timefield%": "@timestamp",
        "index": "ia-workqueue-items",
        "body": {
          "size": 0,
          "aggs": {
            "m": {
              "filter": {
                "term": {
                  "mapped": true
                }
              },
              "aggs": {
                "s": {
                  "terms": {
                    "field": "spoke.name",
                    "size": 2
                  }
                }
              }
            }
          }
        }
      },
      "format": {
        "property": "aggregations.m.s.buckets"
      }
    },
    {
      "name": "wdph",
      "url": {
        "index": "ia-cost-daily",
        "body": {
          "size": 1,
          "query": {
            "bool": {
              "filter": [
                {
                  "term": {
                    "pool": "HUB"
                  }
                },
                {
                  "range": {
                    "@timestamp": {
                      "lte": {
                        "%timefilter%": "max"
                      },
                      "format": "epoch_millis"
                    }
                  }
                }
              ]
            }
          },
          "sort": [
            {
              "@timestamp": {
                "order": "desc"
              }
            }
          ]
        }
      },
      "format": {
        "property": "hits.hits"
      }
    },
    {
      "name": "tiles",
      "values": [
        {
          "i": 0,
          "label": "Net benefit (window)",
          "accent": "#0F4D43",
          "deltaGood": "up"
        },
        {
          "i": 1,
          "label": "Annualised net (this window)",
          "accent": "#0B8A6B"
        },
        {
          "i": 2,
          "label": "ROI",
          "accent": "#B9852C"
        },
        {
          "i": 3,
          "label": "Colleague hours released",
          "accent": "#B6462F",
          "deltaGood": "up"
        },
        {
          "i": 4,
          "label": "FTE released",
          "accent": "#B9852C",
          "deltaGood": "up"
        },
        {
          "i": 5,
          "label": "Cost per item vs target",
          "accent": "#2A6A5F",
          "deltaGood": "down"
        }
      ],
      "transform": [
        {
          "type": "formula",
          "as": "value",
          "expr": "[(isValid((((length(data('tot')) ? data('tot')[0].cur_gb : 0) - (length(data('tot')) ? data('tot')[0].cur_ec : 0)))) && isFinite((((length(data('tot')) ? data('tot')[0].cur_gb : 0) - (length(data('tot')) ? data('tot')[0].cur_ec : 0)))) ? ((((length(data('tot')) ? data('tot')[0].cur_gb : 0) - (length(data('tot')) ? data('tot')[0].cur_ec : 0))) < 0 ? '-' : '') + '£' + (abs((((length(data('tot')) ? data('tot')[0].cur_gb : 0) - (length(data('tot')) ? data('tot')[0].cur_ec : 0)))) >= 1e6 ? format(abs((((length(data('tot')) ? data('tot')[0].cur_gb : 0) - (length(data('tot')) ? data('tot')[0].cur_ec : 0)))) / 1e6, '.2f') + 'M' : abs((((length(data('tot')) ? data('tot')[0].cur_gb : 0) - (length(data('tot')) ? data('tot')[0].cur_ec : 0)))) >= 1e3 ? format(abs((((length(data('tot')) ? data('tot')[0].cur_gb : 0) - (length(data('tot')) ? data('tot')[0].cur_ec : 0)))) / 1e3, '.1f') + 'k' : format(abs((((length(data('tot')) ? data('tot')[0].cur_gb : 0) - (length(data('tot')) ? data('tot')[0].cur_ec : 0)))), '.2f')) : '–'), (isValid(((ndays ? ((length(data('tot')) ? data('tot')[0].cur_gb : 0) - (length(data('tot')) ? data('tot')[0].cur_ec : 0)) * 365.25 / ndays : 0))) && isFinite(((ndays ? ((length(data('tot')) ? data('tot')[0].cur_gb : 0) - (length(data('tot')) ? data('tot')[0].cur_ec : 0)) * 365.25 / ndays : 0))) ? (((ndays ? ((length(data('tot')) ? data('tot')[0].cur_gb : 0) - (length(data('tot')) ? data('tot')[0].cur_ec : 0)) * 365.25 / ndays : 0)) < 0 ? '-' : '') + '£' + (abs(((ndays ? ((length(data('tot')) ? data('tot')[0].cur_gb : 0) - (length(data('tot')) ? data('tot')[0].cur_ec : 0)) * 365.25 / ndays : 0))) >= 1e6 ? format(abs(((ndays ? ((length(data('tot')) ? data('tot')[0].cur_gb : 0) - (length(data('tot')) ? data('tot')[0].cur_ec : 0)) * 365.25 / ndays : 0))) / 1e6, '.2f') + 'M' : abs(((ndays ? ((length(data('tot')) ? data('tot')[0].cur_gb : 0) - (length(data('tot')) ? data('tot')[0].cur_ec : 0)) * 365.25 / ndays : 0))) >= 1e3 ? format(abs(((ndays ? ((length(data('tot')) ? data('tot')[0].cur_gb : 0) - (length(data('tot')) ? data('tot')[0].cur_ec : 0)) * 365.25 / ndays : 0))) / 1e3, '.1f') + 'k' : format(abs(((ndays ? ((length(data('tot')) ? data('tot')[0].cur_gb : 0) - (length(data('tot')) ? data('tot')[0].cur_ec : 0)) * 365.25 / ndays : 0))), '.2f')) : '–'), (length(data('tot')) ? data('tot')[0].cur_ec : 0) ? format(((length(data('tot')) ? data('tot')[0].cur_ec : 0) ? (length(data('tot')) ? data('tot')[0].cur_gb : 0) / (length(data('tot')) ? data('tot')[0].cur_ec : 0) : 0), '.1f') + '×' : '–', (isValid(((length(data('tot')) ? data('tot')[0].cur_h : 0))) && isFinite(((length(data('tot')) ? data('tot')[0].cur_h : 0))) ? (abs(((length(data('tot')) ? data('tot')[0].cur_h : 0))) >= 1e6 ? format(((length(data('tot')) ? data('tot')[0].cur_h : 0)) / 1e6, abs(((length(data('tot')) ? data('tot')[0].cur_h : 0))) >= 1e7 ? '.0f' : '.1f') + 'M' : abs(((length(data('tot')) ? data('tot')[0].cur_h : 0))) >= 1e3 ? format(((length(data('tot')) ? data('tot')[0].cur_h : 0)) / 1e3, abs(((length(data('tot')) ? data('tot')[0].cur_h : 0))) >= 1e4 ? '.0f' : '.1f') + 'k' : format(((length(data('tot')) ? data('tot')[0].cur_h : 0)), '.0f')) : '–') + ' h', format((ndays > 0 ? ((length(data('tot')) ? data('tot')[0].cur_h : 0)) / (ndays * (wd / 365.25) * ph) : 0), '.1f'), (isValid((((length(data('tot')) ? data('tot')[0].cur_c : 0) ? (length(data('tot')) ? data('tot')[0].cur_ec : 0) / (length(data('tot')) ? data('tot')[0].cur_c : 0) : 0))) && isFinite((((length(data('tot')) ? data('tot')[0].cur_c : 0) ? (length(data('tot')) ? data('tot')[0].cur_ec : 0) / (length(data('tot')) ? data('tot')[0].cur_c : 0) : 0))) ? ((((length(data('tot')) ? data('tot')[0].cur_c : 0) ? (length(data('tot')) ? data('tot')[0].cur_ec : 0) / (length(data('tot')) ? data('tot')[0].cur_c : 0) : 0)) < 0 ? '-' : '') + '£' + format(abs((((length(data('tot')) ? data('tot')[0].cur_c : 0) ? (length(data('tot')) ? data('tot')[0].cur_ec : 0) / (length(data('tot')) ? data('tot')[0].cur_c : 0) : 0))), ',.2f') : '–')][datum.i]"
        },
        {
