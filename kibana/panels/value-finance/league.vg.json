{
  "$schema": "https://vega.github.io/schema/vega/v5.json",
  "description": "IA · Value & Finance · Process value league. Generated by vega/build.mjs from vega/panels/value-finance.mjs, do not edit by hand.",
  "autosize": {
    "type": "fit",
    "contains": "padding"
  },
  "padding": 0,
  "config": {
    "background": "#FFFFFF",
    "padding": 0,
    "font": "Inter, 'Segoe UI', system-ui, -apple-system, sans-serif",
    "text": {
      "font": "Inter, 'Segoe UI', system-ui, -apple-system, sans-serif",
      "fill": "#0F4D43",
      "fontSize": 12
    },
    "axis": {
      "gridColor": "#E6E8E2",
      "labelFont": "'Roboto Mono', Menlo, Consolas, monospace",
      "labelFontSize": 10,
      "labelColor": "#5F6E69",
      "titleFont": "'Roboto Mono', Menlo, Consolas, monospace",
      "titleColor": "#5F6E69",
      "titleFontSize": 10,
      "titleFontWeight": 400,
      "domain": false,
      "ticks": false,
      "gridWidth": 1,
      "labelPadding": 6
    },
    "style": {
      "guide-label": {
        "font": "'Roboto Mono', Menlo, Consolas, monospace"
      }
    },
    "view": {
      "stroke": null
    },
    "kibana": {
      "renderer": "svg",
      "hideWarnings": true
    }
  },
  "signals": [
    {
      "name": "headerRight",
      "value": 0
    },
    {
      "name": "top",
      "value": 42
    },
    {
      "name": "cw",
      "update": "width - 32"
    },
    {
      "name": "ch",
      "update": "height - top - 16"
    },
    {
      "name": "posTotal",
      "update": "length(data('postot')) ? data('postot')[0].total : 0"
    },
    {
      "name": "posTop",
      "update": "length(data('postot')) ? data('postot')[0].top : 1"
    },
    {
      "name": "posN",
      "update": "length(data('postot')) ? data('postot')[0].n : 0"
    },
    {
      "name": "thrK",
      "update": "length(data('thr')) ? data('thr')[0].k : 0"
    },
    {
      "name": "lgH",
      "update": "clamp((ch - 24) / max(1, posN), 20, 32)"
    },
    {
      "name": "lgLab",
      "value": 190
    },
    {
      "name": "pick",
      "on": [
        {
          "events": "@league_row:click",
          "update": "kibanaAddFilter({'match_phrase': {'process.name': datum.name}}, 'ia-workqueue-items*')"
        }
      ]
    }
  ],
  "data": [
    {
      "name": "procs_raw",
      "url": {
        "index": "ia-reference",
        "body": {
          "size": 500,
          "query": {
            "term": {
              "doc_type": "process"
            }
          }
        }
      },
      "format": {
        "property": "hits.hits"
      }
    },
    {
      "name": "procs",
      "source": "procs_raw",
      "transform": [
        {
          "type": "formula",
          "as": "name",
          "expr": "datum._source.process.name"
        },
        {
          "type": "formula",
          "as": "pid",
          "expr": "datum._source.process.id"
        },
        {
          "type": "formula",
          "as": "acronym",
          "expr": "datum._source.process.acronym"
        },
        {
          "type": "formula",
          "as": "spoke",
          "expr": "datum._source.spoke.name"
        },
        {
          "type": "formula",
          "as": "spokeColor",
          "expr": "datum._source.spoke.color"
        },
        {
          "type": "formula",
          "as": "proposition",
          "expr": "datum._source.proposition.name"
        },
        {
          "type": "formula",
          "as": "queue",
          "expr": "datum._source.primary_queue"
        },
        {
          "type": "formula",
          "as": "queues",
          "expr": "join(datum._source.queues, ' → ')"
        },
        {
          "type": "formula",
          "as": "description",
          "expr": "datum._source.process.description"
        },
        {
          "type": "formula",
          "as": "tags",
          "expr": "datum._source.process.tags"
        },
        {
          "type": "formula",
          "as": "smv",
          "expr": "datum._source.process.smv_minutes"
        },
        {
          "type": "formula",
          "as": "grade",
          "expr": "datum._source.process.grade"
        },
        {
          "type": "formula",
          "as": "gradeName",
          "expr": "datum._source.process.grade_name"
        },
        {
          "type": "formula",
          "as": "rate",
          "expr": "datum._source.process.current_rate_gbp"
        },
        {
          "type": "formula",
          "as": "slaHours",
          "expr": "datum._source.process.sla_hours"
        }
      ]
    },
    {
      "name": "bp_raw",
      "url": {
        "%context%": true,
        "%timefield%": "@timestamp",
        "index": "ia-workqueue-items",
        "body": {
          "size": 0,
          "aggs": {
            "m": {
              "filter": {
                "term": {
                  "mapped": true
                }
              },
              "aggs": {
                "p": {
                  "terms": {
                    "field": "process.name",
                    "size": 100
                  },
                  "aggs": {
                    "gb": {
                      "sum": {
                        "field": "value.benefit_gbp"
                      }
                    },
                    "ec": {
                      "sum": {
                        "field": "cost.estate_gbp"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      },
      "format": {
        "property": "aggregations.m.p.buckets"
      }
    },
    {
      "name": "bp",
      "source": "bp_raw",
      "transform": [
        {
          "type": "formula",
          "as": "name",
          "expr": "datum.key"
        },
        {
          "type": "formula",
          "as": "gb",
          "expr": "datum['gb'].value"
        },
        {
          "type": "formula",
          "as": "ec",
          "expr": "datum['ec'].value"
        },
        {
          "type": "lookup",
          "from": "procs",
          "key": "name",
          "fields": [
            "name"
          ],
          "as": [
            "ref"
          ]
        },
        {
          "type": "formula",
          "as": "spoke",
          "expr": "datum.ref ? datum.ref.spoke : ''"
        },
        {
          "type": "formula",
          "as": "spokeColor",
          "expr": "datum.ref ? datum.ref.spokeColor : '#5F6E69'"
        },
        {
          "type": "formula",
          "as": "queue",
          "expr": "datum.ref ? datum.ref.queue : ''"
        },
        {
          "type": "formula",
          "as": "proposition",
          "expr": "datum.ref ? datum.ref.proposition : ''"
        },
        {
          "type": "formula",
          "as": "slaHours",
          "expr": "datum.ref ? datum.ref.slaHours : null"
        }
      ]
    },
    {
      "name": "pos",
      "source": "bp",
      "transform": [
        {
          "type": "formula",
          "as": "net",
          "expr": "datum.gb - datum.ec"
        },
        {
          "type": "filter",
          "expr": "datum.net > 0"
        },
        {
          "type": "collect",
          "sort": {
            "field": "net",
            "order": "descending"
          }
        },
        {
          "type": "window",
          "ops": [
            "row_number",
            "sum"
          ],
          "fields": [
            null,
            "net"
          ],
          "as": [
            "r",
            "cum"
          ]
        }
      ]
    },
    {
      "name": "postot",
      "source": "pos",
      "transform": [
        {
          "type": "aggregate",
          "ops": [
            "sum",
            "count",
            "max"
          ],
          "fields": [
            "net",
            "net",
            "net"
          ],
          "as": [
            "total",
            "n",
            "top"
          ]
        }
      ]
    },
    {
      "name": "thr",
      "source": "pos",
      "transform": [
        {
          "type": "filter",
          "expr": "datum.cum - datum.net < 0.8 * posTotal"
        },
        {
          "type": "aggregate",
          "ops": [
            "count"
          ],
          "as": [
            "k"
          ]
        }
      ]
    },
    {
      "name": "shown",
      "source": "pos",
      "transform": [
        {
          "type": "filter",
          "expr": "datum.r * lgH <= ch - 24"
        },
        {
          "type": "formula",
          "as": "core",
          "expr": "datum.r <= thrK"
        }
      ]
    }
  ],
  "marks": [
    {
      "type": "text",
      "name": "frame_title",
      "encode": {
        "update": {
          "x": {
            "value": 16
          },
          "y": {
            "value": 18
          },
          "baseline": {
            "value": "top"
          },
          "font": {
            "value": "'Roboto Mono', Menlo, Consolas, monospace"
          },
          "fontSize": {
            "value": 11
          },
          "fontWeight": {
            "value": 600
          },
          "fill": {
            "value": "#0F4D43"
          },
          "text": {
            "signal": "'PROCESS VALUE LEAGUE'"
          },
          "limit": {
            "signal": "width - 32"
          }
        }
      }
    },
    {
      "type": "text",
      "encode": {
        "update": {
          "x": {
            "signal": "16 + length('PROCESS VALUE LEAGUE') * 6.9 + 10"
          },
          "y": {
            "value": 17
          },
          "baseline": {
            "value": "top"
          },
          "font": {
            "value": "Inter, 'Segoe UI', system-ui, -apple-system, sans-serif"
          },
          "fontSize": {
            "value": 12
          },
          "fill": {
            "value": "#5F6E69"
          },
          "text": {
            "value": "By net benefit; darker bars, above the dashed line, deliver 80% of it · right column is the running share"
          },
          "limit": {
            "signal": "width - 42 - length('PROCESS VALUE LEAGUE') * 6.9 - 0 - headerRight"
          }
        }
      }
    },
    {
      "type": "text",
      "encode": {
        "update": {
          "x": {
            "value": 16
          },
          "y": {
            "signal": "top"
          },
          "baseline": {
            "value": "top"
          },
          "font": {
            "value": "Inter, 'Segoe UI', system-ui, -apple-system, sans-serif"
          },
          "fontSize": {
            "value": 12
          },
          "fill": {
            "value": "#5F6E69"
          },
          "text": {
            "signal": "posN ? '80% of positive net comes from ' + thrK + ' of ' + posN + ' processes.' : 'No process delivers positive net benefit for these filters.'"
          }
        }
      }
    },
    {
      "type": "group",
      "name": "league_row",
      "from": {
        "data": "shown"
      },
      "encode": {
        "update": {
          "x": {
            "value": 16
          },
          "y": {
            "signal": "top + 24 + (datum.r - 1) * lgH"
          },
          "width": {
            "signal": "cw"
          },
          "height": {
            "signal": "lgH"
          },
          "fill": {
            "value": "transparent"
          },
          "cursor": {
            "value": "pointer"
          },
          "tooltip": {
            "signal": "{'Process': datum.name, 'Net': (isValid((datum.net)) && isFinite((datum.net)) ? ((datum.net) < 0 ? '-' : '') + '£' + format(round(abs((datum.net))), ',') : '–'), 'Cumulative share': (isValid((datum.cum / posTotal)) && isFinite((datum.cum / posTotal)) ? format((datum.cum / posTotal) * 100, '.1f') + '%' : '–')}"
          }
        },
        "hover": {
          "fill": {
            "value": "#F7F6F2"
          }
        }
      },
      "marks": [
        {
          "type": "text",
          "encode": {
            "update": {
              "x": {
                "value": 0
              },
              "y": {
                "signal": "lgH / 2"
              },
              "baseline": {
                "value": "middle"
              },
              "font": {
                "value": "Inter, 'Segoe UI', system-ui, -apple-system, sans-serif"
              },
              "fontSize": {
                "value": 12
              },
              "fill": {
                "value": "#0F4D43"
              },
              "text": {
                "field": {
                  "parent": "name"
                }
              },
              "limit": {
                "signal": "lgLab - 10"
              }
            }
          }
        },
        {
          "type": "rect",
          "encode": {
            "update": {
              "x": {
                "signal": "lgLab"
              },
              "y": {
                "signal": "lgH / 2 - 5"
              },
              "width": {
                "signal": "max(2, (cw - lgLab - 140) * parent.net / posTop)"
              },
              "height": {
                "value": 10
              },
              "cornerRadius": {
                "value": 5
              },
              "fill": {
                "signal": "parent.core ? '#2A6A5F' : '#DCE8E0'"
              }
            }
          }
        },
        {
          "type": "text",
          "encode": {
            "update": {
              "x": {
                "signal": "cw - 64"
              },
              "y": {
                "signal": "lgH / 2"
              },
              "align": {
                "value": "right"
              },
              "baseline": {
                "value": "middle"
              },
              "font": {
                "value": "'Roboto Mono', Menlo, Consolas, monospace"
              },
              "fontSize": {
                "value": 11
              },
              "fontWeight": {
                "value": 600
              },
              "fill": {
                "value": "#0F4D43"
              },
              "text": {
                "signal": "(isValid((parent.net)) && isFinite((parent.net)) ? ((parent.net) < 0 ? '-' : '') + '£' + (abs((parent.net)) >= 1e6 ? format(abs((parent.net)) / 1e6, '.2f') + 'M' : abs((parent.net)) >= 1e3 ? format(abs((parent.net)) / 1e3, '.1f') + 'k' : format(abs((parent.net)), '.2f')) : '–')"
              }
            }
          }
        },
        {
          "type": "text",
          "encode": {
            "update": {
              "x": {
                "signal": "cw"
              },
              "y": {
                "signal": "lgH / 2"
              },
              "align": {
                "value": "right"
              },
              "baseline": {
                "value": "middle"
              },
              "font": {
                "value": "'Roboto Mono', Menlo, Consolas, monospace"
              },
              "fontSize": {
                "value": 10.5
              },
              "fill": {
                "value": "#5F6E69"
              },
              "text": {
                "signal": "(isValid((parent.cum / posTotal)) && isFinite((parent.cum / posTotal)) ? format((parent.cum / posTotal) * 100, '.0f') + '%' : '–')"
              }
            }
          }
        }
      ]
    },
    {
      "type": "rule",
      "encode": {
        "update": {
          "x": {
            "value": 16
          },
          "x2": {
            "signal": "width - 16"
          },
          "y": {
            "signal": "top + 24 + thrK * lgH"
          },
          "stroke": {
            "value": "#B6462F"
          },
          "strokeDash": {
            "value": [
              4,
              3
            ]
          },
          "opacity": {
            "signal": "thrK > 0 && thrK < posN ? 1 : 0"
          }
        }
      }
    }
  ]
}
