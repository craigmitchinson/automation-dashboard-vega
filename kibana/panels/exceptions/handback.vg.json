{
  "$schema": "https://vega.github.io/schema/vega/v5.json",
  "description": "IA · Exceptions · Work handed back. Generated by vega/build.mjs from vega/panels/exceptions.mjs, do not edit by hand.",
  "autosize": {
    "type": "fit",
    "contains": "padding"
  },
  "padding": 0,
  "config": {
    "background": "#FFFFFF",
    "padding": 0,
    "font": "Inter, 'Segoe UI', system-ui, -apple-system, sans-serif",
    "text": {
      "font": "Inter, 'Segoe UI', system-ui, -apple-system, sans-serif",
      "fill": "#0F4D43",
      "fontSize": 12
    },
    "axis": {
      "gridColor": "#E6E8E2",
      "labelFont": "'Roboto Mono', Menlo, Consolas, monospace",
      "labelFontSize": 10,
      "labelColor": "#5F6E69",
      "titleFont": "'Roboto Mono', Menlo, Consolas, monospace",
      "titleColor": "#5F6E69",
      "titleFontSize": 10,
      "titleFontWeight": 400,
      "domain": false,
      "ticks": false,
      "gridWidth": 1,
      "labelPadding": 6
    },
    "style": {
      "guide-label": {
        "font": "'Roboto Mono', Menlo, Consolas, monospace"
      }
    },
    "view": {
      "stroke": null
    },
    "kibana": {
      "renderer": "svg",
      "hideWarnings": true
    }
  },
  "signals": [
    {
      "name": "ndays",
      "update": "length(data('win'))"
    },
    {
      "name": "lo",
      "update": "ndays ? data('win')[0].key : 0"
    },
    {
      "name": "hi",
      "update": "ndays ? data('win')[ndays - 1].key : 0"
    },
    {
      "name": "plo",
      "update": "lo - ndays * 86400000"
    },
    {
      "name": "phi",
      "update": "lo - 86400000"
    },
    {
      "name": "headerRight",
      "value": 0
    },
    {
      "name": "top",
      "value": 42
    },
    {
      "name": "cw",
      "update": "width - 32"
    },
    {
      "name": "ch",
      "update": "height - top - 16"
    },
    {
      "name": "hb_fit",
      "update": "max(1, floor((ch) / 34))"
    }
  ],
  "data": [
    {
      "name": "raw",
      "url": {
        "index": "ia-workqueue-items",
        "body": {
          "size": 0,
          "query": {
            "bool": {
              "must": [
                "%dashboard_context-must_clause%",
                {
                  "range": {
                    "@timestamp": {
                      "gte": {
                        "%timefilter%": "min",
                        "shift": -732,
                        "unit": "day"
                      },
                      "lte": {
                        "%timefilter%": "max"
                      },
                      "format": "epoch_millis"
                    }
                  }
                },
                {
                  "term": {
                    "mapped": true
                  }
                }
              ],
              "filter": [
                "%dashboard_context-filter_clause%"
              ],
              "must_not": [
                "%dashboard_context-must_not_clause%"
              ]
            }
          },
          "aggs": {
            "win": {
              "filter": {
                "range": {
                  "@timestamp": {
                    "gte": {
                      "%timefilter%": "min",
                      "shift": 1,
                      "unit": "hour"
                    },
                    "lte": {
                      "%timefilter%": "max"
                    },
                    "format": "epoch_millis"
                  }
                }
              },
              "aggs": {
                "d": {
                  "date_histogram": {
                    "field": "@timestamp",
                    "fixed_interval": "1d",
                    "min_doc_count": 0,
                    "extended_bounds": {
                      "min": {
                        "%timefilter%": "min",
                        "shift": 1,
                        "unit": "hour"
                      },
                      "max": {
                        "%timefilter%": "max"
                      }
                    }
                  }
                }
              }
            },
            "days": {
              "date_histogram": {
                "field": "@timestamp",
                "fixed_interval": "1d",
                "min_doc_count": 1
              },
              "aggs": {
                "b": {
                  "sum": {
                    "field": "n.business"
                  }
                }
              }
            }
          }
        }
      },
      "format": {
        "property": "aggregations"
      }
    },
    {
      "name": "win",
      "source": "raw",
      "transform": [
        {
          "type": "flatten",
          "fields": [
            "win.d.buckets"
          ],
          "as": [
            "_bk"
          ]
        },
        {
          "type": "formula",
          "as": "key",
          "expr": "datum._bk.key"
        },
        {
          "type": "formula",
          "as": "n",
          "expr": "datum._bk.doc_count"
        },
        {
          "type": "project",
          "fields": [
            "key",
            "n"
          ]
        }
      ]
    },
    {
      "name": "days",
      "source": "raw",
      "transform": [
        {
          "type": "flatten",
          "fields": [
            "days.buckets"
          ],
          "as": [
            "_bk"
          ]
        },
        {
          "type": "formula",
          "as": "key",
          "expr": "datum._bk.key"
        },
        {
          "type": "formula",
          "as": "n",
          "expr": "datum._bk.doc_count"
        },
        {
          "type": "formula",
          "as": "b",
          "expr": "datum._bk[\"b\"] ? (datum._bk[\"b\"].value || 0) : 0"
        },
        {
          "type": "project",
          "fields": [
            "key",
            "n",
            "b"
          ]
        }
      ]
    },
    {
      "name": "series",
      "source": "win",
      "transform": [
        {
          "type": "lookup",
          "from": "days",
          "key": "key",
          "fields": [
            "key"
          ],
          "as": [
            "d"
          ]
        },
        {
          "type": "formula",
          "as": "t",
          "expr": "datum.key"
        },
        {
          "type": "formula",
          "as": "b",
          "expr": "datum.d ? datum.d.b : 0"
        }
      ]
    },
    {
      "name": "tot",
      "source": "days",
      "transform": [
        {
          "type": "formula",
          "as": "cur_b",
          "expr": "datum.key >= lo && datum.key <= hi ? datum.b : 0"
        },
        {
          "type": "formula",
          "as": "prev_b",
          "expr": "datum.key >= plo && datum.key <= phi ? datum.b : 0"
        },
        {
          "type": "aggregate",
          "ops": [
            "sum",
            "sum"
          ],
          "fields": [
            "cur_b",
            "prev_b"
          ],
          "as": [
            "cur_b",
            "prev_b"
          ]
        }
      ]
    },
    {
      "name": "hb_raw",
      "url": {
        "index": "ia-workqueue-items",
        "body": {
          "size": 0,
          "query": {
            "bool": {
              "must": [
                "%dashboard_context-must_clause%",
                {
                  "range": {
                    "outcome_date": {
                      "gt": {
                        "%timefilter%": "min",
                        "shift": -23,
                        "unit": "hour"
                      },
                      "format": "epoch_millis"
                    }
                  }
                },
                {
                  "range": {
                    "@timestamp": {
                      "lte": {
                        "%timefilter%": "max"
                      },
                      "format": "epoch_millis"
                    }
                  }
                }
              ],
              "filter": [
                "%dashboard_context-filter_clause%"
              ],
              "must_not": [
                "%dashboard_context-must_not_clause%"
              ]
            }
          },
          "aggs": {
            "m": {
              "filter": {
                "bool": {
                  "filter": [
                    {
                      "term": {
                        "mapped": true
                      }
                    },
                    {
                      "term": {
                        "exception.type": "Business"
                      }
                    }
                  ]
                }
              },
              "aggs": {
                "p": {
                  "terms": {
                    "field": "proposition.name",
                    "size": 50
                  },
                  "aggs": {
                    "rh": {
                      "sum": {
                        "field": "value.rework_hours"
                      }
                    },
                    "sp": {
                      "terms": {
                        "field": "spoke.name",
                        "size": 1
                      }
                    }
                  }
                }
              }
            }
          }
        }
      },
      "format": {
        "property": "aggregations.m.p.buckets"
      }
    },
    {
      "name": "hbk",
      "source": "hb_raw",
      "transform": [
        {
          "type": "formula",
          "as": "label",
          "expr": "datum.key"
        },
        {
          "type": "formula",
          "as": "value",
          "expr": "datum.rh.value / max(1, ndays)"
        },
        {
          "type": "formula",
          "as": "display",
          "expr": "format(datum.value, ',.1f') + ' h'"
        },
        {
          "type": "formula",
          "as": "sub",
          "expr": "format(datum.doc_count / max(1, ndays), ',.0f') + ' exceptions a day · ' + (length(datum.sp.buckets) ? datum.sp.buckets[0].key : '')"
        },
        {
          "type": "formula",
          "as": "color",
          "expr": "'#B9852C'"
        },
        {
          "type": "collect",
          "sort": {
            "field": "value",
            "order": "descending"
          }
        }
      ]
    },
    {
      "name": "hb_rows",
      "source": "hbk",
      "transform": [
        {
          "type": "window",
          "ops": [
            "row_number"
          ],
          "as": [
            "rank"
          ]
        },
        {
          "type": "filter",
          "expr": "datum.rank <= hb_fit"
        }
      ]
    }
  ],
  "scales": [
    {
      "name": "hb_x",
      "type": "linear",
      "domain": {
        "signal": "length(data('hbk')) ? extent(pluck(data('hbk'), 'value')) : [0, 1]"
      },
      "range": [
        0,
        {
          "signal": "cw - 250"
        }
      ],
      "zero": true,
      "nice": false
    }
  ],
  "marks": [
    {
      "type": "text",
      "name": "frame_title",
      "encode": {
        "update": {
          "x": {
            "value": 16
          },
          "y": {
            "value": 18
          },
          "baseline": {
            "value": "top"
          },
          "font": {
            "value": "'Roboto Mono', Menlo, Consolas, monospace"
          },
          "fontSize": {
            "value": 11
          },
          "fontWeight": {
            "value": 600
          },
          "fill": {
            "value": "#0F4D43"
          },
          "text": {
            "signal": "'WORK HANDED BACK'"
          },
          "limit": {
            "signal": "width - 32"
          }
        }
      }
    },
    {
      "type": "text",
      "encode": {
        "update": {
          "x": {
            "signal": "16 + length('WORK HANDED BACK') * 6.9 + 10"
          },
          "y": {
            "value": 17
          },
          "baseline": {
            "value": "top"
          },
          "font": {
            "value": "Inter, 'Segoe UI', system-ui, -apple-system, sans-serif"
          },
          "fontSize": {
            "value": 12
          },
          "fill": {
            "value": "#5F6E69"
          },
          "text": {
            "value": "Colleague hours a day spent on business exceptions, by proposition"
          },
          "limit": {
            "signal": "width - 42 - length('WORK HANDED BACK') * 6.9 - 0 - headerRight"
          }
        }
      }
    },
    {
      "type": "group",
      "name": "hb_row",
      "from": {
        "data": "hb_rows"
      },
      "encode": {
        "update": {
          "x": {
            "value": 16
          },
          "y": {
            "signal": "top + (datum.rank - 1) * 34"
          },
          "width": {
            "signal": "cw"
          },
          "height": {
            "value": 34
          },
          "fill": {
            "value": "transparent"
          },
          "opacity": {
            "value": 1
          }
        }
      },
      "marks": [
        {
          "type": "text",
          "encode": {
            "update": {
              "x": {
                "value": 0
              },
              "y": {
                "value": 17
              },
              "baseline": {
                "value": "middle"
              },
              "font": {
                "value": "Inter, 'Segoe UI', system-ui, -apple-system, sans-serif"
              },
              "fontSize": {
                "value": 12.5
              },
              "fill": {
                "value": "#0F4D43"
              },
              "text": {
                "field": {
                  "parent": "label"
                }
              },
              "limit": {
                "value": 160
              }
            }
          }
        },
        {
          "type": "rect",
          "encode": {
            "update": {
              "x": {
                "value": 170
              },
              "y": {
                "value": 12
              },
              "width": {
                "signal": "cw - 250"
              },
              "height": {
                "value": 10
              },
              "fill": {
                "value": "#E6E8E2"
              },
              "cornerRadius": {
                "value": 5
              }
            }
          }
        },
        {
          "type": "rect",
          "encode": {
            "update": {
              "x": {
                "value": 170
              },
              "y": {
                "value": 12
              },
              "width": {
                "signal": "parent.value > 0 ? max(2, scale('hb_x', parent.value)) : 0"
              },
              "height": {
                "value": 10
              },
              "fill": {
                "field": {
                  "parent": "color"
                }
              },
              "cornerRadius": {
                "value": 5
              },
              "tooltip": {
                "signal": "parent.sub ? {'': parent.label, 'Value': parent.display, 'Detail': parent.sub} : {'': parent.label, 'Value': parent.display}"
              }
            }
          }
        },
        {
          "type": "text",
          "encode": {
            "update": {
              "x": {
                "signal": "cw"
              },
              "y": {
                "value": 17
              },
              "align": {
                "value": "right"
              },
              "baseline": {
                "value": "middle"
              },
              "font": {
                "value": "'Roboto Mono', Menlo, Consolas, monospace"
              },
              "fontSize": {
                "value": 12
              },
              "fontWeight": {
                "value": 600
              },
              "fill": {
                "value": "#0F4D43"
              },
              "text": {
                "field": {
                  "parent": "display"
                }
              }
            }
          }
        }
      ]
    },
    {
      "type": "text",
      "encode": {
        "update": {
          "x": {
            "signal": "width - 16"
          },
          "y": {
            "signal": "top + ch - 4"
          },
          "align": {
            "value": "right"
          },
          "font": {
            "value": "'Roboto Mono', Menlo, Consolas, monospace"
          },
          "fontSize": {
            "value": 10
          },
          "fill": {
            "value": "#5F6E69"
          },
          "text": {
            "signal": "length(data('hbk')) > hb_fit ? '+' + (length(data('hbk')) - hb_fit) + ' more' : ''"
          }
        }
      }
    }
  ]
}
