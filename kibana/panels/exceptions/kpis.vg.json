              "text": {
                "signal": "(isValid(parent.target) && parent.target !== '' ? (parent.met ? 'ON ' : 'OFF ') + parent.target : '')"
              },
              "limit": {
                "signal": "item.mark.group.width - 60"
              }
            }
          }
        },
        {
          "type": "text",
          "interactive": false,
          "encode": {
            "update": {
              "x": {
                "value": 16
              },
              "y": {
                "signal": "((isValid(parent.delta) ? (isValid((parent.delta)) && isFinite((parent.delta)) ? ((parent.delta) >= 0 ? '▲ ' : '▼ ') + format(abs((parent.delta)) * 100, '.1f') + '%' : '–') : '') || (isValid(parent.target) && parent.target !== '' ? (parent.met ? 'ON ' : 'OFF ') + parent.target : '')) ? 100 : 76"
              },
              "baseline": {
                "value": "top"
              },
              "font": {
                "value": "Inter, 'Segoe UI', system-ui, -apple-system, sans-serif"
              },
              "fontSize": {
                "value": 11.5
              },
              "fill": {
                "value": "#5F6E69"
              },
              "text": {
                "field": {
                  "parent": "sub"
                }
              },
              "limit": {
                "signal": "item.mark.group.width - 28"
              }
            }
          }
        }
      ]
    }
  ]
}
