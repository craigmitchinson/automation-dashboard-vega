          "type": "rect",
          "encode": {
            "update": {
              "x": {
                "signal": "0 + 10"
              },
              "y": {
                "signal": "tb_rh / 2 - 5"
              },
              "width": {
                "value": 10
              },
              "height": {
                "value": 10
              },
              "cornerRadius": {
                "value": 3
              },
              "fill": {
                "signal": "parent.type === 'System' ? '#B6462F' : '#B9852C'"
              }
            }
          }
        },
        {
