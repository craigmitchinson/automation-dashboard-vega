              },
              "text": {
                "signal": "utcFormat((parent.lastSeen), '%d %b')"
              },
              "limit": {
                "signal": "130 - 16"
              }
            }
          }
        }
      ]
    },
    {
      "type": "text",
      "encode": {
        "update": {
          "x": {
            "signal": "16 + cw"
          },
          "y": {
            "signal": "top + ch - 2"
          },
          "align": {
            "value": "right"
          },
          "baseline": {
            "value": "bottom"
          },
          "font": {
            "value": "'Roboto Mono', Menlo, Consolas, monospace"
          },
          "fontSize": {
            "value": 10
          },
          "fill": {
            "value": "#5F6E69"
          },
          "text": {
            "signal": "length(data('exv')) > tb_fit ? '+' + (length(data('exv')) - tb_fit) + ' more rows: widen the panel or filter' : ''"
          }
        }
      }
    }
  ]
}
