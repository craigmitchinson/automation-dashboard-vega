              },
              "fill": {
                "value": "#0F4D43"
              },
              "text": {
                "signal": "parent.name"
              },
              "limit": {
                "signal": "((cw - 510) / 1) - 32"
              },
              "tooltip": {
                "signal": "parent.type + ' exception'"
              }
            }
          }
        },
        {
          "type": "text",
          "encode": {
            "update": {
              "x": {
                "signal": "0 + ((cw - 510) / 1) + 110 - 10"
