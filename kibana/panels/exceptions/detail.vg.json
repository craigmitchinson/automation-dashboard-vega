              },
              "align": {
                "value": "right"
              },
              "baseline": {
                "value": "middle"
              },
              "font": {
                "value": "Inter, 'Segoe UI', system-ui, -apple-system, sans-serif"
              },
              "fontSize": {
                "value": 12
              },
              "fontWeight": {
                "value": "normal"
              },
              "fill": {
                "value": "#0F4D43"
              },
              "text": {
                "signal": "(isValid((parent.volume)) && isFinite((parent.volume)) ? format((parent.volume), ',.0f') : '–')"
              },
              "limit": {
                "signal": "110 - 16"
              }
            }
          }
        },
        {
          "type": "text",
          "encode": {
            "update": {
              "x": {
                "signal": "0 + ((cw - 510) / 1) + 110 + 120 - 10"
              },
              "y": {
                "signal": "tb_rh / 2"
              },
              "align": {
                "value": "right"
              },
              "baseline": {
                "value": "middle"
              },
              "font": {
                "value": "Inter, 'Segoe UI', system-ui, -apple-system, sans-serif"
              },
              "fontSize": {
                "value": 12
              },
              "fontWeight": {
                "value": "normal"
              },
              "fill": {
                "value": "#0F4D43"
              },
              "text": {
                "signal": "(isValid((parent.pct)) && isFinite((parent.pct)) ? format((parent.pct) * 100, '.1f') + '%' : '–')"
              },
              "limit": {
                "signal": "120 - 16"
              }
            }
          }
        },
        {
          "type": "text",
          "encode": {
            "update": {
              "x": {
                "signal": "0 + ((cw - 510) / 1) + 110 + 120 + 150 - 10"
              },
              "y": {
                "signal": "tb_rh / 2"
              },
              "align": {
                "value": "right"
              },
              "baseline": {
                "value": "middle"
              },
              "font": {
                "value": "Inter, 'Segoe UI', system-ui, -apple-system, sans-serif"
              },
              "fontSize": {
                "value": 12
              },
              "fontWeight": {
                "value": "normal"
              },
              "fill": {
                "value": "#0F4D43"
              },
              "text": {
                "signal": "(isValid((parent.cost)) && isFinite((parent.cost)) ? ((parent.cost) < 0 ? '-' : '') + '£' + format(round(abs((parent.cost))), ',') : '–')"
              },
              "limit": {
                "signal": "150 - 16"
              }
            }
          }
        },
        {
          "type": "text",
          "encode": {
            "update": {
              "x": {
                "signal": "0 + ((cw - 510) / 1) + 110 + 120 + 150 + 130 - 10"
              },
              "y": {
                "signal": "tb_rh / 2"
              },
              "align": {
                "value": "right"
              },
              "baseline": {
                "value": "middle"
              },
              "font": {
