{
  "$schema": "https://vega.github.io/schema/vega/v5.json",
  "description": "IA · Exceptions · Exception detail. Generated by vega/build.mjs from vega/panels/exceptions.mjs, do not edit by hand.",
  "autosize": {
    "type": "fit",
    "contains": "padding"
  },
  "padding": 0,
  "config": {
    "background": "#FFFFFF",
    "padding": 0,
    "font": "Inter, 'Segoe UI', system-ui, -apple-system, sans-serif",
    "text": {
      "font": "Inter, 'Segoe UI', system-ui, -apple-system, sans-serif",
      "fill": "#0F4D43",
      "fontSize": 12
    },
    "axis": {
      "gridColor": "#E6E8E2",
      "labelFont": "'Roboto Mono', Menlo, Consolas, monospace",
      "labelFontSize": 10,
      "labelColor": "#5F6E69",
      "titleFont": "'Roboto Mono', Menlo, Consolas, monospace",
      "titleColor": "#5F6E69",
      "titleFontSize": 10,
      "titleFontWeight": 400,
      "domain": false,
      "ticks": false,
      "gridWidth": 1,
      "labelPadding": 6
    },
    "style": {
      "guide-label": {
        "font": "'Roboto Mono', Menlo, Consolas, monospace"
      }
    },
    "view": {
      "stroke": null
    },
    "kibana": {
      "renderer": "svg",
      "hideWarnings": true
    }
  },
  "signals": [
    {
      "name": "headerRight",
      "value": 0
    },
    {
      "name": "top",
      "value": 58
    },
    {
      "name": "cw",
      "update": "width - 32"
    },
    {
      "name": "ch",
      "update": "height - top - 16"
    },
    {
      "name": "cat",
      "value": "all",
      "on": [
        {
          "events": "@seg_cat_0:click",
          "update": "'all'"
        },
        {
          "events": "@seg_cat_1:click",
          "update": "'System'"
        },
        {
          "events": "@seg_cat_2:click",
          "update": "'Business'"
        }
      ]
    },
    {
      "name": "q",
      "value": "",
      "bind": {
        "input": "text",
        "placeholder": "Search exception…",
        "name": "Search "
      }
    },
    {
      "name": "totalExc",
      "update": "length(data('exsum')) ? max(1, data('exsum')[0].volume) : 1"
    },
    {
      "name": "pickRow",
      "on": [
        {
          "events": "@tb_row:click",
          "update": "kibanaAddFilter({'match_phrase': {'exception.reason_display': datum.name}}, 'ia-workqueue-items*')"
        }
      ]
    },
    {
      "name": "tb_fit",
      "update": "max(0, floor((ch - 26 - 0 - 14) / 29))"
    },
    {
      "name": "tb_rh",
      "update": "clamp((ch - 26 - 0 - 14) / max(1, length(data('exv'))), 29, 46)"
    },
    {
      "name": "tb_sortKey",
      "value": "volume",
      "on": [
        {
          "events": {
            "signal": "tb_sortClick"
          },
          "update": "tb_sortClick"
        }
      ]
    },
    {
      "name": "tb_sortDir",
      "value": "descending",
      "on": [
        {
          "events": {
            "signal": "tb_sortClick"
          },
          "update": "tb_sortClick === tb_sortKey ? (tb_sortDir === 'descending' ? 'ascending' : 'descending') : 'descending'"
        }
      ]
    },
    {
      "name": "tb_sortClick",
      "on": [
        {
          "events": "@tb_head0:click, @tb_head1:click, @tb_head2:click, @tb_head3:click, @tb_head4:click",
          "update": "datum.sortKey"
        }
      ]
    }
  ],
  "data": [
    {
      "name": "ex_raw",
      "url": {
        "%context%": true,
        "%timefield%": "@timestamp",
        "index": "ia-workqueue-items",
        "body": {
          "size": 0,
          "aggs": {
            "m": {
              "filter": {
                "bool": {
                  "filter": [
                    {
                      "term": {
                        "mapped": true
                      }
                    },
                    {
                      "term": {
                        "outcome": "Exception"
                      }
                    }
                  ]
                }
              },
              "aggs": {
                "r": {
                  "terms": {
                    "field": "exception.reason_display",
                    "size": 200
                  },
                  "aggs": {
                    "t": {
                      "terms": {
                        "field": "exception.type",
                        "size": 1
                      }
                    },
                    "rw": {
                      "sum": {
                        "field": "value.rework_gbp"
                      }
                    },
                    "last": {
                      "max": {
                        "field": "@timestamp"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      },
      "format": {
        "property": "aggregations.m.r.buckets"
      }
    },
    {
      "name": "ex",
      "source": "ex_raw",
      "transform": [
        {
          "type": "formula",
          "as": "name",
          "expr": "datum.key"
        },
        {
          "type": "formula",
          "as": "type",
          "expr": "datum.t.buckets[0].key"
        },
        {
          "type": "formula",
          "as": "volume",
          "expr": "datum.doc_count"
        },
        {
          "type": "formula",
          "as": "cost",
          "expr": "datum.rw.value"
        },
        {
          "type": "formula",
          "as": "lastSeen",
          "expr": "datum.last.value"
        }
      ]
    },
    {
      "name": "exsum",
      "source": "ex",
      "transform": [
        {
          "type": "aggregate",
          "ops": [
            "sum"
          ],
          "fields": [
            "volume"
          ],
          "as": [
            "volume"
          ]
        }
      ]
    },
    {
      "name": "exv",
      "source": "ex",
      "transform": [
        {
          "type": "filter",
          "expr": "(cat === 'all' || datum.type === cat) && (!q || indexof(lower(datum.name), lower(q)) >= 0)"
        },
        {
          "type": "formula",
          "as": "pct",
          "expr": "datum.volume / totalExc"
        }
      ]
    },
    {
      "name": "tb_hd0",
      "values": [
        {
          "sortKey": "name"
        }
      ]
    },
    {
      "name": "tb_hd1",
      "values": [
        {
          "sortKey": "volume"
        }
      ]
    },
    {
      "name": "tb_hd2",
      "values": [
        {
          "sortKey": "pct"
        }
      ]
    },
    {
      "name": "tb_hd3",
      "values": [
        {
          "sortKey": "cost"
        }
      ]
    },
    {
      "name": "tb_hd4",
      "values": [
        {
          "sortKey": "lastSeen"
        }
      ]
    },
    {
      "name": "tb_rows",
      "source": "exv",
      "transform": [
        {
          "type": "collect",
          "sort": {
            "field": {
              "signal": "tb_sortKey"
            },
            "order": {
              "signal": "tb_sortDir"
            }
          }
        },
        {
          "type": "window",
          "ops": [
            "row_number"
          ],
          "as": [
            "rank"
          ]
        },
        {
          "type": "filter",
          "expr": "datum.rank <= tb_fit"
        }
      ]
    }
  ],
  "marks": [
    {
      "type": "text",
      "name": "frame_title",
