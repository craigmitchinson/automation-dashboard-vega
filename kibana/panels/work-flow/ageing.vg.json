{
  "$schema": "https://vega.github.io/schema/vega/v5.json",
  "description": "IA · Work in & out · Waiting by age. Generated by vega/build.mjs from vega/panels/work-flow.mjs, do not edit by hand.",
  "autosize": {
    "type": "fit",
    "contains": "padding"
  },
  "padding": 0,
  "config": {
    "background": "#FFFFFF",
    "padding": 0,
    "font": "Inter, 'Segoe UI', system-ui, -apple-system, sans-serif",
    "text": {
      "font": "Inter, 'Segoe UI', system-ui, -apple-system, sans-serif",
      "fill": "#0F4D43",
      "fontSize": 12
    },
    "axis": {
      "gridColor": "#E6E8E2",
      "labelFont": "'Roboto Mono', Menlo, Consolas, monospace",
      "labelFontSize": 10,
      "labelColor": "#5F6E69",
      "titleFont": "'Roboto Mono', Menlo, Consolas, monospace",
      "titleColor": "#5F6E69",
      "titleFontSize": 10,
      "titleFontWeight": 400,
      "domain": false,
      "ticks": false,
      "gridWidth": 1,
      "labelPadding": 6
    },
    "style": {
      "guide-label": {
        "font": "'Roboto Mono', Menlo, Consolas, monospace"
      }
    },
    "view": {
      "stroke": null
    },
    "kibana": {
      "renderer": "svg",
      "hideWarnings": true
    }
  },
  "signals": [
    {
      "name": "headerRight",
      "value": 0
    },
    {
      "name": "top",
      "value": 58
    },
    {
      "name": "cw",
      "update": "width - 32"
    },
    {
      "name": "ch",
      "update": "height - top - 16"
    },
    {
      "name": "agRowH",
      "value": 26
    },
    {
      "name": "agTop",
      "update": "top + 18"
    },
    {
      "name": "agFit",
      "update": "max(1, floor((ch - 40) / agRowH))"
    },
    {
      "name": "agLabelW",
      "update": "clamp(cw * 0.22, 150, 260)"
    },
    {
      "name": "agBarW",
      "update": "cw - agLabelW - 230"
    },
    {
      "name": "agMax",
      "update": "length(data('agmax')) ? max(1, data('agmax')[0].m) : 1"
    },
    {
      "name": "pickAg",
      "on": [
        {
          "events": "@ag_label:click",
          "update": "kibanaAddFilter({'match_phrase': {'process.name': datum.name}}, 'ia-workqueue-items*')"
        }
      ]
    }
  ],
  "data": [
    {
      "name": "procs_raw",
      "url": {
        "index": "ia-reference",
        "body": {
          "size": 500,
          "query": {
            "term": {
              "doc_type": "process"
            }
          }
        }
      },
      "format": {
        "property": "hits.hits"
      }
    },
    {
      "name": "procs",
      "source": "procs_raw",
      "transform": [
        {
          "type": "formula",
          "as": "name",
          "expr": "datum._source.process.name"
        },
        {
          "type": "formula",
          "as": "pid",
          "expr": "datum._source.process.id"
        },
        {
          "type": "formula",
          "as": "acronym",
          "expr": "datum._source.process.acronym"
        },
        {
          "type": "formula",
          "as": "spoke",
          "expr": "datum._source.spoke.name"
        },
        {
          "type": "formula",
          "as": "spokeColor",
          "expr": "datum._source.spoke.color"
        },
        {
          "type": "formula",
          "as": "proposition",
          "expr": "datum._source.proposition.name"
        },
        {
          "type": "formula",
          "as": "queue",
          "expr": "datum._source.primary_queue"
        },
        {
          "type": "formula",
          "as": "queues",
          "expr": "join(datum._source.queues, ' → ')"
        },
        {
          "type": "formula",
          "as": "description",
          "expr": "datum._source.process.description"
        },
        {
          "type": "formula",
          "as": "tags",
          "expr": "datum._source.process.tags"
        },
        {
          "type": "formula",
          "as": "smv",
          "expr": "datum._source.process.smv_minutes"
        },
        {
          "type": "formula",
          "as": "grade",
          "expr": "datum._source.process.grade"
        },
        {
          "type": "formula",
          "as": "gradeName",
          "expr": "datum._source.process.grade_name"
        },
        {
          "type": "formula",
          "as": "rate",
          "expr": "datum._source.process.current_rate_gbp"
        },
        {
          "type": "formula",
          "as": "rateOff",
          "expr": "datum._source.process.current_rate_offshore_gbp"
        },
        {
          "type": "formula",
          "as": "offShare",
          "expr": "datum._source.process.offshore_share || 0"
        },
        {
          "type": "formula",
          "as": "slaHours",
          "expr": "datum._source.process.sla_hours"
        }
      ]
    },
    {
      "name": "ag_raw",
      "url": {
        "index": "ia-workqueue-items",
        "body": {
          "size": 0,
          "query": {
            "bool": {
              "must": [
                "%dashboard_context-must_clause%",
                {
                  "term": {
                    "mapped": true
                  }
                },
                {
                  "term": {
                    "n.pending": 1
                  }
                },
                {
                  "range": {
                    "item.loaded_at": {
                      "lte": {
                        "%timefilter%": "max"
                      },
                      "format": "epoch_millis"
                    }
                  }
                }
              ],
              "filter": [
                "%dashboard_context-filter_clause%"
              ],
              "must_not": [
                "%dashboard_context-must_not_clause%"
              ]
            }
          },
          "aggs": {
            "p": {
              "terms": {
                "field": "process.name",
                "size": 30
              },
              "aggs": {
                "age": {
                  "date_range": {
                    "field": "item.loaded_at",
                    "keyed": true,
                    "ranges": [
                      {
                        "key": "a0",
                        "from": {
                          "%timefilter%": "max",
                          "shift": -4,
                          "unit": "hour"
                        }
                      },
                      {
                        "key": "a1",
                        "from": {
                          "%timefilter%": "max",
                          "shift": -24,
                          "unit": "hour"
                        },
                        "to": {
                          "%timefilter%": "max",
                          "shift": -4,
                          "unit": "hour"
                        }
                      },
                      {
                        "key": "a2",
                        "from": {
                          "%timefilter%": "max",
                          "shift": -72,
                          "unit": "hour"
                        },
                        "to": {
                          "%timefilter%": "max",
                          "shift": -24,
                          "unit": "hour"
                        }
                      },
                      {
                        "key": "a3",
                        "from": {
                          "%timefilter%": "max",
                          "shift": -168,
                          "unit": "hour"
                        },
                        "to": {
                          "%timefilter%": "max",
                          "shift": -72,
                          "unit": "hour"
                        }
                      },
                      {
                        "key": "a4",
                        "to": {
                          "%timefilter%": "max",
                          "shift": -168,
                          "unit": "hour"
                        }
                      }
                    ]
                  }
                },
                "past": {
                  "filter": {
                    "range": {
                      "item.sla_due_at": {
                        "lte": {
                          "%timefilter%": "max"
                        },
                        "format": "epoch_millis"
                      }
                    }
                  }
                },
                "oldest": {
                  "min": {
                    "field": "item.loaded_at"
                  }
                }
              }
            },
            "nowb": {
              "date_range": {
                "field": "item.loaded_at",
                "ranges": [
                  {
                    "key": "now",
                    "from": {
                      "%timefilter%": "max"
                    }
                  }
                ]
              }
            }
          }
        }
      },
      "format": {
        "property": "aggregations"
      }
    },
    {
      "name": "ag",
      "source": "ag_raw",
      "transform": [
        {
          "type": "flatten",
          "fields": [
            "p.buckets"
          ],
          "as": [
            "g"
          ]
        },
        {
          "type": "formula",
          "as": "name",
          "expr": "datum.g.key"
        },
        {
          "type": "formula",
          "as": "n",
          "expr": "datum.g.doc_count"
        },
        {
          "type": "formula",
          "as": "past",
          "expr": "datum.g.past.doc_count"
        },
        {
          "type": "formula",
          "as": "ageH",
          "expr": "(datum.nowb.buckets[0].from - datum.g.oldest.value) / 3600000"
        },
        {
          "type": "formula",
          "as": "a0",
          "expr": "datum.g.age.buckets.a0.doc_count"
        },
        {
          "type": "formula",
          "as": "a1",
          "expr": "datum.g.age.buckets.a1.doc_count"
        },
        {
          "type": "formula",
          "as": "a2",
          "expr": "datum.g.age.buckets.a2.doc_count"
        },
        {
          "type": "formula",
          "as": "a3",
          "expr": "datum.g.age.buckets.a3.doc_count"
        },
        {
          "type": "formula",
          "as": "a4",
          "expr": "datum.g.age.buckets.a4.doc_count"
        },
        {
          "type": "formula",
          "as": "old",
          "expr": "datum.a2 + datum.a3 + datum.a4"
        },
        {
          "type": "collect",
          "sort": {
            "field": [
              "a4",
              "a3",
              "a2",
              "n"
            ],
            "order": [
              "descending",
              "descending",
              "descending",
              "descending"
            ]
          }
        },
        {
          "type": "window",
          "ops": [
            "row_number"
          ],
          "as": [
            "r"
          ]
        },
        {
          "type": "project",
          "fields": [
            "name",
            "n",
            "past",
            "ageH",
            "old",
            "r",
            "a0",
            "a1",
            "a2",
            "a3",
            "a4"
          ]
        }
      ]
    },
    {
      "name": "agseg",
      "source": "ag",
      "transform": [
        {
          "type": "fold",
          "fields": [
            "a0",
            "a1",
            "a2",
            "a3",
            "a4"
          ],
          "as": [
            "k",
            "v"
          ]
        },
        {
          "type": "formula",
          "as": "ord",
          "expr": "indexof(['a0', 'a1', 'a2', 'a3', 'a4'], datum.k)"
        },
        {
          "type": "window",
          "groupby": [
            "name"
          ],
          "sort": {
            "field": "ord",
            "order": "descending"
          },
          "ops": [
            "sum"
          ],
          "fields": [
            "v"
          ],
          "as": [
            "x1"
          ]
        },
        {
          "type": "formula",
          "as": "x0",
          "expr": "datum.x1 - datum.v"
        },
        {
          "type": "filter",
          "expr": "datum.v > 0 && datum.r <= agFit"
        }
      ]
    },
    {
      "name": "agv",
      "source": "ag",
      "transform": [
        {
          "type": "filter",
          "expr": "datum.r <= agFit"
        }
      ]
    },
    {
      "name": "agmax",
      "source": "ag",
      "transform": [
        {
          "type": "aggregate",
          "ops": [
            "max",
            "sum",
            "sum",
            "sum"
          ],
          "fields": [
            "n",
            "n",
            "past",
            "old"
          ],
          "as": [
            "m",
            "n",
            "past",
            "old"
          ]
        }
      ]
    }
  ],
