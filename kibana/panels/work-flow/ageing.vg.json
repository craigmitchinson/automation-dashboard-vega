      "type": "text",
      "name": "ag_label",
      "from": {
        "data": "agv"
      },
      "encode": {
        "update": {
          "x": {
            "value": 16
          },
          "y": {
            "signal": "agTop + (datum.r - 0.5) * agRowH"
          },
          "baseline": {
            "value": "middle"
          },
          "font": {
            "value": "Inter, 'Segoe UI', system-ui, -apple-system, sans-serif"
          },
          "fontSize": {
            "value": 12.5
          },
          "fill": {
            "value": "#0F4D43"
          },
          "text": {
            "field": "name"
          },
          "limit": {
            "signal": "agLabelW - 10"
          },
          "cursor": {
            "value": "pointer"
          }
        }
      }
    },
    {
      "type": "rect",
      "from": {
        "data": "agv"
      },
      "encode": {
        "update": {
          "x": {
            "signal": "16 + agLabelW"
          },
          "width": {
            "signal": "agBarW"
          },
          "y": {
            "signal": "agTop + (datum.r - 0.5) * agRowH - 5"
          },
          "height": {
            "value": 10
          },
          "cornerRadius": {
            "value": 5
          },
          "fill": {
            "value": "#E6E8E2"
          }
        }
      }
    },
    {
      "type": "rect",
      "from": {
        "data": "agseg"
      },
      "encode": {
        "update": {
          "x": {
            "signal": "16 + agLabelW + agBarW * datum.x0 / agMax"
          },
          "x2": {
            "signal": "16 + agLabelW + agBarW * datum.x1 / agMax"
          },
          "y": {
            "signal": "agTop + (datum.r - 0.5) * agRowH - 5"
          },
          "height": {
            "value": 10
          },
          "fill": {
            "signal": "['#DCE8E0', '#9FC2B6', '#B9852C', '#C9663F', '#B6462F'][datum.ord]"
          },
          "tooltip": {
            "signal": "{'Process': datum.name, 'Waiting': ['Under 4 h', '4 to 24 h', '1 to 3 days', '3 to 7 days', 'Over 7 days'][datum.ord], 'Items': datum.v}"
          }
        }
      }
    },
    {
      "type": "text",
      "from": {
        "data": "agv"
      },
      "encode": {
        "update": {
          "x": {
            "signal": "16 + cw - 120"
          },
          "y": {
            "signal": "agTop + (datum.r - 0.5) * agRowH"
          },
          "align": {
            "value": "right"
          },
          "baseline": {
            "value": "middle"
          },
          "font": {
            "value": "'Roboto Mono', Menlo, Consolas, monospace"
          },
          "fontSize": {
            "value": 12
          },
          "fontWeight": {
            "value": 600
          },
          "fill": {
            "signal": "'#0F4D43'"
          },
          "text": {
            "signal": "(isValid((datum.n)) && isFinite((datum.n)) ? format((datum.n), ',.0f') : '–')"
          }
        }
      }
    },
    {
      "type": "text",
      "from": {
        "data": "agv"
      },
      "encode": {
        "update": {
          "x": {
            "signal": "16 + cw - 60"
          },
          "y": {
            "signal": "agTop + (datum.r - 0.5) * agRowH"
          },
          "align": {
            "value": "right"
          },
          "baseline": {
            "value": "middle"
          },
          "font": {
            "value": "'Roboto Mono', Menlo, Consolas, monospace"
          },
          "fontSize": {
            "value": 12
          },
          "fontWeight": {
            "value": 600
          },
          "fill": {
            "signal": "datum.past > 0 ? '#B6462F' : '#5F6E69'"
          },
          "text": {
            "signal": "(isValid((datum.past)) && isFinite((datum.past)) ? format((datum.past), ',.0f') : '–')"
          }
        }
      }
    },
    {
      "type": "text",
      "from": {
        "data": "agv"
      },
      "encode": {
        "update": {
          "x": {
            "signal": "16 + cw"
          },
          "y": {
            "signal": "agTop + (datum.r - 0.5) * agRowH"
          },
          "align": {
            "value": "right"
          },
          "baseline": {
            "value": "middle"
          },
          "font": {
            "value": "'Roboto Mono', Menlo, Consolas, monospace"
          },
          "fontSize": {
            "value": 12
          },
          "fontWeight": {
            "value": 600
          },
          "fill": {
            "signal": "datum.ageH > 72 ? '#B6462F' : '#0F4D43'"
          },
          "text": {
            "signal": "datum.ageH < 48 ? format(datum.ageH, '.0f') + ' h' : format(datum.ageH / 24, '.0f') + ' days'"
          }
        }
      }
    },
    {
      "type": "text",
      "encode": {
        "update": {
          "x": {
            "signal": "16 + cw"
          },
          "y": {
            "signal": "top + ch"
          },
          "align": {
            "value": "right"
          },
          "baseline": {
            "value": "bottom"
          },
          "font": {
            "value": "'Roboto Mono', Menlo, Consolas, monospace"
          },
          "fontSize": {
            "value": 10
          },
          "fill": {
            "value": "#5F6E69"
          },
          "text": {
            "signal": "length(data('ag')) > agFit ? '+' + (length(data('ag')) - agFit) + ' more processes' : ''"
          }
        }
      }
    },
    {
      "type": "text",
      "encode": {
        "update": {
          "x": {
            "signal": "width / 2"
          },
          "y": {
            "signal": "top + ch / 2"
          },
          "align": {
            "value": "center"
          },
          "baseline": {
            "value": "middle"
          },
          "font": {
            "value": "Inter, 'Segoe UI', system-ui, -apple-system, sans-serif"
          },
          "fontSize": {
            "value": 13
          },
          "fill": {
            "value": "#5F6E69"
          },
          "text": {
            "value": "Nothing waiting at the end of the period"
          },
          "opacity": {
            "signal": "(!length(data('ag'))) ? 1 : 0"
          }
        }
      }
    }
  ]
}
