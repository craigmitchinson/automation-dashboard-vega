          "fill": {
            "value": "#5F6E69"
          },
          "text": {
            "signal": "(view === 'monthly' ? 'Items worked per month' : view === 'avg' ? 'Items worked per day, trailing 7-day average' : 'Items worked per day') + ' by outcome · ◆ marks a release or change'"
          },
          "limit": {
            "signal": "width - 42 - length('ITEM FLOW') * 6.9 - 0 - headerRight"
          }
        }
      }
