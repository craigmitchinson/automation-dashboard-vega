{
  "$schema": "https://vega.github.io/schema/vega/v5.json",
  "description": "IA · Overview · Item flow. Generated by vega/build.mjs from vega/panels/overview.mjs, do not edit by hand.",
  "autosize": {
    "type": "fit",
    "contains": "padding"
  },
  "padding": 0,
  "config": {
    "background": "#FFFFFF",
    "padding": 0,
    "font": "Inter, 'Segoe UI', system-ui, -apple-system, sans-serif",
    "text": {
      "font": "Inter, 'Segoe UI', system-ui, -apple-system, sans-serif",
      "fill": "#0F4D43",
      "fontSize": 12
    },
    "axis": {
      "gridColor": "#E6E8E2",
      "labelFont": "'Roboto Mono', Menlo, Consolas, monospace",
      "labelFontSize": 10,
      "labelColor": "#5F6E69",
      "titleFont": "'Roboto Mono', Menlo, Consolas, monospace",
      "titleColor": "#5F6E69",
      "titleFontSize": 10,
      "titleFontWeight": 400,
      "domain": false,
      "ticks": false,
      "gridWidth": 1,
      "labelPadding": 6
    },
    "style": {
      "guide-label": {
        "font": "'Roboto Mono', Menlo, Consolas, monospace"
      }
    },
    "view": {
      "stroke": null
    },
    "kibana": {
      "renderer": "svg",
      "hideWarnings": true
    }
  },
  "signals": [
    {
      "name": "ndays",
      "update": "length(data('win'))"
    },
    {
      "name": "lo",
      "update": "ndays ? data('win')[0].key : 0"
    },
    {
      "name": "hi",
      "update": "ndays ? data('win')[ndays - 1].key : 0"
    },
    {
      "name": "plo",
      "update": "lo - ndays * 86400000"
    },
    {
      "name": "phi",
      "update": "lo - 86400000"
    },
    {
      "name": "headerRight",
      "value": 0
    },
    {
      "name": "top",
      "value": 58
    },
    {
      "name": "cw",
      "update": "width - 32"
    },
    {
      "name": "ch",
      "update": "height - top - 16"
    },
    {
      "name": "view",
      "value": "avg",
      "on": [
        {
          "events": "@seg_view_0:click",
          "update": "'daily'"
        },
        {
          "events": "@seg_view_1:click",
          "update": "'avg'"
        },
        {
          "events": "@seg_view_2:click",
          "update": "'monthly'"
        }
      ]
    },
    {
      "name": "grain",
      "update": "view === 'monthly' ? 'monthly' : 'daily'"
    },
    {
      "name": "chart_ymax",
      "update": "max(extent(pluck(data('flow2'), 'yc'))[1] || 0, extent(pluck(data('flow2'), 'yb'))[1] || 0, extent(pluck(data('flow2'), 'ys'))[1] || 0, 0)"
    }
  ],
  "data": [
    {
      "name": "raw",
      "url": {
        "index": "ia-workqueue-items",
        "body": {
          "size": 0,
          "query": {
            "bool": {
              "must": [
                "%dashboard_context-must_clause%",
                {
                  "range": {
                    "@timestamp": {
                      "gte": {
                        "%timefilter%": "min",
                        "shift": -732,
                        "unit": "day"
                      },
                      "lte": {
                        "%timefilter%": "max"
                      },
                      "format": "epoch_millis"
                    }
                  }
                },
                {
                  "term": {
                    "mapped": true
                  }
                }
              ],
              "filter": [
                "%dashboard_context-filter_clause%"
              ],
              "must_not": [
                "%dashboard_context-must_not_clause%"
              ]
            }
          },
          "aggs": {
            "win": {
              "filter": {
                "range": {
                  "@timestamp": {
                    "gte": {
                      "%timefilter%": "min",
                      "shift": 1,
                      "unit": "hour"
                    },
                    "lte": {
                      "%timefilter%": "max"
                    },
                    "format": "epoch_millis"
                  }
                }
              },
              "aggs": {
                "d": {
                  "date_histogram": {
                    "field": "@timestamp",
                    "fixed_interval": "1d",
                    "min_doc_count": 0,
                    "extended_bounds": {
                      "min": {
                        "%timefilter%": "min",
                        "shift": 1,
                        "unit": "hour"
                      },
                      "max": {
                        "%timefilter%": "max"
                      }
                    }
                  }
                }
              }
            },
            "days": {
              "date_histogram": {
                "field": "@timestamp",
                "fixed_interval": "1d",
                "min_doc_count": 1
              },
              "aggs": {
                "c": {
                  "sum": {
                    "field": "n.completed"
                  }
                },
                "b": {
                  "sum": {
                    "field": "n.business"
                  }
                },
                "s": {
                  "sum": {
                    "field": "n.system"
                  }
                }
              }
            }
          }
        }
      },
      "format": {
        "property": "aggregations"
      }
    },
    {
      "name": "win",
      "source": "raw",
      "transform": [
        {
          "type": "flatten",
          "fields": [
            "win.d.buckets"
          ],
          "as": [
            "_bk"
          ]
        },
        {
          "type": "formula",
          "as": "key",
          "expr": "datum._bk.key"
        },
        {
          "type": "formula",
          "as": "n",
          "expr": "datum._bk.doc_count"
        },
        {
          "type": "project",
          "fields": [
            "key",
            "n"
          ]
        }
      ]
    },
    {
      "name": "days",
      "source": "raw",
      "transform": [
        {
          "type": "flatten",
          "fields": [
            "days.buckets"
          ],
          "as": [
            "_bk"
          ]
        },
        {
          "type": "formula",
          "as": "key",
          "expr": "datum._bk.key"
        },
        {
          "type": "formula",
          "as": "n",
          "expr": "datum._bk.doc_count"
        },
        {
          "type": "formula",
          "as": "c",
          "expr": "datum._bk[\"c\"] ? (datum._bk[\"c\"].value || 0) : 0"
        },
        {
          "type": "formula",
          "as": "b",
          "expr": "datum._bk[\"b\"] ? (datum._bk[\"b\"].value || 0) : 0"
        },
        {
          "type": "formula",
          "as": "s",
          "expr": "datum._bk[\"s\"] ? (datum._bk[\"s\"].value || 0) : 0"
        },
        {
          "type": "project",
          "fields": [
            "key",
            "n",
            "c",
            "b",
            "s"
          ]
        }
      ]
    },
    {
      "name": "series",
      "source": "win",
      "transform": [
        {
          "type": "lookup",
          "from": "days",
          "key": "key",
          "fields": [
            "key"
          ],
          "as": [
            "d"
          ]
        },
        {
          "type": "formula",
          "as": "t",
          "expr": "datum.key"
        },
        {
          "type": "formula",
          "as": "c",
          "expr": "datum.d ? datum.d.c : 0"
        },
        {
          "type": "formula",
          "as": "b",
          "expr": "datum.d ? datum.d.b : 0"
        },
        {
          "type": "formula",
          "as": "s",
          "expr": "datum.d ? datum.d.s : 0"
        }
      ]
    },
    {
      "name": "tot",
      "source": "days",
      "transform": [
        {
          "type": "formula",
          "as": "cur_c",
          "expr": "datum.key >= lo && datum.key <= hi ? datum.c : 0"
        },
        {
          "type": "formula",
          "as": "prev_c",
          "expr": "datum.key >= plo && datum.key <= phi ? datum.c : 0"
        },
        {
          "type": "formula",
          "as": "cur_b",
          "expr": "datum.key >= lo && datum.key <= hi ? datum.b : 0"
        },
        {
          "type": "formula",
          "as": "prev_b",
          "expr": "datum.key >= plo && datum.key <= phi ? datum.b : 0"
        },
        {
          "type": "formula",
          "as": "cur_s",
          "expr": "datum.key >= lo && datum.key <= hi ? datum.s : 0"
        },
        {
          "type": "formula",
          "as": "prev_s",
          "expr": "datum.key >= plo && datum.key <= phi ? datum.s : 0"
        },
        {
          "type": "aggregate",
          "ops": [
            "sum",
            "sum",
            "sum",
            "sum",
            "sum",
            "sum"
          ],
          "fields": [
            "cur_c",
            "prev_c",
            "cur_b",
            "prev_b",
            "cur_s",
            "prev_s"
          ],
          "as": [
            "cur_c",
            "prev_c",
            "cur_b",
            "prev_b",
            "cur_s",
            "prev_s"
          ]
        }
      ]
    },
    {
      "name": "ref_rel",
      "url": {
        "index": "ia-reference",
        "body": {
          "size": 500,
          "query": {
            "term": {
              "doc_type": "release"
            }
          }
        }
      },
      "format": {
        "property": "hits.hits"
      }
    },
    {
      "name": "rel",
      "source": "ref_rel",
      "transform": [
        {
          "type": "formula",
          "as": "t",
          "expr": "toDate(datum._source.release.date)"
        },
        {
          "type": "formula",
          "as": "process",
          "expr": "datum._source.release.process"
        },
        {
          "type": "formula",
          "as": "label",
          "expr": "datum._source.release.title + ' · ' + (datum.process || 'estate-wide')"
        },
        {
          "type": "filter",
          "expr": "true"
        },
        {
          "type": "project",
          "fields": [
            "t",
            "process",
            "label"
          ]
        }
      ]
    },
    {
      "name": "flow",
      "source": "series",
      "transform": [
        {
          "type": "formula",
          "as": "g",
          "expr": "grain === 'monthly' ? utc(utcyear(datum.t), utcmonth(datum.t), 1) : grain === 'weekly' ? datum.t - ((utcday(datum.t) + 6) % 7) * 86400000 : datum.t"
        },
        {
          "type": "aggregate",
          "groupby": [
            "g"
          ],
          "ops": [
            "sum",
            "sum",
            "sum"
          ],
          "fields": [
            "c",
            "b",
            "s"
          ],
          "as": [
            "c",
            "b",
            "s"
          ]
        },
        {
          "type": "formula",
          "as": "t",
          "expr": "datum.g"
        },
        {
          "type": "collect",
          "sort": {
            "field": "t"
          }
        }
      ]
    },
    {
      "name": "flow2",
      "source": "flow",
      "transform": [
        {
          "type": "window",
          "ops": [
            "mean",
            "mean",
            "mean"
          ],
          "fields": [
            "c",
            "b",
            "s"
          ],
          "as": [
            "c7",
            "b7",
            "s7"
          ],
          "frame": [
            -6,
            0
          ]
        },
        {
          "type": "formula",
          "as": "yc",
          "expr": "view === 'avg' ? datum.c7 : datum.c"
        },
        {
          "type": "formula",
          "as": "yb",
          "expr": "view === 'avg' ? datum.b7 : datum.b"
        },
        {
          "type": "formula",
          "as": "ys",
          "expr": "view === 'avg' ? datum.s7 : datum.s"
        }
      ]
    },
    {
      "name": "chart_mk",
      "source": "rel",
      "transform": [
        {
          "type": "filter",
          "expr": "length(data('flow2')) && datum.t >= extent(pluck(data('flow2'), 't'))[0] && datum.t <= extent(pluck(data('flow2'), 't'))[1]"
        }
      ]
    }
  ],
  "scales": [
    {
      "name": "chart_x",
      "type": "utc",
      "domain": {
        "signal": "length(data('flow2')) ? extent(pluck(data('flow2'), 't')) : [0, 1]"
      },
      "range": [
        0,
        {
          "signal": "cw - 44"
        }
      ]
    },
    {
      "name": "chart_y",
      "type": "linear",
      "domain": {
        "signal": "[0, max(0, chart_ymax)]"
      },
      "range": [
        {
          "signal": "ch - 22"
        },
        0
      ],
      "nice": true,
      "zero": true
    }
  ],
  "marks": [
