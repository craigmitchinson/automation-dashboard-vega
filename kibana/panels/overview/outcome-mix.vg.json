{
  "$schema": "https://vega.github.io/schema/vega/v5.json",
  "description": "IA · Overview · Outcome mix. Generated by vega/build.mjs from vega/panels/overview.mjs, do not edit by hand.",
  "autosize": {
    "type": "fit",
    "contains": "padding"
  },
  "padding": 0,
  "config": {
    "background": "#FFFFFF",
    "padding": 0,
    "font": "Inter, 'Segoe UI', system-ui, -apple-system, sans-serif",
    "text": {
      "font": "Inter, 'Segoe UI', system-ui, -apple-system, sans-serif",
      "fill": "#0F4D43",
      "fontSize": 12
    },
    "axis": {
      "gridColor": "#E6E8E2",
      "labelFont": "'Roboto Mono', Menlo, Consolas, monospace",
      "labelFontSize": 10,
      "labelColor": "#5F6E69",
      "titleFont": "'Roboto Mono', Menlo, Consolas, monospace",
      "titleColor": "#5F6E69",
      "titleFontSize": 10,
      "titleFontWeight": 400,
      "domain": false,
      "ticks": false,
      "gridWidth": 1,
      "labelPadding": 6
    },
    "style": {
      "guide-label": {
        "font": "'Roboto Mono', Menlo, Consolas, monospace"
      }
    },
    "view": {
      "stroke": null
    },
    "kibana": {
      "renderer": "svg",
      "hideWarnings": true
    }
  },
  "signals": [
    {
      "name": "ndays",
      "update": "length(data('win'))"
    },
    {
      "name": "lo",
      "update": "ndays ? data('win')[0].key : 0"
    },
    {
      "name": "hi",
      "update": "ndays ? data('win')[ndays - 1].key : 0"
    },
    {
      "name": "plo",
      "update": "lo - ndays * 86400000"
    },
    {
      "name": "phi",
      "update": "lo - 86400000"
    },
    {
      "name": "headerRight",
      "value": 0
    },
    {
      "name": "top",
      "value": 42
    },
    {
      "name": "cw",
      "update": "width - 32"
    },
    {
      "name": "ch",
      "update": "height - top - 16"
    },
    {
      "name": "stripTop",
      "update": "top + 6 + 26 + 12 + 3 * 26 + 10"
    },
    {
      "name": "stripH",
      "update": "max(0, height - stripTop - 52)"
    }
  ],
  "data": [
    {
      "name": "raw",
      "url": {
        "index": "ia-workqueue-items",
        "body": {
          "size": 0,
          "query": {
            "bool": {
              "must": [
                "%dashboard_context-must_clause%",
                {
                  "range": {
                    "@timestamp": {
                      "gte": {
                        "%timefilter%": "min",
                        "shift": -732,
                        "unit": "day"
                      },
                      "lte": {
                        "%timefilter%": "max"
                      },
                      "format": "epoch_millis"
                    }
                  }
                },
                {
                  "term": {
                    "mapped": true
                  }
                }
              ],
              "filter": [
                "%dashboard_context-filter_clause%"
              ],
              "must_not": [
                "%dashboard_context-must_not_clause%"
              ]
            }
          },
          "aggs": {
            "win": {
              "filter": {
                "range": {
                  "@timestamp": {
                    "%timefilter%": true
                  }
                }
              },
              "aggs": {
                "d": {
                  "date_histogram": {
                    "field": "@timestamp",
                    "fixed_interval": "1d",
                    "min_doc_count": 0,
                    "extended_bounds": {
                      "min": {
                        "%timefilter%": "min"
                      },
                      "max": {
                        "%timefilter%": "max"
                      }
                    }
                  }
                }
              }
            },
            "days": {
              "date_histogram": {
                "field": "@timestamp",
                "fixed_interval": "1d",
                "min_doc_count": 1
              },
              "aggs": {
                "c": {
                  "sum": {
                    "field": "n.completed"
                  }
                },
                "b": {
                  "sum": {
                    "field": "n.business"
                  }
                },
                "s": {
                  "sum": {
                    "field": "n.system"
                  }
                },
                "a": {
                  "sum": {
                    "field": "n.attempt"
                  }
                },
                "ec": {
                  "sum": {
                    "field": "cost.estate_gbp"
                  }
                }
              }
            }
          }
        }
      },
      "format": {
        "property": "aggregations"
      }
    },
    {
      "name": "win",
      "source": "raw",
      "transform": [
        {
          "type": "flatten",
          "fields": [
            "win.d.buckets"
          ],
          "as": [
            "_bk"
          ]
        },
        {
          "type": "formula",
          "as": "key",
          "expr": "datum._bk.key"
        },
        {
          "type": "formula",
          "as": "n",
          "expr": "datum._bk.doc_count"
        },
        {
          "type": "project",
          "fields": [
            "key",
            "n"
          ]
        }
      ]
    },
    {
      "name": "days",
      "source": "raw",
      "transform": [
        {
          "type": "flatten",
          "fields": [
            "days.buckets"
          ],
          "as": [
            "_bk"
          ]
        },
        {
          "type": "formula",
          "as": "key",
          "expr": "datum._bk.key"
        },
        {
          "type": "formula",
          "as": "n",
          "expr": "datum._bk.doc_count"
        },
        {
          "type": "formula",
          "as": "c",
          "expr": "datum._bk[\"c\"] ? (datum._bk[\"c\"].value || 0) : 0"
        },
        {
          "type": "formula",
          "as": "b",
          "expr": "datum._bk[\"b\"] ? (datum._bk[\"b\"].value || 0) : 0"
        },
        {
          "type": "formula",
          "as": "s",
          "expr": "datum._bk[\"s\"] ? (datum._bk[\"s\"].value || 0) : 0"
        },
        {
          "type": "formula",
          "as": "a",
          "expr": "datum._bk[\"a\"] ? (datum._bk[\"a\"].value || 0) : 0"
        },
        {
          "type": "formula",
          "as": "ec",
          "expr": "datum._bk[\"ec\"] ? (datum._bk[\"ec\"].value || 0) : 0"
        },
        {
          "type": "project",
          "fields": [
            "key",
            "n",
            "c",
            "b",
            "s",
            "a",
            "ec"
          ]
        }
      ]
    },
    {
      "name": "series",
      "source": "win",
      "transform": [
        {
          "type": "lookup",
          "from": "days",
          "key": "key",
          "fields": [
            "key"
          ],
          "as": [
            "d"
          ]
        },
        {
          "type": "formula",
          "as": "t",
          "expr": "datum.key"
        },
        {
          "type": "formula",
          "as": "c",
          "expr": "datum.d ? datum.d.c : 0"
        },
        {
          "type": "formula",
          "as": "b",
          "expr": "datum.d ? datum.d.b : 0"
        },
        {
          "type": "formula",
          "as": "s",
          "expr": "datum.d ? datum.d.s : 0"
        },
        {
          "type": "formula",
          "as": "a",
          "expr": "datum.d ? datum.d.a : 0"
        },
        {
          "type": "formula",
          "as": "ec",
          "expr": "datum.d ? datum.d.ec : 0"
        }
      ]
    },
    {
      "name": "tot",
      "source": "days",
      "transform": [
        {
          "type": "formula",
          "as": "cur_c",
          "expr": "datum.key >= lo && datum.key <= hi ? datum.c : 0"
        },
        {
          "type": "formula",
          "as": "prev_c",
          "expr": "datum.key >= plo && datum.key <= phi ? datum.c : 0"
        },
        {
          "type": "formula",
          "as": "cur_b",
          "expr": "datum.key >= lo && datum.key <= hi ? datum.b : 0"
        },
        {
          "type": "formula",
          "as": "prev_b",
          "expr": "datum.key >= plo && datum.key <= phi ? datum.b : 0"
        },
        {
          "type": "formula",
          "as": "cur_s",
          "expr": "datum.key >= lo && datum.key <= hi ? datum.s : 0"
        },
        {
          "type": "formula",
          "as": "prev_s",
          "expr": "datum.key >= plo && datum.key <= phi ? datum.s : 0"
        },
        {
          "type": "formula",
          "as": "cur_a",
          "expr": "datum.key >= lo && datum.key <= hi ? datum.a : 0"
        },
        {
          "type": "formula",
          "as": "prev_a",
          "expr": "datum.key >= plo && datum.key <= phi ? datum.a : 0"
        },
        {
          "type": "formula",
          "as": "cur_ec",
          "expr": "datum.key >= lo && datum.key <= hi ? datum.ec : 0"
        },
        {
          "type": "formula",
          "as": "prev_ec",
          "expr": "datum.key >= plo && datum.key <= phi ? datum.ec : 0"
        },
        {
          "type": "aggregate",
          "ops": [
            "sum",
            "sum",
            "sum",
            "sum",
            "sum",
            "sum",
            "sum",
            "sum",
            "sum",
            "sum"
          ],
          "fields": [
            "cur_c",
            "prev_c",
            "cur_b",
            "prev_b",
            "cur_s",
            "prev_s",
            "cur_a",
            "prev_a",
            "cur_ec",
            "prev_ec"
          ],
          "as": [
            "cur_c",
            "prev_c",
            "cur_b",
            "prev_b",
            "cur_s",
            "prev_s",
            "cur_a",
            "prev_a",
            "cur_ec",
            "prev_ec"
          ]
        }
      ]
    },
    {
      "name": "mix",
      "values": [
        {
          "k": "c",
          "label": "Completed",
          "color": "#0F4D43",
          "i": 0
        },
        {
          "k": "b",
          "label": "Business exception",
          "color": "#B9852C",
          "i": 1
        },
        {
          "k": "s",
          "label": "System exception",
          "color": "#B6462F",
          "i": 2
        }
      ],
      "transform": [
        {
          "type": "formula",
          "as": "v",
          "expr": "[(length(data('tot')) ? data('tot')[0].cur_c : 0), (length(data('tot')) ? data('tot')[0].cur_b : 0), (length(data('tot')) ? data('tot')[0].cur_s : 0)][datum.i]"
        },
        {
          "type": "formula",
          "as": "share",
          "expr": "datum.v / max(1, (length(data('tot')) ? data('tot')[0].cur_a : 0))"
        },
        {
          "type": "window",
          "ops": [
            "sum"
          ],
          "fields": [
            "share"
          ],
          "as": [
            "cum"
          ],
          "frame": [
            null,
            0
          ]
        },
        {
          "type": "formula",
          "as": "x0",
          "expr": "datum.cum - datum.share"
        }
      ]
    },
    {
      "name": "strip",
      "source": "series",
      "transform": [
        {
          "type": "formula",
          "as": "tot",
          "expr": "datum.c + datum.b + datum.s"
        },
        {
          "type": "filter",
          "expr": "datum.tot > 0"
        },
        {
          "type": "fold",
          "fields": [
            "c",
            "b",
            "s"
          ],
          "as": [
            "k",
            "v"
          ]
        },
        {
          "type": "formula",
          "as": "share",
          "expr": "datum.v / datum.tot"
        },
        {
          "type": "formula",
          "as": "order",
          "expr": "indexof(['c','b','s'], datum.k)"
        },
        {
          "type": "stack",
          "groupby": [
            "t"
          ],
          "field": "share",
          "sort": {
            "field": "order"
          },
          "as": [
            "y0",
            "y1"
          ]
        }
      ]
    }
  ],
  "scales": [
    {
      "name": "ox",
      "type": "linear",
      "domain": [
        0,
        1
      ],
      "range": [
        0,
        {
          "signal": "cw"
        }
      ]
    },
    {
      "name": "sx",
      "type": "band",
      "domain": {
        "data": "strip",
        "field": "t",
        "sort": true
      },
      "range": [
        0,
        {
          "signal": "cw"
        }
      ],
      "paddingInner": 0.15
    },
    {
      "name": "sy",
      "type": "linear",
      "domain": [
        0,
        1
      ],
      "range": [
        {
          "signal": "stripH"
        },
        0
      ]
    },
    {
      "name": "oc",
      "type": "ordinal",
      "domain": [
        "c",
        "b",
        "s"
      ],
      "range": [
        "#0F4D43",
        "#B9852C",
        "#B6462F"
      ]
    }
  ],
  "marks": [
    {
      "type": "text",
      "name": "frame_title",
      "encode": {
        "update": {
          "x": {
            "value": 16
          },
          "y": {
            "value": 18
          },
          "baseline": {
            "value": "top"
          },
          "font": {
            "value": "'Roboto Mono', Menlo, Consolas, monospace"
          },
          "fontSize": {
            "value": 11
          },
          "fontWeight": {
            "value": 600
          },
          "fill": {
            "value": "#0F4D43"
          },
          "text": {
            "signal": "'OUTCOME MIX'"
          },
          "limit": {
            "signal": "width - 32"
          }
        }
      }
    },
    {
      "type": "text",
      "encode": {
        "update": {
          "x": {
            "signal": "16 + length('OUTCOME MIX') * 6.9 + 10"
          },
          "y": {
            "value": 17
          },
          "baseline": {
            "value": "top"
          },
          "font": {
            "value": "Inter, 'Segoe UI', system-ui, -apple-system, sans-serif"
          },
          "fontSize": {
            "value": 12
          },
          "fill": {
            "value": "#5F6E69"
          },
          "text": {
            "signal": "(isValid(((length(data('tot')) ? data('tot')[0].cur_a : 0))) && isFinite(((length(data('tot')) ? data('tot')[0].cur_a : 0))) ? format(((length(data('tot')) ? data('tot')[0].cur_a : 0)), ',.0f') : '–') + ' items attempted'"
          },
          "limit": {
            "signal": "width - 42 - length('OUTCOME MIX') * 6.9 - 0 - headerRight"
          }
        }
      }
    },
    {
      "type": "rect",
      "from": {
        "data": "mix"
      },
      "encode": {
        "update": {
          "x": {
            "signal": "16 + scale('ox', datum.x0)"
          },
          "x2": {
            "signal": "16 + max(scale('ox', datum.x0) + (datum.v > 0 ? 2 : 0), scale('ox', datum.cum) - 2)"
          },
          "y": {
            "signal": "top + 6"
          },
          "height": {
            "value": 26
          },
          "fill": {
            "field": "color"
          },
          "cornerRadius": {
            "value": 4
          },
          "tooltip": {
            "signal": "{'Outcome': datum.label, 'Items': (isValid((datum.v)) && isFinite((datum.v)) ? format((datum.v), ',.0f') : '–'), 'Share': (isValid((datum.share)) && isFinite((datum.share)) ? format((datum.share) * 100, '.1f') + '%' : '–')}"
          }
        }
      }
    },
    {
      "type": "rect",
      "from": {
        "data": "mix"
      },
      "encode": {
        "update": {
          "x": {
            "value": 16
          },
          "y": {
            "signal": "top + 6 + 26 + 12 + datum.i * 26 + 13 - 5.5"
          },
          "width": {
            "value": 11
          },
          "height": {
            "value": 11
          },
          "cornerRadius": {
            "value": 3
          },
          "fill": {
            "field": "color"
          }
        }
      }
    },
    {
      "type": "text",
      "from": {
        "data": "mix"
      },
      "encode": {
        "update": {
          "x": {
            "value": 37
          },
          "y": {
            "signal": "top + 6 + 26 + 12 + datum.i * 26 + 13"
          },
          "baseline": {
            "value": "middle"
          },
          "font": {
            "value": "Inter, 'Segoe UI', system-ui, -apple-system, sans-serif"
          },
          "fontSize": {
            "value": 13
          },
          "fill": {
            "value": "#0F4D43"
          },
          "text": {
            "field": "label"
          }
        }
      }
    },
    {
      "type": "text",
      "from": {
        "data": "mix"
      },
      "encode": {
        "update": {
          "x": {
            "signal": "width - 16 - 62"
          },
          "y": {
            "signal": "top + 6 + 26 + 12 + datum.i * 26 + 13"
          },
          "align": {
            "value": "right"
          },
          "baseline": {
            "value": "middle"
          },
          "font": {
            "value": "'Roboto Mono', Menlo, Consolas, monospace"
          },
          "fontSize": {
            "value": 13
          },
          "fontWeight": {
            "value": 600
          },
          "fill": {
            "value": "#0F4D43"
          },
          "text": {
            "signal": "(isValid((datum.v)) && isFinite((datum.v)) ? format((datum.v), ',.0f') : '–')"
          }
        }
      }
    },
    {
      "type": "text",
      "from": {
        "data": "mix"
      },
      "encode": {
        "update": {
          "x": {
            "signal": "width - 16"
          },
          "y": {
            "signal": "top + 6 + 26 + 12 + datum.i * 26 + 13"
          },
          "align": {
            "value": "right"
          },
          "baseline": {
            "value": "middle"
          },
          "font": {
            "value": "'Roboto Mono', Menlo, Consolas, monospace"
          },
          "fontSize": {
            "value": 12
          },
          "fill": {
            "value": "#5F6E69"
          },
          "text": {
            "signal": "(isValid((datum.share)) && isFinite((datum.share)) ? format((datum.share) * 100, '.1f') + '%' : '–')"
          }
        }
      }
    },
    {
      "type": "group",
      "encode": {
        "update": {
          "x": {
            "value": 16
          },
          "y": {
            "signal": "stripTop"
          },
          "width": {
            "signal": "cw"
          },
          "height": {
            "signal": "stripH"
          },
          "opacity": {
            "signal": "ndays > 14 && stripH > 30 ? 1 : 0"
          }
        }
      },
      "marks": [
        {
          "type": "rect",
          "from": {
            "data": "strip"
          },
          "encode": {
            "update": {
              "x": {
                "scale": "sx",
                "field": "t"
              },
              "width": {
                "scale": "sx",
                "band": 1
              },
              "y": {
                "scale": "sy",
                "field": "y1"
              },
              "y2": {
                "scale": "sy",
                "field": "y0"
              },
              "fill": {
                "scale": "oc",
                "field": "k"
              }
            }
          }
        }
      ]
    },
    {
      "type": "rule",
      "encode": {
        "update": {
          "x": {
            "value": 16
          },
          "x2": {
            "signal": "width - 16"
          },
          "y": {
            "signal": "height - 40"
          },
          "stroke": {
            "value": "#D6D9D2"
          }
        }
      }
    },
    {
      "type": "text",
      "encode": {
        "update": {
          "x": {
            "value": 16
          },
          "y": {
            "signal": "height - 24"
          },
          "baseline": {
            "value": "middle"
          },
          "font": {
            "value": "Inter, 'Segoe UI', system-ui, -apple-system, sans-serif"
          },
          "fontSize": {
            "value": 13
          },
          "fill": {
            "value": "#5F6E69"
          },
          "text": {
            "value": "Estate cost (period, apportioned)"
          }
        }
      }
    },
    {
      "type": "text",
      "encode": {
        "update": {
          "x": {
            "signal": "width - 16"
          },
          "y": {
            "signal": "height - 24"
          },
          "align": {
            "value": "right"
          },
          "baseline": {
            "value": "middle"
          },
          "font": {
            "value": "'Roboto Mono', Menlo, Consolas, monospace"
          },
          "fontSize": {
            "value": 13
          },
          "fontWeight": {
            "value": 600
          },
          "fill": {
            "value": "#0F4D43"
          },
          "text": {
            "signal": "(isValid(((length(data('tot')) ? data('tot')[0].cur_ec : 0))) && isFinite(((length(data('tot')) ? data('tot')[0].cur_ec : 0))) ? (((length(data('tot')) ? data('tot')[0].cur_ec : 0)) < 0 ? '-' : '') + '£' + format(round(abs(((length(data('tot')) ? data('tot')[0].cur_ec : 0)))), ',') : '–')"
          }
        }
      }
    }
  ]
}
