{
  "$schema": "https://vega.github.io/schema/vega/v5.json",
  "description": "IA · Process Analysis · Process performance. Generated by vega/build.mjs from vega/panels/process-analysis.mjs, do not edit by hand.",
  "autosize": {
    "type": "fit",
    "contains": "padding"
  },
  "padding": 0,
  "config": {
    "background": "#FAF7F2",
    "padding": 0,
    "font": "Calibri, Carlito, 'Segoe UI', Inter, Arial, sans-serif",
    "text": {
      "font": "Calibri, Carlito, 'Segoe UI', Inter, Arial, sans-serif",
      "fill": "#0B3239",
      "fontSize": 12
    },
    "axis": {
      "labelFont": "'JetBrains Mono', 'Roboto Mono', Consolas, 'Courier New', monospace",
      "labelFontSize": 10,
      "labelColor": "#5A7378",
      "titleFont": "'JetBrains Mono', 'Roboto Mono', Consolas, 'Courier New', monospace",
      "titleColor": "#5A7378",
      "titleFontSize": 10,
      "titleFontWeight": 400,
      "domain": false,
      "ticks": false,
      "gridColor": "#DCDCD7",
      "gridWidth": 1,
      "labelPadding": 6
    },
    "style": {
      "guide-label": {
        "font": "'JetBrains Mono', 'Roboto Mono', Consolas, 'Courier New', monospace"
      }
    },
    "view": {
      "stroke": null
    },
    "kibana": {
      "renderer": "svg",
      "hideWarnings": true
    }
  },
  "signals": [
    {
      "name": "top",
      "value": 56
    },
    {
      "name": "cw",
      "update": "width - 32"
    },
    {
      "name": "ch",
      "update": "height - top - 16"
    },
    {
      "name": "metric",
      "value": "time",
      "on": [
        {
          "events": "@seg_metric_0:click",
          "update": "'time'"
        },
        {
          "events": "@seg_metric_1:click",
          "update": "'throughput'"
        },
        {
          "events": "@seg_metric_2:click",
          "update": "'exrate'"
        }
      ]
    },
    {
      "name": "pick",
      "on": [
        {
          "events": "@hb_row:click",
          "update": "kibanaAddFilter({'match_phrase': {'process.name': datum.label}}, 'ia-workqueue-items*')"
        }
      ]
    },
    {
      "name": "hb_fit",
      "update": "max(1, floor((ch) / 25))"
    }
  ],
  "data": [
    {
      "name": "procs_raw",
      "url": {
        "index": "ia-reference",
        "body": {
          "size": 500,
          "query": {
            "term": {
              "doc_type": "process"
            }
          }
        }
      },
      "format": {
        "property": "hits.hits"
      }
    },
    {
      "name": "procs",
      "source": "procs_raw",
      "transform": [
        {
          "type": "formula",
          "as": "name",
          "expr": "datum._source.process.name"
        },
        {
          "type": "formula",
          "as": "pid",
          "expr": "datum._source.process.id"
        },
        {
          "type": "formula",
          "as": "acronym",
          "expr": "datum._source.process.acronym"
        },
        {
          "type": "formula",
          "as": "spoke",
          "expr": "datum._source.spoke.name"
        },
        {
          "type": "formula",
          "as": "spokeColor",
          "expr": "datum._source.spoke.color"
        },
        {
          "type": "formula",
          "as": "proposition",
          "expr": "datum._source.proposition.name"
        },
        {
          "type": "formula",
          "as": "queue",
          "expr": "datum._source.primary_queue"
        },
        {
          "type": "formula",
          "as": "queues",
          "expr": "join(datum._source.queues, ' → ')"
        },
        {
          "type": "formula",
          "as": "description",
          "expr": "datum._source.process.description"
        },
        {
          "type": "formula",
          "as": "tags",
          "expr": "datum._source.process.tags"
        },
        {
          "type": "formula",
          "as": "smv",
          "expr": "datum._source.process.smv_minutes"
        },
        {
          "type": "formula",
          "as": "grade",
          "expr": "datum._source.process.grade"
        },
        {
          "type": "formula",
          "as": "gradeName",
          "expr": "datum._source.process.grade_name"
        },
        {
          "type": "formula",
          "as": "rate",
          "expr": "datum._source.process.current_rate_gbp"
        }
      ]
    },
    {
      "name": "bp_raw",
      "url": {
        "%context%": true,
        "%timefield%": "@timestamp",
        "index": "ia-workqueue-items",
        "body": {
          "size": 0,
          "aggs": {
            "m": {
              "filter": {
                "term": {
                  "mapped": true
                }
              },
              "aggs": {
                "p": {
                  "terms": {
                    "field": "process.name",
                    "size": 100
                  },
                  "aggs": {
                    "c": {
                      "sum": {
                        "field": "n.completed"
                      }
                    },
                    "a": {
                      "sum": {
                        "field": "n.attempt"
                      }
                    },
                    "e": {
                      "sum": {
                        "field": "n.exception"
                      }
                    },
                    "cw": {
                      "sum": {
                        "field": "worktime_completed_sec"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      },
      "format": {
        "property": "aggregations.m.p.buckets"
      }
    },
    {
      "name": "bp",
      "source": "bp_raw",
      "transform": [
        {
          "type": "formula",
          "as": "name",
          "expr": "datum.key"
        },
        {
          "type": "formula",
          "as": "c",
          "expr": "datum['c'].value"
        },
        {
          "type": "formula",
          "as": "a",
          "expr": "datum['a'].value"
        },
        {
          "type": "formula",
          "as": "e",
          "expr": "datum['e'].value"
        },
        {
          "type": "formula",
          "as": "cw",
          "expr": "datum['cw'].value"
        },
        {
          "type": "lookup",
          "from": "procs",
          "key": "name",
          "fields": [
            "name"
          ],
          "as": [
            "ref"
          ]
        },
        {
          "type": "formula",
          "as": "spoke",
          "expr": "datum.ref ? datum.ref.spoke : ''"
        },
        {
          "type": "formula",
          "as": "spokeColor",
          "expr": "datum.ref ? datum.ref.spokeColor : '#5A7378'"
        },
        {
          "type": "formula",
          "as": "queue",
          "expr": "datum.ref ? datum.ref.queue : ''"
        },
        {
          "type": "formula",
          "as": "proposition",
          "expr": "datum.ref ? datum.ref.proposition : ''"
        }
      ]
    },
    {
      "name": "bars",
      "source": "bp",
      "transform": [
        {
          "type": "formula",
          "as": "label",
          "expr": "datum.name"
        },
        {
          "type": "formula",
          "as": "cycle",
          "expr": "datum.c ? datum.cw / datum.c : 0"
        },
        {
          "type": "formula",
          "as": "rate",
          "expr": "datum.a ? datum.e / datum.a * 100 : 0"
        },
        {
          "type": "formula",
          "as": "value",
          "expr": "metric === 'time' ? datum.cycle : metric === 'throughput' ? datum.c : datum.rate"
        },
        {
          "type": "formula",
          "as": "display",
          "expr": "metric === 'time' ? (isValid((datum.cycle)) && isFinite((datum.cycle)) ? (round((datum.cycle)) < 60 ? round(max(0, (datum.cycle))) + 's' : round((datum.cycle)) < 3600 ? floor(round((datum.cycle)) / 60) + 'm ' + pad('' + (round((datum.cycle)) % 60), 2, '0', 'left') + 's' : floor(round((datum.cycle)) / 3600) + 'h ' + pad('' + floor((round((datum.cycle)) % 3600) / 60), 2, '0', 'left') + 'm') : '–') : metric === 'throughput' ? (isValid((datum.c)) && isFinite((datum.c)) ? (abs((datum.c)) >= 1e6 ? format((datum.c) / 1e6, abs((datum.c)) >= 1e7 ? '.0f' : '.1f') + 'M' : abs((datum.c)) >= 1e3 ? format((datum.c) / 1e3, abs((datum.c)) >= 1e4 ? '.0f' : '.1f') + 'k' : format((datum.c), '.0f')) : '–') : format(datum.rate, '.1f') + '%'"
        },
        {
          "type": "formula",
          "as": "sub",
          "expr": "metric === 'time' ? (isValid((datum.c)) && isFinite((datum.c)) ? (abs((datum.c)) >= 1e6 ? format((datum.c) / 1e6, abs((datum.c)) >= 1e7 ? '.0f' : '.1f') + 'M' : abs((datum.c)) >= 1e3 ? format((datum.c) / 1e3, abs((datum.c)) >= 1e4 ? '.0f' : '.1f') + 'k' : format((datum.c), '.0f')) : '–') + ' cases' : metric === 'exrate' ? (isValid((datum.e)) && isFinite((datum.e)) ? format((datum.e), ',.0f') : '–') + ' exc' : ''"
        },
        {
          "type": "formula",
          "as": "color",
          "expr": "metric === 'exrate' ? '#FF222F' : '#0B3239'"
        },
        {
          "type": "collect",
          "sort": {
            "field": "value",
            "order": "descending"
          }
        }
      ]
    },
    {
      "name": "hb_rows",
      "source": "bars",
      "transform": [
        {
          "type": "window",
          "ops": [
            "row_number"
          ],
          "as": [
            "rank"
          ]
        },
        {
          "type": "filter",
          "expr": "datum.rank <= hb_fit"
        }
      ]
    }
  ],
  "scales": [
    {
      "name": "hb_x",
      "type": "linear",
      "domain": {
        "data": "bars",
        "field": "value"
      },
      "range": [
        0,
        {
          "signal": "cw - 246"
        }
      ],
      "zero": true,
      "nice": false
    }
  ],
  "marks": [
    {
      "type": "text",
      "name": "frame_title",
      "encode": {
        "update": {
          "x": {
            "value": 16
          },
          "y": {
            "value": 16
          },
          "baseline": {
            "value": "top"
          },
          "font": {
            "value": "Georgia, Gelasio, 'Times New Roman', serif"
          },
          "fontSize": {
            "value": 16
          },
          "fontWeight": {
            "value": "bold"
          },
          "fill": {
            "value": "#0B3239"
          },
          "text": {
            "value": "Process performance"
          },
          "limit": {
            "signal": "width - 32"
          }
        }
      }
    },
    {
      "type": "text",
      "encode": {
        "update": {
          "x": {
            "value": 16
          },
          "y": {
            "value": 38
          },
          "baseline": {
            "value": "top"
          },
          "font": {
            "value": "Calibri, Carlito, 'Segoe UI', Inter, Arial, sans-serif"
          },
          "fontSize": {
            "value": 12
          },
          "fill": {
            "value": "#5A7378"
          },
          "text": {
            "signal": "metric === 'time' ? 'Average digital-worker runtime per case, longest first' : metric === 'throughput' ? 'Completed cases per process' : 'Share of attempts ending in an exception'"
          },
          "limit": {
            "signal": "width - 32"
          }
        }
      }
    },
    {
      "type": "rect",
      "encode": {
        "update": {
          "x": {
            "signal": "width - 16 - 336"
          },
          "y": {
            "value": 14
          },
          "width": {
            "value": 336
          },
          "height": {
            "value": 30
          },
          "cornerRadius": {
            "value": 8
          },
          "fill": {
            "value": "#F1EEE8"
          },
          "stroke": {
            "value": "#DCDCD7"
          }
        }
      }
    },
    {
      "type": "rect",
      "name": "seg_metric_0",
      "encode": {
        "update": {
          "x": {
            "signal": "width - 16 - 336 + 3"
          },
          "y": {
            "value": 17
          },
          "width": {
            "value": 138
          },
          "height": {
            "value": 24
          },
          "cornerRadius": {
            "value": 6
          },
          "fill": {
            "signal": "metric === 'time' ? '#FAF7F2' : 'transparent'"
          },
          "stroke": {
            "signal": "metric === 'time' ? '#DCDCD7' : 'transparent'"
          },
          "cursor": {
            "value": "pointer"
          }
        }
      }
    },
    {
      "type": "text",
      "interactive": false,
      "encode": {
        "update": {
          "x": {
            "signal": "width - 16 - 336 + 3 + 69"
          },
          "y": {
            "value": 29
          },
          "align": {
            "value": "center"
          },
          "baseline": {
            "value": "middle"
          },
          "font": {
            "value": "Calibri, Carlito, 'Segoe UI', Inter, Arial, sans-serif"
          },
          "fontSize": {
            "value": 12
          },
          "fontWeight": {
            "signal": "metric === 'time' ? 'bold' : 'normal'"
          },
          "fill": {
            "signal": "metric === 'time' ? '#0B3239' : '#5A7378'"
          },
          "text": {
            "value": "Avg completion time"
          }
        }
      }
    },
    {
      "type": "rect",
      "name": "seg_metric_1",
      "encode": {
        "update": {
          "x": {
            "signal": "width - 16 - 336 + 141"
          },
          "y": {
            "value": 17
          },
          "width": {
            "value": 84
          },
          "height": {
            "value": 24
          },
          "cornerRadius": {
            "value": 6
          },
          "fill": {
            "signal": "metric === 'throughput' ? '#FAF7F2' : 'transparent'"
          },
          "stroke": {
            "signal": "metric === 'throughput' ? '#DCDCD7' : 'transparent'"
          },
          "cursor": {
            "value": "pointer"
          }
        }
      }
    },
    {
      "type": "text",
      "interactive": false,
      "encode": {
        "update": {
          "x": {
            "signal": "width - 16 - 336 + 141 + 42"
          },
          "y": {
            "value": 29
          },
          "align": {
            "value": "center"
          },
          "baseline": {
            "value": "middle"
          },
          "font": {
            "value": "Calibri, Carlito, 'Segoe UI', Inter, Arial, sans-serif"
          },
          "fontSize": {
            "value": 12
          },
          "fontWeight": {
            "signal": "metric === 'throughput' ? 'bold' : 'normal'"
          },
          "fill": {
            "signal": "metric === 'throughput' ? '#0B3239' : '#5A7378'"
          },
          "text": {
            "value": "Throughput"
          }
        }
      }
    },
    {
      "type": "rect",
      "name": "seg_metric_2",
      "encode": {
        "update": {
          "x": {
            "signal": "width - 16 - 336 + 225"
          },
          "y": {
            "value": 17
          },
          "width": {
            "value": 108
          },
          "height": {
            "value": 24
          },
          "cornerRadius": {
            "value": 6
          },
          "fill": {
            "signal": "metric === 'exrate' ? '#FAF7F2' : 'transparent'"
          },
          "stroke": {
            "signal": "metric === 'exrate' ? '#DCDCD7' : 'transparent'"
          },
          "cursor": {
            "value": "pointer"
          }
        }
      }
    },
    {
      "type": "text",
      "interactive": false,
      "encode": {
        "update": {
          "x": {
            "signal": "width - 16 - 336 + 225 + 54"
          },
          "y": {
            "value": 29
          },
          "align": {
            "value": "center"
          },
          "baseline": {
            "value": "middle"
          },
          "font": {
            "value": "Calibri, Carlito, 'Segoe UI', Inter, Arial, sans-serif"
          },
          "fontSize": {
            "value": 12
          },
          "fontWeight": {
            "signal": "metric === 'exrate' ? 'bold' : 'normal'"
          },
          "fill": {
            "signal": "metric === 'exrate' ? '#0B3239' : '#5A7378'"
          },
          "text": {
            "value": "Exception rate"
          }
        }
      }
    },
    {
      "type": "group",
      "name": "hb_row",
      "from": {
        "data": "hb_rows"
      },
      "encode": {
        "update": {
          "x": {
            "value": 16
          },
          "y": {
            "signal": "top + (datum.rank - 1) * 25"
          },
          "width": {
            "signal": "cw"
          },
          "height": {
            "value": 25
          },
          "fill": {
            "value": "transparent"
          },
          "cursor": {
            "value": "pointer"
          },
          "opacity": {
            "value": 1
          }
        }
      },
      "marks": [
        {
          "type": "text",
          "encode": {
            "update": {
              "x": {
                "value": 0
              },
              "y": {
                "value": 12.5
              },
              "baseline": {
                "value": "middle"
              },
              "font": {
                "value": "Calibri, Carlito, 'Segoe UI', Inter, Arial, sans-serif"
              },
              "fontSize": {
                "value": 13
              },
              "fill": {
                "value": "#0B3239"
              },
              "text": {
                "field": {
                  "parent": "label"
                }
              },
              "limit": {
                "value": 150
              }
            }
          }
        },
        {
          "type": "rect",
          "encode": {
            "update": {
              "x": {
                "value": 160
              },
              "y": {
                "value": 5.5
              },
              "width": {
                "signal": "cw - 246"
              },
              "height": {
                "value": 14
              },
              "fill": {
                "value": "#E4E3DE"
              },
              "cornerRadius": {
                "value": 3
              }
            }
          }
        },
        {
          "type": "rect",
          "encode": {
            "update": {
              "x": {
                "value": 160
              },
              "y": {
                "value": 5.5
              },
              "width": {
                "signal": "max(2, scale('hb_x', parent.value))"
              },
              "height": {
                "value": 14
              },
              "fill": {
                "field": {
                  "parent": "color"
                }
              },
              "cornerRadius": {
                "value": 3
              },
              "tooltip": {
                "signal": "{'': parent.label, 'Value': parent.display}"
              }
            }
          }
        },
        {
          "type": "text",
          "encode": {
            "update": {
              "x": {
                "signal": "cw - 92"
              },
              "y": {
                "value": 12.5
              },
              "align": {
                "value": "right"
              },
              "baseline": {
                "value": "middle"
              },
              "font": {
                "value": "'JetBrains Mono', 'Roboto Mono', Consolas, 'Courier New', monospace"
              },
              "fontSize": {
                "value": 10
              },
              "fill": {
                "value": "#5A7378"
              },
              "text": {
                "signal": "parent.sub || ''"
              }
            }
          }
        },
        {
          "type": "text",
          "encode": {
            "update": {
              "x": {
                "signal": "cw"
              },
              "y": {
                "value": 12.5
              },
              "align": {
                "value": "right"
              },
              "baseline": {
                "value": "middle"
              },
              "font": {
                "value": "'JetBrains Mono', 'Roboto Mono', Consolas, 'Courier New', monospace"
              },
              "fontSize": {
                "value": 12
              },
              "fontWeight": {
                "value": "bold"
              },
              "fill": {
                "value": "#0B3239"
              },
              "text": {
                "field": {
                  "parent": "display"
                }
              }
            }
          }
        }
      ]
    },
    {
      "type": "text",
      "encode": {
        "update": {
          "x": {
            "signal": "width - 16"
          },
          "y": {
            "signal": "top + ch - 4"
          },
          "align": {
            "value": "right"
          },
          "font": {
            "value": "'JetBrains Mono', 'Roboto Mono', Consolas, 'Courier New', monospace"
          },
          "fontSize": {
            "value": 10
          },
          "fill": {
            "value": "#5A7378"
          },
          "text": {
            "signal": "length(data('bars')) > hb_fit ? '+' + (length(data('bars')) - hb_fit) + ' more' : ''"
          }
        }
      }
    }
  ]
}
