          }
        }
      }
    },
    {
      "type": "text",
      "interactive": false,
      "encode": {
        "update": {
          "x": {
            "signal": "width - 16 - 126 + 3 + 27"
          },
          "y": {
            "value": 29
          },
          "align": {
            "value": "center"
          },
          "baseline": {
            "value": "middle"
          },
          "font": {
            "value": "Calibri, Carlito, 'Segoe UI', Inter, Arial, sans-serif"
          },
          "fontSize": {
            "value": 12
          },
          "fontWeight": {
            "signal": "grain === 'daily' ? 'bold' : 'normal'"
          },
          "fill": {
