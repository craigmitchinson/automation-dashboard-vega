{
  "$schema": "https://vega.github.io/schema/vega/v5.json",
  "description": "IA · Process Analysis · Exception time trend. Generated by vega/build.mjs from vega/panels/process-analysis.mjs, do not edit by hand.",
  "autosize": {
    "type": "fit",
    "contains": "padding"
  },
  "padding": 0,
  "config": {
    "background": "#FAF7F2",
    "padding": 0,
    "font": "Calibri, Carlito, 'Segoe UI', Inter, Arial, sans-serif",
    "text": {
      "font": "Calibri, Carlito, 'Segoe UI', Inter, Arial, sans-serif",
      "fill": "#0B3239",
      "fontSize": 12
    },
    "axis": {
      "labelFont": "'JetBrains Mono', 'Roboto Mono', Consolas, 'Courier New', monospace",
      "labelFontSize": 10,
      "labelColor": "#5A7378",
      "titleFont": "'JetBrains Mono', 'Roboto Mono', Consolas, 'Courier New', monospace",
      "titleColor": "#5A7378",
      "titleFontSize": 10,
      "titleFontWeight": 400,
      "domain": false,
      "ticks": false,
      "gridColor": "#DCDCD7",
      "gridWidth": 1,
      "labelPadding": 6
    },
    "style": {
      "guide-label": {
        "font": "'JetBrains Mono', 'Roboto Mono', Consolas, 'Courier New', monospace"
      }
    },
    "view": {
      "stroke": null
    },
    "kibana": {
      "renderer": "svg",
      "hideWarnings": true
    }
  },
  "signals": [
    {
      "name": "ndays",
      "update": "length(data('win'))"
    },
    {
      "name": "lo",
      "update": "ndays ? data('win')[0].key : 0"
    },
    {
      "name": "hi",
      "update": "ndays ? data('win')[ndays - 1].key : 0"
    },
    {
      "name": "plo",
      "update": "lo - ndays * 86400000"
    },
    {
      "name": "phi",
      "update": "lo - 86400000"
    },
    {
      "name": "top",
      "value": 78
    },
    {
      "name": "cw",
      "update": "width - 32"
    },
    {
      "name": "ch",
      "update": "height - top - 16"
    },
    {
      "name": "grain",
      "value": "daily",
      "on": [
        {
          "events": "@seg_grain_0:click",
          "update": "'daily'"
        },
        {
          "events": "@seg_grain_1:click",
          "update": "'monthly'"
        }
      ]
    },
    {
      "name": "chart_ymax",
      "update": "max(extent(pluck(data('flow'), 's'))[1] || 0, extent(pluck(data('flow'), 'b'))[1] || 0, 0)"
    }
  ],
  "data": [
    {
      "name": "raw",
      "url": {
        "index": "ia-workqueue-items",
        "body": {
          "size": 0,
          "query": {
            "bool": {
              "must": [
                "%dashboard_context-must_clause%",
                {
                  "range": {
                    "@timestamp": {
                      "gte": {
                        "%timefilter%": "min",
                        "shift": -732,
                        "unit": "day"
                      },
                      "lte": {
                        "%timefilter%": "max"
                      },
                      "format": "epoch_millis"
                    }
                  }
                },
                {
                  "term": {
                    "mapped": true
                  }
                }
              ],
              "filter": [
                "%dashboard_context-filter_clause%"
              ],
              "must_not": [
                "%dashboard_context-must_not_clause%"
              ]
            }
          },
          "aggs": {
            "win": {
              "filter": {
                "range": {
                  "@timestamp": {
                    "%timefilter%": true
                  }
                }
              },
              "aggs": {
                "d": {
                  "date_histogram": {
                    "field": "@timestamp",
                    "fixed_interval": "1d",
                    "min_doc_count": 0,
                    "extended_bounds": {
                      "min": {
                        "%timefilter%": "min"
                      },
                      "max": {
                        "%timefilter%": "max"
                      }
                    }
                  }
                }
              }
            },
            "days": {
              "date_histogram": {
                "field": "@timestamp",
                "fixed_interval": "1d",
                "min_doc_count": 1
              },
              "aggs": {
                "b": {
                  "sum": {
                    "field": "n.business"
                  }
                },
                "s": {
                  "sum": {
                    "field": "n.system"
                  }
                }
              }
            }
          }
        }
      },
      "format": {
        "property": "aggregations"
      }
    },
    {
      "name": "win",
      "source": "raw",
      "transform": [
        {
          "type": "flatten",
          "fields": [
            "win.d.buckets"
          ],
          "as": [
            "_bk"
          ]
        },
        {
          "type": "formula",
          "as": "key",
          "expr": "datum._bk.key"
        },
        {
          "type": "formula",
          "as": "n",
          "expr": "datum._bk.doc_count"
        },
        {
          "type": "project",
          "fields": [
            "key",
            "n"
          ]
        }
      ]
    },
    {
      "name": "days",
      "source": "raw",
      "transform": [
        {
          "type": "flatten",
          "fields": [
            "days.buckets"
          ],
          "as": [
            "_bk"
          ]
        },
        {
          "type": "formula",
          "as": "key",
          "expr": "datum._bk.key"
        },
        {
          "type": "formula",
          "as": "n",
          "expr": "datum._bk.doc_count"
        },
        {
          "type": "formula",
          "as": "b",
          "expr": "datum._bk[\"b\"] ? (datum._bk[\"b\"].value || 0) : 0"
        },
        {
          "type": "formula",
          "as": "s",
          "expr": "datum._bk[\"s\"] ? (datum._bk[\"s\"].value || 0) : 0"
        },
        {
          "type": "project",
          "fields": [
            "key",
            "n",
            "b",
            "s"
          ]
        }
      ]
    },
    {
      "name": "series",
      "source": "win",
      "transform": [
        {
          "type": "lookup",
          "from": "days",
          "key": "key",
          "fields": [
            "key"
          ],
          "as": [
            "d"
          ]
        },
        {
          "type": "formula",
          "as": "t",
          "expr": "datum.key"
        },
        {
          "type": "formula",
          "as": "b",
          "expr": "datum.d ? datum.d.b : 0"
        },
        {
          "type": "formula",
          "as": "s",
          "expr": "datum.d ? datum.d.s : 0"
        }
      ]
    },
    {
      "name": "tot",
      "source": "days",
      "transform": [
        {
          "type": "formula",
          "as": "cur_b",
          "expr": "datum.key >= lo && datum.key <= hi ? datum.b : 0"
        },
        {
          "type": "formula",
          "as": "prev_b",
          "expr": "datum.key >= plo && datum.key <= phi ? datum.b : 0"
        },
        {
          "type": "formula",
          "as": "cur_s",
          "expr": "datum.key >= lo && datum.key <= hi ? datum.s : 0"
        },
        {
          "type": "formula",
          "as": "prev_s",
          "expr": "datum.key >= plo && datum.key <= phi ? datum.s : 0"
        },
        {
          "type": "aggregate",
          "ops": [
            "sum",
            "sum",
            "sum",
            "sum"
          ],
          "fields": [
            "cur_b",
            "prev_b",
            "cur_s",
            "prev_s"
          ],
          "as": [
            "cur_b",
            "prev_b",
            "cur_s",
            "prev_s"
          ]
        }
      ]
    },
    {
      "name": "flow",
      "source": "series",
      "transform": [
        {
          "type": "formula",
          "as": "g",
          "expr": "grain === 'monthly' ? utc(utcyear(datum.t), utcmonth(datum.t), 1) : datum.t"
        },
        {
          "type": "aggregate",
          "groupby": [
            "g"
          ],
          "ops": [
            "sum",
            "sum"
          ],
          "fields": [
            "b",
            "s"
          ],
          "as": [
            "b",
            "s"
          ]
        },
        {
          "type": "formula",
          "as": "t",
          "expr": "datum.g"
        },
        {
          "type": "collect",
          "sort": {
            "field": "t"
          }
        }
      ]
    }
  ],
  "scales": [
    {
      "name": "chart_x",
      "type": "utc",
      "domain": {
        "data": "flow",
        "field": "t"
      },
      "range": [
        0,
        {
          "signal": "cw - 44"
        }
      ]
    },
    {
      "name": "chart_y",
      "type": "linear",
      "domain": {
        "signal": "[0, max(0, chart_ymax)]"
      },
      "range": [
        {
          "signal": "ch - 22"
        },
        0
      ],
      "nice": true,
      "zero": true
    }
  ],
  "marks": [
    {
      "type": "text",
      "name": "frame_title",
      "encode": {
        "update": {
          "x": {
            "value": 16
          },
          "y": {
            "value": 16
          },
          "baseline": {
            "value": "top"
          },
          "font": {
            "value": "Georgia, Gelasio, 'Times New Roman', serif"
          },
          "fontSize": {
            "value": 16
          },
          "fontWeight": {
            "value": "bold"
          },
          "fill": {
            "value": "#0B3239"
          },
          "text": {
            "value": "Exception time trend"
          },
          "limit": {
            "signal": "width - 32"
          }
        }
      }
    },
    {
      "type": "text",
      "encode": {
        "update": {
          "x": {
            "value": 16
          },
          "y": {
            "value": 38
          },
          "baseline": {
            "value": "top"
          },
          "font": {
            "value": "Calibri, Carlito, 'Segoe UI', Inter, Arial, sans-serif"
          },
          "fontSize": {
            "value": 12
          },
          "fill": {
            "value": "#5A7378"
          },
          "text": {
            "value": "Exception volume over time, system vs business"
          },
          "limit": {
            "signal": "width - 32"
          }
        }
      }
    },
    {
      "type": "rect",
      "encode": {
        "update": {
          "x": {
