          }
        }
      }
    },
    {
      "type": "rect",
      "encode": {
        "update": {
          "x": {
            "signal": "width - 16 - 126"
          },
          "y": {
            "value": 14
          },
          "width": {
            "value": 126
          },
          "height": {
            "value": 30
          },
          "cornerRadius": {
            "value": 8
          },
          "fill": {
            "value": "#F1EEE8"
          },
          "stroke": {
            "value": "#DCDCD7"
          }
        }
      }
    },
    {
      "type": "rect",
      "name": "seg_grain_0",
      "encode": {
        "update": {
          "x": {
            "signal": "width - 16 - 126 + 3"
          },
          "y": {
            "value": 17
          },
          "width": {
