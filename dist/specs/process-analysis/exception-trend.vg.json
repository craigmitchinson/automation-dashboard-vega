          },
          "stroke": {
            "signal": "grain === 'monthly' ? '#DCDCD7' : 'transparent'"
          },
          "cursor": {
            "value": "pointer"
          }
        }
      }
    },
    {
      "type": "text",
      "interactive": false,
      "encode": {
        "update": {
          "x": {
            "signal": "width - 16 - 126 + 57 + 33"
          },
          "y": {
            "value": 29
          },
          "align": {
            "value": "center"
          },
          "baseline": {
