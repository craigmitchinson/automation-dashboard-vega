          },
          "fill": {
            "value": "#5A7378"
          },
          "text": {
            "value": "System"
          }
        }
      }
    },
    {
      "type": "rect",
      "encode": {
        "update": {
          "x": {
            "signal": "85"
          },
          "y": {
