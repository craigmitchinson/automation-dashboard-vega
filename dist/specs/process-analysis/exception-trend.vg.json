          },
          "fontWeight": {
            "signal": "grain === 'monthly' ? 'bold' : 'normal'"
          },
          "fill": {
            "signal": "grain === 'monthly' ? '#0B3239' : '#5A7378'"
          },
          "text": {
            "value": "Monthly"
          }
        }
      }
    },
    {
      "type": "group",
      "name": "chart",
      "encode": {
        "update": {
          "x": {
            "value": 60
          },
          "y": {
            "signal": "top"
          },
          "width": {
            "signal": "cw - 44"
          },
          "height": {
            "signal": "ch - 22"
          }
        }
      },
      "axes": [
        {
          "scale": "chart_y",
          "orient": "left",
          "grid": true,
          "tickCount": 5,
          "labelPadding": 8,
          "encode": {
            "labels": {
              "update": {
                "text": {
                  "signal": "(isValid((datum.value)) && isFinite((datum.value)) ? (abs((datum.value)) >= 1e6 ? format((datum.value) / 1e6, abs((datum.value)) >= 1e7 ? '.0f' : '.1f') + 'M' : abs((datum.value)) >= 1e3 ? format((datum.value) / 1e3, abs((datum.value)) >= 1e4 ? '.0f' : '.1f') + 'k' : format((datum.value), '.0f')) : '–')"
                }
              }
            }
          },
          "zindex": 0
        },
        {
          "scale": "chart_x",
          "orient": "bottom",
          "tickCount": {
            "signal": "min(10, max(2, floor((cw - 44) / 70)))"
          },
          "labelOverlap": true,
          "labelPadding": 6,
          "encode": {
            "labels": {
              "update": {
                "text": {
                  "signal": "grain === 'monthly' ? utcFormat((datum.value), '%b %y') : utcFormat((datum.value), '%d %b')"
                }
              }
            }
          }
        }
      ],
      "marks": [
        {
          "type": "area",
          "from": {
            "data": "flow"
          },
          "encode": {
            "update": {
              "x": {
                "scale": "chart_x",
                "field": "t"
              },
              "y": {
                "scale": "chart_y",
                "field": "s"
              },
              "y2": {
                "scale": "chart_y",
                "value": 0
              },
              "fill": {
                "value": "#FF222F"
              },
              "fillOpacity": {
                "value": 0.1
              },
              "interpolate": {
                "value": "linear"
              }
            }
          }
        },
        {
          "type": "line",
          "from": {
            "data": "flow"
          },
          "encode": {
            "update": {
              "x": {
                "scale": "chart_x",
                "field": "t"
              },
              "y": {
                "scale": "chart_y",
                "field": "s"
              },
              "stroke": {
                "value": "#FF222F"
              },
              "strokeWidth": {
                "value": 1.8
              },
              "strokeJoin": {
                "value": "round"
              },
              "interpolate": {
                "value": "linear"
              },
              "defined": {
                "signal": "isValid(datum['s'])"
              }
            }
          }
        },
        {
          "type": "line",
          "from": {
            "data": "flow"
          },
          "encode": {
            "update": {
              "x": {
                "scale": "chart_x",
                "field": "t"
              },
              "y": {
                "scale": "chart_y",
                "field": "b"
              },
              "stroke": {
                "value": "#8A6FB0"
              },
              "strokeWidth": {
                "value": 1.8
              },
              "strokeJoin": {
                "value": "round"
              },
              "interpolate": {
                "value": "linear"
              },
              "defined": {
                "signal": "isValid(datum['b'])"
              }
            }
          }
        },
        {
          "type": "rect",
          "name": "chart_hover",
          "from": {
            "data": "flow"
          },
          "encode": {
            "update": {
              "x": {
                "signal": "scale('chart_x', datum.t) - max(2, (cw - 44) / max(1, length(data('flow'))) / 2)"
              },
              "width": {
                "signal": "max(4, (cw - 44) / max(1, length(data('flow'))))"
              },
              "y": {
                "value": 0
              },
              "y2": {
                "signal": "ch - 22"
              },
              "fill": {
                "value": "#0B3239"
              },
              "fillOpacity": {
                "value": 0
              },
              "tooltip": {
                "signal": "{'Date': grain === 'monthly' ? utcFormat((datum.t), '%b %y') : utcFormat((datum.t), '%-d %b %Y'), 'System exception': (isValid((datum['s'])) && isFinite((datum['s'])) ? format((datum['s']), ',.0f') : '–'), 'Business exception': (isValid((datum['b'])) && isFinite((datum['b'])) ? format((datum['b']), ',.0f') : '–')}"
              }
            },
            "hover": {
              "fillOpacity": {
                "value": 0.06
              }
            }
          }
        }
      ]
    }
  ]
}
