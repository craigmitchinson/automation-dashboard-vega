          },
          "width": {
            "value": 11
          },
          "height": {
            "value": 11
          },
          "cornerRadius": {
            "value": 3
          },
          "fill": {
            "value": "#8A6FB0"
          }
        }
      }
    },
    {
      "type": "text",
      "encode": {
        "update": {
          "x": {
