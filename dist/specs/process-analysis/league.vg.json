{
  "$schema": "https://vega.github.io/schema/vega/v5.json",
  "description": "IA · Process Analysis · Process league table. Generated by vega/build.mjs from vega/panels/process-analysis.mjs, do not edit by hand.",
  "autosize": {
    "type": "fit",
    "contains": "padding"
  },
  "padding": 0,
  "config": {
    "background": "#FFFFFF",
    "padding": 0,
    "font": "Inter, 'Segoe UI', Carlito, Calibri, Arial, sans-serif",
    "text": {
      "font": "Inter, 'Segoe UI', Carlito, Calibri, Arial, sans-serif",
      "fill": "#0F4D43",
      "fontSize": 12
    },
    "axis": {
      "gridColor": "#E6E8E2",
      "labelFont": "'JetBrains Mono', Consolas, 'Roboto Mono', monospace",
      "labelFontSize": 10,
      "labelColor": "#5F6E69",
      "titleFont": "'JetBrains Mono', Consolas, 'Roboto Mono', monospace",
      "titleColor": "#5F6E69",
      "titleFontSize": 10,
      "titleFontWeight": 400,
      "domain": false,
      "ticks": false,
      "gridWidth": 1,
      "labelPadding": 6
    },
    "style": {
      "guide-label": {
        "font": "'JetBrains Mono', Consolas, 'Roboto Mono', monospace"
      }
    },
    "view": {
      "stroke": null
    },
    "kibana": {
      "renderer": "svg",
      "hideWarnings": true
    }
  },
  "signals": [
    {
      "name": "oneSpoke",
      "update": "length(data('scope_spokes')) === 1 ? data('scope_spokes')[0].key : ''"
    },
    {
      "name": "tgt_completionPct",
      "update": "oneSpoke && indexof(pluck(data('tg'), 'k'), 'spoke|' + oneSpoke + '|completionPct') >= 0 ? data('tg')[indexof(pluck(data('tg'), 'k'), 'spoke|' + oneSpoke + '|completionPct')].v : (indexof(pluck(data('tg'), 'k'), 'global|completionPct') >= 0 ? data('tg')[indexof(pluck(data('tg'), 'k'), 'global|completionPct')].v : 0.95)"
    },
    {
      "name": "tgt_exceptionRate",
      "update": "oneSpoke && indexof(pluck(data('tg'), 'k'), 'spoke|' + oneSpoke + '|exceptionRate') >= 0 ? data('tg')[indexof(pluck(data('tg'), 'k'), 'spoke|' + oneSpoke + '|exceptionRate')].v : (indexof(pluck(data('tg'), 'k'), 'global|exceptionRate') >= 0 ? data('tg')[indexof(pluck(data('tg'), 'k'), 'global|exceptionRate')].v : 0.06)"
    },
    {
      "name": "tgt_systemRate",
      "update": "oneSpoke && indexof(pluck(data('tg'), 'k'), 'spoke|' + oneSpoke + '|systemRate') >= 0 ? data('tg')[indexof(pluck(data('tg'), 'k'), 'spoke|' + oneSpoke + '|systemRate')].v : (indexof(pluck(data('tg'), 'k'), 'global|systemRate') >= 0 ? data('tg')[indexof(pluck(data('tg'), 'k'), 'global|systemRate')].v : 0.03)"
    },
    {
      "name": "tgt_costPerCase",
      "update": "oneSpoke && indexof(pluck(data('tg'), 'k'), 'spoke|' + oneSpoke + '|costPerCase') >= 0 ? data('tg')[indexof(pluck(data('tg'), 'k'), 'spoke|' + oneSpoke + '|costPerCase')].v : (indexof(pluck(data('tg'), 'k'), 'global|costPerCase') >= 0 ? data('tg')[indexof(pluck(data('tg'), 'k'), 'global|costPerCase')].v : 9)"
    },
    {
      "name": "tgt_utilMin",
      "update": "oneSpoke && indexof(pluck(data('tg'), 'k'), 'spoke|' + oneSpoke + '|utilMin') >= 0 ? data('tg')[indexof(pluck(data('tg'), 'k'), 'spoke|' + oneSpoke + '|utilMin')].v : (indexof(pluck(data('tg'), 'k'), 'global|utilMin') >= 0 ? data('tg')[indexof(pluck(data('tg'), 'k'), 'global|utilMin')].v : 0.15)"
    },
    {
      "name": "tgt_utilMax",
      "update": "oneSpoke && indexof(pluck(data('tg'), 'k'), 'spoke|' + oneSpoke + '|utilMax') >= 0 ? data('tg')[indexof(pluck(data('tg'), 'k'), 'spoke|' + oneSpoke + '|utilMax')].v : (indexof(pluck(data('tg'), 'k'), 'global|utilMax') >= 0 ? data('tg')[indexof(pluck(data('tg'), 'k'), 'global|utilMax')].v : 0.6)"
    },
    {
      "name": "tgt_vdiStaleDays",
      "update": "oneSpoke && indexof(pluck(data('tg'), 'k'), 'spoke|' + oneSpoke + '|vdiStaleDays') >= 0 ? data('tg')[indexof(pluck(data('tg'), 'k'), 'spoke|' + oneSpoke + '|vdiStaleDays')].v : (indexof(pluck(data('tg'), 'k'), 'global|vdiStaleDays') >= 0 ? data('tg')[indexof(pluck(data('tg'), 'k'), 'global|vdiStaleDays')].v : 14)"
    },
    {
      "name": "cfg_fyStart",
      "update": "length(data('ref_config')) ? data('ref_config')[0]._source.fiscal_year_start_month : 4"
    },
    {
      "name": "cfg_warn",
      "update": "length(data('ref_config')) ? data('ref_config')[0]._source.warn_margin : 0.1"
    },
    {
      "name": "headerRight",
      "value": 0
    },
    {
      "name": "top",
      "value": 42
    },
    {
      "name": "cw",
      "update": "width - 32"
    },
    {
      "name": "ch",
      "update": "height - top - 16"
    },
    {
      "name": "pick",
      "on": [
        {
          "events": "@tb_row:click",
          "update": "kibanaAddFilter({'match_phrase': {'process.name': datum.name}}, 'ia-workqueue-items*')"
        }
      ]
    },
    {
      "name": "tb_fit",
      "update": "max(0, floor((ch - 26 - 0 - 14) / 26))"
    },
    {
      "name": "tb_rh",
      "update": "clamp((ch - 26 - 0 - 14) / max(1, length(data('lg'))), 26, 42)"
    },
    {
      "name": "tb_sortKey",
      "value": "ec",
      "on": [
        {
          "events": {
            "signal": "tb_sortClick"
          },
          "update": "tb_sortClick"
        }
      ]
    },
    {
      "name": "tb_sortDir",
      "value": "descending",
      "on": [
        {
          "events": {
            "signal": "tb_sortClick"
          },
          "update": "tb_sortClick === tb_sortKey ? (tb_sortDir === 'descending' ? 'ascending' : 'descending') : 'descending'"
        }
      ]
    },
    {
      "name": "tb_sortClick",
      "on": [
        {
          "events": "@tb_head1:click, @tb_head3:click, @tb_head4:click, @tb_head5:click, @tb_head6:click, @tb_head7:click, @tb_head8:click",
          "update": "datum.sortKey"
        }
      ]
    }
  ],
  "data": [
    {
      "name": "procs_raw",
      "url": {
        "index": "ia-reference",
        "body": {
          "size": 500,
          "query": {
            "term": {
              "doc_type": "process"
            }
          }
        }
      },
      "format": {
        "property": "hits.hits"
      }
    },
    {
      "name": "procs",
      "source": "procs_raw",
      "transform": [
        {
          "type": "formula",
          "as": "name",
          "expr": "datum._source.process.name"
        },
        {
          "type": "formula",
          "as": "pid",
          "expr": "datum._source.process.id"
        },
        {
          "type": "formula",
          "as": "acronym",
          "expr": "datum._source.process.acronym"
        },
        {
          "type": "formula",
          "as": "spoke",
          "expr": "datum._source.spoke.name"
        },
        {
          "type": "formula",
          "as": "spokeColor",
          "expr": "datum._source.spoke.color"
        },
        {
          "type": "formula",
          "as": "proposition",
          "expr": "datum._source.proposition.name"
        },
        {
          "type": "formula",
          "as": "queue",
          "expr": "datum._source.primary_queue"
        },
        {
          "type": "formula",
          "as": "queues",
          "expr": "join(datum._source.queues, ' → ')"
        },
        {
          "type": "formula",
          "as": "description",
          "expr": "datum._source.process.description"
        },
        {
          "type": "formula",
          "as": "tags",
          "expr": "datum._source.process.tags"
        },
        {
          "type": "formula",
          "as": "smv",
          "expr": "datum._source.process.smv_minutes"
        },
        {
          "type": "formula",
          "as": "grade",
          "expr": "datum._source.process.grade"
        },
        {
          "type": "formula",
          "as": "gradeName",
          "expr": "datum._source.process.grade_name"
        },
        {
          "type": "formula",
          "as": "rate",
          "expr": "datum._source.process.current_rate_gbp"
        },
        {
          "type": "formula",
          "as": "slaHours",
          "expr": "datum._source.process.sla_hours"
        }
      ]
    },
    {
      "name": "ref_targets",
      "url": {
        "index": "ia-reference",
        "body": {
          "size": 200,
          "query": {
            "term": {
              "doc_type": "target"
            }
          }
        }
      },
      "format": {
        "property": "hits.hits"
      }
    },
    {
      "name": "tg",
      "source": "ref_targets",
      "transform": [
        {
          "type": "formula",
          "as": "k",
          "expr": "datum._source.scope === 'global' ? 'global|' + datum._source.metric : datum._source.scope + '|' + datum._source.scope_id + '|' + datum._source.metric"
        },
        {
          "type": "formula",
          "as": "v",
          "expr": "datum._source.value"
        }
      ]
    },
    {
      "name": "ref_config",
      "url": {
        "index": "ia-reference",
        "body": {
          "size": 1,
          "query": {
            "term": {
              "doc_type": "config"
            }
          }
        }
      },
      "format": {
        "property": "hits.hits"
      }
    },
    {
      "name": "scope_spokes",
      "url": {
        "%context%": true,
        "%timefield%": "@timestamp",
        "index": "ia-workqueue-items",
        "body": {
          "size": 0,
          "aggs": {
            "m": {
              "filter": {
                "term": {
                  "mapped": true
                }
              },
              "aggs": {
                "s": {
                  "terms": {
                    "field": "spoke.name",
                    "size": 2
                  }
                }
              }
            }
          }
        }
      },
      "format": {
        "property": "aggregations.m.s.buckets"
      }
    },
    {
      "name": "bp_raw",
      "url": {
        "%context%": true,
        "%timefield%": "@timestamp",
        "index": "ia-workqueue-items",
        "body": {
          "size": 0,
          "aggs": {
            "m": {
              "filter": {
                "term": {
                  "mapped": true
                }
              },
              "aggs": {
                "p": {
                  "terms": {
                    "field": "process.name",
                    "size": 100
                  },
                  "aggs": {
                    "c": {
                      "sum": {
                        "field": "n.completed"
                      }
                    },
                    "a": {
                      "sum": {
                        "field": "n.attempt"
                      }
                    },
                    "e": {
                      "sum": {
                        "field": "n.exception"
                      }
                    },
                    "cw": {
                      "sum": {
                        "field": "worktime_completed_sec"
                      }
                    },
                    "ec": {
                      "sum": {
                        "field": "cost.estate_gbp"
                      }
                    },
                    "ta": {
                      "sum": {
                        "field": "turnaround_sec"
                      }
                    },
                    "sl": {
                      "sum": {
                        "field": "n.in_sla"
                      }
                    },
                    "f1": {
                      "sum": {
                        "field": "n.first"
                      }
                    },
                    "fo": {
                      "sum": {
                        "field": "n.first_ok"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      },
      "format": {
        "property": "aggregations.m.p.buckets"
      }
    },
    {
      "name": "bp",
      "source": "bp_raw",
      "transform": [
        {
          "type": "formula",
          "as": "name",
          "expr": "datum.key"
        },
        {
          "type": "formula",
          "as": "c",
          "expr": "datum['c'].value"
        },
        {
          "type": "formula",
          "as": "a",
          "expr": "datum['a'].value"
        },
        {
          "type": "formula",
          "as": "e",
          "expr": "datum['e'].value"
        },
        {
          "type": "formula",
          "as": "cw",
          "expr": "datum['cw'].value"
        },
        {
          "type": "formula",
          "as": "ec",
          "expr": "datum['ec'].value"
        },
        {
          "type": "formula",
          "as": "ta",
          "expr": "datum['ta'].value"
        },
        {
          "type": "formula",
          "as": "sl",
          "expr": "datum['sl'].value"
        },
        {
          "type": "formula",
          "as": "f1",
          "expr": "datum['f1'].value"
        },
        {
          "type": "formula",
          "as": "fo",
          "expr": "datum['fo'].value"
        },
        {
          "type": "lookup",
          "from": "procs",
          "key": "name",
          "fields": [
            "name"
          ],
          "as": [
            "ref"
          ]
        },
        {
          "type": "formula",
          "as": "spoke",
          "expr": "datum.ref ? datum.ref.spoke : ''"
        },
        {
          "type": "formula",
          "as": "spokeColor",
          "expr": "datum.ref ? datum.ref.spokeColor : '#5F6E69'"
        },
        {
          "type": "formula",
          "as": "queue",
          "expr": "datum.ref ? datum.ref.queue : ''"
        },
        {
          "type": "formula",
          "as": "proposition",
          "expr": "datum.ref ? datum.ref.proposition : ''"
        },
        {
          "type": "formula",
          "as": "slaHours",
          "expr": "datum.ref ? datum.ref.slaHours : null"
        }
      ]
    },
    {
      "name": "lg",
      "source": "bp",
      "transform": [
        {
          "type": "formula",
          "as": "cycle",
          "expr": "datum.c ? datum.cw / datum.c : 0"
        },
        {
          "type": "formula",
          "as": "turn",
          "expr": "datum.a ? datum.ta / datum.a : 0"
        },
        {
          "type": "formula",
          "as": "slaP",
          "expr": "datum.c ? datum.sl / datum.c : 0"
        },
        {
          "type": "formula",
          "as": "firstP",
          "expr": "datum.f1 ? datum.fo / datum.f1 : 0"
        },
        {
          "type": "formula",
          "as": "rate",
          "expr": "datum.a ? datum.e / datum.a : 0"
        },
        {
          "type": "formula",
          "as": "thin",
          "expr": "datum.a < 30"
        }
      ]
    },
    {
      "name": "tb_hd1",
      "values": [
        {
          "sortKey": "c"
        }
      ]
    },
    {
      "name": "tb_hd3",
      "values": [
        {
          "sortKey": "slaP"
        }
      ]
    },
    {
      "name": "tb_hd4",
      "values": [
        {
          "sortKey": "turn"
        }
      ]
    },
    {
      "name": "tb_hd5",
      "values": [
        {
          "sortKey": "firstP"
        }
      ]
    },
    {
      "name": "tb_hd6",
      "values": [
        {
          "sortKey": "cycle"
        }
      ]
    },
    {
      "name": "tb_hd7",
      "values": [
        {
          "sortKey": "rate"
        }
      ]
    },
    {
      "name": "tb_hd8",
      "values": [
        {
          "sortKey": "ec"
        }
      ]
    },
    {
      "name": "tb_rows",
      "source": "lg",
      "transform": [
        {
          "type": "collect",
          "sort": {
            "field": {
              "signal": "tb_sortKey"
            },
            "order": {
              "signal": "tb_sortDir"
            }
          }
        },
        {
          "type": "window",
          "ops": [
            "row_number"
          ],
          "as": [
            "rank"
          ]
        },
        {
          "type": "filter",
          "expr": "datum.rank <= tb_fit"
        }
      ]
    }
  ],
  "marks": [
    {
      "type": "text",
      "name": "frame_title",
      "encode": {
        "update": {
          "x": {
            "value": 16
          },
          "y": {
            "value": 18
          },
          "baseline": {
            "value": "top"
          },
          "font": {
            "value": "'JetBrains Mono', Consolas, 'Roboto Mono', monospace"
          },
          "fontSize": {
            "value": 11
          },
          "fontWeight": {
            "value": 600
          },
          "fill": {
            "value": "#0F4D43"
          },
          "text": {
            "signal": "'PROCESS LEAGUE TABLE'"
          },
          "limit": {
            "signal": "width - 32"
          }
        }
      }
    },
    {
      "type": "text",
      "encode": {
        "update": {
          "x": {
            "signal": "16 + length('PROCESS LEAGUE TABLE') * 6.9 + 10"
          },
          "y": {
            "value": 17
          },
          "baseline": {
            "value": "top"
          },
          "font": {
            "value": "Inter, 'Segoe UI', Carlito, Calibri, Arial, sans-serif"
          },
          "fontSize": {
            "value": 12
          },
          "fill": {
            "value": "#5F6E69"
          },
          "text": {
            "value": "Sorted by cost contribution · click a heading to sort, a row to filter"
          },
          "limit": {
            "signal": "width - 42 - length('PROCESS LEAGUE TABLE') * 6.9 - 0 - headerRight"
          }
        }
      }
    },
    {
      "type": "group",
      "encode": {
        "update": {
          "x": {
            "value": 16
          },
          "y": {
            "signal": "top"
          },
          "width": {
            "signal": "cw"
          },
          "height": {
            "value": 26
          }
        }
      },
      "marks": [
        {
          "type": "rule",
          "encode": {
            "update": {
              "x": {
                "value": 0
              },
              "x2": {
                "signal": "cw"
              },
              "y": {
                "value": 25.5
              },
              "stroke": {
                "value": "#D6D9D2"
              }
            }
          }
        },
        {
          "type": "text",
          "encode": {
            "update": {
              "x": {
                "signal": "0 + 10"
              },
              "y": {
                "value": 13
              },
              "align": {
                "value": "left"
              },
              "baseline": {
                "value": "middle"
              },
              "font": {
                "value": "'JetBrains Mono', Consolas, 'Roboto Mono', monospace"
              },
              "fontSize": {
                "value": 10
              },
              "fontWeight": {
                "value": 600
              },
              "fill": {
                "value": "#5F6E69"
              },
              "text": {
                "value": "PROCESS"
              },
              "limit": {
                "signal": "((cw - 624) / 1) - 12"
              }
            }
          }
        },
        {
          "type": "text",
          "name": "tb_head1",
          "from": {
            "data": "tb_hd1"
          },
          "encode": {
            "update": {
              "x": {
                "signal": "0 + ((cw - 624) / 1) + 70 - 10"
              },
              "y": {
                "value": 13
              },
              "align": {
                "value": "right"
              },
              "baseline": {
                "value": "middle"
              },
              "font": {
                "value": "'JetBrains Mono', Consolas, 'Roboto Mono', monospace"
              },
              "fontSize": {
                "value": 10
              },
              "fontWeight": {
                "value": 600
              },
              "fill": {
                "signal": "tb_sortKey === 'c' ? '#0F4D43' : '#5F6E69'"
              },
              "text": {
                "signal": "'ITEMS' + (tb_sortKey === 'c' ? (tb_sortDir === 'descending' ? ' ▾' : ' ▴') : '')"
              },
              "cursor": {
                "value": "pointer"
              },
              "limit": {
                "signal": "70 - 12"
              }
            }
          }
        },
        {
          "type": "text",
          "encode": {
            "update": {
              "x": {
                "signal": "0 + ((cw - 624) / 1) + 70 + 56 - 10"
              },
              "y": {
                "value": 13
              },
              "align": {
                "value": "right"
              },
              "baseline": {
                "value": "middle"
              },
              "font": {
                "value": "'JetBrains Mono', Consolas, 'Roboto Mono', monospace"
              },
              "fontSize": {
                "value": 10
              },
              "fontWeight": {
                "value": 600
              },
              "fill": {
                "value": "#5F6E69"
              },
              "text": {
                "value": "SLA"
              },
              "limit": {
                "signal": "56 - 12"
              }
            }
          }
        },
        {
          "type": "text",
          "name": "tb_head3",
          "from": {
            "data": "tb_hd3"
          },
          "encode": {
            "update": {
              "x": {
                "signal": "0 + ((cw - 624) / 1) + 70 + 56 + 92 - 10"
              },
              "y": {
                "value": 13
              },
              "align": {
                "value": "right"
              },
              "baseline": {
                "value": "middle"
              },
              "font": {
                "value": "'JetBrains Mono', Consolas, 'Roboto Mono', monospace"
              },
              "fontSize": {
                "value": 10
              },
              "fontWeight": {
                "value": 600
              },
              "fill": {
                "signal": "tb_sortKey === 'slaP' ? '#0F4D43' : '#5F6E69'"
              },
              "text": {
                "signal": "'WITHIN SLA' + (tb_sortKey === 'slaP' ? (tb_sortDir === 'descending' ? ' ▾' : ' ▴') : '')"
              },
              "cursor": {
                "value": "pointer"
              },
              "limit": {
                "signal": "92 - 12"
              }
            }
          }
        },
        {
          "type": "text",
          "name": "tb_head4",
          "from": {
            "data": "tb_hd4"
          },
          "encode": {
            "update": {
              "x": {
                "signal": "0 + ((cw - 624) / 1) + 70 + 56 + 92 + 92 - 10"
