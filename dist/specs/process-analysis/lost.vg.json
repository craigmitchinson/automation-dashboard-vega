              }
            }
          }
        }
      ]
    },
    {
      "type": "group",
      "name": "lt_row",
      "from": {
        "data": "lt_rows"
      },
      "encode": {
        "update": {
          "x": {
            "value": 16
          },
          "y": {
            "signal": "top + 26 + (datum.rank - 1) * lt_rh"
          },
          "width": {
            "signal": "cw"
          },
          "height": {
            "signal": "lt_rh"
          },
          "fill": {
            "signal": "'transparent'"
          },
          "cursor": {
            "value": "pointer"
          }
        },
        "hover": {
          "fill": {
            "value": "#E6E8E2"
          }
        }
      },
      "marks": [
        {
          "type": "rule",
          "encode": {
            "update": {
              "x": {
                "value": 0
              },
              "x2": {
                "signal": "cw"
              },
              "y": {
                "signal": "lt_rh - 0.5"
              },
              "stroke": {
                "value": "#D6D9D2"
              },
              "strokeOpacity": {
                "value": 0.7
              }
            }
          }
        },
        {
          "type": "rect",
          "encode": {
            "update": {
              "x": {
                "signal": "0 + 10"
              },
              "y": {
                "signal": "lt_rh / 2 - 5"
              },
              "width": {
                "value": 10
              },
              "height": {
                "value": 10
              },
              "cornerRadius": {
                "value": 3
              },
              "fill": {
                "signal": "parent.spokeColor"
              }
            }
          }
        },
        {
          "type": "text",
          "interactive": true,
          "encode": {
            "update": {
              "x": {
                "signal": "0 + 26"
              },
              "y": {
                "signal": "lt_rh / 2"
              },
              "align": {
                "value": "left"
              },
              "baseline": {
                "value": "middle"
              },
              "font": {
                "value": "Inter, 'Segoe UI', system-ui, -apple-system, sans-serif"
              },
              "fontSize": {
                "value": 12
              },
              "fontWeight": {
                "value": "bold"
              },
              "fill": {
                "value": "#0F4D43"
              },
              "text": {
                "signal": "parent.name"
              },
              "limit": {
                "signal": "((cw - 912) / 1) - 32"
              }
            }
          }
        },
        {
          "type": "text",
          "interactive": true,
          "encode": {
            "update": {
              "x": {
                "signal": "0 + ((cw - 912) / 1) + 92 - 10"
              },
              "y": {
                "signal": "lt_rh / 2"
              },
              "align": {
                "value": "right"
              },
              "baseline": {
                "value": "middle"
              },
              "font": {
                "value": "'Roboto Mono', Menlo, Consolas, monospace"
              },
              "fontSize": {
                "value": 11
              },
              "fontWeight": {
                "value": "normal"
              },
              "fill": {
                "value": "#0F4D43"
              },
              "text": {
                "signal": "(isValid((parent.e)) && isFinite((parent.e)) ? format((parent.e), ',.0f') : '–')"
              },
              "limit": {
                "signal": "92 - 16"
              }
            }
          }
        },
        {
          "type": "text",
          "interactive": true,
          "encode": {
            "update": {
              "x": {
                "signal": "0 + ((cw - 912) / 1) + 92 + 110 - 10"
              },
              "y": {
                "signal": "lt_rh / 2"
              },
              "align": {
                "value": "right"
              },
              "baseline": {
                "value": "middle"
              },
              "font": {
                "value": "'Roboto Mono', Menlo, Consolas, monospace"
              },
              "fontSize": {
                "value": 11
              },
              "fontWeight": {
                "value": "normal"
              },
              "fill": {
                "value": "#0F4D43"
              },
              "text": {
                "signal": "format(parent.lostH, ',.1f')"
              },
              "limit": {
                "signal": "110 - 16"
              }
            }
          }
        },
        {
          "type": "rect",
          "encode": {
            "update": {
              "x": {
                "signal": "0 + ((cw - 912) / 1) + 92 + 110 + 10"
              },
              "y": {
                "signal": "lt_rh / 2 - 4"
              },
              "width": {
                "signal": "170 - 60"
              },
              "height": {
                "value": 8
              },
              "cornerRadius": {
                "value": 3
              },
              "fill": {
                "value": "#E6E8E2"
              }
            }
          }
        },
        {
          "type": "rect",
          "encode": {
            "update": {
              "x": {
                "signal": "0 + ((cw - 912) / 1) + 92 + 110 + 10"
              },
              "y": {
                "signal": "lt_rh / 2 - 4"
              },
              "width": {
                "signal": "max(2, (170 - 60) * clamp(parent.share / 0.3, 0, 1))"
              },
              "height": {
                "value": 8
              },
              "cornerRadius": {
                "value": 3
              },
