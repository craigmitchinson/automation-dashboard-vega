{
  "$schema": "https://vega.github.io/schema/vega/v5.json",
  "description": "IA · Process Analysis · Bot time lost to exceptions. Generated by vega/build.mjs from vega/panels/process-analysis.mjs, do not edit by hand.",
  "autosize": {
    "type": "fit",
    "contains": "padding"
  },
  "padding": 0,
  "config": {
    "background": "#FFFFFF",
    "padding": 0,
    "font": "Inter, 'Segoe UI', system-ui, -apple-system, sans-serif",
    "text": {
      "font": "Inter, 'Segoe UI', system-ui, -apple-system, sans-serif",
      "fill": "#0F4D43",
      "fontSize": 12
    },
    "axis": {
      "gridColor": "#E6E8E2",
      "labelFont": "'Roboto Mono', Menlo, Consolas, monospace",
      "labelFontSize": 10,
      "labelColor": "#5F6E69",
      "titleFont": "'Roboto Mono', Menlo, Consolas, monospace",
      "titleColor": "#5F6E69",
      "titleFontSize": 10,
      "titleFontWeight": 400,
      "domain": false,
      "ticks": false,
      "gridWidth": 1,
      "labelPadding": 6
    },
    "style": {
      "guide-label": {
        "font": "'Roboto Mono', Menlo, Consolas, monospace"
      }
    },
    "view": {
      "stroke": null
    },
    "kibana": {
      "renderer": "svg",
      "hideWarnings": true
    }
  },
  "signals": [
    {
      "name": "headerRight",
      "value": 0
    },
    {
      "name": "top",
      "value": 42
    },
    {
      "name": "cw",
      "update": "width - 32"
    },
    {
      "name": "ch",
      "update": "height - top - 16"
    },
    {
      "name": "ltT",
      "update": "length(data('lt_tot')) ? data('lt_tot')[0] : {h: 0, g: 0, r: 0, w: 0}"
    },
    {
      "name": "pickLt",
      "on": [
        {
          "events": "@lt_row:click",
          "update": "kibanaAddFilter({'match_phrase': {'process.name': datum.name}}, 'ia-workqueue-items*')"
        }
      ]
    },
    {
      "name": "lt_fit",
      "update": "max(0, floor((ch - 26 - 27 - 14) / 27))"
    },
    {
      "name": "lt_rh",
      "update": "clamp((ch - 26 - 27 - 14) / max(1, length(data('lt'))), 27, 43)"
    }
  ],
  "data": [
    {
      "name": "procs_raw",
      "url": {
        "index": "ia-reference",
        "body": {
          "size": 500,
          "query": {
            "term": {
              "doc_type": "process"
            }
          }
        }
      },
      "format": {
        "property": "hits.hits"
      }
    },
    {
      "name": "procs",
      "source": "procs_raw",
      "transform": [
        {
          "type": "formula",
          "as": "name",
          "expr": "datum._source.process.name"
        },
        {
          "type": "formula",
          "as": "pid",
          "expr": "datum._source.process.id"
        },
        {
          "type": "formula",
          "as": "acronym",
          "expr": "datum._source.process.acronym"
        },
        {
          "type": "formula",
          "as": "spoke",
          "expr": "datum._source.spoke.name"
        },
        {
          "type": "formula",
          "as": "spokeColor",
          "expr": "datum._source.spoke.color"
        },
        {
          "type": "formula",
          "as": "proposition",
          "expr": "datum._source.proposition.name"
        },
        {
          "type": "formula",
          "as": "queue",
          "expr": "datum._source.primary_queue"
        },
        {
          "type": "formula",
          "as": "queues",
          "expr": "join(datum._source.queues, ' → ')"
        },
        {
          "type": "formula",
          "as": "description",
          "expr": "datum._source.process.description"
        },
        {
          "type": "formula",
          "as": "tags",
          "expr": "datum._source.process.tags"
        },
        {
          "type": "formula",
          "as": "smv",
          "expr": "datum._source.process.smv_minutes"
        },
        {
          "type": "formula",
          "as": "grade",
          "expr": "datum._source.process.grade"
        },
        {
          "type": "formula",
          "as": "gradeName",
          "expr": "datum._source.process.grade_name"
        },
        {
          "type": "formula",
          "as": "rate",
          "expr": "datum._source.process.current_rate_gbp"
        },
        {
          "type": "formula",
          "as": "slaHours",
          "expr": "datum._source.process.sla_hours"
        }
      ]
    },
    {
      "name": "bl_raw",
      "url": {
        "%context%": true,
        "%timefield%": "@timestamp",
        "index": "ia-workqueue-items",
        "body": {
          "size": 0,
          "aggs": {
            "m": {
              "filter": {
                "term": {
                  "mapped": true
                }
              },
              "aggs": {
                "p": {
                  "terms": {
                    "field": "process.name",
                    "size": 100
                  },
                  "aggs": {
                    "w": {
                      "sum": {
                        "field": "worktime_sec"
                      }
                    },
                    "cw": {
                      "sum": {
                        "field": "worktime_completed_sec"
                      }
                    },
                    "e": {
                      "sum": {
                        "field": "n.exception"
                      }
                    },
                    "a": {
                      "sum": {
                        "field": "n.attempt"
                      }
                    },
                    "xe": {
                      "filter": {
                        "term": {
                          "n.exception": 1
                        }
                      },
                      "aggs": {
                        "ec": {
                          "sum": {
                            "field": "cost.estate_gbp"
                          }
                        },
                        "rw": {
                          "sum": {
                            "field": "value.rework_gbp"
                          }
                        },
                        "r": {
                          "terms": {
                            "field": "exception.reason_display",
                            "size": 1,
                            "order": {
                              "w": "desc"
                            }
                          },
                          "aggs": {
                            "w": {
                              "sum": {
                                "field": "worktime_sec"
                              }
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      },
      "format": {
        "property": "aggregations.m.p.buckets"
      }
    },
    {
      "name": "bl",
      "source": "bl_raw",
      "transform": [
        {
          "type": "formula",
          "as": "name",
          "expr": "datum.key"
        },
        {
          "type": "formula",
          "as": "w",
          "expr": "datum['w'].value"
        },
        {
          "type": "formula",
          "as": "cw",
          "expr": "datum['cw'].value"
        },
        {
          "type": "formula",
          "as": "e",
          "expr": "datum['e'].value"
        },
        {
          "type": "formula",
          "as": "a",
          "expr": "datum['a'].value"
        },
        {
          "type": "lookup",
          "from": "procs",
          "key": "name",
          "fields": [
            "name"
          ],
          "as": [
            "ref"
          ]
        },
        {
          "type": "formula",
          "as": "spoke",
          "expr": "datum.ref ? datum.ref.spoke : ''"
        },
        {
          "type": "formula",
          "as": "spokeColor",
          "expr": "datum.ref ? datum.ref.spokeColor : '#5F6E69'"
        },
        {
          "type": "formula",
          "as": "queue",
          "expr": "datum.ref ? datum.ref.queue : ''"
        },
        {
          "type": "formula",
          "as": "proposition",
          "expr": "datum.ref ? datum.ref.proposition : ''"
        },
        {
          "type": "formula",
          "as": "slaHours",
          "expr": "datum.ref ? datum.ref.slaHours : null"
        }
      ]
    },
    {
      "name": "lt",
      "source": "bl",
      "transform": [
        {
          "type": "formula",
          "as": "lostH",
          "expr": "(datum.w - datum.cw) / 3600"
        },
        {
          "type": "filter",
          "expr": "datum.lostH > 0"
        },
        {
          "type": "formula",
          "as": "share",
          "expr": "datum.w ? (datum.w - datum.cw) / datum.w : 0"
        },
        {
          "type": "formula",
          "as": "lostGbp",
          "expr": "datum.xe.ec.value"
        },
        {
          "type": "formula",
          "as": "rework",
          "expr": "datum.xe.rw.value"
        },
        {
          "type": "formula",
          "as": "why",
          "expr": "length(datum.xe.r.buckets) ? datum.xe.r.buckets[0].key : ''"
        },
        {
          "type": "formula",
          "as": "whyShare",
          "expr": "length(datum.xe.r.buckets) && datum.w - datum.cw ? datum.xe.r.buckets[0].w.value / (datum.w - datum.cw) : 0"
        },
        {
          "type": "collect",
          "sort": {
            "field": "lostGbp",
            "order": "descending"
          }
        }
      ]
    },
    {
      "name": "lt_tot",
      "source": "lt",
      "transform": [
        {
          "type": "aggregate",
          "ops": [
            "sum",
            "sum",
            "sum",
            "sum"
          ],
          "fields": [
            "lostH",
            "lostGbp",
            "rework",
            "w"
          ],
          "as": [
            "h",
            "g",
            "r",
            "w"
          ]
        }
      ]
    },
    {
      "name": "lt_rows",
      "source": "lt",
      "transform": [
        {
          "type": "window",
          "ops": [
            "row_number"
          ],
          "as": [
            "rank"
          ]
        },
        {
          "type": "filter",
          "expr": "datum.rank <= lt_fit"
        }
      ]
    }
  ],
  "marks": [
    {
      "type": "text",
      "name": "frame_title",
      "encode": {
        "update": {
          "x": {
            "value": 16
          },
          "y": {
            "value": 18
          },
          "baseline": {
            "value": "top"
          },
          "font": {
            "value": "'Roboto Mono', Menlo, Consolas, monospace"
          },
          "fontSize": {
            "value": 11
          },
          "fontWeight": {
            "value": 600
          },
          "fill": {
            "value": "#0F4D43"
          },
          "text": {
            "signal": "'BOT TIME LOST TO EXCEPTIONS'"
          },
          "limit": {
            "signal": "width - 32"
          }
        }
      }
    },
    {
      "type": "text",
      "encode": {
        "update": {
          "x": {
            "signal": "16 + length('BOT TIME LOST TO EXCEPTIONS') * 6.9 + 10"
          },
          "y": {
            "value": 17
          },
          "baseline": {
            "value": "top"
          },
          "font": {
            "value": "Inter, 'Segoe UI', system-ui, -apple-system, sans-serif"
          },
          "fontSize": {
            "value": 12
          },
          "fill": {
            "value": "#5F6E69"
          },
          "text": {
            "value": "Robot time and cost spent on items that then failed, worst first · the reason that cost most · click a row to filter"
          },
          "limit": {
            "signal": "width - 42 - length('BOT TIME LOST TO EXCEPTIONS') * 6.9 - 0 - headerRight"
          }
        }
      }
    },
    {
      "type": "group",
      "encode": {
        "update": {
          "x": {
            "value": 16
          },
          "y": {
            "signal": "top"
          },
          "width": {
            "signal": "cw"
          },
          "height": {
            "value": 26
          }
        }
      },
      "marks": [
        {
          "type": "rule",
          "encode": {
            "update": {
              "x": {
                "value": 0
              },
              "x2": {
                "signal": "cw"
              },
              "y": {
                "value": 25.5
              },
              "stroke": {
                "value": "#D6D9D2"
              }
            }
          }
        },
        {
          "type": "text",
          "encode": {
            "update": {
              "x": {
                "signal": "0 + 10"
              },
              "y": {
                "value": 13
              },
              "align": {
                "value": "left"
              },
              "baseline": {
                "value": "middle"
              },
              "font": {
                "value": "'Roboto Mono', Menlo, Consolas, monospace"
              },
              "fontSize": {
                "value": 10
              },
              "fontWeight": {
                "value": 600
              },
              "fill": {
                "value": "#5F6E69"
              },
              "text": {
                "value": "PROCESS"
              },
              "limit": {
                "signal": "((cw - 912) / 1) - 12"
              }
            }
          }
        },
        {
          "type": "text",
          "encode": {
            "update": {
              "x": {
                "signal": "0 + ((cw - 912) / 1) + 92 - 10"
              },
              "y": {
                "value": 13
              },
              "align": {
                "value": "right"
              },
              "baseline": {
                "value": "middle"
              },
              "font": {
                "value": "'Roboto Mono', Menlo, Consolas, monospace"
              },
              "fontSize": {
                "value": 10
              },
              "fontWeight": {
                "value": 600
              },
              "fill": {
                "value": "#5F6E69"
              },
              "text": {
                "value": "EXCEPTIONS"
              },
              "limit": {
                "signal": "92 - 12"
              }
            }
          }
        },
        {
          "type": "text",
          "encode": {
            "update": {
              "x": {
                "signal": "0 + ((cw - 912) / 1) + 92 + 110 - 10"
              },
              "y": {
                "value": 13
              },
              "align": {
                "value": "right"
              },
              "baseline": {
                "value": "middle"
              },
              "font": {
                "value": "'Roboto Mono', Menlo, Consolas, monospace"
              },
              "fontSize": {
                "value": 10
              },
              "fontWeight": {
                "value": 600
              },
              "fill": {
                "value": "#5F6E69"
              },
              "text": {
                "value": "BOT HOURS LOST"
              },
              "limit": {
                "signal": "110 - 12"
              }
            }
          }
        },
        {
          "type": "text",
          "encode": {
            "update": {
              "x": {
                "signal": "0 + ((cw - 912) / 1) + 92 + 110 + 170 - 10"
              },
              "y": {
                "value": 13
              },
              "align": {
                "value": "right"
              },
              "baseline": {
                "value": "middle"
              },
              "font": {
                "value": "'Roboto Mono', Menlo, Consolas, monospace"
              },
              "fontSize": {
                "value": 10
              },
              "fontWeight": {
                "value": 600
              },
              "fill": {
                "value": "#5F6E69"
              },
              "text": {
                "value": "SHARE OF ITS BOT TIME"
              },
              "limit": {
                "signal": "170 - 12"
              }
            }
          }
        },
        {
          "type": "text",
          "encode": {
            "update": {
              "x": {
                "signal": "0 + ((cw - 912) / 1) + 92 + 110 + 170 + 120 - 10"
              },
              "y": {
                "value": 13
              },
              "align": {
                "value": "right"
              },
              "baseline": {
                "value": "middle"
              },
              "font": {
                "value": "'Roboto Mono', Menlo, Consolas, monospace"
              },
              "fontSize": {
                "value": 10
              },
              "fontWeight": {
                "value": 600
              },
              "fill": {
                "value": "#5F6E69"
              },
              "text": {
                "value": "COST OF LOST TIME"
              },
              "limit": {
                "signal": "120 - 12"
              }
            }
          }
        },
        {
          "type": "text",
          "encode": {
            "update": {
              "x": {
                "signal": "0 + ((cw - 912) / 1) + 92 + 110 + 170 + 120 + 120 - 10"
              },
              "y": {
                "value": 13
              },
              "align": {
                "value": "right"
              },
              "baseline": {
                "value": "middle"
              },
              "font": {
                "value": "'Roboto Mono', Menlo, Consolas, monospace"
              },
              "fontSize": {
                "value": 10
              },
              "fontWeight": {
                "value": 600
              },
              "fill": {
                "value": "#5F6E69"
              },
              "text": {
                "value": "REWORK EXPOSURE"
              },
              "limit": {
                "signal": "120 - 12"
              }
            }
          }
        },
        {
          "type": "text",
          "encode": {
            "update": {
              "x": {
                "signal": "0 + ((cw - 912) / 1) + 92 + 110 + 170 + 120 + 120 + 10"
              },
              "y": {
                "value": 13
              },
              "align": {
                "value": "left"
              },
              "baseline": {
                "value": "middle"
              },
              "font": {
                "value": "'Roboto Mono', Menlo, Consolas, monospace"
              },
              "fontSize": {
                "value": 10
              },
              "fontWeight": {
                "value": 600
              },
              "fill": {
                "value": "#5F6E69"
              },
              "text": {
                "value": "COSTLIEST REASON"
              },
              "limit": {
