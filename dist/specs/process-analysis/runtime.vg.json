{
  "$schema": "https://vega.github.io/schema/vega/v5.json",
  "description": "IA · Process Analysis · Bot time per item. Generated by vega/build.mjs from vega/panels/process-analysis.mjs, do not edit by hand.",
  "autosize": {
    "type": "fit",
    "contains": "padding"
  },
  "padding": 0,
  "config": {
    "background": "#FFFFFF",
    "padding": 0,
    "font": "Inter, 'Segoe UI', system-ui, -apple-system, sans-serif",
    "text": {
      "font": "Inter, 'Segoe UI', system-ui, -apple-system, sans-serif",
      "fill": "#0F4D43",
      "fontSize": 12
    },
    "axis": {
      "gridColor": "#E6E8E2",
      "labelFont": "'Roboto Mono', Menlo, Consolas, monospace",
      "labelFontSize": 10,
      "labelColor": "#5F6E69",
      "titleFont": "'Roboto Mono', Menlo, Consolas, monospace",
      "titleColor": "#5F6E69",
      "titleFontSize": 10,
      "titleFontWeight": 400,
      "domain": false,
      "ticks": false,
      "gridWidth": 1,
      "labelPadding": 6
    },
    "style": {
      "guide-label": {
        "font": "'Roboto Mono', Menlo, Consolas, monospace"
      }
    },
    "view": {
      "stroke": null
    },
    "kibana": {
      "renderer": "svg",
      "hideWarnings": true
    }
  },
  "signals": [
    {
      "name": "ndays",
      "update": "length(data('win'))"
    },
    {
      "name": "lo",
      "update": "ndays ? data('win')[0].key : 0"
    },
    {
      "name": "hi",
      "update": "ndays ? data('win')[ndays - 1].key : 0"
    },
    {
      "name": "plo",
      "update": "lo - ndays * 86400000"
    },
    {
      "name": "phi",
      "update": "lo - 86400000"
    },
    {
      "name": "headerRight",
      "value": 0
    },
    {
      "name": "top",
      "value": 58
    },
    {
      "name": "cw",
      "update": "width - 32"
    },
    {
      "name": "ch",
      "update": "height - top - 16"
    },
    {
      "name": "grain",
      "value": "weekly",
      "on": [
        {
          "events": "@seg_grain_0:click",
          "update": "'daily'"
        },
        {
          "events": "@seg_grain_1:click",
          "update": "'weekly'"
        },
        {
          "events": "@seg_grain_2:click",
          "update": "'monthly'"
        }
      ]
    },
    {
      "name": "chart_ymax",
      "update": "max(extent(pluck(data('rtf'), 'okT'))[1] || 0, extent(pluck(data('rtf'), 'exT'))[1] || 0, 0)"
    }
  ],
  "data": [
    {
      "name": "raw",
      "url": {
        "index": "ia-workqueue-items",
        "body": {
          "size": 0,
          "query": {
            "bool": {
              "must": [
                "%dashboard_context-must_clause%",
                {
                  "range": {
                    "@timestamp": {
                      "gte": {
                        "%timefilter%": "min",
                        "shift": -732,
                        "unit": "day"
                      },
                      "lte": {
                        "%timefilter%": "max"
                      },
                      "format": "epoch_millis"
                    }
                  }
                },
                {
                  "term": {
                    "mapped": true
                  }
                }
              ],
              "filter": [
                "%dashboard_context-filter_clause%"
              ],
              "must_not": [
                "%dashboard_context-must_not_clause%"
              ]
            }
          },
          "aggs": {
            "win": {
              "filter": {
                "range": {
                  "@timestamp": {
                    "gte": {
                      "%timefilter%": "min",
                      "shift": 1,
                      "unit": "hour"
                    },
                    "lte": {
                      "%timefilter%": "max"
                    },
                    "format": "epoch_millis"
                  }
                }
              },
              "aggs": {
                "d": {
                  "date_histogram": {
                    "field": "@timestamp",
                    "fixed_interval": "1d",
                    "min_doc_count": 0,
                    "extended_bounds": {
                      "min": {
                        "%timefilter%": "min",
                        "shift": 1,
                        "unit": "hour"
                      },
                      "max": {
                        "%timefilter%": "max"
                      }
                    }
                  }
                }
              }
            },
            "days": {
              "date_histogram": {
                "field": "@timestamp",
                "fixed_interval": "1d",
                "min_doc_count": 1
              },
              "aggs": {
                "c": {
                  "sum": {
                    "field": "n.completed"
                  }
                },
                "e": {
                  "sum": {
                    "field": "n.exception"
                  }
                },
                "w": {
                  "sum": {
                    "field": "worktime_sec"
                  }
                },
                "cw": {
                  "sum": {
                    "field": "worktime_completed_sec"
                  }
                }
              }
            }
          }
        }
      },
      "format": {
        "property": "aggregations"
      }
    },
    {
      "name": "win",
      "source": "raw",
      "transform": [
        {
          "type": "flatten",
          "fields": [
            "win.d.buckets"
          ],
          "as": [
            "_bk"
          ]
        },
        {
          "type": "formula",
          "as": "key",
          "expr": "datum._bk.key"
        },
        {
          "type": "formula",
          "as": "n",
          "expr": "datum._bk.doc_count"
        },
        {
          "type": "project",
          "fields": [
            "key",
            "n"
          ]
        }
      ]
    },
    {
      "name": "days",
      "source": "raw",
      "transform": [
        {
          "type": "flatten",
          "fields": [
            "days.buckets"
          ],
          "as": [
            "_bk"
          ]
        },
        {
          "type": "formula",
          "as": "key",
          "expr": "datum._bk.key"
        },
        {
          "type": "formula",
          "as": "n",
          "expr": "datum._bk.doc_count"
        },
        {
          "type": "formula",
          "as": "c",
          "expr": "datum._bk[\"c\"] ? (datum._bk[\"c\"].value || 0) : 0"
        },
        {
          "type": "formula",
          "as": "e",
          "expr": "datum._bk[\"e\"] ? (datum._bk[\"e\"].value || 0) : 0"
        },
        {
          "type": "formula",
          "as": "w",
          "expr": "datum._bk[\"w\"] ? (datum._bk[\"w\"].value || 0) : 0"
        },
        {
          "type": "formula",
          "as": "cw",
          "expr": "datum._bk[\"cw\"] ? (datum._bk[\"cw\"].value || 0) : 0"
        },
        {
          "type": "project",
          "fields": [
            "key",
            "n",
            "c",
            "e",
            "w",
            "cw"
          ]
        }
      ]
    },
    {
      "name": "series",
      "source": "win",
      "transform": [
        {
          "type": "lookup",
          "from": "days",
          "key": "key",
          "fields": [
            "key"
          ],
          "as": [
            "d"
          ]
        },
        {
          "type": "formula",
          "as": "t",
          "expr": "datum.key"
        },
        {
          "type": "formula",
          "as": "c",
          "expr": "datum.d ? datum.d.c : 0"
        },
        {
          "type": "formula",
          "as": "e",
          "expr": "datum.d ? datum.d.e : 0"
        },
        {
          "type": "formula",
          "as": "w",
          "expr": "datum.d ? datum.d.w : 0"
        },
        {
          "type": "formula",
          "as": "cw",
          "expr": "datum.d ? datum.d.cw : 0"
        }
      ]
    },
    {
      "name": "tot",
      "source": "days",
      "transform": [
        {
          "type": "formula",
          "as": "cur_c",
          "expr": "datum.key >= lo && datum.key <= hi ? datum.c : 0"
        },
        {
          "type": "formula",
          "as": "prev_c",
          "expr": "datum.key >= plo && datum.key <= phi ? datum.c : 0"
        },
        {
          "type": "formula",
          "as": "cur_e",
          "expr": "datum.key >= lo && datum.key <= hi ? datum.e : 0"
        },
        {
          "type": "formula",
          "as": "prev_e",
          "expr": "datum.key >= plo && datum.key <= phi ? datum.e : 0"
        },
        {
          "type": "formula",
          "as": "cur_w",
          "expr": "datum.key >= lo && datum.key <= hi ? datum.w : 0"
        },
        {
          "type": "formula",
          "as": "prev_w",
          "expr": "datum.key >= plo && datum.key <= phi ? datum.w : 0"
        },
        {
          "type": "formula",
          "as": "cur_cw",
          "expr": "datum.key >= lo && datum.key <= hi ? datum.cw : 0"
        },
        {
          "type": "formula",
          "as": "prev_cw",
          "expr": "datum.key >= plo && datum.key <= phi ? datum.cw : 0"
        },
        {
          "type": "aggregate",
          "ops": [
            "sum",
            "sum",
            "sum",
            "sum",
            "sum",
            "sum",
            "sum",
            "sum"
          ],
          "fields": [
            "cur_c",
            "prev_c",
            "cur_e",
            "prev_e",
            "cur_w",
            "prev_w",
            "cur_cw",
            "prev_cw"
          ],
          "as": [
            "cur_c",
            "prev_c",
            "cur_e",
            "prev_e",
            "cur_w",
            "prev_w",
            "cur_cw",
            "prev_cw"
          ]
        }
      ]
    },
    {
      "name": "ref_rel",
      "url": {
        "index": "ia-reference",
        "body": {
          "size": 500,
          "query": {
            "term": {
              "doc_type": "release"
            }
          }
        }
      },
      "format": {
        "property": "hits.hits"
      }
    },
    {
      "name": "rel",
      "source": "ref_rel",
      "transform": [
        {
          "type": "formula",
          "as": "t",
          "expr": "toDate(datum._source.release.date)"
        },
        {
          "type": "formula",
          "as": "process",
          "expr": "datum._source.release.process"
        },
        {
          "type": "formula",
          "as": "label",
          "expr": "datum._source.release.title + ' · ' + (datum.process || 'estate-wide')"
        },
        {
          "type": "filter",
          "expr": "true"
        },
        {
          "type": "project",
          "fields": [
            "t",
            "process",
            "label"
          ]
        }
      ]
    },
    {
      "name": "flow",
      "source": "series",
      "transform": [
        {
          "type": "formula",
          "as": "g",
          "expr": "grain === 'monthly' ? utc(utcyear(datum.t), utcmonth(datum.t), 1) : grain === 'weekly' ? datum.t - ((utcday(datum.t) + 6) % 7) * 86400000 : datum.t"
        },
        {
          "type": "aggregate",
          "groupby": [
            "g"
          ],
          "ops": [
            "sum",
            "sum",
            "sum",
            "sum"
          ],
          "fields": [
            "c",
            "e",
            "w",
            "cw"
          ],
          "as": [
            "c",
            "e",
            "w",
            "cw"
          ]
        },
        {
          "type": "formula",
          "as": "t",
          "expr": "datum.g"
        },
        {
          "type": "collect",
          "sort": {
            "field": "t"
          }
        }
      ]
    },
    {
      "name": "rtf",
      "source": "flow",
      "transform": [
        {
          "type": "formula",
          "as": "okT",
          "expr": "datum.c ? datum.cw / datum.c : null"
        },
        {
          "type": "formula",
          "as": "exT",
          "expr": "datum.e ? (datum.w - datum.cw) / datum.e : null"
        }
      ]
    },
    {
      "name": "chart_mk",
      "source": "rel",
      "transform": [
        {
          "type": "filter",
          "expr": "length(data('rtf')) && datum.t >= extent(pluck(data('rtf'), 't'))[0] && datum.t <= extent(pluck(data('rtf'), 't'))[1]"
        }
      ]
    }
  ],
  "scales": [
    {
      "name": "chart_x",
      "type": "utc",
      "domain": {
        "signal": "length(data('rtf')) ? extent(pluck(data('rtf'), 't')) : [0, 1]"
      },
      "range": [
        0,
        {
          "signal": "cw - 44"
        }
      ]
    },
    {
      "name": "chart_y",
      "type": "linear",
      "domain": {
        "signal": "[0, max(0, chart_ymax)]"
      },
      "range": [
        {
          "signal": "ch - 22"
        },
        0
      ],
      "nice": true,
      "zero": true
    }
  ],
  "marks": [
    {
      "type": "text",
      "name": "frame_title",
      "encode": {
        "update": {
          "x": {
            "value": 16
          },
          "y": {
            "value": 18
          },
          "baseline": {
            "value": "top"
          },
          "font": {
            "value": "'Roboto Mono', Menlo, Consolas, monospace"
          },
          "fontSize": {
            "value": 11
          },
          "fontWeight": {
            "value": 600
          },
          "fill": {
            "value": "#0F4D43"
          },
          "text": {
            "signal": "'BOT TIME PER ITEM'"
          },
          "limit": {
            "signal": "width - 32"
          }
        }
      }
    },
    {
      "type": "text",
      "encode": {
        "update": {
          "x": {
            "signal": "16 + length('BOT TIME PER ITEM') * 6.9 + 10"
          },
          "y": {
            "value": 17
          },
          "baseline": {
            "value": "top"
          },
          "font": {
            "value": "Inter, 'Segoe UI', system-ui, -apple-system, sans-serif"
          },
          "fontSize": {
            "value": 12
          },
          "fill": {
            "value": "#5F6E69"
          },
          "text": {
            "signal": "(isValid(((length(data('tot')) ? data('tot')[0].cur_cw : 0) / max(1, (length(data('tot')) ? data('tot')[0].cur_c : 0)))) && isFinite(((length(data('tot')) ? data('tot')[0].cur_cw : 0) / max(1, (length(data('tot')) ? data('tot')[0].cur_c : 0)))) ? (round(((length(data('tot')) ? data('tot')[0].cur_cw : 0) / max(1, (length(data('tot')) ? data('tot')[0].cur_c : 0)))) < 60 ? round(max(0, ((length(data('tot')) ? data('tot')[0].cur_cw : 0) / max(1, (length(data('tot')) ? data('tot')[0].cur_c : 0))))) + 's' : round(((length(data('tot')) ? data('tot')[0].cur_cw : 0) / max(1, (length(data('tot')) ? data('tot')[0].cur_c : 0)))) < 3600 ? floor(round(((length(data('tot')) ? data('tot')[0].cur_cw : 0) / max(1, (length(data('tot')) ? data('tot')[0].cur_c : 0)))) / 60) + 'm ' + pad('' + (round(((length(data('tot')) ? data('tot')[0].cur_cw : 0) / max(1, (length(data('tot')) ? data('tot')[0].cur_c : 0)))) % 60), 2, '0', 'left') + 's' : floor(round(((length(data('tot')) ? data('tot')[0].cur_cw : 0) / max(1, (length(data('tot')) ? data('tot')[0].cur_c : 0)))) / 3600) + 'h ' + pad('' + floor((round(((length(data('tot')) ? data('tot')[0].cur_cw : 0) / max(1, (length(data('tot')) ? data('tot')[0].cur_c : 0)))) % 3600) / 60), 2, '0', 'left') + 'm') : '–') + ' completed · ' + (isValid((((length(data('tot')) ? data('tot')[0].cur_w : 0) - (length(data('tot')) ? data('tot')[0].cur_cw : 0)) / max(1, (length(data('tot')) ? data('tot')[0].cur_e : 0)))) && isFinite((((length(data('tot')) ? data('tot')[0].cur_w : 0) - (length(data('tot')) ? data('tot')[0].cur_cw : 0)) / max(1, (length(data('tot')) ? data('tot')[0].cur_e : 0)))) ? (round((((length(data('tot')) ? data('tot')[0].cur_w : 0) - (length(data('tot')) ? data('tot')[0].cur_cw : 0)) / max(1, (length(data('tot')) ? data('tot')[0].cur_e : 0)))) < 60 ? round(max(0, (((length(data('tot')) ? data('tot')[0].cur_w : 0) - (length(data('tot')) ? data('tot')[0].cur_cw : 0)) / max(1, (length(data('tot')) ? data('tot')[0].cur_e : 0))))) + 's' : round((((length(data('tot')) ? data('tot')[0].cur_w : 0) - (length(data('tot')) ? data('tot')[0].cur_cw : 0)) / max(1, (length(data('tot')) ? data('tot')[0].cur_e : 0)))) < 3600 ? floor(round((((length(data('tot')) ? data('tot')[0].cur_w : 0) - (length(data('tot')) ? data('tot')[0].cur_cw : 0)) / max(1, (length(data('tot')) ? data('tot')[0].cur_e : 0)))) / 60) + 'm ' + pad('' + (round((((length(data('tot')) ? data('tot')[0].cur_w : 0) - (length(data('tot')) ? data('tot')[0].cur_cw : 0)) / max(1, (length(data('tot')) ? data('tot')[0].cur_e : 0)))) % 60), 2, '0', 'left') + 's' : floor(round((((length(data('tot')) ? data('tot')[0].cur_w : 0) - (length(data('tot')) ? data('tot')[0].cur_cw : 0)) / max(1, (length(data('tot')) ? data('tot')[0].cur_e : 0)))) / 3600) + 'h ' + pad('' + floor((round((((length(data('tot')) ? data('tot')[0].cur_w : 0) - (length(data('tot')) ? data('tot')[0].cur_cw : 0)) / max(1, (length(data('tot')) ? data('tot')[0].cur_e : 0)))) % 3600) / 60), 2, '0', 'left') + 'm') : '–') + ' before an exception'"
          },
          "limit": {
            "signal": "width - 42 - length('BOT TIME PER ITEM') * 6.9 - 0 - headerRight"
          }
        }
      }
    },
    {
      "type": "rect",
      "encode": {
        "update": {
          "x": {
            "signal": "16"
          },
          "y": {
            "value": 36
          },
          "width": {
            "value": 11
          },
          "height": {
            "value": 11
          },
          "cornerRadius": {
            "value": 3
          },
          "fill": {
            "value": "#0F4D43"
          }
        }
      }
    },
    {
      "type": "text",
      "encode": {
        "update": {
          "x": {
            "signal": "16 + 17"
          },
          "y": {
            "value": 41.5
          },
          "baseline": {
            "value": "middle"
          },
          "font": {
            "value": "Inter, 'Segoe UI', system-ui, -apple-system, sans-serif"
          },
          "fontSize": {
            "value": 12
          },
          "fill": {
            "value": "#5F6E69"
          },
          "text": {
            "value": "Completed"
          }
        }
      }
    },
    {
      "type": "rect",
      "encode": {
        "update": {
          "x": {
            "signal": "103"
          },
          "y": {
            "value": 36
          },
          "width": {
            "value": 11
          },
          "height": {
            "value": 11
          },
          "cornerRadius": {
            "value": 3
          },
          "fill": {
            "value": "#B6462F"
          }
        }
      }
    },
    {
      "type": "text",
      "encode": {
        "update": {
          "x": {
            "signal": "103 + 17"
          },
          "y": {
            "value": 41.5
          },
          "baseline": {
            "value": "middle"
          },
          "font": {
            "value": "Inter, 'Segoe UI', system-ui, -apple-system, sans-serif"
          },
          "fontSize": {
            "value": 12
          },
          "fill": {
            "value": "#5F6E69"
          },
          "text": {
            "value": "Exception"
          }
        }
      }
    },
    {
      "type": "rect",
      "encode": {
        "update": {
          "x": {
            "signal": "width - 16 - 171"
          },
          "y": {
            "value": 12
          },
          "width": {
            "value": 171
          },
          "height": {
            "value": 24
          },
          "cornerRadius": {
            "value": 12
          },
          "fill": {
            "value": "#F7F6F2"
          },
          "stroke": {
            "value": "#D6D9D2"
          }
        }
      }
    },
    {
      "type": "rect",
      "name": "seg_grain_0",
      "encode": {
        "update": {
          "x": {
            "signal": "width - 16 - 171 + 3"
          },
          "y": {
            "value": 14
          },
          "width": {
            "value": 49
          },
          "height": {
            "value": 20
          },
          "cornerRadius": {
            "value": 10
          },
          "fill": {
            "signal": "grain === 'daily' ? '#DCE8E0' : 'transparent'"
          },
          "stroke": {
            "value": "transparent"
          },
          "cursor": {
            "value": "pointer"
          }
        }
      }
    },
    {
      "type": "text",
      "interactive": false,
      "encode": {
        "update": {
          "x": {
            "signal": "width - 16 - 171 + 3 + 24.5"
          },
          "y": {
            "value": 24
          },
          "align": {
            "value": "center"
          },
          "baseline": {
            "value": "middle"
          },
          "font": {
            "value": "Inter, 'Segoe UI', system-ui, -apple-system, sans-serif"
          },
          "fontSize": {
            "value": 11.5
          },
          "fontWeight": {
            "signal": "grain === 'daily' ? 600 : 'normal'"
          },
          "fill": {
            "signal": "grain === 'daily' ? '#0F4D43' : '#5F6E69'"
          },
          "text": {
            "value": "Daily"
          }
        }
      }
    },
    {
      "type": "rect",
      "name": "seg_grain_1",
      "encode": {
        "update": {
          "x": {
            "signal": "width - 16 - 171 + 52"
          },
          "y": {
            "value": 14
          },
          "width": {
            "value": 55
          },
          "height": {
            "value": 20
          },
          "cornerRadius": {
            "value": 10
          },
          "fill": {
