{
  "$schema": "https://vega.github.io/schema/vega/v5.json",
  "description": "IA · Overview · Day by day. Generated by vega/build.mjs from vega/panels/overview.mjs, do not edit by hand.",
  "autosize": {
    "type": "fit",
    "contains": "padding"
  },
  "padding": 0,
  "config": {
    "background": "#FFFFFF",
    "padding": 0,
    "font": "Inter, 'Segoe UI', system-ui, -apple-system, sans-serif",
    "text": {
      "font": "Inter, 'Segoe UI', system-ui, -apple-system, sans-serif",
      "fill": "#0F4D43",
      "fontSize": 12
    },
    "axis": {
      "gridColor": "#E6E8E2",
      "labelFont": "'Roboto Mono', Menlo, Consolas, monospace",
      "labelFontSize": 10,
      "labelColor": "#5F6E69",
      "titleFont": "'Roboto Mono', Menlo, Consolas, monospace",
      "titleColor": "#5F6E69",
      "titleFontSize": 10,
      "titleFontWeight": 400,
      "domain": false,
      "ticks": false,
      "gridWidth": 1,
      "labelPadding": 6
    },
    "style": {
      "guide-label": {
        "font": "'Roboto Mono', Menlo, Consolas, monospace"
      }
    },
    "view": {
      "stroke": null
    },
    "kibana": {
      "renderer": "svg",
      "hideWarnings": true
    }
  },
  "signals": [
    {
      "name": "ndays",
      "update": "length(data('win'))"
    },
    {
      "name": "lo",
      "update": "ndays ? data('win')[0].key : 0"
    },
    {
      "name": "hi",
      "update": "ndays ? data('win')[ndays - 1].key : 0"
    },
    {
      "name": "plo",
      "update": "lo - ndays * 86400000"
    },
    {
      "name": "phi",
      "update": "lo - 86400000"
    },
    {
      "name": "headerRight",
      "value": 0
    },
    {
      "name": "top",
      "value": 42
    },
    {
      "name": "cw",
      "update": "width - 32"
    },
    {
      "name": "ch",
      "update": "height - top - 16"
    },
    {
      "name": "nW",
      "update": "length(data('calmax')) ? data('calmax')[0].w + 1 : 1"
    },
    {
      "name": "calAvg",
      "update": "length(data('calmax')) && data('calmax')[0].a ? data('calmax')[0].e / data('calmax')[0].a : 0"
    },
    {
      "name": "cellW",
      "update": "min(64, (cw - 34) / nW)"
    },
    {
      "name": "cellH",
      "update": "(ch - 44) / 7"
    },
    {
      "name": "showTxt",
      "update": "cellW >= 30 && cellH >= 16"
    }
  ],
  "data": [
    {
      "name": "raw",
      "url": {
        "index": "ia-workqueue-items",
        "body": {
          "size": 0,
          "query": {
            "bool": {
              "must": [
                "%dashboard_context-must_clause%",
                {
                  "range": {
                    "@timestamp": {
                      "gte": {
                        "%timefilter%": "min",
                        "shift": -732,
                        "unit": "day"
                      },
                      "lte": {
                        "%timefilter%": "max"
                      },
                      "format": "epoch_millis"
                    }
                  }
                },
                {
                  "term": {
                    "mapped": true
                  }
                }
              ],
              "filter": [
                "%dashboard_context-filter_clause%"
              ],
              "must_not": [
                "%dashboard_context-must_not_clause%"
              ]
            }
          },
          "aggs": {
            "win": {
              "filter": {
                "range": {
                  "@timestamp": {
                    "%timefilter%": true
                  }
                }
              },
              "aggs": {
                "d": {
                  "date_histogram": {
                    "field": "@timestamp",
                    "fixed_interval": "1d",
                    "min_doc_count": 0,
                    "extended_bounds": {
                      "min": {
                        "%timefilter%": "min"
                      },
                      "max": {
                        "%timefilter%": "max"
                      }
                    }
                  }
                }
              }
            },
            "days": {
              "date_histogram": {
                "field": "@timestamp",
                "fixed_interval": "1d",
                "min_doc_count": 1
              },
              "aggs": {
                "a": {
                  "sum": {
                    "field": "n.attempt"
                  }
                },
                "c": {
                  "sum": {
                    "field": "n.completed"
                  }
                },
                "e": {
                  "sum": {
                    "field": "n.exception"
                  }
                },
                "s": {
                  "sum": {
                    "field": "n.system"
                  }
                }
              }
            }
          }
        }
      },
      "format": {
        "property": "aggregations"
      }
    },
    {
      "name": "win",
      "source": "raw",
      "transform": [
        {
          "type": "flatten",
          "fields": [
            "win.d.buckets"
          ],
          "as": [
            "_bk"
          ]
        },
        {
          "type": "formula",
          "as": "key",
          "expr": "datum._bk.key"
        },
        {
          "type": "formula",
          "as": "n",
          "expr": "datum._bk.doc_count"
        },
        {
          "type": "project",
          "fields": [
            "key",
            "n"
          ]
        }
      ]
    },
    {
      "name": "days",
      "source": "raw",
      "transform": [
        {
          "type": "flatten",
          "fields": [
            "days.buckets"
          ],
          "as": [
            "_bk"
          ]
        },
        {
          "type": "formula",
          "as": "key",
          "expr": "datum._bk.key"
        },
        {
          "type": "formula",
          "as": "n",
          "expr": "datum._bk.doc_count"
        },
        {
          "type": "formula",
          "as": "a",
          "expr": "datum._bk[\"a\"] ? (datum._bk[\"a\"].value || 0) : 0"
        },
        {
          "type": "formula",
          "as": "c",
          "expr": "datum._bk[\"c\"] ? (datum._bk[\"c\"].value || 0) : 0"
        },
        {
          "type": "formula",
          "as": "e",
          "expr": "datum._bk[\"e\"] ? (datum._bk[\"e\"].value || 0) : 0"
        },
        {
          "type": "formula",
          "as": "s",
          "expr": "datum._bk[\"s\"] ? (datum._bk[\"s\"].value || 0) : 0"
        },
        {
          "type": "project",
          "fields": [
            "key",
            "n",
            "a",
            "c",
            "e",
            "s"
          ]
        }
      ]
    },
    {
      "name": "series",
      "source": "win",
      "transform": [
        {
          "type": "lookup",
          "from": "days",
          "key": "key",
          "fields": [
            "key"
          ],
          "as": [
            "d"
          ]
        },
        {
          "type": "formula",
          "as": "t",
          "expr": "datum.key"
        },
        {
          "type": "formula",
          "as": "a",
          "expr": "datum.d ? datum.d.a : 0"
        },
        {
          "type": "formula",
          "as": "c",
          "expr": "datum.d ? datum.d.c : 0"
        },
        {
          "type": "formula",
          "as": "e",
          "expr": "datum.d ? datum.d.e : 0"
        },
        {
          "type": "formula",
          "as": "s",
          "expr": "datum.d ? datum.d.s : 0"
        }
      ]
    },
    {
      "name": "tot",
      "source": "days",
      "transform": [
        {
          "type": "formula",
          "as": "cur_a",
          "expr": "datum.key >= lo && datum.key <= hi ? datum.a : 0"
        },
        {
          "type": "formula",
          "as": "prev_a",
          "expr": "datum.key >= plo && datum.key <= phi ? datum.a : 0"
        },
        {
          "type": "formula",
          "as": "cur_c",
          "expr": "datum.key >= lo && datum.key <= hi ? datum.c : 0"
        },
        {
          "type": "formula",
          "as": "prev_c",
          "expr": "datum.key >= plo && datum.key <= phi ? datum.c : 0"
        },
        {
          "type": "formula",
          "as": "cur_e",
          "expr": "datum.key >= lo && datum.key <= hi ? datum.e : 0"
        },
        {
          "type": "formula",
          "as": "prev_e",
          "expr": "datum.key >= plo && datum.key <= phi ? datum.e : 0"
        },
        {
          "type": "formula",
          "as": "cur_s",
          "expr": "datum.key >= lo && datum.key <= hi ? datum.s : 0"
        },
        {
          "type": "formula",
          "as": "prev_s",
          "expr": "datum.key >= plo && datum.key <= phi ? datum.s : 0"
        },
        {
          "type": "aggregate",
          "ops": [
            "sum",
            "sum",
            "sum",
            "sum",
            "sum",
            "sum",
            "sum",
            "sum"
          ],
          "fields": [
            "cur_a",
            "prev_a",
            "cur_c",
            "prev_c",
            "cur_e",
            "prev_e",
            "cur_s",
            "prev_s"
          ],
          "as": [
            "cur_a",
            "prev_a",
            "cur_c",
            "prev_c",
            "cur_e",
            "prev_e",
            "cur_s",
            "prev_s"
          ]
        }
      ]
    },
    {
      "name": "cal",
      "source": "series",
      "transform": [
        {
          "type": "formula",
          "as": "dow",
          "expr": "(utcday(datum.t) + 6) % 7"
        },
        {
          "type": "formula",
          "as": "wk",
          "expr": "floor((datum.t - (lo - ((utcday(lo) + 6) % 7) * 86400000)) / (7 * 86400000))"
        },
        {
          "type": "formula",
          "as": "r",
          "expr": "datum.a ? datum.e / datum.a : null"
        },
        {
          "type": "formula",
          "as": "ok",
          "expr": "datum.a >= 20"
        }
      ]
    },
    {
      "name": "calmax",
      "source": "cal",
      "transform": [
        {
          "type": "aggregate",
          "ops": [
            "max",
            "sum",
            "sum"
          ],
          "fields": [
            "wk",
            "e",
            "a"
          ],
          "as": [
            "w",
            "e",
            "a"
          ]
        }
      ]
    },
    {
      "name": "calrows",
      "values": [
        {
          "i": 0,
          "d": "Mon"
        },
        {
          "i": 1,
          "d": "Tue"
        },
        {
          "i": 2,
          "d": "Wed"
        },
        {
          "i": 3,
          "d": "Thu"
        },
        {
          "i": 4,
          "d": "Fri"
        },
        {
          "i": 5,
          "d": "Sat"
        },
        {
          "i": 6,
          "d": "Sun"
        }
      ]
    },
    {
      "name": "calkey",
      "values": [
        {
          "i": 0
        },
        {
          "i": 1
        },
        {
          "i": 2
        },
        {
          "i": 3
        },
        {
          "i": 4
        },
        {
          "i": 5
        },
        {
          "i": 6
        },
        {
          "i": 7
        },
        {
          "i": 8
        },
        {
          "i": 9
        },
        {
          "i": 10
        },
        {
          "i": 11
        }
      ]
    }
  ],
  "scales": [
    {
      "name": "calc",
      "type": "linear",
      "domain": {
        "signal": "[calAvg * 0.5, calAvg, calAvg * 1.6]"
      },
      "range": [
        "#D5E6DD",
        "#F4EBDD",
        "#B6462F"
      ],
      "clamp": true,
      "interpolate": "lab"
    }
  ],
  "marks": [
    {
      "type": "text",
      "name": "frame_title",
      "encode": {
        "update": {
          "x": {
            "value": 16
          },
          "y": {
            "value": 18
          },
          "baseline": {
            "value": "top"
          },
          "font": {
            "value": "'Roboto Mono', Menlo, Consolas, monospace"
          },
          "fontSize": {
            "value": 11
          },
          "fontWeight": {
            "value": 600
          },
          "fill": {
            "value": "#0F4D43"
          },
          "text": {
            "signal": "'DAY BY DAY'"
          },
          "limit": {
            "signal": "width - 32"
          }
        }
      }
    },
    {
      "type": "text",
      "encode": {
        "update": {
          "x": {
            "signal": "16 + length('DAY BY DAY') * 6.9 + 10"
          },
          "y": {
            "value": 17
          },
          "baseline": {
            "value": "top"
          },
          "font": {
            "value": "Inter, 'Segoe UI', system-ui, -apple-system, sans-serif"
          },
          "fontSize": {
            "value": 12
          },
          "fill": {
            "value": "#5F6E69"
          },
          "text": {
            "signal": "'Exception rate each day, %, against the period average of ' + format(calAvg * 100, '.1f') + '% · outlined: half as bad again'"
          },
          "limit": {
            "signal": "width - 42 - length('DAY BY DAY') * 6.9 - 0 - headerRight"
          }
        }
      }
    },
    {
      "type": "text",
      "from": {
        "data": "calrows"
      },
      "encode": {
        "update": {
          "x": {
            "value": 16
          },
          "y": {
            "signal": "top + 20 + (datum.i + 0.5) * cellH"
          },
          "baseline": {
            "value": "middle"
          },
          "font": {
            "value": "'Roboto Mono', Menlo, Consolas, monospace"
          },
          "fontSize": {
            "value": 10
          },
          "fill": {
            "value": "#5F6E69"
          },
          "text": {
            "field": "d"
          }
        }
      }
    },
    {
      "type": "text",
      "from": {
        "data": "cal"
      },
      "encode": {
        "update": {
          "x": {
            "signal": "16 + 34 + datum.wk * cellW + 2"
          },
          "y": {
            "signal": "top + 9"
          },
          "baseline": {
            "value": "middle"
          },
          "font": {
            "value": "'Roboto Mono', Menlo, Consolas, monospace"
          },
          "fontSize": {
            "value": 10
          },
          "fill": {
            "value": "#5F6E69"
          },
          "text": {
            "signal": "datum.dow === 0 && (datum.wk % max(1, ceil(nW / 13)) === 0) ? utcFormat(datum.t, '%d %b') : ''"
          }
        }
      }
    },
    {
      "type": "rect",
      "from": {
        "data": "cal"
      },
      "encode": {
        "update": {
          "x": {
            "signal": "16 + 34 + datum.wk * cellW + 1.5"
          },
          "width": {
            "signal": "max(1, cellW - 3)"
          },
          "y": {
            "signal": "top + 20 + datum.dow * cellH + 1.5"
          },
          "height": {
            "signal": "max(1, cellH - 3)"
          },
          "cornerRadius": {
            "value": 4
          },
          "fill": {
            "signal": "datum.ok && calAvg ? scale('calc', datum.r) : '#F7F6F2'"
          },
          "stroke": {
            "signal": "datum.ok && calAvg && datum.r > calAvg * 1.5 ? '#0F4D43' : '#D6D9D2'"
          },
          "strokeWidth": {
            "signal": "datum.ok && calAvg && datum.r > calAvg * 1.5 ? 1.6 : 0.6"
          },
          "tooltip": {
            "signal": "{'Day': utcFormat((datum.t), '%-d %b %Y'), 'Items': (isValid((datum.a)) && isFinite((datum.a)) ? format((datum.a), ',.0f') : '–'), 'Exception rate': (isValid((datum.r)) && isFinite((datum.r)) ? format((datum.r) * 100, '.1f') + '%' : '–'), 'Period average': (isValid((calAvg)) && isFinite((calAvg)) ? format((calAvg) * 100, '.1f') + '%' : '–'), 'System exceptions': datum.s}"
          }
        }
      }
    },
    {
      "type": "text",
      "from": {
        "data": "cal"
      },
      "interactive": false,
      "encode": {
        "update": {
          "x": {
            "signal": "16 + 34 + datum.wk * cellW + cellW / 2"
          },
          "y": {
            "signal": "top + 20 + datum.dow * cellH + cellH / 2"
          },
          "align": {
            "value": "center"
          },
          "baseline": {
            "value": "middle"
          },
          "font": {
            "value": "'Roboto Mono', Menlo, Consolas, monospace"
          },
          "fontSize": {
            "signal": "cellW >= 44 ? 11 : 9.5"
          },
          "fontWeight": {
            "signal": "datum.ok && datum.r > calAvg * 1.25 ? 600 : 400"
          },
          "fill": {
            "signal": "!datum.ok ? '#8FA09A' : datum.r > calAvg * 1.35 ? '#FFFFFF' : '#0F4D43'"
          },
          "text": {
            "signal": "showTxt && isValid(datum.r) ? format(datum.r * 100, '.1f') : ''"
          }
        }
      }
    },
    {
      "type": "text",
      "encode": {
        "update": {
          "x": {
            "value": 16
          },
          "y": {
            "signal": "height - 18"
          },
          "baseline": {
            "value": "middle"
          },
          "font": {
            "value": "'Roboto Mono', Menlo, Consolas, monospace"
          },
          "fontSize": {
            "value": 10
          },
          "fill": {
            "value": "#5F6E69"
          },
          "text": {
            "value": "BETTER"
          }
        }
      }
    },
    {
      "type": "rect",
      "from": {
        "data": "calkey"
      },
      "encode": {
        "update": {
          "x": {
            "signal": "16 + 54 + datum.i * 14"
          },
          "y": {
            "signal": "height - 24"
          },
          "width": {
            "value": 12
          },
          "height": {
            "value": 12
          },
          "cornerRadius": {
            "value": 3
          },
          "fill": {
            "signal": "scale('calc', calAvg * (0.5 + datum.i * 0.1))"
          }
        }
      }
    },
    {
      "type": "text",
      "encode": {
        "update": {
          "x": {
            "signal": "16 + 54 + 12 * 14 + 6"
          },
          "y": {
            "signal": "height - 18"
          },
          "baseline": {
            "value": "middle"
          },
          "font": {
            "value": "'Roboto Mono', Menlo, Consolas, monospace"
          },
          "fontSize": {
            "value": 10
          },
          "fill": {
            "value": "#5F6E69"
          },
          "text": {
            "value": "WORSE"
          }
        }
      }
    },
    {
      "type": "text",
      "encode": {
        "update": {
          "x": {
            "signal": "16 + 54 + 12 * 14 + 56"
          },
          "y": {
            "signal": "height - 18"
          },
          "baseline": {
            "value": "middle"
          },
          "font": {
            "value": "Inter, 'Segoe UI', system-ui, -apple-system, sans-serif"
          },
          "fontSize": {
            "value": 11
          },
          "fill": {
            "value": "#5F6E69"
          },
          "text": {
            "value": "Grey: under 20 items that day, too few to judge"
          }
        }
      }
    }
  ]
}
