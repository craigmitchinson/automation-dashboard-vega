                "value": "normal"
              },
              "fill": {
                "signal": "parent.dRate > 0.005 ? '#B6462F' : parent.dRate < -0.005 ? '#0B8A6B' : '#0F4D43'"
              },
              "text": {
                "signal": "(isValid((parent.rate)) && isFinite((parent.rate)) ? format((parent.rate) * 100, '.1f') + '%' : '–') + ' ' + (parent.dRate >= 0 ? '+' : '') + format(parent.dRate * 100, '.1f')"
              },
              "limit": {
                "signal": "120 - 16"
              },
              "tooltip": {
                "signal": "'change in percentage points'"
              }
            }
          }
        },
        {
          "type": "text",
          "encode": {
            "update": {
              "x": {
                "signal": "0 + ((cw - 426) / 1) + 66 + 120 + 110 - 10"
              },
              "y": {
                "signal": "mv_rh / 2"
              },
              "align": {
                "value": "right"
              },
              "baseline": {
                "value": "middle"
              },
              "font": {
                "value": "'Roboto Mono', Menlo, Consolas, monospace"
              },
              "fontSize": {
                "value": 11
              },
              "fontWeight": {
                "value": "normal"
              },
              "fill": {
                "signal": "parent.dCpi > 0.03 ? '#B6462F' : parent.dCpi < -0.03 ? '#0B8A6B' : '#0F4D43'"
              },
              "text": {
                "signal": "(isValid((parent.cpi)) && isFinite((parent.cpi)) ? ((parent.cpi) < 0 ? '-' : '') + '£' + format(abs((parent.cpi)), ',.2f') : '–') + ' ' + (isValid(parent.dCpi) ? (parent.dCpi >= 0 ? '+' : '') + format(parent.dCpi * 100, '.0f') + '%' : '–')"
              },
              "limit": {
                "signal": "110 - 16"
              }
            }
          }
        },
        {
          "type": "text",
          "encode": {
            "update": {
              "x": {
                "signal": "0 + ((cw - 426) / 1) + 66 + 120 + 110 + 130 - 10"
              },
              "y": {
                "signal": "mv_rh / 2"
              },
              "align": {
                "value": "right"
              },
              "baseline": {
                "value": "middle"
              },
              "font": {
                "value": "'Roboto Mono', Menlo, Consolas, monospace"
              },
              "fontSize": {
                "value": 11
              },
              "fontWeight": {
                "value": "bold"
              },
              "fill": {
                "signal": "parent.dNet < 0 ? '#B6462F' : '#0B8A6B'"
              },
              "text": {
                "signal": "(parent.dNet >= 0 ? '+' : '') + (isValid((parent.dNet)) && isFinite((parent.dNet)) ? ((parent.dNet) < 0 ? '-' : '') + '£' + format(round(abs((parent.dNet))), ',') : '–')"
              },
              "limit": {
                "signal": "130 - 16"
              }
            }
          }
        }
      ]
    },
    {
      "type": "text",
      "encode": {
        "update": {
          "x": {
            "signal": "16 + cw"
          },
          "y": {
            "signal": "top + ch - 2"
          },
          "align": {
            "value": "right"
          },
          "baseline": {
            "value": "bottom"
          },
          "font": {
            "value": "'Roboto Mono', Menlo, Consolas, monospace"
          },
          "fontSize": {
            "value": 10
          },
          "fill": {
            "value": "#5F6E69"
          },
          "text": {
            "signal": "length(data('mv')) > mv_fit ? '+' + (length(data('mv')) - mv_fit) + ' more rows: widen the panel or filter' : ''"
          }
        }
      }
    }
  ]
}
