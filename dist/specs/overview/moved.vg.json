{
  "$schema": "https://vega.github.io/schema/vega/v5.json",
  "description": "IA · Overview · What moved. Generated by vega/build.mjs from vega/panels/overview.mjs, do not edit by hand.",
  "autosize": {
    "type": "fit",
    "contains": "padding"
  },
  "padding": 0,
  "config": {
    "background": "#FFFFFF",
    "padding": 0,
    "font": "Inter, 'Segoe UI', system-ui, -apple-system, sans-serif",
    "text": {
      "font": "Inter, 'Segoe UI', system-ui, -apple-system, sans-serif",
      "fill": "#0F4D43",
      "fontSize": 12
    },
    "axis": {
      "gridColor": "#E6E8E2",
      "labelFont": "'Roboto Mono', Menlo, Consolas, monospace",
      "labelFontSize": 10,
      "labelColor": "#5F6E69",
      "titleFont": "'Roboto Mono', Menlo, Consolas, monospace",
      "titleColor": "#5F6E69",
      "titleFontSize": 10,
      "titleFontWeight": 400,
      "domain": false,
      "ticks": false,
      "gridWidth": 1,
      "labelPadding": 6
    },
    "style": {
      "guide-label": {
        "font": "'Roboto Mono', Menlo, Consolas, monospace"
      }
    },
    "view": {
      "stroke": null
    },
    "kibana": {
      "renderer": "svg",
      "hideWarnings": true
    }
  },
  "signals": [
    {
      "name": "ndays",
      "update": "length(data('win'))"
    },
    {
      "name": "lo",
      "update": "ndays ? data('win')[0].key : 0"
    },
    {
      "name": "hi",
      "update": "ndays ? data('win')[ndays - 1].key : 0"
    },
    {
      "name": "plo",
      "update": "lo - ndays * 86400000"
    },
    {
      "name": "phi",
      "update": "lo - 86400000"
    },
    {
      "name": "pickMv",
      "on": [
        {
          "events": "@mv_row:click",
          "update": "kibanaAddFilter({'match_phrase': {'process.name': datum.name}}, 'ia-workqueue-items*')"
        }
      ]
    },
    {
      "name": "headerRight",
      "value": 0
    },
    {
      "name": "top",
      "value": 42
    },
    {
      "name": "cw",
      "update": "width - 32"
    },
    {
      "name": "ch",
      "update": "height - top - 16"
    },
    {
      "name": "mv_fit",
      "update": "max(0, floor((ch - 26 - 0 - 14) / 26))"
    },
    {
      "name": "mv_rh",
      "update": "clamp((ch - 26 - 0 - 14) / max(1, length(data('mv'))), 26, 42)"
    }
  ],
  "data": [
    {
      "name": "raw",
      "url": {
        "index": "ia-workqueue-items",
        "body": {
          "size": 0,
          "query": {
            "bool": {
              "must": [
                "%dashboard_context-must_clause%",
                {
                  "range": {
                    "@timestamp": {
                      "gte": {
                        "%timefilter%": "min",
                        "shift": -732,
                        "unit": "day"
                      },
                      "lte": {
                        "%timefilter%": "max"
                      },
                      "format": "epoch_millis"
                    }
                  }
                },
                {
                  "term": {
                    "mapped": true
                  }
                }
              ],
              "filter": [
                "%dashboard_context-filter_clause%"
              ],
              "must_not": [
                "%dashboard_context-must_not_clause%"
              ]
            }
          },
          "aggs": {
            "win": {
              "filter": {
                "range": {
                  "@timestamp": {
                    "%timefilter%": true
                  }
                }
              },
              "aggs": {
                "d": {
                  "date_histogram": {
                    "field": "@timestamp",
                    "fixed_interval": "1d",
                    "min_doc_count": 0,
                    "extended_bounds": {
                      "min": {
                        "%timefilter%": "min"
                      },
                      "max": {
                        "%timefilter%": "max"
                      }
                    }
                  }
                }
              }
            },
            "days": {
              "date_histogram": {
                "field": "@timestamp",
                "fixed_interval": "1d",
                "min_doc_count": 1
              },
              "aggs": {
                "a": {
                  "sum": {
                    "field": "n.attempt"
                  }
                }
              }
            }
          }
        }
      },
      "format": {
        "property": "aggregations"
      }
    },
    {
      "name": "win",
      "source": "raw",
      "transform": [
        {
          "type": "flatten",
          "fields": [
            "win.d.buckets"
          ],
          "as": [
            "_bk"
          ]
        },
        {
          "type": "formula",
          "as": "key",
          "expr": "datum._bk.key"
        },
        {
          "type": "formula",
          "as": "n",
          "expr": "datum._bk.doc_count"
        },
        {
          "type": "project",
          "fields": [
            "key",
            "n"
          ]
        }
      ]
    },
    {
      "name": "days",
      "source": "raw",
      "transform": [
        {
          "type": "flatten",
          "fields": [
            "days.buckets"
          ],
          "as": [
            "_bk"
          ]
        },
        {
          "type": "formula",
          "as": "key",
          "expr": "datum._bk.key"
        },
        {
          "type": "formula",
          "as": "n",
          "expr": "datum._bk.doc_count"
        },
        {
          "type": "formula",
          "as": "a",
          "expr": "datum._bk[\"a\"] ? (datum._bk[\"a\"].value || 0) : 0"
        },
        {
          "type": "project",
          "fields": [
            "key",
            "n",
            "a"
          ]
        }
      ]
    },
    {
      "name": "series",
      "source": "win",
      "transform": [
        {
          "type": "lookup",
          "from": "days",
          "key": "key",
          "fields": [
            "key"
          ],
          "as": [
            "d"
          ]
        },
        {
          "type": "formula",
          "as": "t",
          "expr": "datum.key"
        },
        {
          "type": "formula",
          "as": "a",
          "expr": "datum.d ? datum.d.a : 0"
        }
      ]
    },
    {
      "name": "tot",
      "source": "days",
      "transform": [
        {
          "type": "formula",
          "as": "cur_a",
          "expr": "datum.key >= lo && datum.key <= hi ? datum.a : 0"
        },
        {
          "type": "formula",
          "as": "prev_a",
          "expr": "datum.key >= plo && datum.key <= phi ? datum.a : 0"
        },
        {
          "type": "aggregate",
          "ops": [
            "sum",
            "sum"
          ],
          "fields": [
            "cur_a",
            "prev_a"
          ],
          "as": [
            "cur_a",
            "prev_a"
          ]
        }
      ]
    },
    {
      "name": "mv_raw",
      "url": {
        "index": "ia-workqueue-items",
        "body": {
          "size": 0,
          "query": {
            "bool": {
              "must": [
                "%dashboard_context-must_clause%",
                {
                  "range": {
                    "@timestamp": {
                      "gte": {
                        "%timefilter%": "min",
                        "shift": -732,
                        "unit": "day"
                      },
                      "lte": {
                        "%timefilter%": "max"
                      },
                      "format": "epoch_millis"
                    }
                  }
                },
                {
                  "term": {
                    "mapped": true
                  }
                }
              ],
              "filter": [
                "%dashboard_context-filter_clause%"
              ],
              "must_not": [
                "%dashboard_context-must_not_clause%"
              ]
            }
          },
          "aggs": {
            "p": {
              "terms": {
                "field": "process.name",
                "size": 25
              },
              "aggs": {
                "d": {
                  "date_histogram": {
                    "field": "@timestamp",
                    "fixed_interval": "1d",
                    "min_doc_count": 1
                  },
                  "aggs": {
                    "a": {
                      "sum": {
                        "field": "n.attempt"
                      }
                    },
                    "e": {
                      "sum": {
                        "field": "n.exception"
                      }
                    },
                    "c": {
                      "sum": {
                        "field": "n.completed"
                      }
                    },
                    "ec": {
                      "sum": {
                        "field": "cost.estate_gbp"
                      }
                    },
                    "gb": {
                      "sum": {
                        "field": "value.benefit_gbp"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      },
      "format": {
        "property": "aggregations.p.buckets"
      }
    },
    {
      "name": "mv",
      "source": "mv_raw",
      "transform": [
        {
          "type": "formula",
          "as": "name",
          "expr": "datum.key"
        },
        {
          "type": "flatten",
          "fields": [
            "d.buckets"
          ],
          "as": [
            "b"
          ]
        },
        {
          "type": "formula",
          "as": "inC",
          "expr": "datum.b.key >= lo && datum.b.key <= hi ? 1 : 0"
        },
        {
          "type": "formula",
          "as": "inP",
          "expr": "datum.b.key >= plo && datum.b.key <= phi ? 1 : 0"
        },
        {
          "type": "formula",
          "as": "c_a",
          "expr": "datum.inC * datum.b['a'].value"
        },
        {
          "type": "formula",
          "as": "p_a",
          "expr": "datum.inP * datum.b['a'].value"
        },
        {
          "type": "formula",
          "as": "c_e",
          "expr": "datum.inC * datum.b['e'].value"
        },
        {
          "type": "formula",
          "as": "p_e",
          "expr": "datum.inP * datum.b['e'].value"
        },
        {
          "type": "formula",
          "as": "c_c",
          "expr": "datum.inC * datum.b['c'].value"
        },
        {
          "type": "formula",
          "as": "p_c",
          "expr": "datum.inP * datum.b['c'].value"
        },
        {
          "type": "formula",
          "as": "c_ec",
          "expr": "datum.inC * datum.b['ec'].value"
        },
        {
          "type": "formula",
          "as": "p_ec",
          "expr": "datum.inP * datum.b['ec'].value"
        },
        {
          "type": "formula",
          "as": "c_gb",
          "expr": "datum.inC * datum.b['gb'].value"
        },
        {
          "type": "formula",
          "as": "p_gb",
          "expr": "datum.inP * datum.b['gb'].value"
        },
        {
          "type": "aggregate",
          "groupby": [
            "name"
          ],
          "ops": [
            "sum",
            "sum",
            "sum",
            "sum",
            "sum",
            "sum",
            "sum",
            "sum",
            "sum",
            "sum"
          ],
          "fields": [
            "c_a",
            "p_a",
            "c_e",
            "p_e",
            "c_c",
            "p_c",
            "c_ec",
            "p_ec",
            "c_gb",
            "p_gb"
          ],
          "as": [
            "c_a",
            "p_a",
            "c_e",
            "p_e",
            "c_c",
            "p_c",
            "c_ec",
            "p_ec",
            "c_gb",
            "p_gb"
          ]
        },
        {
          "type": "filter",
          "expr": "datum.c_a >= 30 && datum.p_a >= 30"
        },
        {
          "type": "formula",
          "as": "dVol",
          "expr": "(datum.c_a - datum.p_a) / datum.p_a"
        },
        {
          "type": "formula",
          "as": "rate",
          "expr": "datum.c_e / datum.c_a"
        },
        {
          "type": "formula",
          "as": "dRate",
          "expr": "datum.rate - datum.p_e / datum.p_a"
        },
        {
          "type": "formula",
          "as": "cpi",
          "expr": "datum.c_c ? datum.c_ec / datum.c_c : null"
        },
        {
          "type": "formula",
          "as": "dCpi",
          "expr": "datum.c_c && datum.p_c && datum.p_ec ? datum.cpi / (datum.p_ec / datum.p_c) - 1 : null"
        },
        {
          "type": "formula",
          "as": "dNet",
          "expr": "(datum.c_gb - datum.c_ec) - (datum.p_gb - datum.p_ec)"
        },
        {
          "type": "formula",
          "as": "mag",
          "expr": "abs(datum.dNet)"
        },
        {
          "type": "collect",
          "sort": {
            "field": "mag",
            "order": "descending"
          }
        }
      ]
    },
    {
      "name": "mv_rows",
      "source": "mv",
      "transform": [
        {
          "type": "window",
          "ops": [
            "row_number"
          ],
          "as": [
            "rank"
          ]
        },
        {
          "type": "filter",
          "expr": "datum.rank <= mv_fit"
        }
      ]
    }
  ],
  "marks": [
    {
