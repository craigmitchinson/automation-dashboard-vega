    {
      "type": "group",
      "name": "mv_row",
      "from": {
        "data": "mv_rows"
      },
      "encode": {
        "update": {
          "x": {
            "value": 16
          },
          "y": {
            "signal": "top + 26 + (datum.rank - 1) * mv_rh"
          },
          "width": {
