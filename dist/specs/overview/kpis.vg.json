          "accent": "#B6462F",
          "deltaGood": "down"
        },
        {
          "i": 3,
          "label": "Net/FTE value",
          "accent": "#B9852C",
          "deltaGood": "up"
        },
        {
          "i": 4,
          "label": "Completed cases",
          "accent": "#0F4D43",
          "deltaGood": "up"
        },
        {
          "i": 5,
          "label": "Colleague time saved",
          "accent": "#2A6A5F",
          "deltaGood": "up"
        }
      ],
      "transform": [
        {
          "type": "formula",
