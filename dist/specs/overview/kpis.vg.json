{
  "$schema": "https://vega.github.io/schema/vega/v5.json",
  "description": "IA · Overview · Overview KPIs. Generated by vega/build.mjs from vega/panels/overview.mjs, do not edit by hand.",
  "autosize": {
    "type": "fit",
    "contains": "padding"
  },
  "padding": 0,
  "config": {
    "background": "#FFFFFF",
    "padding": 0,
    "font": "Inter, 'Segoe UI', system-ui, -apple-system, sans-serif",
    "text": {
      "font": "Inter, 'Segoe UI', system-ui, -apple-system, sans-serif",
      "fill": "#0F4D43",
      "fontSize": 12
    },
    "axis": {
      "gridColor": "#E6E8E2",
      "labelFont": "'Roboto Mono', Menlo, Consolas, monospace",
      "labelFontSize": 10,
      "labelColor": "#5F6E69",
      "titleFont": "'Roboto Mono', Menlo, Consolas, monospace",
      "titleColor": "#5F6E69",
      "titleFontSize": 10,
      "titleFontWeight": 400,
      "domain": false,
      "ticks": false,
      "gridWidth": 1,
      "labelPadding": 6
    },
    "style": {
      "guide-label": {
        "font": "'Roboto Mono', Menlo, Consolas, monospace"
      }
    },
    "view": {
      "stroke": null
    },
    "kibana": {
      "renderer": "svg",
      "hideWarnings": true
    }
  },
  "signals": [
    {
      "name": "ndays",
      "update": "length(data('win'))"
    },
    {
      "name": "lo",
      "update": "ndays ? data('win')[0].key : 0"
    },
    {
      "name": "hi",
      "update": "ndays ? data('win')[ndays - 1].key : 0"
    },
    {
      "name": "plo",
      "update": "lo - ndays * 86400000"
    },
    {
      "name": "phi",
      "update": "lo - 86400000"
    },
    {
      "name": "oneSpoke",
      "update": "length(data('scope_spokes')) === 1 ? data('scope_spokes')[0].key : ''"
    },
    {
      "name": "tgt_completionPct",
      "update": "oneSpoke && indexof(pluck(data('tg'), 'k'), 'spoke|' + oneSpoke + '|completionPct') >= 0 ? data('tg')[indexof(pluck(data('tg'), 'k'), 'spoke|' + oneSpoke + '|completionPct')].v : (indexof(pluck(data('tg'), 'k'), 'global|completionPct') >= 0 ? data('tg')[indexof(pluck(data('tg'), 'k'), 'global|completionPct')].v : 0.95)"
    },
    {
      "name": "tgt_exceptionRate",
      "update": "oneSpoke && indexof(pluck(data('tg'), 'k'), 'spoke|' + oneSpoke + '|exceptionRate') >= 0 ? data('tg')[indexof(pluck(data('tg'), 'k'), 'spoke|' + oneSpoke + '|exceptionRate')].v : (indexof(pluck(data('tg'), 'k'), 'global|exceptionRate') >= 0 ? data('tg')[indexof(pluck(data('tg'), 'k'), 'global|exceptionRate')].v : 0.06)"
    },
    {
      "name": "tgt_systemRate",
      "update": "oneSpoke && indexof(pluck(data('tg'), 'k'), 'spoke|' + oneSpoke + '|systemRate') >= 0 ? data('tg')[indexof(pluck(data('tg'), 'k'), 'spoke|' + oneSpoke + '|systemRate')].v : (indexof(pluck(data('tg'), 'k'), 'global|systemRate') >= 0 ? data('tg')[indexof(pluck(data('tg'), 'k'), 'global|systemRate')].v : 0.03)"
    },
    {
      "name": "tgt_costPerCase",
      "update": "oneSpoke && indexof(pluck(data('tg'), 'k'), 'spoke|' + oneSpoke + '|costPerCase') >= 0 ? data('tg')[indexof(pluck(data('tg'), 'k'), 'spoke|' + oneSpoke + '|costPerCase')].v : (indexof(pluck(data('tg'), 'k'), 'global|costPerCase') >= 0 ? data('tg')[indexof(pluck(data('tg'), 'k'), 'global|costPerCase')].v : 9)"
    },
    {
      "name": "tgt_utilMin",
      "update": "oneSpoke && indexof(pluck(data('tg'), 'k'), 'spoke|' + oneSpoke + '|utilMin') >= 0 ? data('tg')[indexof(pluck(data('tg'), 'k'), 'spoke|' + oneSpoke + '|utilMin')].v : (indexof(pluck(data('tg'), 'k'), 'global|utilMin') >= 0 ? data('tg')[indexof(pluck(data('tg'), 'k'), 'global|utilMin')].v : 0.15)"
    },
    {
      "name": "tgt_utilMax",
      "update": "oneSpoke && indexof(pluck(data('tg'), 'k'), 'spoke|' + oneSpoke + '|utilMax') >= 0 ? data('tg')[indexof(pluck(data('tg'), 'k'), 'spoke|' + oneSpoke + '|utilMax')].v : (indexof(pluck(data('tg'), 'k'), 'global|utilMax') >= 0 ? data('tg')[indexof(pluck(data('tg'), 'k'), 'global|utilMax')].v : 0.6)"
    },
    {
      "name": "tgt_vdiStaleDays",
      "update": "oneSpoke && indexof(pluck(data('tg'), 'k'), 'spoke|' + oneSpoke + '|vdiStaleDays') >= 0 ? data('tg')[indexof(pluck(data('tg'), 'k'), 'spoke|' + oneSpoke + '|vdiStaleDays')].v : (indexof(pluck(data('tg'), 'k'), 'global|vdiStaleDays') >= 0 ? data('tg')[indexof(pluck(data('tg'), 'k'), 'global|vdiStaleDays')].v : 14)"
    },
    {
      "name": "cfg_fyStart",
      "update": "length(data('ref_config')) ? data('ref_config')[0]._source.fiscal_year_start_month : 4"
    },
    {
      "name": "cfg_warn",
      "update": "length(data('ref_config')) ? data('ref_config')[0]._source.warn_margin : 0.1"
    }
  ],
  "data": [
    {
      "name": "raw",
      "url": {
        "index": "ia-workqueue-items",
        "body": {
          "size": 0,
          "query": {
            "bool": {
              "must": [
                "%dashboard_context-must_clause%",
                {
                  "range": {
                    "@timestamp": {
                      "gte": {
                        "%timefilter%": "min",
                        "shift": -732,
                        "unit": "day"
                      },
                      "lte": {
                        "%timefilter%": "max"
                      },
                      "format": "epoch_millis"
                    }
                  }
                },
                {
                  "term": {
                    "mapped": true
                  }
                }
              ],
              "filter": [
                "%dashboard_context-filter_clause%"
              ],
              "must_not": [
                "%dashboard_context-must_not_clause%"
              ]
            }
          },
          "aggs": {
            "win": {
              "filter": {
                "range": {
                  "@timestamp": {
                    "gte": {
                      "%timefilter%": "min",
                      "shift": 1,
                      "unit": "hour"
                    },
                    "lte": {
                      "%timefilter%": "max"
                    },
                    "format": "epoch_millis"
                  }
                }
              },
              "aggs": {
                "d": {
                  "date_histogram": {
                    "field": "@timestamp",
                    "fixed_interval": "1d",
                    "min_doc_count": 0,
                    "extended_bounds": {
                      "min": {
                        "%timefilter%": "min",
                        "shift": 1,
                        "unit": "hour"
                      },
                      "max": {
                        "%timefilter%": "max"
                      }
                    }
                  }
                }
              }
            },
            "days": {
              "date_histogram": {
                "field": "@timestamp",
                "fixed_interval": "1d",
                "min_doc_count": 1
              },
              "aggs": {
                "c": {
                  "sum": {
                    "field": "n.completed"
                  }
                },
                "b": {
                  "sum": {
                    "field": "n.business"
                  }
                },
                "s": {
                  "sum": {
                    "field": "n.system"
                  }
                },
                "e": {
                  "sum": {
                    "field": "n.exception"
                  }
                },
                "a": {
                  "sum": {
                    "field": "n.attempt"
                  }
                },
                "h": {
                  "sum": {
                    "field": "value.hours_saved"
                  }
                },
                "hOn": {
                  "sum": {
                    "field": "value.hours_saved_onshore"
                  }
                },
                "hOff": {
                  "sum": {
                    "field": "value.hours_saved_offshore"
                  }
                },
                "ec": {
                  "sum": {
                    "field": "cost.estate_gbp"
                  }
                },
                "cd": {
                  "sum": {
                    "field": "n.case_done"
                  }
                }
              }
            }
          }
        }
      },
      "format": {
        "property": "aggregations"
      }
    },
    {
      "name": "win",
      "source": "raw",
      "transform": [
        {
          "type": "flatten",
          "fields": [
            "win.d.buckets"
          ],
          "as": [
            "_bk"
          ]
        },
        {
          "type": "formula",
          "as": "key",
          "expr": "datum._bk.key"
        },
        {
          "type": "formula",
          "as": "n",
          "expr": "datum._bk.doc_count"
        },
        {
          "type": "project",
          "fields": [
            "key",
            "n"
          ]
        }
      ]
    },
    {
      "name": "days",
      "source": "raw",
      "transform": [
        {
          "type": "flatten",
          "fields": [
            "days.buckets"
          ],
          "as": [
            "_bk"
          ]
        },
        {
          "type": "formula",
          "as": "key",
          "expr": "datum._bk.key"
        },
        {
          "type": "formula",
          "as": "n",
          "expr": "datum._bk.doc_count"
        },
        {
          "type": "formula",
          "as": "c",
          "expr": "datum._bk[\"c\"] ? (datum._bk[\"c\"].value || 0) : 0"
        },
        {
          "type": "formula",
          "as": "b",
          "expr": "datum._bk[\"b\"] ? (datum._bk[\"b\"].value || 0) : 0"
        },
        {
          "type": "formula",
          "as": "s",
          "expr": "datum._bk[\"s\"] ? (datum._bk[\"s\"].value || 0) : 0"
        },
        {
          "type": "formula",
          "as": "e",
          "expr": "datum._bk[\"e\"] ? (datum._bk[\"e\"].value || 0) : 0"
        },
        {
          "type": "formula",
          "as": "a",
          "expr": "datum._bk[\"a\"] ? (datum._bk[\"a\"].value || 0) : 0"
        },
        {
          "type": "formula",
          "as": "h",
          "expr": "datum._bk[\"h\"] ? (datum._bk[\"h\"].value || 0) : 0"
        },
        {
          "type": "formula",
          "as": "hOn",
          "expr": "datum._bk[\"hOn\"] ? (datum._bk[\"hOn\"].value || 0) : 0"
        },
        {
          "type": "formula",
          "as": "hOff",
          "expr": "datum._bk[\"hOff\"] ? (datum._bk[\"hOff\"].value || 0) : 0"
        },
        {
          "type": "formula",
          "as": "ec",
          "expr": "datum._bk[\"ec\"] ? (datum._bk[\"ec\"].value || 0) : 0"
        },
        {
          "type": "formula",
          "as": "cd",
          "expr": "datum._bk[\"cd\"] ? (datum._bk[\"cd\"].value || 0) : 0"
        },
        {
          "type": "project",
          "fields": [
            "key",
            "n",
            "c",
            "b",
            "s",
            "e",
            "a",
            "h",
            "hOn",
            "hOff",
            "ec",
            "cd"
          ]
        }
      ]
    },
    {
      "name": "series",
      "source": "win",
      "transform": [
        {
          "type": "lookup",
          "from": "days",
          "key": "key",
          "fields": [
            "key"
          ],
          "as": [
            "d"
          ]
        },
        {
          "type": "formula",
          "as": "t",
          "expr": "datum.key"
        },
        {
          "type": "formula",
          "as": "c",
          "expr": "datum.d ? datum.d.c : 0"
        },
        {
          "type": "formula",
          "as": "b",
          "expr": "datum.d ? datum.d.b : 0"
        },
        {
          "type": "formula",
          "as": "s",
          "expr": "datum.d ? datum.d.s : 0"
        },
        {
          "type": "formula",
          "as": "e",
          "expr": "datum.d ? datum.d.e : 0"
        },
        {
          "type": "formula",
          "as": "a",
          "expr": "datum.d ? datum.d.a : 0"
        },
        {
          "type": "formula",
          "as": "h",
          "expr": "datum.d ? datum.d.h : 0"
        },
        {
          "type": "formula",
          "as": "hOn",
          "expr": "datum.d ? datum.d.hOn : 0"
        },
        {
          "type": "formula",
          "as": "hOff",
          "expr": "datum.d ? datum.d.hOff : 0"
        },
        {
          "type": "formula",
          "as": "ec",
          "expr": "datum.d ? datum.d.ec : 0"
        },
        {
          "type": "formula",
          "as": "cd",
          "expr": "datum.d ? datum.d.cd : 0"
        }
      ]
    },
    {
      "name": "tot",
      "source": "days",
      "transform": [
        {
          "type": "formula",
          "as": "cur_c",
          "expr": "datum.key >= lo && datum.key <= hi ? datum.c : 0"
        },
        {
          "type": "formula",
          "as": "prev_c",
          "expr": "datum.key >= plo && datum.key <= phi ? datum.c : 0"
        },
        {
          "type": "formula",
          "as": "cur_b",
          "expr": "datum.key >= lo && datum.key <= hi ? datum.b : 0"
        },
        {
          "type": "formula",
          "as": "prev_b",
          "expr": "datum.key >= plo && datum.key <= phi ? datum.b : 0"
        },
        {
          "type": "formula",
          "as": "cur_s",
          "expr": "datum.key >= lo && datum.key <= hi ? datum.s : 0"
        },
        {
          "type": "formula",
          "as": "prev_s",
          "expr": "datum.key >= plo && datum.key <= phi ? datum.s : 0"
        },
        {
          "type": "formula",
          "as": "cur_e",
          "expr": "datum.key >= lo && datum.key <= hi ? datum.e : 0"
        },
        {
          "type": "formula",
          "as": "prev_e",
          "expr": "datum.key >= plo && datum.key <= phi ? datum.e : 0"
        },
        {
          "type": "formula",
          "as": "cur_a",
          "expr": "datum.key >= lo && datum.key <= hi ? datum.a : 0"
        },
        {
          "type": "formula",
          "as": "prev_a",
          "expr": "datum.key >= plo && datum.key <= phi ? datum.a : 0"
        },
        {
          "type": "formula",
          "as": "cur_h",
          "expr": "datum.key >= lo && datum.key <= hi ? datum.h : 0"
        },
        {
          "type": "formula",
          "as": "prev_h",
          "expr": "datum.key >= plo && datum.key <= phi ? datum.h : 0"
        },
        {
          "type": "formula",
          "as": "cur_hOn",
          "expr": "datum.key >= lo && datum.key <= hi ? datum.hOn : 0"
        },
        {
          "type": "formula",
          "as": "prev_hOn",
          "expr": "datum.key >= plo && datum.key <= phi ? datum.hOn : 0"
        },
        {
          "type": "formula",
          "as": "cur_hOff",
          "expr": "datum.key >= lo && datum.key <= hi ? datum.hOff : 0"
        },
        {
          "type": "formula",
          "as": "prev_hOff",
          "expr": "datum.key >= plo && datum.key <= phi ? datum.hOff : 0"
        },
        {
          "type": "formula",
          "as": "cur_ec",
          "expr": "datum.key >= lo && datum.key <= hi ? datum.ec : 0"
        },
        {
          "type": "formula",
          "as": "prev_ec",
          "expr": "datum.key >= plo && datum.key <= phi ? datum.ec : 0"
        },
        {
          "type": "formula",
          "as": "cur_cd",
          "expr": "datum.key >= lo && datum.key <= hi ? datum.cd : 0"
        },
        {
          "type": "formula",
          "as": "prev_cd",
          "expr": "datum.key >= plo && datum.key <= phi ? datum.cd : 0"
        },
        {
          "type": "aggregate",
          "ops": [
            "sum",
            "sum",
            "sum",
            "sum",
            "sum",
            "sum",
            "sum",
            "sum",
            "sum",
            "sum",
            "sum",
            "sum",
            "sum",
            "sum",
            "sum",
            "sum",
            "sum",
            "sum",
            "sum",
            "sum"
          ],
          "fields": [
            "cur_c",
            "prev_c",
            "cur_b",
            "prev_b",
            "cur_s",
            "prev_s",
            "cur_e",
            "prev_e",
            "cur_a",
            "prev_a",
            "cur_h",
            "prev_h",
            "cur_hOn",
            "prev_hOn",
            "cur_hOff",
            "prev_hOff",
            "cur_ec",
            "prev_ec",
            "cur_cd",
            "prev_cd"
          ],
          "as": [
            "cur_c",
            "prev_c",
            "cur_b",
            "prev_b",
            "cur_s",
            "prev_s",
            "cur_e",
            "prev_e",
            "cur_a",
            "prev_a",
            "cur_h",
            "prev_h",
            "cur_hOn",
            "prev_hOn",
            "cur_hOff",
            "prev_hOff",
            "cur_ec",
            "prev_ec",
            "cur_cd",
            "prev_cd"
          ]
        }
      ]
    },
    {
      "name": "ref_targets",
      "url": {
        "index": "ia-reference",
        "body": {
          "size": 200,
          "query": {
            "term": {
              "doc_type": "target"
            }
          }
        }
      },
      "format": {
        "property": "hits.hits"
      }
    },
    {
      "name": "tg",
      "source": "ref_targets",
      "transform": [
        {
          "type": "formula",
          "as": "k",
          "expr": "datum._source.scope === 'global' ? 'global|' + datum._source.metric : datum._source.scope + '|' + datum._source.scope_id + '|' + datum._source.metric"
        },
        {
          "type": "formula",
          "as": "v",
          "expr": "datum._source.value"
        }
      ]
    },
    {
      "name": "ref_config",
      "url": {
        "index": "ia-reference",
        "body": {
          "size": 1,
          "query": {
            "term": {
              "doc_type": "config"
            }
          }
        }
      },
      "format": {
        "property": "hits.hits"
      }
    },
    {
      "name": "scope_spokes",
      "url": {
        "index": "ia-workqueue-items",
        "body": {
          "size": 0,
          "query": {
            "bool": {
              "must": [
                "%dashboard_context-must_clause%",
                {
                  "range": {
                    "outcome_date": {
                      "gt": {
                        "%timefilter%": "min",
                        "shift": -23,
                        "unit": "hour"
                      },
                      "format": "epoch_millis"
                    }
                  }
                },
                {
                  "range": {
                    "@timestamp": {
                      "lte": {
                        "%timefilter%": "max"
                      },
                      "format": "epoch_millis"
                    }
                  }
                }
              ],
              "filter": [
                "%dashboard_context-filter_clause%"
              ],
              "must_not": [
                "%dashboard_context-must_not_clause%"
              ]
            }
          },
          "aggs": {
            "m": {
              "filter": {
                "term": {
                  "mapped": true
                }
              },
              "aggs": {
                "s": {
                  "terms": {
                    "field": "spoke.name",
                    "size": 2
                  }
                }
              }
            }
          }
        }
      },
      "format": {
        "property": "aggregations.m.s.buckets"
      }
    },
    {
      "name": "tiles",
      "values": [
        {
          "i": 0,
          "label": "Completion rate",
          "accent": "#0B8A6B",
          "deltaGood": "up"
        },
        {
          "i": 1,
          "label": "Cost per completed item",
          "accent": "#2A6A5F",
          "deltaGood": "down"
        },
        {
          "i": 2,
          "label": "Exceptions",
          "accent": "#B6462F",
          "deltaGood": "down"
        },
        {
          "i": 3,
          "label": "Cases completed",
          "accent": "#B9852C",
          "deltaGood": "up"
        },
        {
          "i": 4,
          "label": "Items completed",
          "accent": "#0F4D43",
          "deltaGood": "up"
        },
        {
          "i": 5,
          "label": "Colleague time saved",
          "accent": "#2A6A5F",
          "deltaGood": "up"
        }
      ],
      "transform": [
        {
