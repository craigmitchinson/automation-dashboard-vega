    {
      "name": "ref_targets",
      "url": {
        "index": "ia-reference",
        "body": {
          "size": 200,
          "query": {
            "term": {
              "doc_type": "target"
            }
          }
        }
      },
      "format": {
        "property": "hits.hits"
      }
    },
    {
      "name": "tg",
      "source": "ref_targets",
      "transform": [
        {
          "type": "formula",
          "as": "k",
          "expr": "datum._source.scope === 'global' ? 'global|' + datum._source.metric : datum._source.scope + '|' + datum._source.scope_id + '|' + datum._source.metric"
        },
        {
          "type": "formula",
          "as": "v",
          "expr": "datum._source.value"
        }
      ]
    },
    {
      "name": "ref_config",
      "url": {
        "index": "ia-reference",
        "body": {
          "size": 1,
          "query": {
            "term": {
              "doc_type": "config"
            }
          }
        }
      },
      "format": {
        "property": "hits.hits"
      }
    },
    {
      "name": "scope_spokes",
      "url": {
        "%context%": true,
        "%timefield%": "@timestamp",
        "index": "ia-workqueue-items",
        "body": {
          "size": 0,
          "aggs": {
            "m": {
              "filter": {
                "term": {
                  "mapped": true
                }
              },
              "aggs": {
                "s": {
                  "terms": {
                    "field": "spoke.name",
                    "size": 2
                  }
                }
              }
            }
          }
        }
      },
      "format": {
        "property": "aggregations.m.s.buckets"
      }
    },
    {
      "name": "wdph",
      "url": {
        "index": "ia-cost-daily",
        "body": {
          "size": 1,
          "query": {
            "bool": {
              "filter": [
