{
  "$schema": "https://vega.github.io/schema/vega/v5.json",
  "description": "IA · Overview · Throughput by process. Generated by vega/build.mjs from vega/panels/overview.mjs, do not edit by hand.",
  "autosize": {
    "type": "fit",
    "contains": "padding"
  },
  "padding": 0,
  "config": {
    "background": "#FFFFFF",
    "padding": 0,
    "font": "Inter, 'Segoe UI', Carlito, Calibri, Arial, sans-serif",
    "text": {
      "font": "Inter, 'Segoe UI', Carlito, Calibri, Arial, sans-serif",
      "fill": "#0F4D43",
      "fontSize": 12
    },
    "axis": {
      "gridColor": "#E6E8E2",
      "labelFont": "'JetBrains Mono', Consolas, 'Roboto Mono', monospace",
      "labelFontSize": 10,
      "labelColor": "#5F6E69",
      "titleFont": "'JetBrains Mono', Consolas, 'Roboto Mono', monospace",
      "titleColor": "#5F6E69",
      "titleFontSize": 10,
      "titleFontWeight": 400,
      "domain": false,
      "ticks": false,
      "gridWidth": 1,
      "labelPadding": 6
    },
    "style": {
      "guide-label": {
        "font": "'JetBrains Mono', Consolas, 'Roboto Mono', monospace"
      }
    },
    "view": {
      "stroke": null
    },
    "kibana": {
      "renderer": "svg",
      "hideWarnings": true
    }
  },
  "signals": [
    {
      "name": "headerRight",
      "value": 0
    },
    {
      "name": "top",
      "value": 42
    },
    {
      "name": "cw",
      "update": "width - 32"
    },
    {
      "name": "ch",
      "update": "height - top - 16"
    },
    {
      "name": "pick",
      "on": [
        {
          "events": "@hb_row:click",
          "update": "kibanaAddFilter({'match_phrase': {'process.name': datum.label}}, 'ia-workqueue-items*')"
        }
      ]
    },
    {
      "name": "hb_fit",
      "update": "max(1, floor((ch) / 34))"
    }
  ],
  "data": [
    {
      "name": "procs_raw",
      "url": {
        "index": "ia-reference",
        "body": {
          "size": 500,
          "query": {
            "term": {
              "doc_type": "process"
            }
          }
        }
      },
      "format": {
        "property": "hits.hits"
      }
    },
    {
      "name": "procs",
      "source": "procs_raw",
      "transform": [
        {
          "type": "formula",
          "as": "name",
          "expr": "datum._source.process.name"
        },
        {
          "type": "formula",
          "as": "pid",
          "expr": "datum._source.process.id"
        },
        {
          "type": "formula",
          "as": "acronym",
          "expr": "datum._source.process.acronym"
        },
        {
          "type": "formula",
          "as": "spoke",
          "expr": "datum._source.spoke.name"
        },
        {
          "type": "formula",
          "as": "spokeColor",
          "expr": "datum._source.spoke.color"
        },
        {
          "type": "formula",
          "as": "proposition",
          "expr": "datum._source.proposition.name"
        },
        {
          "type": "formula",
          "as": "queue",
          "expr": "datum._source.primary_queue"
        },
        {
          "type": "formula",
          "as": "queues",
          "expr": "join(datum._source.queues, ' → ')"
        },
        {
          "type": "formula",
          "as": "description",
          "expr": "datum._source.process.description"
        },
        {
          "type": "formula",
          "as": "tags",
          "expr": "datum._source.process.tags"
        },
        {
          "type": "formula",
          "as": "smv",
          "expr": "datum._source.process.smv_minutes"
        },
        {
          "type": "formula",
          "as": "grade",
          "expr": "datum._source.process.grade"
        },
        {
          "type": "formula",
          "as": "gradeName",
          "expr": "datum._source.process.grade_name"
        },
        {
          "type": "formula",
          "as": "rate",
          "expr": "datum._source.process.current_rate_gbp"
        }
      ]
    },
    {
      "name": "bp_raw",
      "url": {
        "%context%": true,
        "%timefield%": "@timestamp",
        "index": "ia-workqueue-items",
        "body": {
          "size": 0,
          "aggs": {
            "m": {
              "filter": {
                "term": {
                  "mapped": true
                }
              },
              "aggs": {
                "p": {
                  "terms": {
                    "field": "process.name",
                    "size": 100
                  },
                  "aggs": {
                    "c": {
                      "sum": {
                        "field": "n.completed"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      },
      "format": {
        "property": "aggregations.m.p.buckets"
      }
    },
    {
      "name": "bp",
      "source": "bp_raw",
      "transform": [
        {
          "type": "formula",
          "as": "name",
          "expr": "datum.key"
        },
        {
          "type": "formula",
          "as": "c",
          "expr": "datum['c'].value"
        },
        {
          "type": "lookup",
          "from": "procs",
          "key": "name",
          "fields": [
            "name"
          ],
          "as": [
            "ref"
          ]
        },
        {
          "type": "formula",
          "as": "spoke",
          "expr": "datum.ref ? datum.ref.spoke : ''"
        },
        {
          "type": "formula",
          "as": "spokeColor",
          "expr": "datum.ref ? datum.ref.spokeColor : '#5F6E69'"
        },
        {
          "type": "formula",
          "as": "queue",
          "expr": "datum.ref ? datum.ref.queue : ''"
        },
        {
          "type": "formula",
          "as": "proposition",
          "expr": "datum.ref ? datum.ref.proposition : ''"
        }
      ]
    },
    {
      "name": "bars",
      "source": "bp",
      "transform": [
        {
          "type": "collect",
          "sort": {
            "field": "c",
            "order": "descending"
          }
        },
        {
          "type": "window",
          "ops": [
            "row_number"
          ],
          "as": [
            "r"
          ]
        },
        {
          "type": "filter",
          "expr": "datum.r <= 7"
        },
        {
          "type": "formula",
          "as": "label",
          "expr": "datum.name"
        },
        {
          "type": "formula",
          "as": "value",
          "expr": "datum.c"
        },
        {
          "type": "formula",
          "as": "display",
          "expr": "(isValid((datum.c)) && isFinite((datum.c)) ? (abs((datum.c)) >= 1e6 ? format((datum.c) / 1e6, abs((datum.c)) >= 1e7 ? '.0f' : '.1f') + 'M' : abs((datum.c)) >= 1e3 ? format((datum.c) / 1e3, abs((datum.c)) >= 1e4 ? '.0f' : '.1f') + 'k' : format((datum.c), '.0f')) : '–')"
        },
        {
          "type": "formula",
          "as": "color",
          "expr": "'#0F4D43'"
        }
      ]
    },
    {
      "name": "hb_rows",
      "source": "bars",
      "transform": [
        {
          "type": "window",
          "ops": [
            "row_number"
          ],
          "as": [
            "rank"
          ]
        },
        {
          "type": "filter",
          "expr": "datum.rank <= hb_fit"
        }
      ]
    }
  ],
  "scales": [
    {
      "name": "hb_x",
      "type": "linear",
      "domain": {
        "data": "bars",
        "field": "value"
      },
      "range": [
        0,
        {
          "signal": "cw - 224"
        }
      ],
      "zero": true,
      "nice": false
    }
  ],
  "marks": [
    {
      "type": "text",
      "name": "frame_title",
      "encode": {
        "update": {
          "x": {
            "value": 16
          },
          "y": {
            "value": 18
          },
          "baseline": {
            "value": "top"
          },
          "font": {
            "value": "'JetBrains Mono', Consolas, 'Roboto Mono', monospace"
          },
          "fontSize": {
            "value": 11
          },
          "fontWeight": {
            "value": 600
          },
          "fill": {
            "value": "#0F4D43"
          },
          "text": {
            "signal": "'THROUGHPUT BY PROCESS'"
          },
          "limit": {
            "signal": "width - 32"
          }
        }
      }
    },
    {
      "type": "text",
      "encode": {
        "update": {
          "x": {
            "signal": "16 + length('THROUGHPUT BY PROCESS') * 6.9 + 10"
          },
          "y": {
            "value": 17
          },
          "baseline": {
            "value": "top"
          },
          "font": {
            "value": "Inter, 'Segoe UI', Carlito, Calibri, Arial, sans-serif"
          },
          "fontSize": {
            "value": 12
          },
          "fill": {
            "value": "#5F6E69"
          },
          "text": {
            "value": "Completed cases · click a bar to filter every panel"
          },
          "limit": {
            "signal": "width - 42 - length('THROUGHPUT BY PROCESS') * 6.9 - 0 - headerRight"
          }
        }
      }
    },
    {
      "type": "group",
      "name": "hb_row",
      "from": {
        "data": "hb_rows"
      },
      "encode": {
        "update": {
          "x": {
            "value": 16
          },
          "y": {
            "signal": "top + (datum.rank - 1) * 34"
          },
          "width": {
            "signal": "cw"
          },
          "height": {
            "value": 34
          },
          "fill": {
            "value": "transparent"
          },
          "cursor": {
            "value": "pointer"
          },
          "opacity": {
            "value": 1
          }
        }
      },
      "marks": [
        {
          "type": "text",
          "encode": {
            "update": {
              "x": {
                "value": 0
              },
              "y": {
                "value": 17
              },
              "baseline": {
                "value": "middle"
              },
              "font": {
                "value": "Inter, 'Segoe UI', Carlito, Calibri, Arial, sans-serif"
              },
              "fontSize": {
                "value": 12.5
              },
              "fill": {
                "value": "#0F4D43"
              },
              "text": {
                "field": {
                  "parent": "label"
                }
              },
              "limit": {
                "value": 150
              }
            }
          }
        },
        {
          "type": "rect",
          "encode": {
            "update": {
              "x": {
                "value": 160
              },
              "y": {
                "value": 12
              },
              "width": {
                "signal": "cw - 224"
              },
              "height": {
                "value": 10
              },
              "fill": {
                "value": "#E6E8E2"
              },
              "cornerRadius": {
                "value": 5
              }
            }
          }
        },
        {
          "type": "rect",
          "encode": {
            "update": {
              "x": {
                "value": 160
              },
              "y": {
                "value": 12
              },
              "width": {
                "signal": "max(2, scale('hb_x', parent.value))"
              },
              "height": {
                "value": 10
              },
              "fill": {
                "field": {
                  "parent": "color"
                }
              },
              "cornerRadius": {
                "value": 5
              },
              "tooltip": {
                "signal": "{'': parent.label, 'Value': parent.display}"
              }
            }
          }
        },
        {
          "type": "text",
          "encode": {
            "update": {
              "x": {
                "signal": "cw"
              },
              "y": {
                "value": 17
              },
              "align": {
                "value": "right"
              },
              "baseline": {
                "value": "middle"
              },
              "font": {
                "value": "'JetBrains Mono', Consolas, 'Roboto Mono', monospace"
              },
              "fontSize": {
                "value": 12
              },
              "fontWeight": {
                "value": 600
              },
              "fill": {
                "value": "#0F4D43"
              },
              "text": {
                "field": {
                  "parent": "display"
                }
              }
            }
          }
        }
      ]
    },
    {
      "type": "text",
      "encode": {
        "update": {
          "x": {
            "signal": "width - 16"
          },
          "y": {
            "signal": "top + ch - 4"
          },
          "align": {
            "value": "right"
          },
          "font": {
            "value": "'JetBrains Mono', Consolas, 'Roboto Mono', monospace"
          },
          "fontSize": {
            "value": 10
          },
          "fill": {
            "value": "#5F6E69"
          },
          "text": {
            "signal": "length(data('bars')) > hb_fit ? '+' + (length(data('bars')) - hb_fit) + ' more' : ''"
          }
        }
      }
    }
  ]
}
