{
  "$schema": "https://vega.github.io/schema/vega/v5.json",
  "description": "IA · Process detail · Top exceptions. Generated by vega/build.mjs from vega/panels/process-detail.mjs, do not edit by hand.",
  "autosize": {
    "type": "fit",
    "contains": "padding"
  },
  "padding": 0,
  "config": {
    "background": "#FAF7F2",
    "padding": 0,
    "font": "Calibri, Carlito, 'Segoe UI', Inter, Arial, sans-serif",
    "text": {
      "font": "Calibri, Carlito, 'Segoe UI', Inter, Arial, sans-serif",
      "fill": "#0B3239",
      "fontSize": 12
    },
    "axis": {
      "labelFont": "'JetBrains Mono', 'Roboto Mono', Consolas, 'Courier New', monospace",
      "labelFontSize": 10,
      "labelColor": "#5A7378",
      "titleFont": "'JetBrains Mono', 'Roboto Mono', Consolas, 'Courier New', monospace",
      "titleColor": "#5A7378",
      "titleFontSize": 10,
      "titleFontWeight": 400,
      "domain": false,
      "ticks": false,
      "gridColor": "#DCDCD7",
      "gridWidth": 1,
      "labelPadding": 6
    },
    "style": {
      "guide-label": {
        "font": "'JetBrains Mono', 'Roboto Mono', Consolas, 'Courier New', monospace"
      }
    },
    "view": {
      "stroke": null
    },
    "kibana": {
      "renderer": "svg",
      "hideWarnings": true
    }
  },
  "signals": [
    {
      "name": "top",
      "value": 56
    },
    {
      "name": "cw",
      "update": "width - 32"
    },
    {
      "name": "ch",
      "update": "height - top - 16"
    },
    {
      "name": "hb_fit",
      "update": "max(1, floor((ch) / 34))"
    }
  ],
  "data": [
    {
      "name": "procs_raw",
      "url": {
        "index": "ia-reference",
        "body": {
          "size": 500,
          "query": {
            "term": {
              "doc_type": "process"
            }
          }
        }
      },
      "format": {
        "property": "hits.hits"
      }
    },
    {
      "name": "procs",
      "source": "procs_raw",
      "transform": [
        {
          "type": "formula",
          "as": "name",
          "expr": "datum._source.process.name"
        },
        {
          "type": "formula",
          "as": "pid",
          "expr": "datum._source.process.id"
        },
        {
          "type": "formula",
          "as": "acronym",
          "expr": "datum._source.process.acronym"
        },
        {
          "type": "formula",
          "as": "spoke",
          "expr": "datum._source.spoke.name"
        },
        {
          "type": "formula",
          "as": "spokeColor",
          "expr": "datum._source.spoke.color"
        },
        {
          "type": "formula",
          "as": "proposition",
          "expr": "datum._source.proposition.name"
        },
        {
          "type": "formula",
          "as": "queue",
          "expr": "datum._source.primary_queue"
        },
        {
          "type": "formula",
          "as": "queues",
          "expr": "join(datum._source.queues, ' → ')"
        },
        {
          "type": "formula",
          "as": "description",
          "expr": "datum._source.process.description"
        },
        {
          "type": "formula",
          "as": "tags",
          "expr": "datum._source.process.tags"
        },
        {
          "type": "formula",
          "as": "smv",
          "expr": "datum._source.process.smv_minutes"
        },
        {
          "type": "formula",
          "as": "grade",
          "expr": "datum._source.process.grade"
        },
        {
          "type": "formula",
          "as": "gradeName",
          "expr": "datum._source.process.grade_name"
        },
        {
          "type": "formula",
          "as": "rate",
          "expr": "datum._source.process.current_rate_gbp"
        }
      ]
    },
    {
      "name": "bp_raw",
      "url": {
        "%context%": true,
        "%timefield%": "@timestamp",
        "index": "ia-workqueue-items",
        "body": {
          "size": 0,
          "aggs": {
            "m": {
              "filter": {
                "term": {
                  "mapped": true
                }
              },
              "aggs": {
                "p": {
                  "terms": {
                    "field": "process.name",
                    "size": 100
                  },
                  "aggs": {
                    "a": {
                      "sum": {
                        "field": "n.attempt"
                      }
                    },
                    "rw": {
                      "sum": {
                        "field": "value.rework_gbp"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      },
      "format": {
        "property": "aggregations.m.p.buckets"
      }
    },
    {
      "name": "bp",
      "source": "bp_raw",
      "transform": [
        {
          "type": "formula",
          "as": "name",
          "expr": "datum.key"
        },
        {
          "type": "formula",
          "as": "a",
          "expr": "datum['a'].value"
        },
        {
          "type": "formula",
          "as": "rw",
          "expr": "datum['rw'].value"
        },
        {
          "type": "lookup",
          "from": "procs",
          "key": "name",
          "fields": [
            "name"
          ],
          "as": [
            "ref"
          ]
        },
        {
          "type": "formula",
          "as": "spoke",
          "expr": "datum.ref ? datum.ref.spoke : ''"
        },
        {
          "type": "formula",
          "as": "spokeColor",
          "expr": "datum.ref ? datum.ref.spokeColor : '#5A7378'"
        },
        {
          "type": "formula",
          "as": "queue",
          "expr": "datum.ref ? datum.ref.queue : ''"
        },
        {
          "type": "formula",
          "as": "proposition",
          "expr": "datum.ref ? datum.ref.proposition : ''"
        }
      ]
    },
    {
      "name": "te_raw",
      "url": {
        "%context%": true,
        "%timefield%": "@timestamp",
        "index": "ia-workqueue-items",
        "body": {
          "size": 0,
          "aggs": {
            "m": {
              "filter": {
                "bool": {
                  "filter": [
                    {
                      "term": {
                        "mapped": true
                      }
                    },
                    {
                      "term": {
                        "outcome": "Exception"
                      }
                    }
                  ]
                }
              },
              "aggs": {
                "r": {
                  "terms": {
                    "field": "exception.reason_display",
                    "size": 7
                  },
                  "aggs": {
                    "t": {
                      "terms": {
                        "field": "exception.type",
                        "size": 1
                      }
                    }
                  }
                }
              }
            }
          }
        }
      },
      "format": {
        "property": "aggregations.m.r.buckets"
      }
    },
    {
      "name": "te",
      "source": "te_raw",
      "transform": [
        {
          "type": "filter",
          "expr": "length(data('bp')) === 1"
        },
        {
          "type": "formula",
          "as": "label",
          "expr": "datum.key"
        },
        {
          "type": "formula",
          "as": "value",
          "expr": "datum.doc_count"
        },
        {
          "type": "formula",
          "as": "display",
          "expr": "(isValid((datum.doc_count)) && isFinite((datum.doc_count)) ? (abs((datum.doc_count)) >= 1e6 ? format((datum.doc_count) / 1e6, abs((datum.doc_count)) >= 1e7 ? '.0f' : '.1f') + 'M' : abs((datum.doc_count)) >= 1e3 ? format((datum.doc_count) / 1e3, abs((datum.doc_count)) >= 1e4 ? '.0f' : '.1f') + 'k' : format((datum.doc_count), '.0f')) : '–')"
        },
        {
          "type": "formula",
          "as": "color",
          "expr": "datum.t.buckets[0].key === 'System' ? '#FF222F' : '#8A6FB0'"
        }
      ]
    },
    {
      "name": "hb_rows",
      "source": "te",
      "transform": [
        {
          "type": "window",
          "ops": [
            "row_number"
          ],
          "as": [
            "rank"
          ]
        },
        {
          "type": "filter",
          "expr": "datum.rank <= hb_fit"
        }
      ]
    }
  ],
  "scales": [
    {
      "name": "hb_x",
      "type": "linear",
      "domain": {
        "data": "te",
        "field": "value"
      },
      "range": [
        0,
        {
          "signal": "cw - 286"
        }
      ],
      "zero": true,
      "nice": false
    }
  ],
  "marks": [
    {
      "type": "text",
      "name": "frame_title",
      "encode": {
        "update": {
          "x": {
            "value": 16
          },
          "y": {
            "value": 16
          },
          "baseline": {
            "value": "top"
          },
          "font": {
            "value": "Georgia, Gelasio, 'Times New Roman', serif"
          },
          "fontSize": {
            "value": 16
          },
          "fontWeight": {
            "value": "bold"
          },
          "fill": {
            "value": "#0B3239"
          },
          "text": {
            "value": "Top exceptions"
          },
          "limit": {
            "signal": "width - 32"
          }
        }
      }
    },
    {
      "type": "text",
      "encode": {
        "update": {
          "x": {
            "value": 16
          },
          "y": {
            "value": 38
          },
          "baseline": {
            "value": "top"
          },
          "font": {
            "value": "Calibri, Carlito, 'Segoe UI', Inter, Arial, sans-serif"
          },
          "fontSize": {
            "value": 12
          },
          "fill": {
            "value": "#5A7378"
          },
          "text": {
            "signal": "'By volume for this process · ' + (isValid(((length(data('bp')) ? data('bp')[0].rw : 0))) && isFinite(((length(data('bp')) ? data('bp')[0].rw : 0))) ? (((length(data('bp')) ? data('bp')[0].rw : 0)) < 0 ? '-' : '') + '£' + format(round(abs(((length(data('bp')) ? data('bp')[0].rw : 0)))), ',') : '–') + ' exception cost (period)'"
          },
          "limit": {
            "signal": "width - 32"
          }
        }
      }
    },
    {
      "type": "text",
      "encode": {
        "update": {
          "x": {
            "signal": "width / 2"
          },
          "y": {
            "signal": "top + ch / 2"
          },
          "align": {
            "value": "center"
          },
          "baseline": {
            "value": "middle"
          },
          "font": {
            "value": "Calibri, Carlito, 'Segoe UI', Inter, Arial, sans-serif"
          },
          "fontSize": {
            "value": 13
          },
          "fill": {
            "value": "#5A7378"
          },
          "text": {
            "value": "Pick a single process (click a tile above, or use the Process control)."
          },
          "opacity": {
            "signal": "(!(length(data('bp')) === 1)) ? 1 : 0"
          }
        }
      }
    },
    {
      "type": "group",
      "name": "hb_row",
      "from": {
        "data": "hb_rows"
      },
      "encode": {
        "update": {
          "x": {
            "value": 16
          },
          "y": {
            "signal": "top + (datum.rank - 1) * 34"
          },
          "width": {
            "signal": "cw"
          },
          "height": {
            "value": 34
          },
          "fill": {
            "value": "transparent"
          },
          "opacity": {
            "value": 1
          }
        }
      },
      "marks": [
        {
          "type": "text",
          "encode": {
            "update": {
              "x": {
                "value": 0
              },
              "y": {
                "value": 17
              },
              "baseline": {
                "value": "middle"
              },
              "font": {
                "value": "Calibri, Carlito, 'Segoe UI', Inter, Arial, sans-serif"
              },
              "fontSize": {
                "value": 13
              },
              "fill": {
                "value": "#0B3239"
              },
              "text": {
                "field": {
                  "parent": "label"
                }
              },
              "limit": {
                "value": 220
              }
            }
          }
        },
        {
          "type": "rect",
          "encode": {
            "update": {
              "x": {
                "value": 230
              },
              "y": {
                "value": 10
              },
              "width": {
                "signal": "cw - 286"
              },
              "height": {
                "value": 14
              },
              "fill": {
                "value": "#E4E3DE"
              },
              "cornerRadius": {
                "value": 3
              }
            }
          }
        },
        {
          "type": "rect",
          "encode": {
            "update": {
              "x": {
                "value": 230
              },
              "y": {
                "value": 10
              },
              "width": {
                "signal": "max(2, scale('hb_x', parent.value))"
              },
              "height": {
                "value": 14
              },
              "fill": {
                "field": {
                  "parent": "color"
                }
              },
              "cornerRadius": {
                "value": 3
              },
              "tooltip": {
                "signal": "{'': parent.label, 'Value': parent.display}"
              }
            }
          }
        },
        {
          "type": "text",
          "encode": {
            "update": {
              "x": {
                "signal": "cw"
              },
              "y": {
                "value": 17
              },
              "align": {
                "value": "right"
              },
              "baseline": {
                "value": "middle"
              },
              "font": {
                "value": "'JetBrains Mono', 'Roboto Mono', Consolas, 'Courier New', monospace"
              },
              "fontSize": {
                "value": 12
              },
              "fontWeight": {
                "value": "bold"
              },
              "fill": {
                "value": "#0B3239"
              },
              "text": {
                "field": {
                  "parent": "display"
                }
              }
            }
          }
        }
      ]
    },
    {
      "type": "text",
      "encode": {
        "update": {
          "x": {
            "signal": "width - 16"
          },
          "y": {
            "signal": "top + ch - 4"
          },
          "align": {
            "value": "right"
          },
          "font": {
            "value": "'JetBrains Mono', 'Roboto Mono', Consolas, 'Courier New', monospace"
          },
          "fontSize": {
            "value": 10
          },
          "fill": {
            "value": "#5A7378"
          },
          "text": {
            "signal": "length(data('te')) > hb_fit ? '+' + (length(data('te')) - hb_fit) + ' more' : ''"
          }
        }
      }
    }
  ]
}
