{
  "$schema": "https://vega.github.io/schema/vega/v5.json",
  "description": "IA · Process detail · Process chooser / banner. Generated by vega/build.mjs from vega/panels/process-detail.mjs, do not edit by hand.",
  "autosize": {
    "type": "fit",
    "contains": "padding"
  },
  "padding": 0,
  "config": {
    "background": "#FAF7F2",
    "padding": 0,
    "font": "Calibri, Carlito, 'Segoe UI', Inter, Arial, sans-serif",
    "text": {
      "font": "Calibri, Carlito, 'Segoe UI', Inter, Arial, sans-serif",
      "fill": "#0B3239",
      "fontSize": 12
    },
    "axis": {
      "labelFont": "'JetBrains Mono', 'Roboto Mono', Consolas, 'Courier New', monospace",
      "labelFontSize": 10,
      "labelColor": "#5A7378",
      "titleFont": "'JetBrains Mono', 'Roboto Mono', Consolas, 'Courier New', monospace",
      "titleColor": "#5A7378",
      "titleFontSize": 10,
      "titleFontWeight": 400,
      "domain": false,
      "ticks": false,
      "gridColor": "#DCDCD7",
      "gridWidth": 1,
      "labelPadding": 6
    },
    "style": {
      "guide-label": {
        "font": "'JetBrains Mono', 'Roboto Mono', Consolas, 'Courier New', monospace"
      }
    },
    "view": {
      "stroke": null
    },
    "kibana": {
      "renderer": "svg",
      "hideWarnings": true
    }
  },
  "signals": [
    {
      "name": "pick",
      "on": [
        {
          "events": "@pd_tile0:click, @pd_tile1:click",
          "update": "kibanaAddFilter({'match_phrase': {'process.name': datum.name}}, 'ia-workqueue-items*')"
        }
      ]
    },
    {
      "name": "cols",
      "value": 5
    },
    {
      "name": "tileW",
      "update": "(width - 32 - (cols - 1) * 10) / cols"
    },
    {
      "name": "tileH",
      "value": 32
    },
    {
      "name": "secH",
      "value": 26
    }
  ],
  "data": [
    {
      "name": "procs_raw",
      "url": {
        "index": "ia-reference",
        "body": {
          "size": 500,
          "query": {
            "term": {
              "doc_type": "process"
            }
          }
        }
      },
      "format": {
        "property": "hits.hits"
      }
    },
    {
      "name": "procs",
      "source": "procs_raw",
      "transform": [
        {
          "type": "formula",
          "as": "name",
          "expr": "datum._source.process.name"
        },
        {
          "type": "formula",
          "as": "pid",
          "expr": "datum._source.process.id"
        },
        {
          "type": "formula",
          "as": "acronym",
          "expr": "datum._source.process.acronym"
        },
        {
          "type": "formula",
          "as": "spoke",
          "expr": "datum._source.spoke.name"
        },
        {
          "type": "formula",
          "as": "spokeColor",
          "expr": "datum._source.spoke.color"
        },
        {
          "type": "formula",
          "as": "proposition",
          "expr": "datum._source.proposition.name"
        },
        {
          "type": "formula",
          "as": "queue",
          "expr": "datum._source.primary_queue"
        },
        {
          "type": "formula",
          "as": "queues",
          "expr": "join(datum._source.queues, ' → ')"
        },
        {
          "type": "formula",
          "as": "description",
          "expr": "datum._source.process.description"
        },
        {
          "type": "formula",
          "as": "tags",
          "expr": "datum._source.process.tags"
        },
        {
          "type": "formula",
          "as": "smv",
          "expr": "datum._source.process.smv_minutes"
        },
        {
          "type": "formula",
          "as": "grade",
          "expr": "datum._source.process.grade"
        },
        {
          "type": "formula",
          "as": "gradeName",
          "expr": "datum._source.process.grade_name"
        },
        {
          "type": "formula",
          "as": "rate",
          "expr": "datum._source.process.current_rate_gbp"
        }
      ]
    },
    {
      "name": "ref_spokes",
      "url": {
        "index": "ia-reference",
        "body": {
          "size": 50,
          "query": {
            "term": {
              "doc_type": "spoke"
            }
          }
        }
      },
      "format": {
        "property": "hits.hits"
      }
    },
    {
      "name": "spk",
      "source": "ref_spokes",
      "transform": [
        {
          "type": "formula",
          "as": "name",
          "expr": "datum._source.spoke.name"
        },
        {
          "type": "formula",
          "as": "color",
          "expr": "datum._source.spoke.color"
        }
      ]
    },
    {
      "name": "bp_raw",
      "url": {
        "%context%": true,
        "%timefield%": "@timestamp",
        "index": "ia-workqueue-items",
        "body": {
          "size": 0,
          "aggs": {
            "m": {
              "filter": {
                "term": {
                  "mapped": true
                }
              },
              "aggs": {
                "p": {
                  "terms": {
                    "field": "process.name",
                    "size": 100
                  },
                  "aggs": {
                    "c": {
                      "sum": {
                        "field": "n.completed"
                      }
                    },
                    "a": {
                      "sum": {
                        "field": "n.attempt"
                      }
                    },
                    "e": {
                      "sum": {
                        "field": "n.exception"
                      }
                    },
                    "cw": {
                      "sum": {
                        "field": "worktime_completed_sec"
                      }
                    },
                    "ec": {
                      "sum": {
                        "field": "cost.estate_gbp"
                      }
                    },
                    "h": {
                      "sum": {
                        "field": "value.hours_saved"
                      }
                    },
                    "rw": {
                      "sum": {
                        "field": "value.rework_gbp"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      },
      "format": {
        "property": "aggregations.m.p.buckets"
      }
    },
    {
      "name": "bp",
      "source": "bp_raw",
      "transform": [
        {
          "type": "formula",
          "as": "name",
          "expr": "datum.key"
        },
        {
          "type": "formula",
          "as": "c",
          "expr": "datum['c'].value"
        },
        {
          "type": "formula",
          "as": "a",
          "expr": "datum['a'].value"
        },
        {
          "type": "formula",
          "as": "e",
          "expr": "datum['e'].value"
        },
        {
          "type": "formula",
          "as": "cw",
          "expr": "datum['cw'].value"
        },
        {
          "type": "formula",
          "as": "ec",
          "expr": "datum['ec'].value"
        },
        {
          "type": "formula",
          "as": "h",
          "expr": "datum['h'].value"
        },
        {
          "type": "formula",
          "as": "rw",
          "expr": "datum['rw'].value"
        },
        {
          "type": "lookup",
          "from": "procs",
          "key": "name",
          "fields": [
            "name"
          ],
          "as": [
            "ref"
          ]
        },
        {
          "type": "formula",
          "as": "spoke",
          "expr": "datum.ref ? datum.ref.spoke : ''"
        },
        {
          "type": "formula",
          "as": "spokeColor",
          "expr": "datum.ref ? datum.ref.spokeColor : '#5A7378'"
        },
        {
          "type": "formula",
          "as": "queue",
          "expr": "datum.ref ? datum.ref.queue : ''"
        },
        {
          "type": "formula",
          "as": "proposition",
          "expr": "datum.ref ? datum.ref.proposition : ''"
        }
      ]
    },
    {
      "name": "worst",
      "source": "bp",
      "transform": [
        {
          "type": "filter",
          "expr": "!(length(data('bp')) === 1) && datum.a > 0"
        },
        {
          "type": "formula",
          "as": "rate",
          "expr": "datum.e / datum.a"
        },
        {
          "type": "collect",
          "sort": {
            "field": "rate",
            "order": "descending"
          }
        },
        {
          "type": "window",
          "ops": [
            "row_number"
          ],
          "as": [
            "k"
          ]
        },
        {
          "type": "filter",
          "expr": "datum.k <= 3"
        },
        {
          "type": "formula",
          "as": "x",
          "expr": "(datum.k - 1)"
        },
        {
          "type": "formula",
          "as": "y",
          "expr": "secH"
        }
      ]
    },
    {
      "name": "tiles",
      "source": "procs",
      "transform": [
        {
          "type": "lookup",
          "from": "bp",
          "key": "name",
          "fields": [
            "name"
          ],
          "values": [
            "a"
          ],
          "as": [
            "a"
          ]
        },
        {
          "type": "filter",
          "expr": "!(length(data('bp')) === 1) && isValid(datum.a)"
        },
        {
          "type": "collect",
          "sort": {
            "field": [
              "spoke",
              "name"
            ]
          }
        },
        {
          "type": "window",
          "ops": [
            "row_number"
          ],
          "groupby": [
            "spoke"
          ],
          "as": [
            "j"
          ]
        },
        {
          "type": "formula",
          "as": "col",
          "expr": "(datum.j - 1) % cols"
        },
        {
          "type": "formula",
          "as": "row",
          "expr": "floor((datum.j - 1) / cols)"
        }
      ]
    },
    {
      "name": "rowsPerGroup",
      "source": "tiles",
      "transform": [
        {
          "type": "aggregate",
          "groupby": [
            "spoke"
          ],
          "ops": [
            "count"
          ],
          "as": [
            "n"
          ]
        },
        {
          "type": "formula",
          "as": "rows",
          "expr": "ceil(datum.n / cols)"
        },
        {
          "type": "collect",
          "sort": {
            "field": "spoke"
          }
        },
        {
          "type": "window",
          "ops": [
            "row_number",
            "sum"
          ],
          "fields": [
            null,
            "rows"
          ],
          "as": [
            "g",
            "cumRows"
          ]
        },
        {
          "type": "formula",
          "as": "prevRows",
          "expr": "datum.cumRows - datum.rows"
        }
      ]
    },
    {
      "name": "tilesPos",
      "source": "tiles",
      "transform": [
        {
          "type": "lookup",
          "from": "rowsPerGroup",
          "key": "spoke",
          "fields": [
            "spoke"
          ],
          "values": [
            "g",
            "prevRows"
          ],
          "as": [
            "g",
            "prevRows"
          ]
        },
        {
          "type": "formula",
          "as": "y",
          "expr": "(length(data('worst')) ? secH + tileH + 12 : 0) + datum.g * secH + ((datum.prevRows || 0) + datum.row) * (tileH + 6)"
        },
        {
          "type": "formula",
          "as": "x",
          "expr": "datum.col"
        },
        {
          "type": "formula",
          "as": "badge",
          "expr": "''"
        }
      ]
    },
    {
      "name": "secs",
      "source": "tilesPos",
      "transform": [
        {
          "type": "aggregate",
          "groupby": [
            "spoke"
          ],
          "ops": [
            "min"
          ],
          "fields": [
            "y"
          ],
          "as": [
            "y"
          ]
        }
      ]
    },
    {
      "name": "worstPos",
      "source": "worst",
      "transform": [
        {
          "type": "lookup",
          "from": "procs",
          "key": "name",
          "fields": [
            "name"
          ],
          "values": [
            "queue",
            "spokeColor"
          ],
          "as": [
            "queue",
            "spokeColor"
          ]
        },
        {
          "type": "formula",
          "as": "badge",
          "expr": "(isValid((datum.rate)) && isFinite((datum.rate)) ? format((datum.rate) * 100, '.1f') + '%' : '–')"
        }
      ]
    }
  ],
  "marks": [
    {
      "type": "text",
      "encode": {
        "update": {
          "x": {
            "value": 16
          },
          "y": {
            "value": 16
          },
          "baseline": {
            "value": "top"
          },
          "font": {
            "value": "Georgia, Gelasio, 'Times New Roman', serif"
          },
          "fontSize": {
            "value": 16
          },
          "fontWeight": {
            "value": "bold"
          },
          "fill": {
            "value": "#0B3239"
          },
          "text": {
            "value": "Drill into a process"
          },
          "opacity": {
            "signal": "length(data('bp')) === 1 ? 0 : 1"
          }
        }
      }
    },
    {
      "type": "text",
      "encode": {
        "update": {
          "x": {
            "value": 16
          },
          "y": {
            "value": 38
          },
          "baseline": {
            "value": "top"
          },
          "font": {
            "value": "Calibri, Carlito, 'Segoe UI', Inter, Arial, sans-serif"
          },
          "fontSize": {
            "value": 12
          },
          "fill": {
            "value": "#5A7378"
          },
          "text": {
            "value": "Pick one (click a tile), or choose it in the Process control above"
          },
          "opacity": {
            "signal": "length(data('bp')) === 1 ? 0 : 1"
          }
        }
      }
    },
    {
      "type": "text",
      "encode": {
        "update": {
          "x": {
            "value": 16
          },
          "y": {
            "value": 76
          },
          "font": {
            "value": "'JetBrains Mono', 'Roboto Mono', Consolas, 'Courier New', monospace"
          },
          "fontSize": {
            "value": 11
          },
          "fontWeight": {
            "value": "bold"
          },
          "fill": {
            "value": "#5A7378"
          },
          "text": {
            "signal": "!(length(data('bp')) === 1) && length(data('worst')) ? 'NEEDS ATTENTION · HIGHEST EXCEPTION RATE' : ''"
          }
        }
      }
    },
    {
      "type": "group",
      "from": {
        "data": "secs"
      },
      "encode": {
        "update": {
          "x": {
            "value": 16
          },
          "y": {
            "signal": "64 + datum.y - secH + 6"
          },
          "width": {
            "value": 400
          },
          "height": {
            "value": 20
          }
        }
      },
      "marks": [
        {
          "type": "rect",
          "encode": {
            "update": {
              "x": {
                "value": 0
              },
              "y": {
                "value": 6
              },
              "width": {
                "value": 11
              },
              "height": {
                "value": 11
              },
              "cornerRadius": {
                "value": 3
              },
              "fill": {
                "signal": "(indexof(pluck(data('spk'), 'name'), parent.spoke) >= 0 ? data('spk')[indexof(pluck(data('spk'), 'name'), parent.spoke)].color : '#5A7378')"
              }
            }
          }
        },
        {
          "type": "text",
          "encode": {
            "update": {
              "x": {
                "value": 18
              },
              "y": {
                "value": 12
              },
              "baseline": {
                "value": "middle"
              },
              "font": {
                "value": "'JetBrains Mono', 'Roboto Mono', Consolas, 'Courier New', monospace"
              },
              "fontSize": {
                "value": 11
              },
              "fontWeight": {
                "value": "bold"
              },
              "fill": {
                "value": "#5A7378"
              },
              "text": {
                "signal": "upper(parent.spoke)"
              }
            }
          }
        }
      ]
    },
    {
      "type": "group",
      "name": "pd_tile0",
      "from": {
        "data": "worstPos"
      },
      "encode": {
        "update": {
          "x": {
            "signal": "16 + datum.x * (tileW + 10)"
          },
          "y": {
            "signal": "64 + datum.y"
          },
          "width": {
            "signal": "tileW"
          },
          "height": {
            "signal": "tileH"
          },
          "fill": {
            "value": "#F1EEE8"
          },
          "stroke": {
            "value": "#DCDCD7"
          },
          "cornerRadius": {
            "value": 10
          },
          "cursor": {
            "value": "pointer"
          }
        },
        "hover": {
          "fill": {
            "value": "#E4E3DE"
          }
        }
      },
      "marks": [
        {
          "type": "rect",
          "encode": {
            "update": {
              "x": {
                "value": 0
              },
              "y": {
                "value": 0
              },
              "width": {
                "value": 3
              },
              "height": {
                "signal": "tileH"
              },
              "fill": {
                "signal": "parent.badge ? '#FF222F' : parent.spokeColor"
              },
              "cornerRadiusTopLeft": {
                "value": 10
              },
              "cornerRadiusBottomLeft": {
                "value": 10
              }
            }
          }
        },
        {
          "type": "text",
          "encode": {
            "update": {
              "x": {
                "value": 12
              },
              "y": {
                "signal": "tileH / 2"
              },
              "baseline": {
                "value": "middle"
              },
              "font": {
                "value": "Calibri, Carlito, 'Segoe UI', Inter, Arial, sans-serif"
              },
              "fontSize": {
                "value": 13
              },
              "fontWeight": {
                "value": "bold"
              },
              "fill": {
                "value": "#0B3239"
              },
              "text": {
                "field": {
                  "parent": "name"
                }
              },
              "limit": {
                "signal": "tileW - (parent.badge ? 70 : 20)"
              },
              "tooltip": {
                "signal": "parent.spoke + ' · ' + parent.queue"
              }
            }
          }
        },
        {
          "type": "text",
          "encode": {
            "update": {
              "x": {
                "signal": "tileW - 10"
              },
              "y": {
                "signal": "tileH / 2"
              },
              "align": {
                "value": "right"
              },
              "baseline": {
                "value": "middle"
              },
              "font": {
                "value": "'JetBrains Mono', 'Roboto Mono', Consolas, 'Courier New', monospace"
              },
              "fontSize": {
                "value": 11
              },
              "fontWeight": {
                "value": "bold"
              },
              "fill": {
                "value": "#FF222F"
              },
              "text": {
                "field": {
                  "parent": "badge"
                }
              }
            }
          }
        }
      ]
    },
    {
      "type": "group",
      "name": "pd_tile1",
      "from": {
        "data": "tilesPos"
      },
      "encode": {
        "update": {
          "x": {
            "signal": "16 + datum.x * (tileW + 10)"
          },
          "y": {
            "signal": "64 + datum.y"
          },
          "width": {
            "signal": "tileW"
          },
          "height": {
            "signal": "tileH"
          },
          "fill": {
            "value": "#F1EEE8"
          },
          "stroke": {
            "value": "#DCDCD7"
          },
          "cornerRadius": {
            "value": 10
          },
          "cursor": {
            "value": "pointer"
          }
        },
        "hover": {
          "fill": {
            "value": "#E4E3DE"
          }
        }
      },
      "marks": [
        {
          "type": "rect",
          "encode": {
            "update": {
              "x": {
                "value": 0
              },
              "y": {
                "value": 0
              },
              "width": {
                "value": 3
              },
              "height": {
                "signal": "tileH"
              },
              "fill": {
                "signal": "parent.badge ? '#FF222F' : parent.spokeColor"
              },
              "cornerRadiusTopLeft": {
                "value": 10
              },
              "cornerRadiusBottomLeft": {
                "value": 10
              }
            }
          }
        },
        {
          "type": "text",
          "encode": {
            "update": {
              "x": {
                "value": 12
              },
              "y": {
                "signal": "tileH / 2"
              },
              "baseline": {
                "value": "middle"
              },
              "font": {
                "value": "Calibri, Carlito, 'Segoe UI', Inter, Arial, sans-serif"
              },
              "fontSize": {
                "value": 13
              },
              "fontWeight": {
                "value": "bold"
              },
              "fill": {
                "value": "#0B3239"
              },
              "text": {
                "field": {
                  "parent": "name"
                }
              },
              "limit": {
                "signal": "tileW - (parent.badge ? 70 : 20)"
              },
              "tooltip": {
                "signal": "parent.spoke + ' · ' + parent.queue"
              }
            }
          }
        },
        {
          "type": "text",
          "encode": {
            "update": {
              "x": {
                "signal": "tileW - 10"
              },
              "y": {
                "signal": "tileH / 2"
              },
              "align": {
                "value": "right"
              },
              "baseline": {
                "value": "middle"
              },
              "font": {
                "value": "'JetBrains Mono', 'Roboto Mono', Consolas, 'Courier New', monospace"
              },
              "fontSize": {
                "value": 11
              },
              "fontWeight": {
                "value": "bold"
              },
              "fill": {
                "value": "#FF222F"
              },
              "text": {
                "field": {
                  "parent": "badge"
                }
              }
            }
          }
        }
      ]
    },
    {
      "type": "group",
      "encode": {
        "update": {
          "clip": {
            "value": true
          },
          "x": {
            "value": 16
          },
          "y": {
            "value": 16
          },
          "width": {
            "signal": "width - 32"
          },
          "height": {
            "signal": "length(data('bp')) === 1 ? 66 : 0"
          },
          "fill": {
            "value": "#F1EEE8"
          },
          "stroke": {
            "signal": "length(data('bp')) === 1 ? '#DCDCD7' : null"
          },
          "cornerRadius": {
            "value": 12
          }
        }
      },
