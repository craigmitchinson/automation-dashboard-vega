{
  "$schema": "https://vega.github.io/schema/vega/v5.json",
  "description": "IA · Process detail · Process chooser / banner. Generated by vega/build.mjs from vega/panels/process-detail.mjs, do not edit by hand.",
  "autosize": {
    "type": "fit",
    "contains": "padding"
  },
  "padding": 0,
  "config": {
    "background": "#FFFFFF",
    "padding": 0,
    "font": "Inter, 'Segoe UI', Carlito, Calibri, Arial, sans-serif",
    "text": {
      "font": "Inter, 'Segoe UI', Carlito, Calibri, Arial, sans-serif",
      "fill": "#0F4D43",
      "fontSize": 12
    },
    "axis": {
      "gridColor": "#E6E8E2",
      "labelFont": "'JetBrains Mono', Consolas, 'Roboto Mono', monospace",
      "labelFontSize": 10,
      "labelColor": "#5F6E69",
      "titleFont": "'JetBrains Mono', Consolas, 'Roboto Mono', monospace",
      "titleColor": "#5F6E69",
      "titleFontSize": 10,
      "titleFontWeight": 400,
      "domain": false,
      "ticks": false,
      "gridWidth": 1,
      "labelPadding": 6
    },
    "style": {
      "guide-label": {
        "font": "'JetBrains Mono', Consolas, 'Roboto Mono', monospace"
      }
    },
    "view": {
      "stroke": null
    },
    "kibana": {
      "renderer": "svg",
      "hideWarnings": true
    }
  },
  "signals": [
    {
      "name": "ndays",
      "update": "length(data('win'))"
    },
    {
      "name": "lo",
      "update": "ndays ? data('win')[0].key : 0"
    },
    {
      "name": "hi",
      "update": "ndays ? data('win')[ndays - 1].key : 0"
    },
    {
      "name": "plo",
      "update": "lo - ndays * 86400000"
    },
    {
      "name": "phi",
      "update": "lo - 86400000"
    },
    {
      "name": "pick",
      "on": [
        {
          "events": "@pd_tile0:click, @pd_tile1:click",
          "update": "kibanaAddFilter({'match_phrase': {'process.name': datum.name}}, 'ia-workqueue-items*')"
        }
      ]
    },
    {
      "name": "cols",
      "value": 5
    },
    {
      "name": "tileW",
      "update": "(width - 32 - (cols - 1) * 10) / cols"
    },
    {
      "name": "tileH",
      "value": 32
    },
    {
      "name": "secH",
      "value": 26
    }
  ],
  "data": [
    {
      "name": "procs_raw",
      "url": {
        "index": "ia-reference",
        "body": {
          "size": 500,
          "query": {
            "term": {
              "doc_type": "process"
            }
          }
        }
      },
      "format": {
        "property": "hits.hits"
      }
    },
    {
      "name": "procs",
      "source": "procs_raw",
      "transform": [
        {
          "type": "formula",
          "as": "name",
          "expr": "datum._source.process.name"
        },
        {
          "type": "formula",
          "as": "pid",
          "expr": "datum._source.process.id"
        },
        {
          "type": "formula",
          "as": "acronym",
          "expr": "datum._source.process.acronym"
        },
        {
          "type": "formula",
          "as": "spoke",
          "expr": "datum._source.spoke.name"
        },
        {
          "type": "formula",
          "as": "spokeColor",
          "expr": "datum._source.spoke.color"
        },
        {
          "type": "formula",
          "as": "proposition",
          "expr": "datum._source.proposition.name"
        },
        {
          "type": "formula",
          "as": "queue",
          "expr": "datum._source.primary_queue"
        },
        {
          "type": "formula",
          "as": "queues",
          "expr": "join(datum._source.queues, ' → ')"
        },
        {
          "type": "formula",
          "as": "description",
          "expr": "datum._source.process.description"
        },
        {
          "type": "formula",
          "as": "tags",
          "expr": "datum._source.process.tags"
        },
        {
          "type": "formula",
          "as": "smv",
          "expr": "datum._source.process.smv_minutes"
        },
        {
          "type": "formula",
          "as": "grade",
          "expr": "datum._source.process.grade"
        },
        {
          "type": "formula",
          "as": "gradeName",
          "expr": "datum._source.process.grade_name"
        },
        {
          "type": "formula",
          "as": "rate",
          "expr": "datum._source.process.current_rate_gbp"
        },
        {
          "type": "formula",
          "as": "slaHours",
          "expr": "datum._source.process.sla_hours"
        }
      ]
    },
    {
      "name": "ref_spokes",
      "url": {
        "index": "ia-reference",
        "body": {
          "size": 50,
          "query": {
            "term": {
              "doc_type": "spoke"
            }
          }
        }
      },
      "format": {
        "property": "hits.hits"
      }
    },
    {
      "name": "spk",
      "source": "ref_spokes",
      "transform": [
        {
          "type": "formula",
          "as": "name",
          "expr": "datum._source.spoke.name"
        },
        {
          "type": "formula",
          "as": "color",
          "expr": "datum._source.spoke.color"
        }
      ]
    },
    {
      "name": "bp_raw",
      "url": {
        "%context%": true,
        "%timefield%": "@timestamp",
        "index": "ia-workqueue-items",
        "body": {
          "size": 0,
          "aggs": {
            "m": {
              "filter": {
                "term": {
                  "mapped": true
                }
              },
              "aggs": {
                "p": {
                  "terms": {
                    "field": "process.name",
                    "size": 100
                  },
                  "aggs": {
                    "c": {
                      "sum": {
                        "field": "n.completed"
                      }
                    },
                    "a": {
                      "sum": {
                        "field": "n.attempt"
                      }
                    },
                    "e": {
                      "sum": {
                        "field": "n.exception"
                      }
                    },
                    "cw": {
                      "sum": {
                        "field": "worktime_completed_sec"
                      }
                    },
                    "ec": {
                      "sum": {
                        "field": "cost.estate_gbp"
                      }
                    },
                    "h": {
                      "sum": {
                        "field": "value.hours_saved"
                      }
                    },
                    "rw": {
                      "sum": {
                        "field": "value.rework_gbp"
                      }
                    },
                    "rh": {
                      "sum": {
                        "field": "value.rework_hours"
                      }
                    },
                    "b": {
                      "sum": {
                        "field": "n.business"
                      }
                    },
                    "sl": {
                      "sum": {
                        "field": "n.in_sla"
                      }
                    },
                    "ta": {
                      "sum": {
                        "field": "turnaround_sec"
                      }
                    },
                    "f1": {
                      "sum": {
                        "field": "n.first"
                      }
                    },
                    "fo": {
                      "sum": {
                        "field": "n.first_ok"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      },
      "format": {
        "property": "aggregations.m.p.buckets"
      }
    },
    {
      "name": "bp",
      "source": "bp_raw",
      "transform": [
        {
          "type": "formula",
          "as": "name",
          "expr": "datum.key"
        },
        {
          "type": "formula",
          "as": "c",
          "expr": "datum['c'].value"
        },
        {
          "type": "formula",
          "as": "a",
          "expr": "datum['a'].value"
        },
        {
          "type": "formula",
          "as": "e",
          "expr": "datum['e'].value"
        },
        {
          "type": "formula",
          "as": "cw",
          "expr": "datum['cw'].value"
        },
        {
          "type": "formula",
          "as": "ec",
          "expr": "datum['ec'].value"
        },
        {
          "type": "formula",
          "as": "h",
          "expr": "datum['h'].value"
        },
        {
          "type": "formula",
          "as": "rw",
          "expr": "datum['rw'].value"
        },
        {
          "type": "formula",
          "as": "rh",
          "expr": "datum['rh'].value"
        },
        {
          "type": "formula",
          "as": "b",
          "expr": "datum['b'].value"
        },
        {
          "type": "formula",
          "as": "sl",
          "expr": "datum['sl'].value"
        },
        {
          "type": "formula",
          "as": "ta",
          "expr": "datum['ta'].value"
        },
        {
          "type": "formula",
          "as": "f1",
          "expr": "datum['f1'].value"
        },
        {
          "type": "formula",
          "as": "fo",
          "expr": "datum['fo'].value"
        },
        {
          "type": "lookup",
          "from": "procs",
          "key": "name",
          "fields": [
            "name"
          ],
          "as": [
            "ref"
          ]
        },
        {
          "type": "formula",
          "as": "spoke",
          "expr": "datum.ref ? datum.ref.spoke : ''"
        },
        {
          "type": "formula",
          "as": "spokeColor",
          "expr": "datum.ref ? datum.ref.spokeColor : '#5F6E69'"
        },
        {
          "type": "formula",
          "as": "queue",
          "expr": "datum.ref ? datum.ref.queue : ''"
        },
        {
          "type": "formula",
          "as": "proposition",
          "expr": "datum.ref ? datum.ref.proposition : ''"
        },
        {
          "type": "formula",
          "as": "slaHours",
          "expr": "datum.ref ? datum.ref.slaHours : null"
        }
      ]
    },
    {
      "name": "raw",
      "url": {
        "index": "ia-workqueue-items",
        "body": {
          "size": 0,
          "query": {
            "bool": {
              "must": [
                "%dashboard_context-must_clause%",
                {
                  "range": {
                    "@timestamp": {
                      "gte": {
                        "%timefilter%": "min",
                        "shift": -732,
                        "unit": "day"
                      },
                      "lte": {
                        "%timefilter%": "max"
                      },
                      "format": "epoch_millis"
                    }
                  }
                },
                {
                  "term": {
                    "mapped": true
                  }
                }
              ],
              "filter": [
                "%dashboard_context-filter_clause%"
              ],
              "must_not": [
                "%dashboard_context-must_not_clause%"
              ]
            }
          },
          "aggs": {
            "win": {
              "filter": {
                "range": {
                  "@timestamp": {
                    "%timefilter%": true
                  }
                }
              },
              "aggs": {
                "d": {
                  "date_histogram": {
                    "field": "@timestamp",
                    "fixed_interval": "1d",
                    "min_doc_count": 0,
                    "extended_bounds": {
                      "min": {
                        "%timefilter%": "min"
                      },
                      "max": {
                        "%timefilter%": "max"
                      }
                    }
                  }
                }
              }
            },
            "days": {
              "date_histogram": {
                "field": "@timestamp",
                "fixed_interval": "1d",
                "min_doc_count": 1
              },
              "aggs": {
                "a": {
                  "sum": {
                    "field": "n.attempt"
                  }
                }
              }
            }
          }
        }
      },
      "format": {
        "property": "aggregations"
      }
    },
    {
      "name": "win",
      "source": "raw",
      "transform": [
        {
          "type": "flatten",
          "fields": [
            "win.d.buckets"
          ],
          "as": [
            "_bk"
          ]
        },
        {
          "type": "formula",
          "as": "key",
          "expr": "datum._bk.key"
        },
        {
          "type": "formula",
          "as": "n",
          "expr": "datum._bk.doc_count"
        },
        {
          "type": "project",
          "fields": [
            "key",
            "n"
          ]
        }
      ]
    },
    {
      "name": "days",
      "source": "raw",
      "transform": [
        {
          "type": "flatten",
          "fields": [
            "days.buckets"
          ],
          "as": [
            "_bk"
          ]
        },
        {
          "type": "formula",
          "as": "key",
          "expr": "datum._bk.key"
        },
        {
          "type": "formula",
          "as": "n",
          "expr": "datum._bk.doc_count"
        },
        {
          "type": "formula",
          "as": "a",
          "expr": "datum._bk[\"a\"] ? (datum._bk[\"a\"].value || 0) : 0"
        },
        {
          "type": "project",
          "fields": [
            "key",
            "n",
            "a"
          ]
        }
      ]
    },
    {
      "name": "series",
      "source": "win",
      "transform": [
        {
          "type": "lookup",
          "from": "days",
          "key": "key",
          "fields": [
            "key"
          ],
          "as": [
            "d"
          ]
        },
        {
          "type": "formula",
          "as": "t",
          "expr": "datum.key"
        },
        {
          "type": "formula",
          "as": "a",
          "expr": "datum.d ? datum.d.a : 0"
        }
      ]
    },
    {
      "name": "tot",
      "source": "days",
      "transform": [
        {
          "type": "formula",
          "as": "cur_a",
          "expr": "datum.key >= lo && datum.key <= hi ? datum.a : 0"
        },
        {
          "type": "formula",
          "as": "prev_a",
          "expr": "datum.key >= plo && datum.key <= phi ? datum.a : 0"
        },
        {
          "type": "aggregate",
          "ops": [
            "sum",
            "sum"
          ],
          "fields": [
            "cur_a",
            "prev_a"
          ],
          "as": [
            "cur_a",
            "prev_a"
          ]
        }
      ]
    },
    {
      "name": "worst",
      "source": "bp",
      "transform": [
        {
          "type": "filter",
          "expr": "!(length(data('bp')) === 1) && datum.a > 0"
        },
        {
          "type": "formula",
          "as": "rate",
          "expr": "datum.e / datum.a"
        },
        {
          "type": "collect",
          "sort": {
            "field": "rate",
            "order": "descending"
          }
        },
        {
          "type": "window",
          "ops": [
            "row_number"
          ],
          "as": [
            "k"
          ]
        },
        {
          "type": "filter",
          "expr": "datum.k <= 3"
        },
        {
          "type": "formula",
          "as": "x",
          "expr": "(datum.k - 1)"
        },
        {
          "type": "formula",
          "as": "y",
          "expr": "secH"
        }
      ]
    },
    {
      "name": "tiles",
      "source": "procs",
      "transform": [
        {
          "type": "lookup",
          "from": "bp",
          "key": "name",
          "fields": [
            "name"
          ],
          "values": [
            "a"
          ],
          "as": [
            "a"
          ]
        },
        {
          "type": "filter",
          "expr": "!(length(data('bp')) === 1) && isValid(datum.a)"
        },
        {
          "type": "collect",
          "sort": {
            "field": [
              "spoke",
              "name"
            ]
          }
        },
        {
          "type": "window",
          "ops": [
            "row_number"
          ],
          "groupby": [
            "spoke"
          ],
          "as": [
            "j"
          ]
        },
        {
          "type": "formula",
          "as": "col",
          "expr": "(datum.j - 1) % cols"
        },
        {
          "type": "formula",
          "as": "row",
          "expr": "floor((datum.j - 1) / cols)"
        }
      ]
    },
    {
      "name": "rowsPerGroup",
      "source": "tiles",
      "transform": [
        {
          "type": "aggregate",
          "groupby": [
            "spoke"
          ],
          "ops": [
            "count"
          ],
          "as": [
            "n"
          ]
        },
        {
          "type": "formula",
          "as": "rows",
          "expr": "ceil(datum.n / cols)"
        },
        {
          "type": "collect",
          "sort": {
            "field": "spoke"
          }
        },
        {
          "type": "window",
          "ops": [
            "row_number",
            "sum"
          ],
          "fields": [
            null,
            "rows"
          ],
          "as": [
            "g",
            "cumRows"
          ]
        },
        {
          "type": "formula",
          "as": "prevRows",
          "expr": "datum.cumRows - datum.rows"
        }
      ]
    },
    {
      "name": "tilesPos",
      "source": "tiles",
      "transform": [
        {
          "type": "lookup",
          "from": "rowsPerGroup",
          "key": "spoke",
          "fields": [
            "spoke"
          ],
          "values": [
            "g",
            "prevRows"
          ],
          "as": [
            "g",
            "prevRows"
          ]
        },
        {
          "type": "formula",
          "as": "y",
          "expr": "(length(data('worst')) ? secH + tileH + 12 : 0) + datum.g * secH + ((datum.prevRows || 0) + datum.row) * (tileH + 6)"
        },
        {
          "type": "formula",
          "as": "x",
          "expr": "datum.col"
        },
        {
          "type": "formula",
          "as": "badge",
          "expr": "''"
        }
      ]
    },
    {
      "name": "secs",
      "source": "tilesPos",
      "transform": [
        {
          "type": "aggregate",
          "groupby": [
            "spoke"
          ],
          "ops": [
            "min"
          ],
          "fields": [
            "y"
          ],
          "as": [
            "y"
          ]
        }
      ]
    },
    {
      "name": "worstPos",
      "source": "worst",
      "transform": [
        {
          "type": "lookup",
          "from": "procs",
          "key": "name",
          "fields": [
            "name"
          ],
          "values": [
            "queue",
            "spokeColor"
          ],
          "as": [
            "queue",
            "spokeColor"
          ]
        },
        {
          "type": "formula",
          "as": "badge",
          "expr": "(isValid((datum.rate)) && isFinite((datum.rate)) ? format((datum.rate) * 100, '.1f') + '%' : '–')"
        }
      ]
    }
  ],
  "marks": [
    {
      "type": "text",
      "encode": {
        "update": {
          "x": {
            "value": 16
          },
          "y": {
            "value": 16
          },
          "baseline": {
            "value": "top"
          },
          "font": {
            "value": "Fraunces, Cambria, Georgia, Gelasio, serif"
          },
          "fontSize": {
            "value": 16
          },
          "fontWeight": {
            "value": 600
          },
          "fill": {
            "value": "#0F4D43"
          },
          "text": {
            "value": "Drill into a process"
          },
          "opacity": {
            "signal": "length(data('bp')) === 1 ? 0 : 1"
          }
        }
      }
    },
    {
      "type": "text",
      "encode": {
        "update": {
          "x": {
            "value": 16
          },
          "y": {
            "value": 38
          },
          "baseline": {
            "value": "top"
          },
          "font": {
            "value": "Inter, 'Segoe UI', Carlito, Calibri, Arial, sans-serif"
          },
          "fontSize": {
            "value": 12
          },
          "fill": {
            "value": "#5F6E69"
          },
          "text": {
            "value": "Pick one (click a tile), or choose it in the Process control above"
          },
          "opacity": {
            "signal": "length(data('bp')) === 1 ? 0 : 1"
          }
        }
      }
    },
    {
      "type": "text",
      "encode": {
        "update": {
          "x": {
            "value": 16
          },
          "y": {
            "value": 76
          },
          "font": {
            "value": "'JetBrains Mono', Consolas, 'Roboto Mono', monospace"
          },
          "fontSize": {
            "value": 11
          },
          "fontWeight": {
            "value": 600
          },
          "fill": {
            "value": "#5F6E69"
          },
          "text": {
            "signal": "!(length(data('bp')) === 1) && length(data('worst')) ? 'NEEDS ATTENTION · HIGHEST EXCEPTION RATE' : ''"
          }
        }
      }
    },
    {
      "type": "group",
      "from": {
        "data": "secs"
      },
      "encode": {
        "update": {
          "x": {
            "value": 16
          },
          "y": {
            "signal": "64 + datum.y - secH + 6"
          },
          "width": {
            "value": 400
          },
          "height": {
            "value": 20
          }
        }
      },
      "marks": [
        {
          "type": "rect",
          "encode": {
            "update": {
              "x": {
                "value": 0
              },
              "y": {
                "value": 6
              },
              "width": {
                "value": 11
              },
              "height": {
                "value": 11
              },
              "cornerRadius": {
                "value": 3
              },
              "fill": {
                "signal": "(indexof(pluck(data('spk'), 'name'), parent.spoke) >= 0 ? data('spk')[indexof(pluck(data('spk'), 'name'), parent.spoke)].color : '#5F6E69')"
              }
            }
          }
        },
        {
          "type": "text",
          "encode": {
            "update": {
              "x": {
                "value": 18
              },
              "y": {
                "value": 12
              },
              "baseline": {
                "value": "middle"
              },
              "font": {
                "value": "'JetBrains Mono', Consolas, 'Roboto Mono', monospace"
              },
              "fontSize": {
                "value": 11
              },
              "fontWeight": {
                "value": 600
              },
              "fill": {
                "value": "#5F6E69"
              },
              "text": {
                "signal": "upper(parent.spoke)"
              }
            }
          }
        }
      ]
    },
    {
      "type": "group",
      "name": "pd_tile0",
      "from": {
        "data": "worstPos"
      },
      "encode": {
        "update": {
          "x": {
