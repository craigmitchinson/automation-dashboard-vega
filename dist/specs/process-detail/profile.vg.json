{
  "$schema": "https://vega.github.io/schema/vega/v5.json",
  "description": "IA · Process detail · Process profile. Generated by vega/build.mjs from vega/panels/process-detail.mjs, do not edit by hand.",
  "autosize": {
    "type": "fit",
    "contains": "padding"
  },
  "padding": 0,
  "config": {
    "background": "#FFFFFF",
    "padding": 0,
    "font": "Inter, 'Segoe UI', Carlito, Calibri, Arial, sans-serif",
    "text": {
      "font": "Inter, 'Segoe UI', Carlito, Calibri, Arial, sans-serif",
      "fill": "#0F4D43",
      "fontSize": 12
    },
    "axis": {
      "gridColor": "#E6E8E2",
      "labelFont": "'JetBrains Mono', Consolas, 'Roboto Mono', monospace",
      "labelFontSize": 10,
      "labelColor": "#5F6E69",
      "titleFont": "'JetBrains Mono', Consolas, 'Roboto Mono', monospace",
      "titleColor": "#5F6E69",
      "titleFontSize": 10,
      "titleFontWeight": 400,
      "domain": false,
      "ticks": false,
      "gridWidth": 1,
      "labelPadding": 6
    },
    "style": {
      "guide-label": {
        "font": "'JetBrains Mono', Consolas, 'Roboto Mono', monospace"
      }
    },
    "view": {
      "stroke": null
    },
    "kibana": {
      "renderer": "svg",
      "hideWarnings": true
    }
  },
  "signals": [
    {
      "name": "headerRight",
      "value": 0
    },
    {
      "name": "top",
      "value": 42
    },
    {
      "name": "cw",
      "update": "width - 32"
    },
    {
      "name": "ch",
      "update": "height - top - 16"
    },
    {
      "name": "ref0",
      "update": "length(data('bp')) && data('bp')[0].ref ? data('bp')[0].ref : null"
    }
  ],
  "data": [
    {
      "name": "procs_raw",
      "url": {
        "index": "ia-reference",
        "body": {
          "size": 500,
          "query": {
            "term": {
              "doc_type": "process"
            }
          }
        }
      },
      "format": {
        "property": "hits.hits"
      }
    },
    {
      "name": "procs",
      "source": "procs_raw",
      "transform": [
        {
          "type": "formula",
          "as": "name",
          "expr": "datum._source.process.name"
        },
        {
          "type": "formula",
          "as": "pid",
          "expr": "datum._source.process.id"
        },
        {
          "type": "formula",
          "as": "acronym",
          "expr": "datum._source.process.acronym"
        },
        {
          "type": "formula",
          "as": "spoke",
          "expr": "datum._source.spoke.name"
        },
        {
          "type": "formula",
          "as": "spokeColor",
          "expr": "datum._source.spoke.color"
        },
        {
          "type": "formula",
          "as": "proposition",
          "expr": "datum._source.proposition.name"
        },
        {
          "type": "formula",
          "as": "queue",
          "expr": "datum._source.primary_queue"
        },
        {
          "type": "formula",
          "as": "queues",
          "expr": "join(datum._source.queues, ' → ')"
        },
        {
          "type": "formula",
          "as": "description",
          "expr": "datum._source.process.description"
        },
        {
          "type": "formula",
          "as": "tags",
          "expr": "datum._source.process.tags"
        },
        {
          "type": "formula",
          "as": "smv",
          "expr": "datum._source.process.smv_minutes"
        },
        {
          "type": "formula",
          "as": "grade",
          "expr": "datum._source.process.grade"
        },
        {
          "type": "formula",
          "as": "gradeName",
          "expr": "datum._source.process.grade_name"
        },
        {
          "type": "formula",
          "as": "rate",
          "expr": "datum._source.process.current_rate_gbp"
        }
      ]
    },
    {
      "name": "bp_raw",
      "url": {
        "%context%": true,
        "%timefield%": "@timestamp",
        "index": "ia-workqueue-items",
        "body": {
          "size": 0,
          "aggs": {
            "m": {
              "filter": {
                "term": {
                  "mapped": true
                }
              },
              "aggs": {
                "p": {
                  "terms": {
                    "field": "process.name",
                    "size": 100
                  },
                  "aggs": {
                    "a": {
                      "sum": {
                        "field": "n.attempt"
                      }
                    },
                    "h": {
                      "sum": {
                        "field": "value.hours_saved"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      },
      "format": {
        "property": "aggregations.m.p.buckets"
      }
    },
    {
      "name": "bp",
      "source": "bp_raw",
      "transform": [
        {
          "type": "formula",
          "as": "name",
          "expr": "datum.key"
        },
        {
          "type": "formula",
          "as": "a",
          "expr": "datum['a'].value"
        },
        {
          "type": "formula",
          "as": "h",
          "expr": "datum['h'].value"
        },
        {
          "type": "lookup",
          "from": "procs",
          "key": "name",
          "fields": [
            "name"
          ],
          "as": [
            "ref"
          ]
        },
        {
          "type": "formula",
          "as": "spoke",
          "expr": "datum.ref ? datum.ref.spoke : ''"
        },
        {
          "type": "formula",
          "as": "spokeColor",
          "expr": "datum.ref ? datum.ref.spokeColor : '#5F6E69'"
        },
        {
          "type": "formula",
          "as": "queue",
          "expr": "datum.ref ? datum.ref.queue : ''"
        },
        {
          "type": "formula",
          "as": "proposition",
          "expr": "datum.ref ? datum.ref.proposition : ''"
        }
      ]
    }
  ],
  "marks": [
    {
      "type": "text",
      "name": "frame_title",
      "encode": {
        "update": {
          "x": {
            "value": 16
          },
          "y": {
            "value": 18
          },
          "baseline": {
            "value": "top"
          },
          "font": {
            "value": "'JetBrains Mono', Consolas, 'Roboto Mono', monospace"
          },
          "fontSize": {
            "value": 11
          },
          "fontWeight": {
            "value": 600
          },
          "fill": {
            "value": "#0F4D43"
          },
          "text": {
            "signal": "'PROCESS PROFILE'"
          },
          "limit": {
            "signal": "width - 32"
          }
        }
      }
    },
    {
      "type": "text",
      "encode": {
        "update": {
          "x": {
            "signal": "16 + length('PROCESS PROFILE') * 6.9 + 10"
          },
          "y": {
            "value": 17
          },
          "baseline": {
            "value": "top"
          },
          "font": {
            "value": "Inter, 'Segoe UI', Carlito, Calibri, Arial, sans-serif"
          },
          "fontSize": {
            "value": 12
          },
          "fill": {
            "value": "#5F6E69"
          },
          "text": {
            "value": "Team-owned configuration (ia-reference)"
          },
          "limit": {
            "signal": "width - 42 - length('PROCESS PROFILE') * 6.9 - 0 - headerRight"
          }
        }
      }
    },
    {
      "type": "text",
      "encode": {
        "update": {
          "x": {
            "signal": "width / 2"
          },
          "y": {
            "signal": "top + ch / 2"
          },
          "align": {
            "value": "center"
          },
          "baseline": {
            "value": "middle"
          },
          "font": {
            "value": "Inter, 'Segoe UI', Carlito, Calibri, Arial, sans-serif"
          },
          "fontSize": {
            "value": 13
          },
          "fill": {
            "value": "#5F6E69"
          },
          "text": {
            "value": "Pick a single process (click a tile above, or use the Process control)."
          },
          "opacity": {
            "signal": "(!(length(data('bp')) === 1)) ? 1 : 0"
          }
        }
      }
    },
    {
      "type": "text",
      "encode": {
        "update": {
          "x": {
            "value": 18
          },
          "y": {
            "signal": "top + 17"
          },
          "baseline": {
            "value": "middle"
          },
          "font": {
            "value": "Inter, 'Segoe UI', Carlito, Calibri, Arial, sans-serif"
          },
          "fontSize": {
            "value": 13
          },
          "fill": {
            "value": "#5F6E69"
          },
          "text": {
            "value": "SMV: manual minutes per case"
          },
          "opacity": {
            "signal": "length(data('bp')) === 1 ? 1 : 0"
          }
        }
      }
    },
    {
      "type": "text",
      "encode": {
        "update": {
          "x": {
            "signal": "width - 16"
          },
          "y": {
            "signal": "top + 17"
          },
          "align": {
            "value": "right"
          },
          "baseline": {
            "value": "middle"
          },
          "font": {
            "value": "'JetBrains Mono', Consolas, 'Roboto Mono', monospace"
          },
          "fontSize": {
            "value": 12.5
          },
          "fontWeight": {
            "value": 600
          },
          "fill": {
            "value": "#0F4D43"
          },
          "text": {
            "signal": "length(data('bp')) === 1 ? ref0 ? ref0.smv + ' min' : '' : ''"
          }
        }
      }
    },
    {
      "type": "rule",
      "encode": {
        "update": {
          "x": {
            "value": 16
          },
          "x2": {
            "signal": "width - 16"
          },
          "y": {
            "signal": "top + 34"
          },
          "stroke": {
            "value": "#D6D9D2"
          },
          "opacity": {
            "signal": "length(data('bp')) === 1 ? 1 : 0"
          }
        }
      }
    },
    {
      "type": "text",
      "encode": {
        "update": {
          "x": {
            "value": 18
          },
          "y": {
            "signal": "top + 51"
          },
          "baseline": {
            "value": "middle"
          },
          "font": {
            "value": "Inter, 'Segoe UI', Carlito, Calibri, Arial, sans-serif"
          },
          "fontSize": {
            "value": 13
          },
          "fill": {
            "value": "#5F6E69"
          },
          "text": {
            "value": "Automates against grade"
          },
          "opacity": {
            "signal": "length(data('bp')) === 1 ? 1 : 0"
          }
        }
      }
    },
    {
      "type": "text",
      "encode": {
        "update": {
          "x": {
            "signal": "width - 16"
          },
          "y": {
            "signal": "top + 51"
          },
          "align": {
            "value": "right"
          },
          "baseline": {
            "value": "middle"
          },
          "font": {
            "value": "'JetBrains Mono', Consolas, 'Roboto Mono', monospace"
          },
          "fontSize": {
            "value": 12.5
          },
          "fontWeight": {
            "value": 600
          },
          "fill": {
            "value": "#0F4D43"
          },
          "text": {
            "signal": "length(data('bp')) === 1 ? ref0 ? ref0.gradeName + ' (' + ref0.grade + ')' : '' : ''"
          }
        }
      }
    },
    {
      "type": "rule",
      "encode": {
        "update": {
          "x": {
            "value": 16
          },
          "x2": {
            "signal": "width - 16"
          },
          "y": {
            "signal": "top + 68"
          },
          "stroke": {
            "value": "#D6D9D2"
          },
          "opacity": {
            "signal": "length(data('bp')) === 1 ? 1 : 0"
          }
        }
      }
    },
    {
      "type": "text",
      "encode": {
        "update": {
          "x": {
            "value": 18
          },
          "y": {
            "signal": "top + 85"
          },
          "baseline": {
            "value": "middle"
          },
          "font": {
            "value": "Inter, 'Segoe UI', Carlito, Calibri, Arial, sans-serif"
          },
          "fontSize": {
            "value": 13
          },
          "fill": {
            "value": "#5F6E69"
          },
          "text": {
            "value": "Current grade rate"
          },
          "opacity": {
            "signal": "length(data('bp')) === 1 ? 1 : 0"
          }
        }
      }
    },
    {
      "type": "text",
      "encode": {
        "update": {
          "x": {
            "signal": "width - 16"
          },
          "y": {
            "signal": "top + 85"
          },
          "align": {
            "value": "right"
          },
          "baseline": {
            "value": "middle"
          },
          "font": {
            "value": "'JetBrains Mono', Consolas, 'Roboto Mono', monospace"
          },
          "fontSize": {
            "value": 12.5
          },
          "fontWeight": {
            "value": 600
          },
          "fill": {
            "value": "#0F4D43"
          },
          "text": {
            "signal": "length(data('bp')) === 1 ? ref0 ? '£' + format(ref0.rate, '.2f') + '/hr' : '' : ''"
          }
        }
      }
    },
    {
      "type": "rule",
      "encode": {
        "update": {
          "x": {
            "value": 16
          },
          "x2": {
            "signal": "width - 16"
          },
          "y": {
            "signal": "top + 102"
          },
          "stroke": {
            "value": "#D6D9D2"
          },
          "opacity": {
            "signal": "length(data('bp')) === 1 ? 1 : 0"
          }
        }
      }
    },
    {
      "type": "text",
      "encode": {
        "update": {
          "x": {
            "value": 18
          },
          "y": {
            "signal": "top + 119"
          },
          "baseline": {
            "value": "middle"
          },
          "font": {
            "value": "Inter, 'Segoe UI', Carlito, Calibri, Arial, sans-serif"
          },
          "fontSize": {
            "value": 13
          },
          "fill": {
            "value": "#5F6E69"
          },
          "text": {
            "value": "Colleague time released (period)"
          },
          "opacity": {
            "signal": "length(data('bp')) === 1 ? 1 : 0"
          }
        }
      }
    },
    {
      "type": "text",
      "encode": {
        "update": {
          "x": {
            "signal": "width - 16"
          },
          "y": {
            "signal": "top + 119"
          },
          "align": {
            "value": "right"
          },
          "baseline": {
            "value": "middle"
          },
          "font": {
            "value": "'JetBrains Mono', Consolas, 'Roboto Mono', monospace"
          },
          "fontSize": {
            "value": 12.5
          },
          "fontWeight": {
            "value": 600
          },
          "fill": {
            "value": "#0F4D43"
          },
          "text": {
            "signal": "length(data('bp')) === 1 ? (isValid(((length(data('bp')) ? data('bp')[0].h : 0))) && isFinite(((length(data('bp')) ? data('bp')[0].h : 0))) ? (abs(((length(data('bp')) ? data('bp')[0].h : 0))) >= 1e6 ? format(((length(data('bp')) ? data('bp')[0].h : 0)) / 1e6, abs(((length(data('bp')) ? data('bp')[0].h : 0))) >= 1e7 ? '.0f' : '.1f') + 'M' : abs(((length(data('bp')) ? data('bp')[0].h : 0))) >= 1e3 ? format(((length(data('bp')) ? data('bp')[0].h : 0)) / 1e3, abs(((length(data('bp')) ? data('bp')[0].h : 0))) >= 1e4 ? '.0f' : '.1f') + 'k' : format(((length(data('bp')) ? data('bp')[0].h : 0)), '.0f')) : '–') + ' h' : ''"
          }
        }
      }
    },
    {
      "type": "rule",
      "encode": {
        "update": {
          "x": {
            "value": 16
          },
          "x2": {
            "signal": "width - 16"
          },
          "y": {
            "signal": "top + 136"
          },
          "stroke": {
            "value": "#D6D9D2"
          },
          "opacity": {
            "signal": "length(data('bp')) === 1 ? 1 : 0"
          }
        }
      }
    },
    {
      "type": "text",
      "encode": {
        "update": {
          "x": {
            "value": 18
          },
          "y": {
            "signal": "top + 152"
          },
          "font": {
            "value": "Inter, 'Segoe UI', Carlito, Calibri, Arial, sans-serif"
          },
          "fontSize": {
            "value": 12.5
          },
          "fill": {
            "value": "#5F6E69"
          },
          "text": {
            "signal": "length(data('bp')) === 1 ? 'What this process does' : ''"
          }
        }
      }
    },
    {
      "type": "text",
      "encode": {
        "update": {
          "x": {
            "value": 18
          },
          "y": {
            "signal": "top + 172"
          },
          "font": {
            "value": "Inter, 'Segoe UI', Carlito, Calibri, Arial, sans-serif"
          },
          "fontSize": {
            "value": 13
          },
          "fill": {
            "value": "#0F4D43"
          },
          "text": {
            "signal": "length(data('bp')) === 1 && ref0 ? ref0.description : ''"
          },
          "limit": {
            "signal": "cw"
          }
        }
      }
    }
  ]
}
