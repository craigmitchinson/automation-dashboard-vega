{
  "$schema": "https://vega.github.io/schema/vega/v5.json",
  "description": "IA · Work in & out · Where the work went. Generated by vega/build.mjs from vega/panels/work-flow.mjs, do not edit by hand.",
  "autosize": {
    "type": "fit",
    "contains": "padding"
  },
  "padding": 0,
  "config": {
    "background": "#FFFFFF",
    "padding": 0,
    "font": "Inter, 'Segoe UI', system-ui, -apple-system, sans-serif",
    "text": {
      "font": "Inter, 'Segoe UI', system-ui, -apple-system, sans-serif",
      "fill": "#0F4D43",
      "fontSize": 12
    },
    "axis": {
      "gridColor": "#E6E8E2",
      "labelFont": "'Roboto Mono', Menlo, Consolas, monospace",
      "labelFontSize": 10,
      "labelColor": "#5F6E69",
      "titleFont": "'Roboto Mono', Menlo, Consolas, monospace",
      "titleColor": "#5F6E69",
      "titleFontSize": 10,
      "titleFontWeight": 400,
      "domain": false,
      "ticks": false,
      "gridWidth": 1,
      "labelPadding": 6
    },
    "style": {
      "guide-label": {
        "font": "'Roboto Mono', Menlo, Consolas, monospace"
      }
    },
    "view": {
      "stroke": null
    },
    "kibana": {
      "renderer": "svg",
      "hideWarnings": true
    }
  },
  "signals": [
    {
      "name": "headerRight",
      "value": 0
    },
    {
      "name": "top",
      "value": 42
    },
    {
      "name": "cw",
      "update": "width - 32"
    },
    {
      "name": "ch",
      "update": "height - top - 16"
    },
    {
      "name": "fN",
      "update": "length(data('fl_tot')) ? data('fl_tot')[0].n : 0"
    },
    {
      "name": "fk",
      "update": "fN ? min((ch - (length(data('fl_p0')) - 1) * 6) / fN, (ch - (length(data('fl')) - 1) * 6) / fN, (ch - 3 * 6) / fN) : 0"
    },
    {
      "name": "x0",
      "update": "16 + clamp(cw * 0.3, 150, 290)"
    },
    {
      "name": "x2",
      "update": "width - 16 - clamp(cw * 0.22, 150, 220)"
    },
    {
      "name": "x1",
      "update": "(x0 + x2) / 2 - 5"
    },
    {
      "name": "flPick",
      "on": [
        {
          "events": "@fl_node0:click",
          "update": "kibanaAddFilter({'match_phrase': {'process.name': datum.proc}}, 'ia-workqueue-items*')"
        }
      ]
    }
  ],
  "data": [
    {
      "name": "procs_raw",
      "url": {
        "index": "ia-reference",
        "body": {
          "size": 500,
          "query": {
            "term": {
              "doc_type": "process"
            }
          }
        }
      },
      "format": {
        "property": "hits.hits"
      }
    },
    {
      "name": "procs",
      "source": "procs_raw",
      "transform": [
        {
          "type": "formula",
          "as": "name",
          "expr": "datum._source.process.name"
        },
        {
          "type": "formula",
          "as": "pid",
          "expr": "datum._source.process.id"
        },
        {
          "type": "formula",
          "as": "acronym",
          "expr": "datum._source.process.acronym"
        },
        {
          "type": "formula",
          "as": "spoke",
          "expr": "datum._source.spoke.name"
        },
        {
          "type": "formula",
          "as": "spokeColor",
          "expr": "datum._source.spoke.color"
        },
        {
          "type": "formula",
          "as": "proposition",
          "expr": "datum._source.proposition.name"
        },
        {
          "type": "formula",
          "as": "queue",
          "expr": "datum._source.primary_queue"
        },
        {
          "type": "formula",
          "as": "queues",
          "expr": "join(datum._source.queues, ' → ')"
        },
        {
          "type": "formula",
          "as": "description",
          "expr": "datum._source.process.description"
        },
        {
          "type": "formula",
          "as": "tags",
          "expr": "datum._source.process.tags"
        },
        {
          "type": "formula",
          "as": "smv",
          "expr": "datum._source.process.smv_minutes"
        },
        {
          "type": "formula",
          "as": "grade",
          "expr": "datum._source.process.grade"
        },
        {
          "type": "formula",
          "as": "gradeName",
          "expr": "datum._source.process.grade_name"
        },
        {
          "type": "formula",
          "as": "rate",
          "expr": "datum._source.process.current_rate_gbp"
        },
        {
          "type": "formula",
          "as": "slaHours",
          "expr": "datum._source.process.sla_hours"
        }
      ]
    },
    {
      "name": "fl_raw",
      "url": {
        "%context%": true,
        "%timefield%": "@timestamp",
        "index": "ia-workqueue-items",
        "body": {
          "size": 0,
          "aggs": {
            "m": {
              "filter": {
                "term": {
                  "mapped": true
                }
              },
              "aggs": {
                "p": {
                  "terms": {
                    "field": "process.name",
                    "size": 12
                  },
                  "aggs": {
                    "q": {
                      "terms": {
                        "field": "queue.name",
                        "size": 10
                      },
                      "aggs": {
                        "c": {
                          "sum": {
                            "field": "n.completed"
                          }
                        },
                        "b": {
                          "sum": {
                            "field": "n.business"
                          }
                        },
                        "s": {
                          "sum": {
                            "field": "n.system"
                          }
                        },
                        "p": {
                          "sum": {
                            "field": "n.pending"
                          }
                        },
                        "so": {
                          "min": {
                            "field": "queue.stage_order"
                          }
                        },
                        "st": {
                          "terms": {
                            "field": "queue.stage",
                            "size": 1
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      },
      "format": {
        "property": "aggregations.m.p.buckets"
      }
    },
    {
      "name": "fl",
      "source": "fl_raw",
      "transform": [
        {
          "type": "flatten",
          "fields": [
            "q.buckets"
          ],
          "as": [
            "g"
          ]
        },
        {
          "type": "formula",
          "as": "proc",
          "expr": "datum.key"
        },
        {
          "type": "formula",
          "as": "procN",
          "expr": "datum.doc_count"
        },
        {
          "type": "formula",
          "as": "queue",
          "expr": "datum.g.key"
        },
        {
          "type": "formula",
          "as": "stage",
          "expr": "length(datum.g.st.buckets) ? datum.g.st.buckets[0].key : null"
        },
        {
          "type": "formula",
          "as": "so",
          "expr": "datum.g.so.value || 1"
        },
        {
          "type": "formula",
          "as": "c",
          "expr": "datum.g['c'].value"
        },
        {
          "type": "formula",
          "as": "b",
          "expr": "datum.g['b'].value"
        },
        {
          "type": "formula",
          "as": "s",
          "expr": "datum.g['s'].value"
        },
        {
          "type": "formula",
          "as": "p",
          "expr": "datum.g['p'].value"
        },
        {
          "type": "formula",
          "as": "n",
          "expr": "datum.c + datum.b + datum.s + datum.p"
        },
        {
          "type": "filter",
          "expr": "datum.n > 0"
        },
        {
          "type": "project",
          "fields": [
            "proc",
            "procN",
            "queue",
            "stage",
            "so",
            "c",
            "b",
            "s",
            "p",
            "n"
          ]
        }
      ]
    },
    {
      "name": "fl_tot",
      "source": "fl",
      "transform": [
        {
          "type": "aggregate",
          "ops": [
            "sum",
            "sum",
            "sum",
            "sum",
            "sum",
            "count"
          ],
          "fields": [
            "n",
            "c",
            "b",
            "s",
            "p",
            "n"
          ],
          "as": [
            "n",
            "c",
            "b",
            "s",
            "p",
            "nq"
          ]
        }
      ]
    },
    {
      "name": "fl_p0",
      "source": "fl",
      "transform": [
        {
          "type": "aggregate",
          "groupby": [
            "proc"
          ],
          "ops": [
            "sum"
          ],
          "fields": [
            "n"
          ],
          "as": [
            "n"
          ]
        },
        {
          "type": "formula",
          "as": "neg",
          "expr": "-datum.n"
        }
      ]
    },
    {
      "name": "n0",
      "source": "fl_p0",
      "transform": [
        {
          "type": "collect",
          "sort": {
            "field": "neg"
          }
        },
        {
          "type": "window",
          "ops": [
            "row_number",
            "sum"
          ],
          "fields": [
            null,
            "n"
          ],
          "as": [
            "idx",
            "cum"
          ]
        },
        {
          "type": "formula",
          "as": "y",
          "expr": "top + (datum.cum - datum.n) * fk + (datum.idx - 1) * 6"
        },
        {
          "type": "formula",
          "as": "h",
          "expr": "max(1, datum.n * fk)"
        }
      ]
    },
    {
      "name": "fl_p0r",
      "source": "fl_p0",
      "transform": [
        {
          "type": "window",
          "sort": {
            "field": "neg"
          },
          "ops": [
            "row_number"
          ],
          "as": [
            "r"
          ]
        }
      ]
    },
    {
      "name": "n1",
      "source": "fl",
      "transform": [
        {
          "type": "lookup",
          "from": "fl_p0r",
          "key": "proc",
          "fields": [
            "proc"
          ],
          "values": [
            "r"
          ],
          "as": [
            "pi"
          ]
        },
        {
          "type": "collect",
          "sort": {
            "field": [
              "pi",
              "so"
            ]
          }
        },
        {
          "type": "window",
          "ops": [
            "row_number",
            "sum"
          ],
          "fields": [
            null,
            "n"
          ],
          "as": [
            "idx",
            "cum"
          ]
        },
        {
          "type": "formula",
          "as": "y",
          "expr": "top + (datum.cum - datum.n) * fk + (datum.idx - 1) * 6"
        },
        {
          "type": "formula",
          "as": "h",
          "expr": "max(1, datum.n * fk)"
        }
      ]
    },
    {
      "name": "fl_o",
      "source": "fl_tot",
      "transform": [
        {
          "type": "fold",
          "fields": [
            "c",
            "b",
            "s",
            "p"
          ],
          "as": [
            "k",
            "n"
          ]
        },
        {
          "type": "formula",
          "as": "ord",
          "expr": "indexof(['c', 'b', 's', 'p'], datum.k)"
        },
        {
          "type": "filter",
          "expr": "datum.n > 0"
        },
        {
          "type": "formula",
          "as": "label",
          "expr": "['Completed', 'Business exception', 'System exception', 'Still waiting'][datum.ord]"
        },
        {
          "type": "formula",
          "as": "color",
          "expr": "['#0F4D43', '#B9852C', '#B6462F', '#8FA09A'][datum.ord]"
        },
        {
          "type": "project",
          "fields": [
            "k",
            "n",
            "ord",
            "label",
            "color"
          ]
        }
      ]
    },
    {
      "name": "n2",
      "source": "fl_o",
      "transform": [
        {
          "type": "collect",
          "sort": {
            "field": "ord"
          }
        },
        {
          "type": "window",
          "ops": [
            "row_number",
            "sum"
          ],
          "fields": [
            null,
            "n"
          ],
          "as": [
            "idx",
            "cum"
          ]
        },
        {
          "type": "formula",
          "as": "y",
          "expr": "top + (datum.cum - datum.n) * fk + (datum.idx - 1) * 6"
        },
        {
          "type": "formula",
          "as": "h",
          "expr": "max(1, datum.n * fk)"
        }
      ]
    },
    {
      "name": "l1",
      "source": "n1",
      "transform": [
        {
          "type": "window",
          "groupby": [
            "proc"
          ],
          "sort": {
            "field": "so"
          },
          "ops": [
            "sum"
          ],
          "fields": [
            "n"
          ],
          "as": [
            "cum"
          ]
        },
        {
          "type": "lookup",
          "from": "n0",
          "key": "proc",
          "fields": [
            "proc"
          ],
          "values": [
            "y"
          ],
          "as": [
            "py"
          ]
        },
        {
          "type": "formula",
          "as": "ya",
          "expr": "datum.py + (datum.cum - datum.n) * fk"
        }
      ]
    },
    {
      "name": "l2",
      "source": "n1",
      "transform": [
        {
          "type": "formula",
          "as": "qy",
          "expr": "datum.y"
        },
        {
          "type": "formula",
          "as": "qi",
          "expr": "datum.idx"
        },
        {
          "type": "fold",
          "fields": [
            "c",
            "b",
            "s",
            "p"
          ],
          "as": [
            "k",
            "v"
          ]
        },
        {
          "type": "filter",
          "expr": "datum.v > 0"
        },
        {
          "type": "formula",
          "as": "ord",
          "expr": "indexof(['c', 'b', 's', 'p'], datum.k)"
        },
        {
          "type": "window",
          "groupby": [
            "queue"
          ],
          "sort": {
            "field": "ord"
          },
          "ops": [
            "sum"
          ],
          "fields": [
            "v"
          ],
          "as": [
            "cq"
          ]
        },
        {
          "type": "window",
          "groupby": [
            "k"
          ],
          "sort": {
            "field": "qi"
          },
          "ops": [
            "sum"
          ],
          "fields": [
            "v"
          ],
          "as": [
            "co"
          ]
        },
        {
          "type": "lookup",
          "from": "n2",
          "key": "k",
          "fields": [
            "k"
          ],
          "values": [
            "y",
            "color"
          ],
          "as": [
            "oy",
            "color"
          ]
        },
        {
          "type": "formula",
          "as": "ya",
          "expr": "datum.qy + (datum.cq - datum.v) * fk"
        },
        {
          "type": "formula",
          "as": "yb",
          "expr": "datum.oy + (datum.co - datum.v) * fk"
        }
      ]
    },
    {
      "name": "n0c",
      "source": "n0",
      "transform": [
        {
          "type": "lookup",
          "from": "procs",
          "key": "name",
          "fields": [
            "proc"
          ],
          "values": [
            "spokeColor"
          ],
          "as": [
            "color"
          ]
        },
        {
          "type": "formula",
          "as": "u",
          "expr": "datum.y + datum.h / 2 - datum.idx * 15"
        },
        {
          "type": "window",
          "sort": {
            "field": "idx"
          },
          "ops": [
            "max"
          ],
          "fields": [
            "u"
          ],
          "as": [
            "um"
          ],
          "frame": [
            null,
            0
          ]
        },
        {
          "type": "formula",
          "as": "ly",
          "expr": "datum.um + datum.idx * 15"
        }
      ]
    },
    {
      "name": "n2c",
      "source": "n2",
      "transform": [
        {
          "type": "formula",
          "as": "u",
          "expr": "datum.y + datum.h / 2 - datum.idx * 34"
        },
        {
          "type": "window",
          "sort": {
            "field": "idx"
          },
          "ops": [
            "max"
          ],
          "fields": [
            "u"
          ],
          "as": [
            "um"
          ],
          "frame": [
            null,
            0
          ]
        },
        {
          "type": "formula",
          "as": "ly",
          "expr": "datum.um + datum.idx * 34"
        }
      ]
    }
  ],
  "marks": [
    {
      "type": "text",
      "name": "frame_title",
      "encode": {
        "update": {
          "x": {
            "value": 16
          },
          "y": {
            "value": 18
          },
          "baseline": {
            "value": "top"
          },
          "font": {
            "value": "'Roboto Mono', Menlo, Consolas, monospace"
          },
          "fontSize": {
            "value": 11
          },
          "fontWeight": {
            "value": 600
          },
          "fill": {
            "value": "#0F4D43"
          },
          "text": {
            "signal": "'WHERE THE WORK WENT'"
          },
          "limit": {
            "signal": "width - 32"
          }
        }
      }
    },
    {
      "type": "text",
      "encode": {
        "update": {
          "x": {
            "signal": "16 + length('WHERE THE WORK WENT') * 6.9 + 10"
          },
          "y": {
            "value": 17
          },
          "baseline": {
            "value": "top"
          },
          "font": {
            "value": "Inter, 'Segoe UI', system-ui, -apple-system, sans-serif"
          },
          "fontSize": {
            "value": 12
          },
          "fill": {
            "value": "#5F6E69"
          },
          "text": {
            "value": "Items in the period: process → queue or stage → outcome · widths are items · click a process to filter"
          },
          "limit": {
            "signal": "width - 42 - length('WHERE THE WORK WENT') * 6.9 - 0 - headerRight"
          }
        }
      }
    },
    {
      "type": "path",
      "from": {
        "data": "l1"
      },
      "interactive": true,
      "encode": {
        "update": {
          "path": {
            "signal": "'M' + (x0 + 10) + ',' + datum.ya + 'C' + (((x0 + 10) + x1) / 2) + ',' + datum.ya + ' ' + (((x0 + 10) + x1) / 2) + ',' + datum.y + ' ' + x1 + ',' + datum.y + 'L' + x1 + ',' + (datum.y + datum.n * fk) + 'C' + (((x0 + 10) + x1) / 2) + ',' + (datum.y + datum.n * fk) + ' ' + (((x0 + 10) + x1) / 2) + ',' + (datum.ya + datum.n * fk) + ' ' + (x0 + 10) + ',' + (datum.ya + datum.n * fk) + 'Z'"
          },
          "fill": {
            "value": "#2A6A5F"
          },
          "fillOpacity": {
            "value": 0.16
          },
          "tooltip": {
            "signal": "{'': datum.proc + ' → ' + (datum.stage || datum.queue), 'Items': (isValid((datum.n)) && isFinite((datum.n)) ? format((datum.n), ',.0f') : '–')}"
          }
        },
        "hover": {
          "fillOpacity": {
            "value": 0.32
          }
        }
      }
    },
    {
      "type": "path",
      "from": {
        "data": "l2"
      },
      "interactive": true,
      "encode": {
        "update": {
          "path": {
            "signal": "'M' + (x1 + 10) + ',' + datum.ya + 'C' + (((x1 + 10) + x2) / 2) + ',' + datum.ya + ' ' + (((x1 + 10) + x2) / 2) + ',' + datum.yb + ' ' + x2 + ',' + datum.yb + 'L' + x2 + ',' + (datum.yb + datum.v * fk) + 'C' + (((x1 + 10) + x2) / 2) + ',' + (datum.yb + datum.v * fk) + ' ' + (((x1 + 10) + x2) / 2) + ',' + (datum.ya + datum.v * fk) + ' ' + (x1 + 10) + ',' + (datum.ya + datum.v * fk) + 'Z'"
          },
          "fill": {
            "field": "color"
          },
          "fillOpacity": {
            "value": 0.28
          },
          "tooltip": {
            "signal": "{'': (datum.stage || datum.queue) + ' → ' + ['Completed', 'Business exception', 'System exception', 'Still waiting'][datum.ord], 'Items': (isValid((datum.v)) && isFinite((datum.v)) ? format((datum.v), ',.0f') : '–'), 'Share of the queue': (isValid((datum.v / datum.n)) && isFinite((datum.v / datum.n)) ? format((datum.v / datum.n) * 100, '.1f') + '%' : '–')}"
          }
        },
        "hover": {
          "fillOpacity": {
            "value": 0.5
          }
        }
      }
    },
    {
      "type": "rect",
      "name": "fl_node0",
      "from": {
        "data": "n0c"
      },
      "encode": {
        "update": {
          "x": {
            "signal": "x0"
          },
          "width": {
            "value": 10
          },
          "y": {
            "field": "y"
          },
          "height": {
            "field": "h"
          },
          "fill": {
            "signal": "datum.color || '#5F6E69'"
          },
          "cornerRadius": {
            "value": 2
          },
          "cursor": {
            "value": "pointer"
          },
          "tooltip": {
            "signal": "{'Process': datum.proc, 'Items': (isValid((datum.n)) && isFinite((datum.n)) ? format((datum.n), ',.0f') : '–')}"
          }
        }
      }
    },
    {
      "type": "rect",
      "from": {
        "data": "n1"
      },
      "encode": {
        "update": {
          "x": {
            "signal": "x1"
          },
          "width": {
            "value": 10
          },
          "y": {
            "field": "y"
