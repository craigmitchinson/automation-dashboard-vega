{
  "$schema": "https://vega.github.io/schema/vega/v5.json",
  "description": "IA · Work in & out · Work in & out KPIs. Generated by vega/build.mjs from vega/panels/work-flow.mjs, do not edit by hand.",
  "autosize": {
    "type": "fit",
    "contains": "padding"
  },
  "padding": 0,
  "config": {
    "background": "#FFFFFF",
    "padding": 0,
    "font": "Inter, 'Segoe UI', system-ui, -apple-system, sans-serif",
    "text": {
      "font": "Inter, 'Segoe UI', system-ui, -apple-system, sans-serif",
      "fill": "#0F4D43",
      "fontSize": 12
    },
    "axis": {
      "gridColor": "#E6E8E2",
      "labelFont": "'Roboto Mono', Menlo, Consolas, monospace",
      "labelFontSize": 10,
      "labelColor": "#5F6E69",
      "titleFont": "'Roboto Mono', Menlo, Consolas, monospace",
      "titleColor": "#5F6E69",
      "titleFontSize": 10,
      "titleFontWeight": 400,
      "domain": false,
      "ticks": false,
      "gridWidth": 1,
      "labelPadding": 6
    },
    "style": {
      "guide-label": {
        "font": "'Roboto Mono', Menlo, Consolas, monospace"
      }
    },
    "view": {
      "stroke": null
    },
    "kibana": {
      "renderer": "svg",
      "hideWarnings": true
    }
  },
  "signals": [
    {
      "name": "ndays",
      "update": "length(data('win'))"
    },
    {
      "name": "lo",
      "update": "ndays ? data('win')[0].key : 0"
    },
    {
      "name": "hi",
      "update": "ndays ? data('win')[ndays - 1].key : 0"
    },
    {
      "name": "plo",
      "update": "lo - ndays * 86400000"
    },
    {
      "name": "phi",
      "update": "lo - 86400000"
    },
    {
      "name": "bEnd",
      "update": "length(data('io_raw')) ? data('io_raw')[0].open.doc_count : 0"
    },
    {
      "name": "bOldest",
      "update": "length(data('io_raw')) ? data('io_raw')[0].open.oldest.value : null"
    }
  ],
  "data": [
    {
      "name": "io_raw",
      "url": {
        "index": "ia-workqueue-items",
        "body": {
          "size": 0,
          "query": {
            "bool": {
              "must": [
                "%dashboard_context-must_clause%",
                {
                  "term": {
                    "mapped": true
                  }
                },
                {
                  "bool": {
                    "should": [
                      {
                        "range": {
                          "@timestamp": {
                            "gte": {
                              "%timefilter%": "min",
                              "shift": -732,
                              "unit": "day"
                            },
                            "lte": {
                              "%timefilter%": "max"
                            },
                            "format": "epoch_millis"
                          }
                        }
                      },
                      {
                        "range": {
                          "item.loaded_at": {
                            "gte": {
                              "%timefilter%": "min",
                              "shift": -732,
                              "unit": "day"
                            },
                            "lte": {
                              "%timefilter%": "max"
                            },
                            "format": "epoch_millis"
                          }
                        }
                      }
                    ],
                    "minimum_should_match": 1
                  }
                }
              ],
              "filter": [
                "%dashboard_context-filter_clause%"
              ],
              "must_not": [
                "%dashboard_context-must_not_clause%"
              ]
            }
          },
          "aggs": {
            "win": {
              "filter": {
                "range": {
                  "@timestamp": {
                    "gte": {
                      "%timefilter%": "min",
                      "shift": 1,
                      "unit": "hour"
                    },
                    "lte": {
                      "%timefilter%": "max"
                    },
                    "format": "epoch_millis"
                  }
                }
              },
              "aggs": {
                "d": {
                  "date_histogram": {
                    "field": "@timestamp",
                    "fixed_interval": "1d",
                    "min_doc_count": 0,
                    "extended_bounds": {
                      "min": {
                        "%timefilter%": "min",
                        "shift": 1,
                        "unit": "hour"
                      },
                      "max": {
                        "%timefilter%": "max"
                      }
                    }
                  }
                }
              }
            },
            "out": {
              "filter": {
                "bool": {
                  "filter": [
                    {
                      "term": {
                        "n.attempt": 1
                      }
                    },
                    {
                      "range": {
                        "@timestamp": {
                          "gte": {
                            "%timefilter%": "min",
                            "shift": -732,
                            "unit": "day"
                          },
                          "lte": {
                            "%timefilter%": "max"
                          },
                          "format": "epoch_millis"
                        }
                      }
                    }
                  ]
                }
              },
              "aggs": {
                "d": {
                  "date_histogram": {
                    "field": "@timestamp",
                    "fixed_interval": "1d",
                    "min_doc_count": 1
                  },
                  "aggs": {
                    "c": {
                      "sum": {
                        "field": "n.completed"
                      }
                    },
                    "b": {
                      "sum": {
                        "field": "n.business"
                      }
                    },
                    "s": {
                      "sum": {
                        "field": "n.system"
                      }
                    },
                    "a": {
                      "sum": {
                        "field": "n.attempt"
                      }
                    },
                    "cd": {
                      "sum": {
                        "field": "n.case_done"
                      }
                    },
                    "ec": {
                      "sum": {
                        "field": "cost.estate_gbp"
                      }
                    },
                    "hOn": {
                      "sum": {
                        "field": "value.hours_saved_onshore"
                      }
                    },
                    "hOff": {
                      "sum": {
                        "field": "value.hours_saved_offshore"
                      }
                    },
                    "w": {
                      "sum": {
                        "field": "worktime_sec"
                      }
                    },
                    "biz": {
                      "filter": {
                        "term": {
                          "n.business": 1
                        }
                      },
                      "aggs": {
                        "rhOn": {
                          "sum": {
                            "field": "value.rework_hours_onshore"
                          }
                        },
                        "rhOff": {
                          "sum": {
                            "field": "value.rework_hours_offshore"
                          }
                        },
                        "rw": {
                          "sum": {
                            "field": "value.rework_gbp"
                          }
                        }
                      }
                    }
                  }
                }
              }
            },
            "inn": {
              "filter": {
                "range": {
                  "item.loaded_at": {
                    "gte": {
                      "%timefilter%": "min",
                      "shift": -732,
                      "unit": "day"
                    },
                    "lte": {
                      "%timefilter%": "max"
                    },
                    "format": "epoch_millis"
                  }
                }
              },
              "aggs": {
                "d": {
                  "date_histogram": {
                    "field": "item.loaded_at",
                    "fixed_interval": "1d",
                    "min_doc_count": 1
                  }
                }
              }
            },
            "open": {
              "filter": {
                "bool": {
                  "filter": [
                    {
                      "range": {
                        "item.loaded_at": {
                          "lte": {
                            "%timefilter%": "max"
                          },
                          "format": "epoch_millis"
                        }
                      }
                    }
                  ],
                  "should": [
                    {
                      "term": {
                        "n.pending": 1
                      }
                    },
                    {
                      "range": {
                        "@timestamp": {
                          "gt": {
                            "%timefilter%": "max"
                          },
                          "format": "epoch_millis"
                        }
                      }
                    }
                  ],
                  "minimum_should_match": 1
                }
              },
              "aggs": {
                "oldest": {
                  "min": {
                    "field": "item.loaded_at"
                  }
                }
              }
            }
          }
        }
      },
      "format": {
        "property": "aggregations"
      }
    },
    {
      "name": "win",
      "source": "io_raw",
      "transform": [
        {
          "type": "flatten",
          "fields": [
            "win.d.buckets"
          ],
          "as": [
            "_bk"
          ]
        },
        {
          "type": "formula",
          "as": "key",
          "expr": "datum._bk.key"
        },
        {
          "type": "formula",
          "as": "n",
          "expr": "datum._bk.doc_count"
        },
        {
          "type": "project",
          "fields": [
            "key",
            "n"
          ]
        }
      ]
    },
    {
      "name": "outd",
      "source": "io_raw",
      "transform": [
        {
          "type": "flatten",
          "fields": [
            "out.d.buckets"
          ],
          "as": [
            "_bk"
          ]
        },
        {
          "type": "formula",
          "as": "key",
          "expr": "datum._bk.key"
        },
        {
          "type": "formula",
          "as": "n",
          "expr": "datum._bk.doc_count"
        },
        {
          "type": "formula",
          "as": "c",
          "expr": "datum._bk[\"c\"] ? (datum._bk[\"c\"].value || 0) : 0"
        },
        {
          "type": "formula",
          "as": "b",
          "expr": "datum._bk[\"b\"] ? (datum._bk[\"b\"].value || 0) : 0"
        },
        {
          "type": "formula",
          "as": "s",
          "expr": "datum._bk[\"s\"] ? (datum._bk[\"s\"].value || 0) : 0"
        },
        {
          "type": "formula",
          "as": "a",
          "expr": "datum._bk[\"a\"] ? (datum._bk[\"a\"].value || 0) : 0"
        },
        {
          "type": "formula",
          "as": "cd",
          "expr": "datum._bk[\"cd\"] ? (datum._bk[\"cd\"].value || 0) : 0"
        },
        {
          "type": "formula",
          "as": "ec",
          "expr": "datum._bk[\"ec\"] ? (datum._bk[\"ec\"].value || 0) : 0"
        },
        {
          "type": "formula",
          "as": "hOn",
          "expr": "datum._bk[\"hOn\"] ? (datum._bk[\"hOn\"].value || 0) : 0"
        },
        {
          "type": "formula",
          "as": "hOff",
          "expr": "datum._bk[\"hOff\"] ? (datum._bk[\"hOff\"].value || 0) : 0"
        },
        {
          "type": "formula",
          "as": "w",
          "expr": "datum._bk[\"w\"] ? (datum._bk[\"w\"].value || 0) : 0"
        },
        {
          "type": "formula",
          "as": "rhBOn",
          "expr": "datum._bk.biz.rhOn.value || 0"
        },
        {
          "type": "formula",
          "as": "rhBOff",
          "expr": "datum._bk.biz.rhOff.value || 0"
        },
        {
          "type": "formula",
          "as": "rwB",
          "expr": "datum._bk.biz.rw.value || 0"
        },
        {
          "type": "project",
          "fields": [
            "key",
            "n",
            "c",
            "b",
            "s",
            "a",
            "cd",
            "ec",
            "hOn",
            "hOff",
            "w",
            "rhBOn",
            "rhBOff",
            "rwB"
          ]
        }
      ]
    },
    {
      "name": "ind",
      "source": "io_raw",
      "transform": [
        {
          "type": "flatten",
          "fields": [
            "inn.d.buckets"
          ],
          "as": [
            "_bk"
          ]
        },
        {
          "type": "formula",
          "as": "key",
          "expr": "datum._bk.key"
        },
        {
          "type": "formula",
          "as": "n",
          "expr": "datum._bk.doc_count"
        },
        {
          "type": "project",
          "fields": [
            "key",
            "n"
          ]
        }
      ]
    },
    {
      "name": "alld",
      "source": "outd",
      "transform": [
        {
          "type": "lookup",
          "from": "ind",
          "key": "key",
          "fields": [
            "key"
          ],
          "values": [
            "n"
          ],
          "as": [
            "in"
          ],
          "default": 0
        }
      ]
    },
    {
      "name": "tot",
      "source": "alld",
      "transform": [
        {
          "type": "formula",
          "as": "cur_in",
          "expr": "datum.key >= lo && datum.key <= hi ? datum['in'] : 0"
        },
        {
          "type": "formula",
          "as": "prev_in",
          "expr": "datum.key >= plo && datum.key <= phi ? datum['in'] : 0"
        },
        {
          "type": "formula",
          "as": "cur_c",
          "expr": "datum.key >= lo && datum.key <= hi ? datum['c'] : 0"
        },
        {
          "type": "formula",
          "as": "prev_c",
          "expr": "datum.key >= plo && datum.key <= phi ? datum['c'] : 0"
        },
        {
          "type": "formula",
          "as": "cur_b",
          "expr": "datum.key >= lo && datum.key <= hi ? datum['b'] : 0"
        },
        {
          "type": "formula",
          "as": "prev_b",
          "expr": "datum.key >= plo && datum.key <= phi ? datum['b'] : 0"
        },
        {
          "type": "formula",
          "as": "cur_s",
          "expr": "datum.key >= lo && datum.key <= hi ? datum['s'] : 0"
        },
        {
          "type": "formula",
          "as": "prev_s",
          "expr": "datum.key >= plo && datum.key <= phi ? datum['s'] : 0"
        },
        {
          "type": "formula",
          "as": "cur_a",
          "expr": "datum.key >= lo && datum.key <= hi ? datum['a'] : 0"
        },
        {
          "type": "formula",
          "as": "prev_a",
          "expr": "datum.key >= plo && datum.key <= phi ? datum['a'] : 0"
        },
        {
          "type": "formula",
          "as": "cur_cd",
          "expr": "datum.key >= lo && datum.key <= hi ? datum['cd'] : 0"
        },
        {
          "type": "formula",
          "as": "prev_cd",
          "expr": "datum.key >= plo && datum.key <= phi ? datum['cd'] : 0"
        },
        {
          "type": "formula",
          "as": "cur_ec",
          "expr": "datum.key >= lo && datum.key <= hi ? datum['ec'] : 0"
        },
        {
          "type": "formula",
          "as": "prev_ec",
          "expr": "datum.key >= plo && datum.key <= phi ? datum['ec'] : 0"
        },
        {
          "type": "formula",
          "as": "cur_hOn",
          "expr": "datum.key >= lo && datum.key <= hi ? datum['hOn'] : 0"
        },
        {
          "type": "formula",
          "as": "prev_hOn",
          "expr": "datum.key >= plo && datum.key <= phi ? datum['hOn'] : 0"
        },
        {
          "type": "formula",
          "as": "cur_hOff",
          "expr": "datum.key >= lo && datum.key <= hi ? datum['hOff'] : 0"
        },
        {
          "type": "formula",
          "as": "prev_hOff",
          "expr": "datum.key >= plo && datum.key <= phi ? datum['hOff'] : 0"
        },
        {
          "type": "formula",
          "as": "cur_w",
          "expr": "datum.key >= lo && datum.key <= hi ? datum['w'] : 0"
        },
        {
          "type": "formula",
          "as": "prev_w",
          "expr": "datum.key >= plo && datum.key <= phi ? datum['w'] : 0"
        },
        {
          "type": "formula",
          "as": "cur_rhBOn",
          "expr": "datum.key >= lo && datum.key <= hi ? datum['rhBOn'] : 0"
        },
        {
          "type": "formula",
          "as": "prev_rhBOn",
          "expr": "datum.key >= plo && datum.key <= phi ? datum['rhBOn'] : 0"
        },
        {
          "type": "formula",
          "as": "cur_rhBOff",
          "expr": "datum.key >= lo && datum.key <= hi ? datum['rhBOff'] : 0"
        },
        {
          "type": "formula",
          "as": "prev_rhBOff",
          "expr": "datum.key >= plo && datum.key <= phi ? datum['rhBOff'] : 0"
        },
        {
          "type": "formula",
          "as": "cur_rwB",
          "expr": "datum.key >= lo && datum.key <= hi ? datum['rwB'] : 0"
        },
        {
          "type": "formula",
          "as": "prev_rwB",
          "expr": "datum.key >= plo && datum.key <= phi ? datum['rwB'] : 0"
        },
        {
          "type": "aggregate",
          "ops": [
            "sum",
            "sum",
            "sum",
            "sum",
            "sum",
            "sum",
            "sum",
            "sum",
            "sum",
            "sum",
            "sum",
            "sum",
            "sum",
            "sum",
            "sum",
            "sum",
            "sum",
            "sum",
            "sum",
            "sum",
            "sum",
            "sum",
            "sum",
            "sum",
            "sum",
            "sum"
          ],
          "fields": [
            "cur_in",
            "prev_in",
            "cur_c",
            "prev_c",
            "cur_b",
            "prev_b",
            "cur_s",
            "prev_s",
            "cur_a",
            "prev_a",
            "cur_cd",
            "prev_cd",
            "cur_ec",
            "prev_ec",
            "cur_hOn",
            "prev_hOn",
            "cur_hOff",
            "prev_hOff",
            "cur_w",
            "prev_w",
            "cur_rhBOn",
            "prev_rhBOn",
            "cur_rhBOff",
            "prev_rhBOff",
            "cur_rwB",
            "prev_rwB"
          ],
          "as": [
            "cur_in",
            "prev_in",
            "cur_c",
            "prev_c",
            "cur_b",
            "prev_b",
            "cur_s",
            "prev_s",
            "cur_a",
            "prev_a",
            "cur_cd",
            "prev_cd",
            "cur_ec",
            "prev_ec",
            "cur_hOn",
            "prev_hOn",
            "cur_hOff",
            "prev_hOff",
            "cur_w",
            "prev_w",
            "cur_rhBOn",
            "prev_rhBOn",
            "cur_rhBOff",
            "prev_rhBOff",
            "cur_rwB",
            "prev_rwB"
          ]
        }
      ]
    },
    {
      "name": "series",
      "source": "win",
      "transform": [
        {
          "type": "lookup",
          "from": "outd",
          "key": "key",
          "fields": [
            "key"
          ],
          "as": [
            "d"
          ]
        },
        {
          "type": "lookup",
          "from": "ind",
          "key": "key",
          "fields": [
            "key"
          ],
          "values": [
            "n"
          ],
          "as": [
            "in"
          ],
          "default": 0
        },
        {
          "type": "formula",
          "as": "t",
          "expr": "datum.key"
        },
        {
          "type": "formula",
          "as": "c",
          "expr": "datum.d ? datum.d['c'] : 0"
        },
        {
          "type": "formula",
          "as": "b",
          "expr": "datum.d ? datum.d['b'] : 0"
        },
        {
          "type": "formula",
          "as": "s",
          "expr": "datum.d ? datum.d['s'] : 0"
        },
        {
          "type": "formula",
          "as": "a",
          "expr": "datum.d ? datum.d['a'] : 0"
        },
        {
          "type": "formula",
          "as": "cd",
          "expr": "datum.d ? datum.d['cd'] : 0"
        },
        {
          "type": "formula",
          "as": "ec",
          "expr": "datum.d ? datum.d['ec'] : 0"
        },
        {
          "type": "formula",
          "as": "hOn",
          "expr": "datum.d ? datum.d['hOn'] : 0"
        },
        {
          "type": "formula",
          "as": "hOff",
          "expr": "datum.d ? datum.d['hOff'] : 0"
        },
        {
          "type": "formula",
          "as": "w",
          "expr": "datum.d ? datum.d['w'] : 0"
        },
        {
          "type": "formula",
          "as": "rhBOn",
          "expr": "datum.d ? datum.d['rhBOn'] : 0"
        },
        {
          "type": "formula",
          "as": "rhBOff",
          "expr": "datum.d ? datum.d['rhBOff'] : 0"
        },
        {
          "type": "formula",
          "as": "rwB",
          "expr": "datum.d ? datum.d['rwB'] : 0"
        },
        {
          "type": "collect",
          "sort": {
            "field": "t"
          }
        },
        {
          "type": "formula",
          "as": "net",
          "expr": "datum.in - datum.a"
        },
        {
          "type": "window",
          "sort": {
            "field": "t"
          },
          "ops": [
            "sum"
          ],
          "fields": [
            "net"
          ],
          "as": [
            "cum"
          ],
          "frame": [
            null,
            0
          ]
        },
        {
          "type": "joinaggregate",
          "ops": [
            "sum"
          ],
          "fields": [
            "net"
          ],
          "as": [
            "netAll"
          ]
        },
        {
          "type": "formula",
          "as": "backlog",
          "expr": "max(0, bEnd - (datum.netAll - datum.cum))"
        }
      ]
    },
    {
      "name": "inTot",
      "source": "ind",
      "transform": [
        {
          "type": "formula",
          "as": "c",
          "expr": "datum.key >= lo && datum.key <= hi ? datum.n : 0"
        },
        {
          "type": "formula",
          "as": "p",
          "expr": "datum.key >= plo && datum.key <= phi ? datum.n : 0"
        },
        {
          "type": "aggregate",
          "ops": [
            "sum",
            "sum"
          ],
          "fields": [
            "c",
            "p"
          ],
          "as": [
            "c",
            "p"
          ]
        }
      ]
    },
    {
      "name": "tiles",
      "values": [
        {
          "i": 0,
          "label": "Work in",
          "deltaGood": "up"
        },
        {
          "i": 1,
          "label": "Work out",
          "deltaGood": "up"
        },
        {
          "i": 2,
          "label": "Waiting at period end",
          "deltaGood": "down"
        },
        {
          "i": 3,
          "label": "Cases completed",
          "deltaGood": "up"
        },
        {
          "i": 4,
