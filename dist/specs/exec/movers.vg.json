            "prev_h",
            "cur_gb",
            "prev_gb",
            "cur_ec",
            "prev_ec",
            "cur_rw",
            "prev_rw"
          ],
          "as": [
            "cur_c",
            "prev_c",
            "cur_b",
            "prev_b",
            "cur_s",
            "prev_s",
            "cur_e",
            "prev_e",
            "cur_a",
            "prev_a",
            "cur_h",
            "prev_h",
            "cur_gb",
            "prev_gb",
            "cur_ec",
            "prev_ec",
            "cur_rw",
            "prev_rw"
