    {
      "name": "fym",
      "source": "days",
      "transform": [
        {
          "type": "filter",
          "expr": "datum.key >= fyStart && datum.key <= hi"
        },
        {
          "type": "formula",
          "as": "m",
          "expr": "utc(utcyear(datum.key), utcmonth(datum.key), 1)"
        },
        {
          "type": "aggregate",
          "groupby": [
            "m"
          ],
          "ops": [
            "sum",
            "sum",
            "sum"
          ],
          "fields": [
            "gb",
            "ec",
            "c"
          ],
          "as": [
            "gb",
            "ec",
            "c"
          ]
        },
        {
          "type": "formula",
          "as": "net",
          "expr": "datum.gb - datum.ec"
        },
        {
          "type": "collect",
          "sort": {
            "field": "m"
          }
        },
        {
          "type": "window",
          "ops": [
            "row_number"
          ],
          "as": [
            "i"
          ]
        }
      ]
