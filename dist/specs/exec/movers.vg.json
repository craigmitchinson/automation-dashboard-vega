        {
          "type": "formula",
          "as": "cur",
          "expr": "datum.bk.key >= fyStart && datum.bk.key <= hi"
        },
        {
          "type": "formula",
          "as": "net",
          "expr": "datum.cur ? datum.bk.gb.value - datum.bk.ec.value : 0"
        },
        {
          "type": "formula",
          "as": "pnet",
          "expr": "datum.bk.key >= pfyStart && datum.bk.key <= pfyHi ? datum.bk.gb.value - datum.bk.ec.value : 0"
        },
        {
          "type": "formula",
          "as": "c",
          "expr": "datum.cur ? datum.bk.c.value : 0"
        },
        {
          "type": "formula",
          "as": "e",
          "expr": "datum.cur ? datum.bk.e.value : 0"
        },
        {
