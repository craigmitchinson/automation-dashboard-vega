{
  "$schema": "https://vega.github.io/schema/vega/v5.json",
  "description": "IA · VDI & Capacity · Capacity & cost summary. Generated by vega/build.mjs from vega/panels/capacity.mjs, do not edit by hand.",
  "autosize": {
    "type": "fit",
    "contains": "padding"
  },
  "padding": 0,
  "config": {
    "background": "#FFFFFF",
    "padding": 0,
    "font": "Inter, 'Segoe UI', system-ui, -apple-system, sans-serif",
    "text": {
      "font": "Inter, 'Segoe UI', system-ui, -apple-system, sans-serif",
      "fill": "#0F4D43",
      "fontSize": 12
    },
    "axis": {
      "gridColor": "#E6E8E2",
      "labelFont": "'Roboto Mono', Menlo, Consolas, monospace",
      "labelFontSize": 10,
      "labelColor": "#5F6E69",
      "titleFont": "'Roboto Mono', Menlo, Consolas, monospace",
      "titleColor": "#5F6E69",
      "titleFontSize": 10,
      "titleFontWeight": 400,
      "domain": false,
      "ticks": false,
      "gridWidth": 1,
      "labelPadding": 6
    },
    "style": {
      "guide-label": {
        "font": "'Roboto Mono', Menlo, Consolas, monospace"
      }
    },
    "view": {
      "stroke": null
    },
    "kibana": {
      "renderer": "svg",
      "hideWarnings": true
    }
  },
  "signals": [
    {
      "name": "oneSpoke",
      "update": "length(data('scope_spokes')) === 1 ? data('scope_spokes')[0].key : ''"
    },
    {
      "name": "tgt_completionPct",
      "update": "oneSpoke && indexof(pluck(data('tg'), 'k'), 'spoke|' + oneSpoke + '|completionPct') >= 0 ? data('tg')[indexof(pluck(data('tg'), 'k'), 'spoke|' + oneSpoke + '|completionPct')].v : (indexof(pluck(data('tg'), 'k'), 'global|completionPct') >= 0 ? data('tg')[indexof(pluck(data('tg'), 'k'), 'global|completionPct')].v : 0.95)"
    },
    {
      "name": "tgt_exceptionRate",
      "update": "oneSpoke && indexof(pluck(data('tg'), 'k'), 'spoke|' + oneSpoke + '|exceptionRate') >= 0 ? data('tg')[indexof(pluck(data('tg'), 'k'), 'spoke|' + oneSpoke + '|exceptionRate')].v : (indexof(pluck(data('tg'), 'k'), 'global|exceptionRate') >= 0 ? data('tg')[indexof(pluck(data('tg'), 'k'), 'global|exceptionRate')].v : 0.06)"
    },
    {
      "name": "tgt_systemRate",
      "update": "oneSpoke && indexof(pluck(data('tg'), 'k'), 'spoke|' + oneSpoke + '|systemRate') >= 0 ? data('tg')[indexof(pluck(data('tg'), 'k'), 'spoke|' + oneSpoke + '|systemRate')].v : (indexof(pluck(data('tg'), 'k'), 'global|systemRate') >= 0 ? data('tg')[indexof(pluck(data('tg'), 'k'), 'global|systemRate')].v : 0.03)"
    },
    {
      "name": "tgt_costPerCase",
      "update": "oneSpoke && indexof(pluck(data('tg'), 'k'), 'spoke|' + oneSpoke + '|costPerCase') >= 0 ? data('tg')[indexof(pluck(data('tg'), 'k'), 'spoke|' + oneSpoke + '|costPerCase')].v : (indexof(pluck(data('tg'), 'k'), 'global|costPerCase') >= 0 ? data('tg')[indexof(pluck(data('tg'), 'k'), 'global|costPerCase')].v : 9)"
    },
    {
      "name": "tgt_utilMin",
      "update": "oneSpoke && indexof(pluck(data('tg'), 'k'), 'spoke|' + oneSpoke + '|utilMin') >= 0 ? data('tg')[indexof(pluck(data('tg'), 'k'), 'spoke|' + oneSpoke + '|utilMin')].v : (indexof(pluck(data('tg'), 'k'), 'global|utilMin') >= 0 ? data('tg')[indexof(pluck(data('tg'), 'k'), 'global|utilMin')].v : 0.15)"
    },
    {
      "name": "tgt_utilMax",
      "update": "oneSpoke && indexof(pluck(data('tg'), 'k'), 'spoke|' + oneSpoke + '|utilMax') >= 0 ? data('tg')[indexof(pluck(data('tg'), 'k'), 'spoke|' + oneSpoke + '|utilMax')].v : (indexof(pluck(data('tg'), 'k'), 'global|utilMax') >= 0 ? data('tg')[indexof(pluck(data('tg'), 'k'), 'global|utilMax')].v : 0.6)"
    },
    {
      "name": "tgt_vdiStaleDays",
      "update": "oneSpoke && indexof(pluck(data('tg'), 'k'), 'spoke|' + oneSpoke + '|vdiStaleDays') >= 0 ? data('tg')[indexof(pluck(data('tg'), 'k'), 'spoke|' + oneSpoke + '|vdiStaleDays')].v : (indexof(pluck(data('tg'), 'k'), 'global|vdiStaleDays') >= 0 ? data('tg')[indexof(pluck(data('tg'), 'k'), 'global|vdiStaleDays')].v : 14)"
    },
    {
      "name": "cfg_fyStart",
      "update": "length(data('ref_config')) ? data('ref_config')[0]._source.fiscal_year_start_month : 4"
    },
    {
      "name": "cfg_warn",
      "update": "length(data('ref_config')) ? data('ref_config')[0]._source.warn_margin : 0.1"
    },
    {
      "name": "allSpokes",
      "update": "length(data('scope_all')) >= (length(data('ref_spoke_count')) ? data('ref_spoke_count')[0].value : 99)"
    },
    {
      "name": "nActive",
      "update": "length(data('vdi_tot')) ? data('vdi_tot')[0].nActive : 0"
    },
    {
      "name": "nAll",
      "update": "length(data('vdi_tot')) ? data('vdi_tot')[0].nAll : 0"
    },
    {
      "name": "sumAvail",
      "update": "length(data('vdi_tot')) ? data('vdi_tot')[0].sumAvail : 0"
    },
    {
      "name": "sumActive",
      "update": "length(data('vdi_tot')) ? data('vdi_tot')[0].sumActive : 0"
    },
    {
      "name": "sumIdle",
      "update": "length(data('vdi_tot')) ? data('vdi_tot')[0].sumIdle : 0"
    },
    {
      "name": "sumCost",
      "update": "length(data('vdi_tot')) ? data('vdi_tot')[0].sumCost : 0"
    },
    {
      "name": "avgUtil",
      "update": "sumAvail ? sumActive / sumAvail : 0"
    },
    {
      "name": "headerRight",
      "value": 0
    },
    {
      "name": "top",
      "value": 42
    },
    {
      "name": "cw",
      "update": "width - 32"
    },
    {
      "name": "ch",
      "update": "height - top - 16"
    },
    {
      "name": "gR",
      "update": "min(58, ch * 0.62)"
    },
    {
      "name": "gx",
      "update": "16 + gR + 6"
    },
    {
      "name": "gy",
      "update": "top + ch * 0.5 + gR * 0.55"
    }
  ],
  "data": [
    {
      "name": "ref_targets",
      "url": {
        "index": "ia-reference",
        "body": {
          "size": 200,
          "query": {
            "term": {
              "doc_type": "target"
            }
          }
        }
      },
      "format": {
        "property": "hits.hits"
      }
    },
    {
      "name": "tg",
      "source": "ref_targets",
      "transform": [
        {
          "type": "formula",
          "as": "k",
          "expr": "datum._source.scope === 'global' ? 'global|' + datum._source.metric : datum._source.scope + '|' + datum._source.scope_id + '|' + datum._source.metric"
        },
        {
          "type": "formula",
          "as": "v",
          "expr": "datum._source.value"
        }
      ]
    },
    {
      "name": "ref_config",
      "url": {
        "index": "ia-reference",
        "body": {
          "size": 1,
          "query": {
            "term": {
              "doc_type": "config"
            }
          }
        }
      },
      "format": {
        "property": "hits.hits"
      }
    },
    {
      "name": "scope_spokes",
      "url": {
        "%context%": true,
        "%timefield%": "@timestamp",
        "index": "ia-workqueue-items",
        "body": {
          "size": 0,
          "aggs": {
            "m": {
              "filter": {
                "term": {
                  "mapped": true
                }
              },
              "aggs": {
                "s": {
                  "terms": {
                    "field": "spoke.name",
                    "size": 2
                  }
                }
              }
            }
          }
        }
      },
      "format": {
        "property": "aggregations.m.s.buckets"
      }
    },
    {
      "name": "act_raw",
      "url": {
        "%context%": true,
        "%timefield%": "@timestamp",
        "index": "ia-workqueue-items",
        "body": {
          "size": 0,
          "aggs": {
            "m": {
              "filter": {
                "bool": {
                  "filter": [
                    {
                      "term": {
                        "mapped": true
                      }
                    },
                    {
                      "exists": {
                        "field": "resource.name"
                      }
                    }
                  ]
                }
              },
              "aggs": {
                "r": {
                  "terms": {
                    "field": "resource.name",
                    "size": 500
                  },
                  "aggs": {
                    "w": {
                      "sum": {
                        "field": "worktime_sec"
                      }
                    },
                    "ec": {
                      "sum": {
                        "field": "cost.estate_gbp"
                      }
                    },
                    "np": {
                      "cardinality": {
                        "field": "process.name"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      },
      "format": {
        "property": "aggregations.m.r.buckets"
      }
    },
    {
      "name": "scope_all",
      "url": {
        "%context%": true,
        "%timefield%": "@timestamp",
        "index": "ia-workqueue-items",
        "body": {
          "size": 0,
          "aggs": {
            "m": {
              "filter": {
                "term": {
                  "mapped": true
                }
              },
              "aggs": {
                "s": {
                  "terms": {
                    "field": "spoke.name",
                    "size": 100
                  }
                }
              }
            }
          }
        }
      },
      "format": {
        "property": "aggregations.m.s.buckets"
      }
    },
    {
      "name": "avail_raw",
      "url": {
        "index": "ia-vdi-daily",
        "body": {
          "size": 0,
          "query": {
            "range": {
              "@timestamp": {
                "%timefilter%": true
              }
            }
          },
          "aggs": {
            "r": {
              "terms": {
                "field": "resource.name",
                "size": 500
              },
              "aggs": {
                "h": {
                  "sum": {
                    "field": "operating_hours"
                  }
                },
                "o": {
                  "terms": {
                    "field": "resource.owner_spoke",
                    "size": 1
                  }
                }
              }
            }
          }
        }
      },
      "format": {
        "property": "aggregations.r.buckets"
      }
    },
    {
      "name": "ref_spoke_count",
      "url": {
        "index": "ia-reference",
        "body": {
          "size": 0,
          "query": {
            "term": {
              "doc_type": "spoke"
            }
          }
        }
      },
      "format": {
        "property": "hits.total"
      }
    },
    {
      "name": "vdis",
      "source": "avail_raw",
      "transform": [
        {
          "type": "formula",
          "as": "name",
          "expr": "datum.key"
        },
        {
          "type": "formula",
          "as": "spoke",
          "expr": "datum.o.buckets[0].key"
        },
        {
          "type": "formula",
          "as": "availableHours",
          "expr": "datum.h.value"
        },
        {
          "type": "lookup",
          "from": "act_raw",
          "key": "key",
          "fields": [
            "key"
          ],
          "as": [
            "a"
          ]
        },
        {
          "type": "formula",
          "as": "cases",
          "expr": "datum.a ? datum.a.doc_count : 0"
        },
        {
          "type": "formula",
          "as": "activeHours",
          "expr": "datum.a ? datum.a.w.value / 3600 : 0"
        },
        {
          "type": "formula",
          "as": "cost",
          "expr": "datum.a ? datum.a.ec.value : 0"
        },
        {
          "type": "formula",
          "as": "processes",
          "expr": "datum.a ? datum.a.np.value : 0"
        },
        {
          "type": "formula",
          "as": "idleHours",
          "expr": "max(0, datum.availableHours - datum.activeHours)"
        },
        {
          "type": "formula",
          "as": "idlePct",
          "expr": "datum.availableHours ? datum.idleHours / datum.availableHours : 0"
        },
        {
          "type": "formula",
          "as": "utilPct",
          "expr": "datum.availableHours ? min(1, datum.activeHours / datum.availableHours) : 0"
        },
        {
          "type": "filter",
          "expr": "(datum.availableHours > 0 || datum.cases > 0) && (datum.cases > 0 || allSpokes || indexof(pluck(data('scope_all'), 'key'), datum.spoke) >= 0)"
        }
      ]
    },
    {
      "name": "vdi_tot",
      "source": "vdis",
      "transform": [
        {
          "type": "formula",
          "as": "on",
          "expr": "datum.cases > 0 ? 1 : 0"
        },
        {
          "type": "formula",
          "as": "av",
          "expr": "datum.cases > 0 ? datum.availableHours : 0"
        },
        {
          "type": "formula",
          "as": "ac",
          "expr": "datum.cases > 0 ? datum.activeHours : 0"
        },
        {
          "type": "formula",
          "as": "id",
          "expr": "datum.cases > 0 ? datum.idleHours : 0"
        },
        {
          "type": "aggregate",
          "ops": [
            "sum",
            "count",
            "sum",
            "sum",
            "sum",
            "sum"
          ],
          "fields": [
            "on",
            "name",
            "av",
            "ac",
            "id",
            "cost"
          ],
          "as": [
            "nActive",
            "nAll",
            "sumAvail",
            "sumActive",
            "sumIdle",
            "sumCost"
          ]
        }
      ]
    }
  ],
  "marks": [
    {
      "type": "text",
      "name": "frame_title",
      "encode": {
        "update": {
          "x": {
            "value": 16
          },
          "y": {
            "value": 18
          },
          "baseline": {
            "value": "top"
          },
          "font": {
            "value": "'Roboto Mono', Menlo, Consolas, monospace"
          },
          "fontSize": {
            "value": 11
          },
          "fontWeight": {
            "value": 600
          },
          "fill": {
            "value": "#0F4D43"
          },
          "text": {
            "signal": "'CAPACITY & COST SUMMARY'"
          },
          "limit": {
            "signal": "width - 32"
          }
        }
      }
    },
    {
      "type": "text",
      "encode": {
        "update": {
          "x": {
            "signal": "16 + length('CAPACITY & COST SUMMARY') * 6.9 + 10"
          },
          "y": {
            "value": 17
          },
          "baseline": {
            "value": "top"
          },
          "font": {
            "value": "Inter, 'Segoe UI', system-ui, -apple-system, sans-serif"
          },
          "fontSize": {
            "value": 12
          },
          "fill": {
            "value": "#5F6E69"
          },
          "text": {
            "value": "Utilisation against the healthy band, and where the spend goes"
          },
          "limit": {
            "signal": "width - 42 - length('CAPACITY & COST SUMMARY') * 6.9 - 0 - headerRight"
          }
        }
      }
    },
    {
      "type": "arc",
      "encode": {
        "update": {
          "x": {
            "signal": "gx"
          },
          "y": {
            "signal": "gy"
          },
          "startAngle": {
            "value": -1.5707963267948966
          },
          "endAngle": {
            "value": 1.5707963267948966
          },
          "innerRadius": {
            "signal": "gR - 10"
          },
          "outerRadius": {
            "signal": "gR"
          },
          "cornerRadius": {
            "value": 5
          },
          "fill": {
            "value": "#E6E8E2"
          }
        }
      }
    },
    {
      "type": "arc",
      "encode": {
        "update": {
          "x": {
            "signal": "gx"
          },
          "y": {
            "signal": "gy"
          },
          "startAngle": {
            "signal": "-PI / 2 + PI * tgt_utilMin"
          },
          "endAngle": {
            "signal": "-PI / 2 + PI * tgt_utilMax"
          },
          "innerRadius": {
            "signal": "gR - 10"
          },
          "outerRadius": {
            "signal": "gR"
          },
          "fill": {
            "value": "#0B8A6B"
          },
          "fillOpacity": {
            "value": 0.22
          }
        }
      }
    },
    {
      "type": "arc",
      "encode": {
        "update": {
          "x": {
            "signal": "gx"
          },
          "y": {
            "signal": "gy"
          },
          "startAngle": {
            "value": -1.5707963267948966
          },
          "endAngle": {
            "signal": "-PI / 2 + PI * clamp(avgUtil, 0.005, 1)"
          },
          "innerRadius": {
            "signal": "gR - 10"
          },
          "outerRadius": {
            "signal": "gR"
          },
          "cornerRadius": {
            "value": 5
          },
          "fill": {
            "signal": "(avgUtil >= tgt_utilMax ? '#B6462F' : avgUtil >= tgt_utilMin ? '#0B8A6B' : '#B9852C')"
          }
        }
      }
    },
    {
      "type": "rule",
      "encode": {
        "update": {
          "x": {
            "signal": "gx + sin(-PI / 2 + PI * tgt_utilMax) * (gR - 16)"
          },
          "y": {
            "signal": "gy - cos(-PI / 2 + PI * tgt_utilMax) * (gR - 16)"
          },
          "x2": {
            "signal": "gx + sin(-PI / 2 + PI * tgt_utilMax) * (gR + 6)"
          },
          "y2": {
            "signal": "gy - cos(-PI / 2 + PI * tgt_utilMax) * (gR + 6)"
          },
          "stroke": {
            "value": "#0F4D43"
          },
          "strokeWidth": {
            "value": 2
          }
        }
      }
    },
    {
      "type": "text",
      "encode": {
        "update": {
          "x": {
            "signal": "gx"
          },
          "y": {
            "signal": "gy - 14"
          },
          "align": {
            "value": "center"
          },
          "font": {
            "value": "Inter, 'Segoe UI', system-ui, -apple-system, sans-serif"
          },
          "fontSize": {
            "value": 22
          },
          "fontWeight": {
            "value": 600
          },
          "fill": {
            "value": "#0F4D43"
          },
          "text": {
            "signal": "(isValid((avgUtil)) && isFinite((avgUtil)) ? format((avgUtil) * 100, '.0f') + '%' : '–')"
          }
        }
      }
    },
    {
      "type": "text",
      "encode": {
        "update": {
          "x": {
            "signal": "gx"
          },
          "y": {
            "signal": "gy + 2"
          },
          "align": {
            "value": "center"
          },
          "font": {
            "value": "'Roboto Mono', Menlo, Consolas, monospace"
          },
          "fontSize": {
            "value": 9.5
          },
          "fill": {
            "value": "#5F6E69"
          },
          "text": {
            "value": "UTILISATION"
          }
        }
      }
    },
    {
      "type": "text",
      "encode": {
        "update": {
          "x": {
            "signal": "gx + gR + 24"
          },
          "y": {
            "signal": "top + 4 + (0 + 0.5) * (ch - 8) / 3"
          },
          "baseline": {
            "value": "middle"
          },
          "font": {
            "value": "Inter, 'Segoe UI', system-ui, -apple-system, sans-serif"
          },
          "fontSize": {
            "value": 13
          },
          "fill": {
            "value": "#5F6E69"
          },
          "text": {
            "value": "Licensed capacity"
          }
        }
      }
    },
    {
      "type": "text",
      "encode": {
        "update": {
          "x": {
            "signal": "width - 16"
          },
          "y": {
            "signal": "top + 4 + (0 + 0.5) * (ch - 8) / 3"
          },
          "align": {
            "value": "right"
          },
          "baseline": {
            "value": "middle"
          },
          "font": {
            "value": "'Roboto Mono', Menlo, Consolas, monospace"
          },
          "fontSize": {
            "value": 13.5
          },
          "fontWeight": {
            "value": 600
          },
          "fill": {
            "value": "#0F4D43"
          },
          "text": {
            "signal": "(isValid((sumAvail)) && isFinite((sumAvail)) ? (abs((sumAvail)) >= 1e6 ? format((sumAvail) / 1e6, abs((sumAvail)) >= 1e7 ? '.0f' : '.1f') + 'M' : abs((sumAvail)) >= 1e3 ? format((sumAvail) / 1e3, abs((sumAvail)) >= 1e4 ? '.0f' : '.1f') + 'k' : format((sumAvail), '.0f')) : '–') + ' h'"
          }
        }
      }
    },
    {
      "type": "rule",
      "encode": {
        "update": {
          "x": {
            "signal": "gx + gR + 24"
          },
          "x2": {
            "signal": "width - 16"
          },
          "y": {
            "signal": "top + 4 + 1 * (ch - 8) / 3"
          },
          "stroke": {
            "value": "#D6D9D2"
          }
        }
      }
    },
    {
      "type": "text",
      "encode": {
        "update": {
          "x": {
            "signal": "gx + gR + 24"
          },
          "y": {
            "signal": "top + 4 + (1 + 0.5) * (ch - 8) / 3"
          },
          "baseline": {
            "value": "middle"
          },
          "font": {
            "value": "Inter, 'Segoe UI', system-ui, -apple-system, sans-serif"
          },
          "fontSize": {
            "value": 13
          },
          "fill": {
            "value": "#5F6E69"
          },
          "text": {
            "value": "Productive bot time"
          }
        }
      }
    },
    {
      "type": "text",
      "encode": {
        "update": {
          "x": {
            "signal": "width - 16"
          },
          "y": {
            "signal": "top + 4 + (1 + 0.5) * (ch - 8) / 3"
          },
          "align": {
            "value": "right"
          },
          "baseline": {
            "value": "middle"
          },
          "font": {
