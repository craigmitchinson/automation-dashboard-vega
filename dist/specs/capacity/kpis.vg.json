{
  "$schema": "https://vega.github.io/schema/vega/v5.json",
  "description": "IA · VDI & Capacity · Capacity KPIs. Generated by vega/build.mjs from vega/panels/capacity.mjs, do not edit by hand.",
  "autosize": {
    "type": "fit",
    "contains": "padding"
  },
  "padding": 0,
  "config": {
    "background": "#FFFFFF",
    "padding": 0,
    "font": "Inter, 'Segoe UI', Carlito, Calibri, Arial, sans-serif",
    "text": {
      "font": "Inter, 'Segoe UI', Carlito, Calibri, Arial, sans-serif",
      "fill": "#0F4D43",
      "fontSize": 12
    },
    "axis": {
      "gridColor": "#E6E8E2",
      "labelFont": "'JetBrains Mono', Consolas, 'Roboto Mono', monospace",
      "labelFontSize": 10,
      "labelColor": "#5F6E69",
      "titleFont": "'JetBrains Mono', Consolas, 'Roboto Mono', monospace",
      "titleColor": "#5F6E69",
      "titleFontSize": 10,
      "titleFontWeight": 400,
      "domain": false,
      "ticks": false,
      "gridWidth": 1,
      "labelPadding": 6
    },
    "style": {
      "guide-label": {
        "font": "'JetBrains Mono', Consolas, 'Roboto Mono', monospace"
      }
    },
    "view": {
      "stroke": null
    },
    "kibana": {
      "renderer": "svg",
      "hideWarnings": true
    }
  },
  "signals": [
    {
      "name": "oneSpoke",
      "update": "length(data('scope_spokes')) === 1 ? data('scope_spokes')[0].key : ''"
    },
    {
      "name": "tgt_completionPct",
      "update": "oneSpoke && indexof(pluck(data('tg'), 'k'), 'spoke|' + oneSpoke + '|completionPct') >= 0 ? data('tg')[indexof(pluck(data('tg'), 'k'), 'spoke|' + oneSpoke + '|completionPct')].v : (indexof(pluck(data('tg'), 'k'), 'global|completionPct') >= 0 ? data('tg')[indexof(pluck(data('tg'), 'k'), 'global|completionPct')].v : 0.95)"
    },
    {
      "name": "tgt_exceptionRate",
      "update": "oneSpoke && indexof(pluck(data('tg'), 'k'), 'spoke|' + oneSpoke + '|exceptionRate') >= 0 ? data('tg')[indexof(pluck(data('tg'), 'k'), 'spoke|' + oneSpoke + '|exceptionRate')].v : (indexof(pluck(data('tg'), 'k'), 'global|exceptionRate') >= 0 ? data('tg')[indexof(pluck(data('tg'), 'k'), 'global|exceptionRate')].v : 0.06)"
    },
    {
      "name": "tgt_systemRate",
      "update": "oneSpoke && indexof(pluck(data('tg'), 'k'), 'spoke|' + oneSpoke + '|systemRate') >= 0 ? data('tg')[indexof(pluck(data('tg'), 'k'), 'spoke|' + oneSpoke + '|systemRate')].v : (indexof(pluck(data('tg'), 'k'), 'global|systemRate') >= 0 ? data('tg')[indexof(pluck(data('tg'), 'k'), 'global|systemRate')].v : 0.03)"
    },
    {
      "name": "tgt_costPerCase",
      "update": "oneSpoke && indexof(pluck(data('tg'), 'k'), 'spoke|' + oneSpoke + '|costPerCase') >= 0 ? data('tg')[indexof(pluck(data('tg'), 'k'), 'spoke|' + oneSpoke + '|costPerCase')].v : (indexof(pluck(data('tg'), 'k'), 'global|costPerCase') >= 0 ? data('tg')[indexof(pluck(data('tg'), 'k'), 'global|costPerCase')].v : 9)"
    },
    {
      "name": "tgt_utilMin",
      "update": "oneSpoke && indexof(pluck(data('tg'), 'k'), 'spoke|' + oneSpoke + '|utilMin') >= 0 ? data('tg')[indexof(pluck(data('tg'), 'k'), 'spoke|' + oneSpoke + '|utilMin')].v : (indexof(pluck(data('tg'), 'k'), 'global|utilMin') >= 0 ? data('tg')[indexof(pluck(data('tg'), 'k'), 'global|utilMin')].v : 0.15)"
    },
    {
      "name": "tgt_utilMax",
      "update": "oneSpoke && indexof(pluck(data('tg'), 'k'), 'spoke|' + oneSpoke + '|utilMax') >= 0 ? data('tg')[indexof(pluck(data('tg'), 'k'), 'spoke|' + oneSpoke + '|utilMax')].v : (indexof(pluck(data('tg'), 'k'), 'global|utilMax') >= 0 ? data('tg')[indexof(pluck(data('tg'), 'k'), 'global|utilMax')].v : 0.6)"
    },
    {
      "name": "tgt_vdiStaleDays",
      "update": "oneSpoke && indexof(pluck(data('tg'), 'k'), 'spoke|' + oneSpoke + '|vdiStaleDays') >= 0 ? data('tg')[indexof(pluck(data('tg'), 'k'), 'spoke|' + oneSpoke + '|vdiStaleDays')].v : (indexof(pluck(data('tg'), 'k'), 'global|vdiStaleDays') >= 0 ? data('tg')[indexof(pluck(data('tg'), 'k'), 'global|vdiStaleDays')].v : 14)"
    },
    {
      "name": "cfg_fyStart",
      "update": "length(data('ref_config')) ? data('ref_config')[0]._source.fiscal_year_start_month : 4"
    },
    {
      "name": "cfg_warn",
      "update": "length(data('ref_config')) ? data('ref_config')[0]._source.warn_margin : 0.1"
    },
    {
      "name": "allSpokes",
      "update": "length(data('scope_all')) >= (length(data('ref_spoke_count')) ? data('ref_spoke_count')[0].value : 99)"
    },
    {
      "name": "nActive",
      "update": "length(data('vdi_tot')) ? data('vdi_tot')[0].nActive : 0"
    },
    {
      "name": "nAll",
      "update": "length(data('vdi_tot')) ? data('vdi_tot')[0].nAll : 0"
    },
    {
      "name": "sumAvail",
      "update": "length(data('vdi_tot')) ? data('vdi_tot')[0].sumAvail : 0"
    },
    {
      "name": "sumActive",
      "update": "length(data('vdi_tot')) ? data('vdi_tot')[0].sumActive : 0"
    },
    {
      "name": "sumIdle",
      "update": "length(data('vdi_tot')) ? data('vdi_tot')[0].sumIdle : 0"
    },
    {
      "name": "sumCost",
      "update": "length(data('vdi_tot')) ? data('vdi_tot')[0].sumCost : 0"
    },
    {
      "name": "avgUtil",
      "update": "sumAvail ? sumActive / sumAvail : 0"
    }
  ],
  "data": [
    {
      "name": "ref_targets",
      "url": {
        "index": "ia-reference",
        "body": {
          "size": 200,
          "query": {
            "term": {
              "doc_type": "target"
            }
          }
        }
      },
      "format": {
        "property": "hits.hits"
      }
    },
    {
      "name": "tg",
      "source": "ref_targets",
      "transform": [
        {
          "type": "formula",
          "as": "k",
          "expr": "datum._source.scope === 'global' ? 'global|' + datum._source.metric : datum._source.scope + '|' + datum._source.scope_id + '|' + datum._source.metric"
        },
        {
          "type": "formula",
          "as": "v",
          "expr": "datum._source.value"
        }
      ]
    },
    {
      "name": "ref_config",
      "url": {
        "index": "ia-reference",
        "body": {
          "size": 1,
          "query": {
            "term": {
              "doc_type": "config"
            }
          }
        }
      },
      "format": {
        "property": "hits.hits"
      }
    },
    {
      "name": "scope_spokes",
      "url": {
        "%context%": true,
        "%timefield%": "@timestamp",
        "index": "ia-workqueue-items",
        "body": {
          "size": 0,
          "aggs": {
            "m": {
              "filter": {
                "term": {
                  "mapped": true
                }
              },
              "aggs": {
                "s": {
                  "terms": {
                    "field": "spoke.name",
                    "size": 2
                  }
                }
              }
            }
          }
        }
      },
      "format": {
        "property": "aggregations.m.s.buckets"
      }
    },
    {
      "name": "act_raw",
      "url": {
        "%context%": true,
        "%timefield%": "@timestamp",
        "index": "ia-workqueue-items",
        "body": {
          "size": 0,
          "aggs": {
            "m": {
              "filter": {
                "bool": {
                  "filter": [
                    {
                      "term": {
                        "mapped": true
                      }
                    },
                    {
                      "exists": {
                        "field": "resource.name"
                      }
                    }
                  ]
                }
              },
              "aggs": {
                "r": {
                  "terms": {
                    "field": "resource.name",
                    "size": 500
                  },
                  "aggs": {
                    "w": {
                      "sum": {
                        "field": "worktime_sec"
                      }
                    },
                    "ec": {
                      "sum": {
                        "field": "cost.estate_gbp"
                      }
                    },
                    "np": {
                      "cardinality": {
                        "field": "process.name"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      },
      "format": {
        "property": "aggregations.m.r.buckets"
      }
    },
    {
      "name": "scope_all",
      "url": {
        "%context%": true,
        "%timefield%": "@timestamp",
        "index": "ia-workqueue-items",
        "body": {
          "size": 0,
          "aggs": {
            "m": {
              "filter": {
                "term": {
                  "mapped": true
                }
              },
              "aggs": {
                "s": {
                  "terms": {
                    "field": "spoke.name",
                    "size": 100
                  }
                }
              }
            }
          }
        }
      },
      "format": {
        "property": "aggregations.m.s.buckets"
      }
    },
    {
      "name": "avail_raw",
      "url": {
        "index": "ia-vdi-daily",
        "body": {
          "size": 0,
          "query": {
            "range": {
              "@timestamp": {
                "%timefilter%": true
              }
            }
          },
          "aggs": {
            "r": {
              "terms": {
                "field": "resource.name",
                "size": 500
              },
              "aggs": {
                "h": {
                  "sum": {
                    "field": "operating_hours"
                  }
                },
                "o": {
                  "terms": {
                    "field": "resource.owner_spoke",
                    "size": 1
                  }
                }
              }
            }
          }
        }
      },
      "format": {
        "property": "aggregations.r.buckets"
      }
    },
    {
      "name": "ref_spoke_count",
      "url": {
        "index": "ia-reference",
        "body": {
          "size": 0,
          "query": {
            "term": {
              "doc_type": "spoke"
            }
          }
        }
      },
      "format": {
        "property": "hits.total"
      }
    },
    {
      "name": "vdis",
      "source": "avail_raw",
      "transform": [
        {
          "type": "formula",
          "as": "name",
          "expr": "datum.key"
        },
        {
          "type": "formula",
          "as": "spoke",
          "expr": "datum.o.buckets[0].key"
        },
        {
          "type": "formula",
          "as": "availableHours",
          "expr": "datum.h.value"
        },
        {
          "type": "lookup",
          "from": "act_raw",
          "key": "key",
          "fields": [
            "key"
          ],
          "as": [
            "a"
          ]
        },
        {
          "type": "formula",
          "as": "cases",
          "expr": "datum.a ? datum.a.doc_count : 0"
        },
        {
          "type": "formula",
          "as": "activeHours",
          "expr": "datum.a ? datum.a.w.value / 3600 : 0"
        },
        {
          "type": "formula",
          "as": "cost",
          "expr": "datum.a ? datum.a.ec.value : 0"
        },
        {
          "type": "formula",
          "as": "processes",
          "expr": "datum.a ? datum.a.np.value : 0"
        },
        {
          "type": "formula",
          "as": "idleHours",
          "expr": "max(0, datum.availableHours - datum.activeHours)"
        },
        {
          "type": "formula",
          "as": "idlePct",
          "expr": "datum.availableHours ? datum.idleHours / datum.availableHours : 0"
        },
        {
          "type": "formula",
          "as": "utilPct",
          "expr": "datum.availableHours ? min(1, datum.activeHours / datum.availableHours) : 0"
        },
        {
          "type": "filter",
          "expr": "(datum.availableHours > 0 || datum.cases > 0) && (datum.cases > 0 || allSpokes || indexof(pluck(data('scope_all'), 'key'), datum.spoke) >= 0)"
        }
      ]
    },
    {
      "name": "vdi_tot",
      "source": "vdis",
      "transform": [
        {
          "type": "formula",
          "as": "on",
          "expr": "datum.cases > 0 ? 1 : 0"
        },
        {
          "type": "formula",
          "as": "av",
          "expr": "datum.cases > 0 ? datum.availableHours : 0"
        },
        {
          "type": "formula",
          "as": "ac",
          "expr": "datum.cases > 0 ? datum.activeHours : 0"
        },
        {
          "type": "formula",
          "as": "id",
          "expr": "datum.cases > 0 ? datum.idleHours : 0"
        },
        {
          "type": "aggregate",
          "ops": [
            "sum",
            "count",
            "sum",
            "sum",
            "sum",
            "sum"
          ],
          "fields": [
            "on",
            "name",
            "av",
            "ac",
            "id",
            "cost"
          ],
          "as": [
            "nActive",
            "nAll",
            "sumAvail",
            "sumActive",
            "sumIdle",
            "sumCost"
          ]
        }
      ]
    },
    {
      "name": "tiles",
      "values": [
        {
          "i": 0,
          "label": "Active digital workers",
          "accent": "#0F4D43"
        },
        {
          "i": 1,
          "label": "Average utilisation"
        },
        {
          "i": 2,
          "label": "Spare capacity",
          "accent": "#B9852C"
        },
        {
          "i": 3,
          "label": "Estate cost (period)",
          "accent": "#B6462F"
        }
      ],
      "transform": [
        {
          "type": "formula",
          "as": "accent",
          "expr": "datum.i === 1 ? (avgUtil >= tgt_utilMax ? '#B6462F' : avgUtil >= tgt_utilMin ? '#0B8A6B' : '#B9852C') : datum.accent"
        },
        {
          "type": "formula",
          "as": "value",
          "expr": "['' + nActive, (isValid((avgUtil)) && isFinite((avgUtil)) ? format((avgUtil) * 100, '.0f') + '%' : '–'), (isValid((sumIdle)) && isFinite((sumIdle)) ? (abs((sumIdle)) >= 1e6 ? format((sumIdle) / 1e6, abs((sumIdle)) >= 1e7 ? '.0f' : '.1f') + 'M' : abs((sumIdle)) >= 1e3 ? format((sumIdle) / 1e3, abs((sumIdle)) >= 1e4 ? '.0f' : '.1f') + 'k' : format((sumIdle), '.0f')) : '–'), (isValid((sumCost)) && isFinite((sumCost)) ? ((sumCost) < 0 ? '-' : '') + '£' + format(round(abs((sumCost))), ',') : '–')][datum.i]"
        },
        {
          "type": "formula",
          "as": "sub",
          "expr": "['of ' + nAll + ' in the estate', (isValid((sumActive)) && isFinite((sumActive)) ? (abs((sumActive)) >= 1e6 ? format((sumActive) / 1e6, abs((sumActive)) >= 1e7 ? '.0f' : '.1f') + 'M' : abs((sumActive)) >= 1e3 ? format((sumActive) / 1e3, abs((sumActive)) >= 1e4 ? '.0f' : '.1f') + 'k' : format((sumActive), '.0f')) : '–') + ' of ' + (isValid((sumAvail)) && isFinite((sumAvail)) ? (abs((sumAvail)) >= 1e6 ? format((sumAvail) / 1e6, abs((sumAvail)) >= 1e7 ? '.0f' : '.1f') + 'M' : abs((sumAvail)) >= 1e3 ? format((sumAvail) / 1e3, abs((sumAvail)) >= 1e4 ? '.0f' : '.1f') + 'k' : format((sumAvail), '.0f')) : '–') + ' hrs', 'hours available for new automations', 'Teams + Machines, apportioned'][datum.i]"
        },
        {
          "type": "formula",
          "as": "delta",
          "expr": "null"
        },
        {
          "type": "formula",
          "as": "target",
          "expr": "datum.i === 1 ? (isValid((tgt_utilMin)) && isFinite((tgt_utilMin)) ? format((tgt_utilMin) * 100, '.0f') + '%' : '–') + '–' + (isValid((tgt_utilMax)) && isFinite((tgt_utilMax)) ? format((tgt_utilMax) * 100, '.0f') + '%' : '–') : ''"
        },
        {
          "type": "formula",
          "as": "met",
          "expr": "avgUtil >= tgt_utilMin && avgUtil <= tgt_utilMax"
        }
      ]
    }
  ],
  "marks": [
    {
      "type": "group",
      "name": "tile",
      "from": {
        "data": "tiles"
      },
      "encode": {
        "update": {
          "x": {
            "signal": "datum.i * ((width - 30) / 4 + 10)"
          },
          "y": {
            "value": 0
          },
          "width": {
            "signal": "(width - 30) / 4"
          },
          "height": {
            "signal": "height"
          },
          "fill": {
            "value": "#FFFFFF"
          },
          "stroke": {
            "value": "#D6D9D2"
          },
          "cornerRadius": {
            "value": 16
          }
        }
      },
      "marks": [
        {
          "type": "text",
          "encode": {
            "update": {
              "x": {
                "value": 16
              },
              "y": {
                "value": 16
              },
              "baseline": {
                "value": "top"
              },
              "font": {
                "value": "'JetBrains Mono', Consolas, 'Roboto Mono', monospace"
              },
              "fontSize": {
                "value": 10.5
              },
              "fontWeight": {
                "value": 600
              },
              "fill": {
                "value": "#5F6E69"
              },
              "text": {
                "signal": "upper(parent.label)"
              },
              "limit": {
                "signal": "item.mark.group.width - 28"
              }
            }
          }
        },
        {
          "type": "text",
          "encode": {
            "update": {
              "x": {
                "value": 16
              },
              "y": {
                "value": 32
              },
              "baseline": {
                "value": "top"
              },
              "font": {
                "value": "Fraunces, Cambria, Georgia, Gelasio, serif"
              },
              "fontSize": {
                "signal": "item.mark.group.width < 170 ? 24 : 28"
              },
              "fontWeight": {
                "value": 600
              },
              "fill": {
                "value": "#0F4D43"
              },
              "text": {
                "field": {
                  "parent": "value"
                }
              }
            }
          }
        },
        {
          "type": "rect",
          "encode": {
            "update": {
              "x": {
                "value": 16
              },
              "y": {
                "value": 72
              },
              "width": {
                "signal": "(length((isValid(parent.delta) ? (isValid((parent.delta)) && isFinite((parent.delta)) ? ((parent.delta) >= 0 ? '▲ ' : '▼ ') + format(abs((parent.delta)) * 100, '.1f') + '%' : '–') : '')) * 6.6 + 18)"
              },
              "height": {
                "value": 18
              },
              "cornerRadius": {
                "value": 9
              },
              "fill": {
                "signal": "(abs(parent.delta) < 0.001 ? 0 : (parent.deltaGood === 'down' ? parent.delta <= 0 : parent.delta >= 0) ? 1 : -1) > 0 ? '#DDF0E8' : (abs(parent.delta) < 0.001 ? 0 : (parent.deltaGood === 'down' ? parent.delta <= 0 : parent.delta >= 0) ? 1 : -1) < 0 ? '#F3E0DA' : '#F7F6F2'"
              },
              "opacity": {
                "signal": "(isValid(parent.delta) ? (isValid((parent.delta)) && isFinite((parent.delta)) ? ((parent.delta) >= 0 ? '▲ ' : '▼ ') + format(abs((parent.delta)) * 100, '.1f') + '%' : '–') : '') ? 1 : 0"
              }
            }
          }
        },
        {
          "type": "text",
          "encode": {
            "update": {
              "x": {
                "value": 25
              },
              "y": {
                "value": 81
              },
              "baseline": {
                "value": "middle"
              },
              "font": {
                "value": "'JetBrains Mono', Consolas, 'Roboto Mono', monospace"
              },
              "fontSize": {
                "value": 10
              },
              "fontWeight": {
                "value": 600
              },
              "fill": {
                "signal": "(abs(parent.delta) < 0.001 ? 0 : (parent.deltaGood === 'down' ? parent.delta <= 0 : parent.delta >= 0) ? 1 : -1) > 0 ? '#0B8A6B' : (abs(parent.delta) < 0.001 ? 0 : (parent.deltaGood === 'down' ? parent.delta <= 0 : parent.delta >= 0) ? 1 : -1) < 0 ? '#B6462F' : '#5F6E69'"
              },
              "text": {
                "signal": "(isValid(parent.delta) ? (isValid((parent.delta)) && isFinite((parent.delta)) ? ((parent.delta) >= 0 ? '▲ ' : '▼ ') + format(abs((parent.delta)) * 100, '.1f') + '%' : '–') : '')"
              }
            }
          }
        },
        {
          "type": "rect",
          "encode": {
            "update": {
              "x": {
                "signal": "(isValid(parent.delta) ? (isValid((parent.delta)) && isFinite((parent.delta)) ? ((parent.delta) >= 0 ? '▲ ' : '▼ ') + format(abs((parent.delta)) * 100, '.1f') + '%' : '–') : '') ? 16 + (length((isValid(parent.delta) ? (isValid((parent.delta)) && isFinite((parent.delta)) ? ((parent.delta) >= 0 ? '▲ ' : '▼ ') + format(abs((parent.delta)) * 100, '.1f') + '%' : '–') : '')) * 6.6 + 18) + 6 : 16"
              },
              "y": {
                "value": 72
              },
              "width": {
                "signal": "(length((isValid(parent.target) && parent.target !== '' ? (parent.met ? 'ON ' : 'OFF ') + parent.target : '')) * 6.6 + 18) + 8"
              },
              "height": {
                "value": 18
              },
              "cornerRadius": {
                "value": 9
              },
              "fill": {
                "signal": "parent.met ? '#DDF0E8' : '#F3E0DA'"
              },
              "opacity": {
                "signal": "(isValid(parent.target) && parent.target !== '' ? (parent.met ? 'ON ' : 'OFF ') + parent.target : '') ? 1 : 0"
              }
            }
          }
        },
        {
          "type": "symbol",
          "encode": {
            "update": {
              "x": {
                "signal": "((isValid(parent.delta) ? (isValid((parent.delta)) && isFinite((parent.delta)) ? ((parent.delta) >= 0 ? '▲ ' : '▼ ') + format(abs((parent.delta)) * 100, '.1f') + '%' : '–') : '') ? 16 + (length((isValid(parent.delta) ? (isValid((parent.delta)) && isFinite((parent.delta)) ? ((parent.delta) >= 0 ? '▲ ' : '▼ ') + format(abs((parent.delta)) * 100, '.1f') + '%' : '–') : '')) * 6.6 + 18) + 6 : 16) + 10"
              },
              "y": {
                "value": 81
              },
              "size": {
                "value": 20
              },
