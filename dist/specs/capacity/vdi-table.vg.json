{
  "$schema": "https://vega.github.io/schema/vega/v5.json",
  "description": "IA · VDI & Capacity · VDI capacity table. Generated by vega/build.mjs from vega/panels/capacity.mjs, do not edit by hand.",
  "autosize": {
    "type": "fit",
    "contains": "padding"
  },
  "padding": 0,
  "config": {
    "background": "#FAF7F2",
    "padding": 0,
    "font": "Calibri, Carlito, 'Segoe UI', Inter, Arial, sans-serif",
    "text": {
      "font": "Calibri, Carlito, 'Segoe UI', Inter, Arial, sans-serif",
      "fill": "#0B3239",
      "fontSize": 12
    },
    "axis": {
      "labelFont": "'JetBrains Mono', 'Roboto Mono', Consolas, 'Courier New', monospace",
      "labelFontSize": 10,
      "labelColor": "#5A7378",
      "titleFont": "'JetBrains Mono', 'Roboto Mono', Consolas, 'Courier New', monospace",
      "titleColor": "#5A7378",
      "titleFontSize": 10,
      "titleFontWeight": 400,
      "domain": false,
      "ticks": false,
      "gridColor": "#DCDCD7",
      "gridWidth": 1,
      "labelPadding": 6
    },
    "style": {
      "guide-label": {
        "font": "'JetBrains Mono', 'Roboto Mono', Consolas, 'Courier New', monospace"
      }
    },
    "view": {
      "stroke": null
    },
    "kibana": {
      "renderer": "svg",
      "hideWarnings": true
    }
  },
  "signals": [
    {
      "name": "oneSpoke",
      "update": "length(data('scope_spokes')) === 1 ? data('scope_spokes')[0].key : ''"
    },
    {
      "name": "tgt_completionPct",
      "update": "oneSpoke && indexof(pluck(data('tg'), 'k'), 'spoke|' + oneSpoke + '|completionPct') >= 0 ? data('tg')[indexof(pluck(data('tg'), 'k'), 'spoke|' + oneSpoke + '|completionPct')].v : (indexof(pluck(data('tg'), 'k'), 'global|completionPct') >= 0 ? data('tg')[indexof(pluck(data('tg'), 'k'), 'global|completionPct')].v : 0.95)"
    },
    {
      "name": "tgt_exceptionRate",
      "update": "oneSpoke && indexof(pluck(data('tg'), 'k'), 'spoke|' + oneSpoke + '|exceptionRate') >= 0 ? data('tg')[indexof(pluck(data('tg'), 'k'), 'spoke|' + oneSpoke + '|exceptionRate')].v : (indexof(pluck(data('tg'), 'k'), 'global|exceptionRate') >= 0 ? data('tg')[indexof(pluck(data('tg'), 'k'), 'global|exceptionRate')].v : 0.06)"
    },
    {
      "name": "tgt_systemRate",
      "update": "oneSpoke && indexof(pluck(data('tg'), 'k'), 'spoke|' + oneSpoke + '|systemRate') >= 0 ? data('tg')[indexof(pluck(data('tg'), 'k'), 'spoke|' + oneSpoke + '|systemRate')].v : (indexof(pluck(data('tg'), 'k'), 'global|systemRate') >= 0 ? data('tg')[indexof(pluck(data('tg'), 'k'), 'global|systemRate')].v : 0.03)"
    },
    {
      "name": "tgt_costPerCase",
      "update": "oneSpoke && indexof(pluck(data('tg'), 'k'), 'spoke|' + oneSpoke + '|costPerCase') >= 0 ? data('tg')[indexof(pluck(data('tg'), 'k'), 'spoke|' + oneSpoke + '|costPerCase')].v : (indexof(pluck(data('tg'), 'k'), 'global|costPerCase') >= 0 ? data('tg')[indexof(pluck(data('tg'), 'k'), 'global|costPerCase')].v : 9)"
    },
    {
      "name": "tgt_utilMin",
      "update": "oneSpoke && indexof(pluck(data('tg'), 'k'), 'spoke|' + oneSpoke + '|utilMin') >= 0 ? data('tg')[indexof(pluck(data('tg'), 'k'), 'spoke|' + oneSpoke + '|utilMin')].v : (indexof(pluck(data('tg'), 'k'), 'global|utilMin') >= 0 ? data('tg')[indexof(pluck(data('tg'), 'k'), 'global|utilMin')].v : 0.15)"
    },
    {
      "name": "tgt_utilMax",
      "update": "oneSpoke && indexof(pluck(data('tg'), 'k'), 'spoke|' + oneSpoke + '|utilMax') >= 0 ? data('tg')[indexof(pluck(data('tg'), 'k'), 'spoke|' + oneSpoke + '|utilMax')].v : (indexof(pluck(data('tg'), 'k'), 'global|utilMax') >= 0 ? data('tg')[indexof(pluck(data('tg'), 'k'), 'global|utilMax')].v : 0.6)"
    },
    {
      "name": "tgt_vdiStaleDays",
      "update": "oneSpoke && indexof(pluck(data('tg'), 'k'), 'spoke|' + oneSpoke + '|vdiStaleDays') >= 0 ? data('tg')[indexof(pluck(data('tg'), 'k'), 'spoke|' + oneSpoke + '|vdiStaleDays')].v : (indexof(pluck(data('tg'), 'k'), 'global|vdiStaleDays') >= 0 ? data('tg')[indexof(pluck(data('tg'), 'k'), 'global|vdiStaleDays')].v : 14)"
    },
    {
      "name": "cfg_fyStart",
      "update": "length(data('ref_config')) ? data('ref_config')[0]._source.fiscal_year_start_month : 4"
    },
    {
      "name": "cfg_warn",
      "update": "length(data('ref_config')) ? data('ref_config')[0]._source.warn_margin : 0.1"
    },
    {
      "name": "allSpokes",
      "update": "length(data('scope_all')) >= (length(data('ref_spoke_count')) ? data('ref_spoke_count')[0].value : 99)"
    },
    {
      "name": "nActive",
      "update": "length(data('vdi_tot')) ? data('vdi_tot')[0].nActive : 0"
    },
    {
      "name": "nAll",
      "update": "length(data('vdi_tot')) ? data('vdi_tot')[0].nAll : 0"
    },
    {
      "name": "sumAvail",
      "update": "length(data('vdi_tot')) ? data('vdi_tot')[0].sumAvail : 0"
    },
    {
      "name": "sumActive",
      "update": "length(data('vdi_tot')) ? data('vdi_tot')[0].sumActive : 0"
    },
    {
      "name": "sumIdle",
      "update": "length(data('vdi_tot')) ? data('vdi_tot')[0].sumIdle : 0"
    },
    {
      "name": "sumCost",
      "update": "length(data('vdi_tot')) ? data('vdi_tot')[0].sumCost : 0"
    },
    {
      "name": "avgUtil",
      "update": "sumAvail ? sumActive / sumAvail : 0"
    },
    {
      "name": "top",
      "value": 56
    },
    {
      "name": "cw",
      "update": "width - 32"
    },
    {
      "name": "ch",
      "update": "height - top - 16"
    },
    {
      "name": "tb_fit",
      "update": "max(0, floor((ch - 30 - 0 - 14) / 27))"
    },
    {
      "name": "tb_sortKey",
      "value": "utilPct",
      "on": [
        {
          "events": {
            "signal": "tb_sortClick"
          },
          "update": "tb_sortClick"
        }
      ]
    },
    {
      "name": "tb_sortDir",
      "value": "descending",
      "on": [
        {
          "events": {
            "signal": "tb_sortClick"
          },
          "update": "tb_sortClick === tb_sortKey ? (tb_sortDir === 'descending' ? 'ascending' : 'descending') : 'descending'"
        }
      ]
    },
    {
      "name": "tb_sortClick",
      "on": [
        {
          "events": "@tb_head0:click, @tb_head1:click, @tb_head2:click, @tb_head3:click, @tb_head4:click, @tb_head5:click, @tb_head6:click, @tb_head7:click",
          "update": "datum.sortKey"
        }
      ]
    }
  ],
  "data": [
    {
      "name": "ref_targets",
      "url": {
        "index": "ia-reference",
        "body": {
          "size": 200,
          "query": {
            "term": {
              "doc_type": "target"
            }
          }
        }
      },
      "format": {
        "property": "hits.hits"
      }
    },
    {
      "name": "tg",
      "source": "ref_targets",
      "transform": [
        {
          "type": "formula",
          "as": "k",
          "expr": "datum._source.scope === 'global' ? 'global|' + datum._source.metric : datum._source.scope + '|' + datum._source.scope_id + '|' + datum._source.metric"
        },
        {
          "type": "formula",
          "as": "v",
          "expr": "datum._source.value"
        }
      ]
    },
    {
      "name": "ref_config",
      "url": {
        "index": "ia-reference",
        "body": {
          "size": 1,
          "query": {
            "term": {
              "doc_type": "config"
            }
          }
        }
      },
      "format": {
        "property": "hits.hits"
      }
    },
    {
      "name": "scope_spokes",
      "url": {
        "%context%": true,
        "%timefield%": "@timestamp",
        "index": "ia-workqueue-items",
        "body": {
          "size": 0,
          "aggs": {
            "m": {
              "filter": {
                "term": {
                  "mapped": true
                }
              },
              "aggs": {
                "s": {
                  "terms": {
                    "field": "spoke.name",
                    "size": 2
                  }
                }
              }
            }
          }
        }
      },
      "format": {
        "property": "aggregations.m.s.buckets"
      }
    },
    {
      "name": "act_raw",
      "url": {
        "%context%": true,
        "%timefield%": "@timestamp",
        "index": "ia-workqueue-items",
        "body": {
          "size": 0,
          "aggs": {
            "m": {
              "filter": {
                "bool": {
                  "filter": [
                    {
                      "term": {
                        "mapped": true
                      }
                    },
                    {
                      "exists": {
                        "field": "resource.name"
                      }
                    }
                  ]
                }
              },
              "aggs": {
                "r": {
                  "terms": {
                    "field": "resource.name",
                    "size": 500
                  },
                  "aggs": {
                    "w": {
                      "sum": {
                        "field": "worktime_sec"
                      }
                    },
                    "ec": {
                      "sum": {
                        "field": "cost.estate_gbp"
                      }
                    },
                    "np": {
                      "cardinality": {
                        "field": "process.name"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      },
      "format": {
        "property": "aggregations.m.r.buckets"
      }
    },
    {
      "name": "scope_all",
      "url": {
        "%context%": true,
        "%timefield%": "@timestamp",
        "index": "ia-workqueue-items",
        "body": {
          "size": 0,
          "aggs": {
            "m": {
              "filter": {
                "term": {
                  "mapped": true
                }
              },
              "aggs": {
                "s": {
                  "terms": {
                    "field": "spoke.name",
                    "size": 100
                  }
                }
              }
            }
          }
        }
      },
      "format": {
        "property": "aggregations.m.s.buckets"
      }
    },
    {
      "name": "avail_raw",
      "url": {
        "index": "ia-vdi-daily",
        "body": {
          "size": 0,
          "query": {
            "range": {
              "@timestamp": {
                "%timefilter%": true
              }
            }
          },
          "aggs": {
            "r": {
              "terms": {
                "field": "resource.name",
                "size": 500
              },
              "aggs": {
                "h": {
                  "sum": {
                    "field": "operating_hours"
                  }
                },
                "o": {
                  "terms": {
                    "field": "resource.owner_spoke",
                    "size": 1
                  }
                }
              }
            }
          }
        }
      },
      "format": {
        "property": "aggregations.r.buckets"
      }
    },
    {
      "name": "ref_spoke_count",
      "url": {
        "index": "ia-reference",
        "body": {
          "size": 0,
          "query": {
            "term": {
              "doc_type": "spoke"
            }
          }
        }
      },
      "format": {
        "property": "hits.total"
      }
    },
    {
      "name": "vdis",
      "source": "avail_raw",
      "transform": [
        {
          "type": "formula",
          "as": "name",
          "expr": "datum.key"
        },
        {
          "type": "formula",
          "as": "spoke",
          "expr": "datum.o.buckets[0].key"
        },
        {
          "type": "formula",
          "as": "availableHours",
          "expr": "datum.h.value"
        },
        {
          "type": "lookup",
          "from": "act_raw",
          "key": "key",
          "fields": [
            "key"
          ],
          "as": [
            "a"
          ]
        },
        {
          "type": "formula",
          "as": "cases",
          "expr": "datum.a ? datum.a.doc_count : 0"
        },
        {
          "type": "formula",
          "as": "activeHours",
          "expr": "datum.a ? datum.a.w.value / 3600 : 0"
        },
        {
          "type": "formula",
          "as": "cost",
          "expr": "datum.a ? datum.a.ec.value : 0"
        },
        {
          "type": "formula",
          "as": "processes",
          "expr": "datum.a ? datum.a.np.value : 0"
        },
        {
          "type": "formula",
          "as": "idleHours",
          "expr": "max(0, datum.availableHours - datum.activeHours)"
        },
        {
          "type": "formula",
          "as": "idlePct",
          "expr": "datum.availableHours ? datum.idleHours / datum.availableHours : 0"
        },
        {
          "type": "formula",
          "as": "utilPct",
          "expr": "datum.availableHours ? min(1, datum.activeHours / datum.availableHours) : 0"
        },
        {
          "type": "filter",
          "expr": "(datum.availableHours > 0 || datum.cases > 0) && (datum.cases > 0 || allSpokes || indexof(pluck(data('scope_all'), 'key'), datum.spoke) >= 0)"
        }
      ]
    },
    {
      "name": "vdi_tot",
      "source": "vdis",
      "transform": [
        {
          "type": "formula",
          "as": "on",
          "expr": "datum.cases > 0 ? 1 : 0"
        },
        {
          "type": "formula",
          "as": "av",
          "expr": "datum.cases > 0 ? datum.availableHours : 0"
        },
        {
          "type": "formula",
          "as": "ac",
          "expr": "datum.cases > 0 ? datum.activeHours : 0"
        },
        {
          "type": "formula",
          "as": "id",
          "expr": "datum.cases > 0 ? datum.idleHours : 0"
        },
        {
          "type": "aggregate",
          "ops": [
            "sum",
            "count",
            "sum",
            "sum",
            "sum",
            "sum"
          ],
          "fields": [
            "on",
            "name",
            "av",
            "ac",
            "id",
            "cost"
          ],
          "as": [
            "nActive",
            "nAll",
            "sumAvail",
            "sumActive",
            "sumIdle",
            "sumCost"
          ]
        }
      ]
    },
    {
      "name": "tb_hd0",
      "values": [
        {
          "sortKey": "name"
        }
      ]
    },
    {
      "name": "tb_hd1",
      "values": [
        {
          "sortKey": "spoke"
        }
      ]
    },
    {
      "name": "tb_hd2",
      "values": [
        {
          "sortKey": "processes"
        }
      ]
    },
    {
      "name": "tb_hd3",
      "values": [
        {
          "sortKey": "cases"
        }
      ]
    },
    {
      "name": "tb_hd4",
      "values": [
        {
          "sortKey": "activeHours"
        }
      ]
    },
    {
      "name": "tb_hd5",
      "values": [
        {
          "sortKey": "idlePct"
        }
      ]
    },
    {
      "name": "tb_hd6",
      "values": [
        {
          "sortKey": "utilPct"
        }
      ]
    },
    {
      "name": "tb_hd7",
      "values": [
        {
          "sortKey": "cost"
        }
      ]
    },
    {
      "name": "tb_rows",
      "source": "vdis",
      "transform": [
        {
          "type": "collect",
          "sort": {
            "field": {
              "signal": "tb_sortKey"
            },
            "order": {
              "signal": "tb_sortDir"
            }
          }
        },
        {
          "type": "window",
          "ops": [
            "row_number"
          ],
          "as": [
            "rank"
          ]
        },
        {
          "type": "filter",
          "expr": "datum.rank <= tb_fit"
        }
      ]
    }
  ],
  "marks": [
    {
      "type": "text",
      "name": "frame_title",
      "encode": {
        "update": {
          "x": {
            "value": 16
          },
          "y": {
            "value": 16
          },
          "baseline": {
            "value": "top"
          },
          "font": {
            "value": "Georgia, Gelasio, 'Times New Roman', serif"
          },
          "fontSize": {
            "value": 16
          },
          "fontWeight": {
            "value": "bold"
          },
          "fill": {
            "value": "#0B3239"
          },
          "text": {
            "value": "VDI capacity table"
          },
          "limit": {
            "signal": "width - 32"
          }
        }
      }
    },
    {
      "type": "text",
      "encode": {
        "update": {
          "x": {
            "value": 16
          },
          "y": {
            "value": 38
          },
          "baseline": {
            "value": "top"
          },
          "font": {
            "value": "Calibri, Carlito, 'Segoe UI', Inter, Arial, sans-serif"
          },
          "fontSize": {
            "value": 12
          },
          "fill": {
            "value": "#5A7378"
          },
          "text": {
            "value": "Click a column to sort; default by utilisation"
          },
          "limit": {
            "signal": "width - 32"
          }
        }
      }
    },
    {
      "type": "group",
      "encode": {
        "update": {
          "x": {
            "value": 16
          },
          "y": {
            "signal": "top"
          },
          "width": {
            "signal": "cw"
          },
          "height": {
            "value": 30
          }
        }
      },
      "marks": [
        {
          "type": "rule",
          "encode": {
            "update": {
              "x": {
                "value": 0
              },
              "x2": {
                "signal": "cw"
              },
              "y": {
                "value": 29.5
              },
              "stroke": {
                "value": "#DCDCD7"
              }
            }
          }
        },
        {
          "type": "text",
          "name": "tb_head0",
          "from": {
            "data": "tb_hd0"
          },
          "encode": {
            "update": {
              "x": {
                "signal": "0 + 10"
              },
              "y": {
                "value": 15
              },
              "align": {
                "value": "left"
              },
              "baseline": {
                "value": "middle"
              },
              "font": {
                "value": "'JetBrains Mono', 'Roboto Mono', Consolas, 'Courier New', monospace"
              },
              "fontSize": {
                "value": 10
              },
              "fontWeight": {
                "value": "bold"
              },
              "fill": {
                "signal": "tb_sortKey === 'name' ? '#0B3239' : '#5A7378'"
              },
              "text": {
                "signal": "'DIGITAL WORKER' + (tb_sortKey === 'name' ? (tb_sortDir === 'descending' ? ' ▾' : ' ▴') : '')"
              },
              "cursor": {
                "value": "pointer"
              },
              "limit": {
                "signal": "((cw - 644) / 1) - 12"
              }
            }
          }
        },
        {
          "type": "text",
          "name": "tb_head1",
          "from": {
            "data": "tb_hd1"
          },
          "encode": {
            "update": {
              "x": {
                "signal": "0 + ((cw - 644) / 1) + 10"
              },
              "y": {
                "value": 15
              },
              "align": {
                "value": "left"
              },
              "baseline": {
                "value": "middle"
              },
              "font": {
                "value": "'JetBrains Mono', 'Roboto Mono', Consolas, 'Courier New', monospace"
              },
              "fontSize": {
                "value": 10
              },
              "fontWeight": {
                "value": "bold"
              },
              "fill": {
                "signal": "tb_sortKey === 'spoke' ? '#0B3239' : '#5A7378'"
              },
              "text": {
                "signal": "'OWNER' + (tb_sortKey === 'spoke' ? (tb_sortDir === 'descending' ? ' ▾' : ' ▴') : '')"
              },
              "cursor": {
                "value": "pointer"
              },
              "limit": {
                "signal": "120 - 12"
              }
            }
          }
        },
        {
          "type": "text",
          "name": "tb_head2",
          "from": {
            "data": "tb_hd2"
          },
          "encode": {
            "update": {
              "x": {
                "signal": "0 + ((cw - 644) / 1) + 120 + 80 - 10"
              },
              "y": {
                "value": 15
              },
              "align": {
                "value": "right"
              },
              "baseline": {
                "value": "middle"
              },
              "font": {
                "value": "'JetBrains Mono', 'Roboto Mono', Consolas, 'Courier New', monospace"
              },
              "fontSize": {
                "value": 10
              },
              "fontWeight": {
                "value": "bold"
              },
              "fill": {
                "signal": "tb_sortKey === 'processes' ? '#0B3239' : '#5A7378'"
              },
              "text": {
                "signal": "'PROCESSES' + (tb_sortKey === 'processes' ? (tb_sortDir === 'descending' ? ' ▾' : ' ▴') : '')"
              },
              "cursor": {
                "value": "pointer"
              },
              "limit": {
                "signal": "80 - 12"
              }
            }
          }
        },
        {
          "type": "text",
          "name": "tb_head3",
          "from": {
            "data": "tb_hd3"
          },
          "encode": {
            "update": {
              "x": {
                "signal": "0 + ((cw - 644) / 1) + 120 + 80 + 70 - 10"
              },
              "y": {
                "value": 15
              },
              "align": {
                "value": "right"
              },
              "baseline": {
                "value": "middle"
              },
              "font": {
                "value": "'JetBrains Mono', 'Roboto Mono', Consolas, 'Courier New', monospace"
              },
              "fontSize": {
                "value": 10
              },
              "fontWeight": {
                "value": "bold"
              },
              "fill": {
                "signal": "tb_sortKey === 'cases' ? '#0B3239' : '#5A7378'"
              },
              "text": {
                "signal": "'ITEMS' + (tb_sortKey === 'cases' ? (tb_sortDir === 'descending' ? ' ▾' : ' ▴') : '')"
