{
  "$schema": "https://vega.github.io/schema/vega/v5.json",
  "description": "IA · Input & Outcome · Outcome split over time. Generated by vega/build.mjs from vega/panels/input-outcome.mjs, do not edit by hand.",
  "autosize": {
    "type": "fit",
    "contains": "padding"
  },
  "padding": 0,
  "config": {
    "background": "#FAF7F2",
    "padding": 0,
    "font": "Calibri, Carlito, 'Segoe UI', Inter, Arial, sans-serif",
    "text": {
      "font": "Calibri, Carlito, 'Segoe UI', Inter, Arial, sans-serif",
      "fill": "#0B3239",
      "fontSize": 12
    },
    "axis": {
      "labelFont": "'JetBrains Mono', 'Roboto Mono', Consolas, 'Courier New', monospace",
      "labelFontSize": 10,
      "labelColor": "#5A7378",
      "titleFont": "'JetBrains Mono', 'Roboto Mono', Consolas, 'Courier New', monospace",
      "titleColor": "#5A7378",
      "titleFontSize": 10,
      "titleFontWeight": 400,
      "domain": false,
      "ticks": false,
      "gridColor": "#DCDCD7",
      "gridWidth": 1,
      "labelPadding": 6
    },
    "style": {
      "guide-label": {
        "font": "'JetBrains Mono', 'Roboto Mono', Consolas, 'Courier New', monospace"
      }
    },
    "view": {
      "stroke": null
    },
    "kibana": {
      "renderer": "svg",
      "hideWarnings": true
    }
  },
  "signals": [
    {
      "name": "ndays",
      "update": "length(data('win'))"
    },
    {
      "name": "lo",
      "update": "ndays ? data('win')[0].key : 0"
    },
    {
      "name": "hi",
      "update": "ndays ? data('win')[ndays - 1].key : 0"
    },
    {
      "name": "plo",
      "update": "lo - ndays * 86400000"
    },
    {
      "name": "phi",
      "update": "lo - 86400000"
    },
    {
      "name": "oneSpoke",
      "update": "length(data('scope_spokes')) === 1 ? data('scope_spokes')[0].key : ''"
    },
    {
      "name": "tgt_completionPct",
      "update": "oneSpoke && indexof(pluck(data('tg'), 'k'), 'spoke|' + oneSpoke + '|completionPct') >= 0 ? data('tg')[indexof(pluck(data('tg'), 'k'), 'spoke|' + oneSpoke + '|completionPct')].v : (indexof(pluck(data('tg'), 'k'), 'global|completionPct') >= 0 ? data('tg')[indexof(pluck(data('tg'), 'k'), 'global|completionPct')].v : 0.95)"
    },
    {
      "name": "tgt_exceptionRate",
      "update": "oneSpoke && indexof(pluck(data('tg'), 'k'), 'spoke|' + oneSpoke + '|exceptionRate') >= 0 ? data('tg')[indexof(pluck(data('tg'), 'k'), 'spoke|' + oneSpoke + '|exceptionRate')].v : (indexof(pluck(data('tg'), 'k'), 'global|exceptionRate') >= 0 ? data('tg')[indexof(pluck(data('tg'), 'k'), 'global|exceptionRate')].v : 0.06)"
    },
    {
      "name": "tgt_systemRate",
      "update": "oneSpoke && indexof(pluck(data('tg'), 'k'), 'spoke|' + oneSpoke + '|systemRate') >= 0 ? data('tg')[indexof(pluck(data('tg'), 'k'), 'spoke|' + oneSpoke + '|systemRate')].v : (indexof(pluck(data('tg'), 'k'), 'global|systemRate') >= 0 ? data('tg')[indexof(pluck(data('tg'), 'k'), 'global|systemRate')].v : 0.03)"
    },
    {
      "name": "tgt_costPerCase",
      "update": "oneSpoke && indexof(pluck(data('tg'), 'k'), 'spoke|' + oneSpoke + '|costPerCase') >= 0 ? data('tg')[indexof(pluck(data('tg'), 'k'), 'spoke|' + oneSpoke + '|costPerCase')].v : (indexof(pluck(data('tg'), 'k'), 'global|costPerCase') >= 0 ? data('tg')[indexof(pluck(data('tg'), 'k'), 'global|costPerCase')].v : 9)"
    },
    {
      "name": "tgt_utilMin",
      "update": "oneSpoke && indexof(pluck(data('tg'), 'k'), 'spoke|' + oneSpoke + '|utilMin') >= 0 ? data('tg')[indexof(pluck(data('tg'), 'k'), 'spoke|' + oneSpoke + '|utilMin')].v : (indexof(pluck(data('tg'), 'k'), 'global|utilMin') >= 0 ? data('tg')[indexof(pluck(data('tg'), 'k'), 'global|utilMin')].v : 0.15)"
    },
    {
      "name": "tgt_utilMax",
      "update": "oneSpoke && indexof(pluck(data('tg'), 'k'), 'spoke|' + oneSpoke + '|utilMax') >= 0 ? data('tg')[indexof(pluck(data('tg'), 'k'), 'spoke|' + oneSpoke + '|utilMax')].v : (indexof(pluck(data('tg'), 'k'), 'global|utilMax') >= 0 ? data('tg')[indexof(pluck(data('tg'), 'k'), 'global|utilMax')].v : 0.6)"
    },
    {
      "name": "tgt_vdiStaleDays",
      "update": "oneSpoke && indexof(pluck(data('tg'), 'k'), 'spoke|' + oneSpoke + '|vdiStaleDays') >= 0 ? data('tg')[indexof(pluck(data('tg'), 'k'), 'spoke|' + oneSpoke + '|vdiStaleDays')].v : (indexof(pluck(data('tg'), 'k'), 'global|vdiStaleDays') >= 0 ? data('tg')[indexof(pluck(data('tg'), 'k'), 'global|vdiStaleDays')].v : 14)"
    },
    {
      "name": "cfg_fyStart",
      "update": "length(data('ref_config')) ? data('ref_config')[0]._source.fiscal_year_start_month : 4"
    },
    {
      "name": "cfg_warn",
      "update": "length(data('ref_config')) ? data('ref_config')[0]._source.warn_margin : 0.1"
    },
    {
      "name": "top",
      "value": 56
    },
    {
      "name": "cw",
      "update": "width - 32"
    },
    {
      "name": "ch",
      "update": "height - top - 16"
    },
    {
      "name": "grain",
      "value": "daily",
      "on": [
        {
          "events": "@seg_grain_0:click",
          "update": "'daily'"
        },
        {
          "events": "@seg_grain_1:click",
          "update": "'monthly'"
        }
      ]
    },
    {
      "name": "chart_ymax",
      "update": "max(extent(pluck(data('share'), 'cp'))[1] || 0, extent(pluck(data('share'), 'ep'))[1] || 0, tgt_completionPct * 100, tgt_exceptionRate * 100)"
    }
  ],
  "data": [
    {
      "name": "raw",
      "url": {
        "index": "ia-workqueue-items",
        "body": {
          "size": 0,
          "query": {
            "bool": {
              "must": [
                "%dashboard_context-must_clause%",
                {
                  "range": {
                    "@timestamp": {
                      "gte": {
                        "%timefilter%": "min",
                        "shift": -732,
                        "unit": "day"
                      },
                      "lte": {
                        "%timefilter%": "max"
                      },
                      "format": "epoch_millis"
                    }
                  }
                },
                {
                  "term": {
                    "mapped": true
                  }
                }
              ],
              "filter": [
                "%dashboard_context-filter_clause%"
              ],
              "must_not": [
                "%dashboard_context-must_not_clause%"
              ]
            }
          },
          "aggs": {
            "win": {
              "filter": {
                "range": {
                  "@timestamp": {
                    "%timefilter%": true
                  }
                }
              },
              "aggs": {
                "d": {
                  "date_histogram": {
                    "field": "@timestamp",
                    "fixed_interval": "1d",
                    "min_doc_count": 0,
                    "extended_bounds": {
                      "min": {
                        "%timefilter%": "min"
                      },
                      "max": {
                        "%timefilter%": "max"
                      }
                    }
                  }
                }
              }
            },
            "days": {
              "date_histogram": {
                "field": "@timestamp",
                "fixed_interval": "1d",
                "min_doc_count": 1
              },
              "aggs": {
                "c": {
                  "sum": {
                    "field": "n.completed"
                  }
                },
                "b": {
                  "sum": {
                    "field": "n.business"
                  }
                },
                "s": {
                  "sum": {
                    "field": "n.system"
                  }
                },
                "a": {
                  "sum": {
                    "field": "n.attempt"
                  }
                }
              }
            }
          }
        }
      },
      "format": {
        "property": "aggregations"
      }
    },
    {
      "name": "win",
      "source": "raw",
      "transform": [
        {
          "type": "flatten",
          "fields": [
            "win.d.buckets"
          ],
          "as": [
            "_bk"
          ]
        },
        {
          "type": "formula",
          "as": "key",
          "expr": "datum._bk.key"
        },
        {
          "type": "formula",
          "as": "n",
          "expr": "datum._bk.doc_count"
        },
        {
          "type": "project",
          "fields": [
            "key",
            "n"
          ]
        }
      ]
    },
    {
      "name": "days",
      "source": "raw",
      "transform": [
        {
          "type": "flatten",
          "fields": [
            "days.buckets"
          ],
          "as": [
            "_bk"
          ]
        },
        {
          "type": "formula",
          "as": "key",
          "expr": "datum._bk.key"
        },
        {
          "type": "formula",
          "as": "n",
          "expr": "datum._bk.doc_count"
        },
        {
          "type": "formula",
          "as": "c",
          "expr": "datum._bk[\"c\"] ? (datum._bk[\"c\"].value || 0) : 0"
        },
        {
          "type": "formula",
          "as": "b",
          "expr": "datum._bk[\"b\"] ? (datum._bk[\"b\"].value || 0) : 0"
        },
        {
          "type": "formula",
          "as": "s",
          "expr": "datum._bk[\"s\"] ? (datum._bk[\"s\"].value || 0) : 0"
        },
        {
          "type": "formula",
          "as": "a",
          "expr": "datum._bk[\"a\"] ? (datum._bk[\"a\"].value || 0) : 0"
        },
        {
          "type": "project",
          "fields": [
            "key",
            "n",
            "c",
            "b",
            "s",
            "a"
          ]
        }
      ]
    },
    {
      "name": "series",
      "source": "win",
      "transform": [
        {
          "type": "lookup",
          "from": "days",
          "key": "key",
          "fields": [
            "key"
          ],
          "as": [
            "d"
          ]
        },
        {
          "type": "formula",
          "as": "t",
          "expr": "datum.key"
        },
        {
          "type": "formula",
          "as": "c",
          "expr": "datum.d ? datum.d.c : 0"
        },
        {
          "type": "formula",
          "as": "b",
          "expr": "datum.d ? datum.d.b : 0"
        },
        {
          "type": "formula",
          "as": "s",
          "expr": "datum.d ? datum.d.s : 0"
        },
        {
          "type": "formula",
          "as": "a",
          "expr": "datum.d ? datum.d.a : 0"
        }
      ]
    },
    {
      "name": "tot",
      "source": "days",
      "transform": [
        {
          "type": "formula",
          "as": "cur_c",
          "expr": "datum.key >= lo && datum.key <= hi ? datum.c : 0"
        },
        {
          "type": "formula",
          "as": "prev_c",
          "expr": "datum.key >= plo && datum.key <= phi ? datum.c : 0"
        },
        {
          "type": "formula",
          "as": "cur_b",
          "expr": "datum.key >= lo && datum.key <= hi ? datum.b : 0"
        },
        {
          "type": "formula",
          "as": "prev_b",
          "expr": "datum.key >= plo && datum.key <= phi ? datum.b : 0"
        },
        {
          "type": "formula",
          "as": "cur_s",
          "expr": "datum.key >= lo && datum.key <= hi ? datum.s : 0"
        },
        {
          "type": "formula",
          "as": "prev_s",
          "expr": "datum.key >= plo && datum.key <= phi ? datum.s : 0"
        },
        {
          "type": "formula",
          "as": "cur_a",
          "expr": "datum.key >= lo && datum.key <= hi ? datum.a : 0"
        },
        {
          "type": "formula",
          "as": "prev_a",
          "expr": "datum.key >= plo && datum.key <= phi ? datum.a : 0"
        },
        {
          "type": "aggregate",
          "ops": [
            "sum",
            "sum",
            "sum",
            "sum",
            "sum",
            "sum",
            "sum",
            "sum"
          ],
          "fields": [
            "cur_c",
            "prev_c",
            "cur_b",
            "prev_b",
            "cur_s",
            "prev_s",
            "cur_a",
            "prev_a"
          ],
          "as": [
            "cur_c",
            "prev_c",
            "cur_b",
            "prev_b",
            "cur_s",
            "prev_s",
            "cur_a",
            "prev_a"
          ]
        }
      ]
    },
    {
      "name": "ref_targets",
      "url": {
        "index": "ia-reference",
        "body": {
          "size": 200,
          "query": {
            "term": {
              "doc_type": "target"
            }
          }
        }
      },
      "format": {
        "property": "hits.hits"
      }
    },
    {
      "name": "tg",
      "source": "ref_targets",
      "transform": [
        {
          "type": "formula",
          "as": "k",
          "expr": "datum._source.scope === 'global' ? 'global|' + datum._source.metric : datum._source.scope + '|' + datum._source.scope_id + '|' + datum._source.metric"
        },
        {
          "type": "formula",
          "as": "v",
          "expr": "datum._source.value"
        }
      ]
    },
    {
      "name": "ref_config",
      "url": {
        "index": "ia-reference",
        "body": {
          "size": 1,
          "query": {
            "term": {
              "doc_type": "config"
            }
          }
        }
      },
      "format": {
        "property": "hits.hits"
      }
    },
    {
      "name": "scope_spokes",
      "url": {
        "%context%": true,
        "%timefield%": "@timestamp",
        "index": "ia-workqueue-items",
        "body": {
          "size": 0,
          "aggs": {
            "m": {
              "filter": {
                "term": {
                  "mapped": true
                }
              },
              "aggs": {
                "s": {
                  "terms": {
                    "field": "spoke.name",
                    "size": 2
                  }
                }
              }
            }
          }
        }
      },
      "format": {
        "property": "aggregations.m.s.buckets"
      }
    },
    {
      "name": "flow",
      "source": "series",
      "transform": [
        {
          "type": "formula",
          "as": "g",
          "expr": "grain === 'monthly' ? utc(utcyear(datum.t), utcmonth(datum.t), 1) : datum.t"
        },
        {
          "type": "aggregate",
          "groupby": [
            "g"
          ],
          "ops": [
            "sum",
            "sum",
            "sum",
            "sum"
          ],
          "fields": [
            "c",
            "b",
            "s",
            "a"
          ],
          "as": [
            "c",
            "b",
            "s",
            "a"
          ]
        },
        {
          "type": "formula",
          "as": "t",
          "expr": "datum.g"
        },
        {
          "type": "collect",
          "sort": {
            "field": "t"
          }
        }
      ]
    },
    {
      "name": "share",
      "source": "flow",
      "transform": [
        {
          "type": "formula",
          "as": "cp",
          "expr": "datum.a ? datum.c / datum.a * 100 : null"
        },
        {
          "type": "formula",
          "as": "ep",
          "expr": "datum.a ? (datum.b + datum.s) / datum.a * 100 : null"
        }
      ]
    }
  ],
  "scales": [
    {
      "name": "chart_x",
      "type": "utc",
      "domain": {
        "data": "share",
        "field": "t"
      },
      "range": [
        0,
        {
          "signal": "cw - 44"
        }
      ]
    },
    {
      "name": "chart_y",
      "type": "linear",
      "domain": [
        0,
        100
      ],
      "range": [
        {
          "signal": "ch - 22"
        },
        0
      ],
      "nice": true,
      "zero": true
    }
  ],
  "marks": [
    {
      "type": "text",
      "name": "frame_title",
      "encode": {
        "update": {
          "x": {
            "value": 16
          },
          "y": {
            "value": 16
          },
          "baseline": {
            "value": "top"
          },
          "font": {
            "value": "Georgia, Gelasio, 'Times New Roman', serif"
          },
          "fontSize": {
            "value": 16
          },
          "fontWeight": {
            "value": "bold"
          },
          "fill": {
            "value": "#0B3239"
          },
          "text": {
            "value": "Outcome split over time"
          },
          "limit": {
            "signal": "width - 32"
          }
        }
      }
    },
    {
      "type": "text",
      "encode": {
        "update": {
          "x": {
            "value": 16
          },
          "y": {
            "value": 38
          },
          "baseline": {
            "value": "top"
          },
          "font": {
            "value": "Calibri, Carlito, 'Segoe UI', Inter, Arial, sans-serif"
          },
          "fontSize": {
            "value": 12
          },
          "fill": {
            "value": "#5A7378"
          },
          "text": {
            "signal": "(grain === 'monthly' ? 'Monthly' : 'Daily') + ' share of completed vs exceptions, against SLA targets'"
          },
          "limit": {
            "signal": "width - 32"
          }
        }
      }
    },
    {
      "type": "rect",
      "encode": {
        "update": {
          "x": {
            "signal": "width - 16 - 126"
          },
          "y": {
            "value": 14
          },
          "width": {
            "value": 126
          },
          "height": {
            "value": 30
          },
          "cornerRadius": {
            "value": 8
          },
          "fill": {
            "value": "#F1EEE8"
          },
          "stroke": {
            "value": "#DCDCD7"
          }
        }
      }
    },
    {
      "type": "rect",
      "name": "seg_grain_0",
      "encode": {
        "update": {
          "x": {
            "signal": "width - 16 - 126 + 3"
          },
          "y": {
            "value": 17
          },
          "width": {
            "value": 54
          },
          "height": {
            "value": 24
          },
          "cornerRadius": {
            "value": 6
          },
          "fill": {
            "signal": "grain === 'daily' ? '#FAF7F2' : 'transparent'"
          },
          "stroke": {
            "signal": "grain === 'daily' ? '#DCDCD7' : 'transparent'"
          },
          "cursor": {
            "value": "pointer"
          }
        }
      }
    },
    {
      "type": "text",
      "interactive": false,
      "encode": {
        "update": {
          "x": {
            "signal": "width - 16 - 126 + 3 + 27"
          },
          "y": {
            "value": 29
          },
          "align": {
            "value": "center"
          },
          "baseline": {
            "value": "middle"
          },
          "font": {
            "value": "Calibri, Carlito, 'Segoe UI', Inter, Arial, sans-serif"
          },
          "fontSize": {
            "value": 12
          },
          "fontWeight": {
            "signal": "grain === 'daily' ? 'bold' : 'normal'"
          },
          "fill": {
            "signal": "grain === 'daily' ? '#0B3239' : '#5A7378'"
          },
          "text": {
            "value": "Daily"
          }
        }
      }
    },
    {
      "type": "rect",
      "name": "seg_grain_1",
      "encode": {
        "update": {
          "x": {
            "signal": "width - 16 - 126 + 57"
          },
          "y": {
            "value": 17
          },
          "width": {
            "value": 66
          },
          "height": {
            "value": 24
          },
          "cornerRadius": {
            "value": 6
          },
          "fill": {
            "signal": "grain === 'monthly' ? '#FAF7F2' : 'transparent'"
          },
          "stroke": {
            "signal": "grain === 'monthly' ? '#DCDCD7' : 'transparent'"
          },
          "cursor": {
            "value": "pointer"
          }
        }
      }
    },
    {
      "type": "text",
      "interactive": false,
      "encode": {
        "update": {
          "x": {
            "signal": "width - 16 - 126 + 57 + 33"
          },
          "y": {
            "value": 29
          },
          "align": {
            "value": "center"
          },
          "baseline": {
            "value": "middle"
          },
          "font": {
            "value": "Calibri, Carlito, 'Segoe UI', Inter, Arial, sans-serif"
          },
          "fontSize": {
            "value": 12
          },
          "fontWeight": {
            "signal": "grain === 'monthly' ? 'bold' : 'normal'"
          },
          "fill": {
            "signal": "grain === 'monthly' ? '#0B3239' : '#5A7378'"
          },
          "text": {
            "value": "Monthly"
          }
        }
      }
    },
    {
      "type": "group",
      "name": "chart",
      "encode": {
        "update": {
          "x": {
            "value": 60
          },
          "y": {
            "signal": "top"
          },
          "width": {
            "signal": "cw - 44"
          },
          "height": {
            "signal": "ch - 22"
          }
        }
      },
      "axes": [
        {
          "scale": "chart_y",
          "orient": "left",
          "grid": true,
          "tickCount": 5,
          "labelPadding": 8,
          "encode": {
            "labels": {
              "update": {
                "text": {
                  "signal": "format(datum.value, '.0f') + '%'"
                }
              }
            }
          },
          "zindex": 0
        },
        {
          "scale": "chart_x",
          "orient": "bottom",
          "tickCount": {
            "signal": "min(10, max(2, floor((cw - 44) / 70)))"
          },
          "labelOverlap": true,
          "labelPadding": 6,
          "encode": {
            "labels": {
              "update": {
                "text": {
                  "signal": "grain === 'monthly' ? utcFormat((datum.value), '%b %y') : utcFormat((datum.value), '%d %b')"
                }
              }
            }
          }
        }
