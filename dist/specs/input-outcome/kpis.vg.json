{
  "$schema": "https://vega.github.io/schema/vega/v5.json",
  "description": "IA · Input & Outcome · Input & Outcome KPIs. Generated by vega/build.mjs from vega/panels/input-outcome.mjs, do not edit by hand.",
  "autosize": {
    "type": "fit",
    "contains": "padding"
  },
  "padding": 0,
  "config": {
    "background": "#FAF7F2",
    "padding": 0,
    "font": "Calibri, Carlito, 'Segoe UI', Inter, Arial, sans-serif",
    "text": {
      "font": "Calibri, Carlito, 'Segoe UI', Inter, Arial, sans-serif",
      "fill": "#0B3239",
      "fontSize": 12
    },
    "axis": {
      "labelFont": "'JetBrains Mono', 'Roboto Mono', Consolas, 'Courier New', monospace",
      "labelFontSize": 10,
      "labelColor": "#5A7378",
      "titleFont": "'JetBrains Mono', 'Roboto Mono', Consolas, 'Courier New', monospace",
      "titleColor": "#5A7378",
      "titleFontSize": 10,
      "titleFontWeight": 400,
      "domain": false,
      "ticks": false,
      "gridColor": "#DCDCD7",
      "gridWidth": 1,
      "labelPadding": 6
    },
    "style": {
      "guide-label": {
        "font": "'JetBrains Mono', 'Roboto Mono', Consolas, 'Courier New', monospace"
      }
    },
    "view": {
      "stroke": null
    },
    "kibana": {
      "renderer": "svg",
      "hideWarnings": true
    }
  },
  "signals": [
    {
      "name": "ndays",
      "update": "length(data('win'))"
    },
    {
      "name": "lo",
      "update": "ndays ? data('win')[0].key : 0"
    },
    {
      "name": "hi",
      "update": "ndays ? data('win')[ndays - 1].key : 0"
    },
    {
      "name": "plo",
      "update": "lo - ndays * 86400000"
    },
    {
      "name": "phi",
      "update": "lo - 86400000"
    }
  ],
  "data": [
    {
      "name": "raw",
      "url": {
        "index": "ia-workqueue-items",
        "body": {
          "size": 0,
          "query": {
            "bool": {
              "must": [
                "%dashboard_context-must_clause%",
                {
                  "range": {
                    "@timestamp": {
                      "gte": {
                        "%timefilter%": "min",
                        "shift": -732,
                        "unit": "day"
                      },
                      "lte": {
                        "%timefilter%": "max"
                      },
                      "format": "epoch_millis"
                    }
                  }
                },
                {
                  "term": {
                    "mapped": true
                  }
                }
              ],
              "filter": [
                "%dashboard_context-filter_clause%"
              ],
              "must_not": [
                "%dashboard_context-must_not_clause%"
              ]
            }
          },
          "aggs": {
            "win": {
              "filter": {
                "range": {
                  "@timestamp": {
                    "%timefilter%": true
                  }
                }
              },
              "aggs": {
                "d": {
                  "date_histogram": {
                    "field": "@timestamp",
                    "fixed_interval": "1d",
                    "min_doc_count": 0,
                    "extended_bounds": {
                      "min": {
                        "%timefilter%": "min"
                      },
                      "max": {
                        "%timefilter%": "max"
                      }
                    }
                  }
                }
              }
            },
            "days": {
              "date_histogram": {
                "field": "@timestamp",
                "fixed_interval": "1d",
                "min_doc_count": 1
              },
              "aggs": {
                "c": {
                  "sum": {
                    "field": "n.completed"
                  }
                },
                "b": {
                  "sum": {
                    "field": "n.business"
                  }
                },
                "s": {
                  "sum": {
                    "field": "n.system"
                  }
                },
                "a": {
                  "sum": {
                    "field": "n.attempt"
                  }
                }
              }
            }
          }
        }
      },
      "format": {
        "property": "aggregations"
      }
    },
    {
      "name": "win",
      "source": "raw",
      "transform": [
        {
          "type": "flatten",
          "fields": [
            "win.d.buckets"
          ],
          "as": [
            "_bk"
          ]
        },
        {
          "type": "formula",
          "as": "key",
          "expr": "datum._bk.key"
        },
        {
          "type": "formula",
          "as": "n",
          "expr": "datum._bk.doc_count"
        },
        {
          "type": "project",
          "fields": [
            "key",
            "n"
          ]
        }
      ]
    },
    {
      "name": "days",
      "source": "raw",
      "transform": [
        {
          "type": "flatten",
          "fields": [
            "days.buckets"
          ],
          "as": [
            "_bk"
          ]
        },
        {
          "type": "formula",
          "as": "key",
          "expr": "datum._bk.key"
        },
        {
          "type": "formula",
          "as": "n",
          "expr": "datum._bk.doc_count"
        },
        {
          "type": "formula",
          "as": "c",
          "expr": "datum._bk[\"c\"] ? (datum._bk[\"c\"].value || 0) : 0"
        },
        {
          "type": "formula",
          "as": "b",
          "expr": "datum._bk[\"b\"] ? (datum._bk[\"b\"].value || 0) : 0"
        },
        {
          "type": "formula",
          "as": "s",
          "expr": "datum._bk[\"s\"] ? (datum._bk[\"s\"].value || 0) : 0"
        },
        {
          "type": "formula",
          "as": "a",
          "expr": "datum._bk[\"a\"] ? (datum._bk[\"a\"].value || 0) : 0"
        },
        {
          "type": "project",
          "fields": [
            "key",
            "n",
            "c",
            "b",
            "s",
            "a"
          ]
        }
      ]
    },
    {
      "name": "series",
      "source": "win",
      "transform": [
        {
          "type": "lookup",
          "from": "days",
          "key": "key",
          "fields": [
            "key"
          ],
          "as": [
            "d"
          ]
        },
        {
          "type": "formula",
          "as": "t",
          "expr": "datum.key"
        },
        {
          "type": "formula",
          "as": "c",
          "expr": "datum.d ? datum.d.c : 0"
        },
        {
          "type": "formula",
          "as": "b",
          "expr": "datum.d ? datum.d.b : 0"
        },
        {
          "type": "formula",
          "as": "s",
          "expr": "datum.d ? datum.d.s : 0"
        },
        {
          "type": "formula",
          "as": "a",
          "expr": "datum.d ? datum.d.a : 0"
        }
      ]
    },
    {
      "name": "tot",
      "source": "days",
      "transform": [
        {
          "type": "formula",
          "as": "cur_c",
          "expr": "datum.key >= lo && datum.key <= hi ? datum.c : 0"
        },
        {
          "type": "formula",
          "as": "prev_c",
          "expr": "datum.key >= plo && datum.key <= phi ? datum.c : 0"
        },
        {
          "type": "formula",
          "as": "cur_b",
          "expr": "datum.key >= lo && datum.key <= hi ? datum.b : 0"
        },
        {
          "type": "formula",
          "as": "prev_b",
          "expr": "datum.key >= plo && datum.key <= phi ? datum.b : 0"
        },
        {
          "type": "formula",
          "as": "cur_s",
          "expr": "datum.key >= lo && datum.key <= hi ? datum.s : 0"
        },
        {
          "type": "formula",
          "as": "prev_s",
          "expr": "datum.key >= plo && datum.key <= phi ? datum.s : 0"
        },
        {
          "type": "formula",
          "as": "cur_a",
          "expr": "datum.key >= lo && datum.key <= hi ? datum.a : 0"
        },
        {
          "type": "formula",
          "as": "prev_a",
          "expr": "datum.key >= plo && datum.key <= phi ? datum.a : 0"
        },
        {
          "type": "aggregate",
          "ops": [
            "sum",
            "sum",
            "sum",
            "sum",
            "sum",
            "sum",
            "sum",
            "sum"
          ],
          "fields": [
            "cur_c",
            "prev_c",
            "cur_b",
            "prev_b",
            "cur_s",
            "prev_s",
            "cur_a",
            "prev_a"
          ],
          "as": [
            "cur_c",
            "prev_c",
            "cur_b",
            "prev_b",
            "cur_s",
            "prev_s",
            "cur_a",
            "prev_a"
          ]
        }
      ]
    },
    {
      "name": "tiles",
      "values": [
        {
          "i": 0,
          "label": "Volume in",
          "accent": "#FF222F"
        },
        {
          "i": 1,
          "label": "Completed out",
          "accent": "#0B3239"
        },
        {
          "i": 2,
          "label": "Business exceptions",
          "accent": "#8A6FB0"
        },
        {
          "i": 3,
          "label": "System exceptions",
          "accent": "#FF222F"
        }
      ],
      "transform": [
        {
          "type": "formula",
          "as": "value",
          "expr": "[(isValid(((length(data('tot')) ? data('tot')[0].cur_a : 0))) && isFinite(((length(data('tot')) ? data('tot')[0].cur_a : 0))) ? (abs(((length(data('tot')) ? data('tot')[0].cur_a : 0))) >= 1e6 ? format(((length(data('tot')) ? data('tot')[0].cur_a : 0)) / 1e6, abs(((length(data('tot')) ? data('tot')[0].cur_a : 0))) >= 1e7 ? '.0f' : '.1f') + 'M' : abs(((length(data('tot')) ? data('tot')[0].cur_a : 0))) >= 1e3 ? format(((length(data('tot')) ? data('tot')[0].cur_a : 0)) / 1e3, abs(((length(data('tot')) ? data('tot')[0].cur_a : 0))) >= 1e4 ? '.0f' : '.1f') + 'k' : format(((length(data('tot')) ? data('tot')[0].cur_a : 0)), '.0f')) : '–'), (isValid(((length(data('tot')) ? data('tot')[0].cur_c : 0))) && isFinite(((length(data('tot')) ? data('tot')[0].cur_c : 0))) ? (abs(((length(data('tot')) ? data('tot')[0].cur_c : 0))) >= 1e6 ? format(((length(data('tot')) ? data('tot')[0].cur_c : 0)) / 1e6, abs(((length(data('tot')) ? data('tot')[0].cur_c : 0))) >= 1e7 ? '.0f' : '.1f') + 'M' : abs(((length(data('tot')) ? data('tot')[0].cur_c : 0))) >= 1e3 ? format(((length(data('tot')) ? data('tot')[0].cur_c : 0)) / 1e3, abs(((length(data('tot')) ? data('tot')[0].cur_c : 0))) >= 1e4 ? '.0f' : '.1f') + 'k' : format(((length(data('tot')) ? data('tot')[0].cur_c : 0)), '.0f')) : '–'), (isValid(((length(data('tot')) ? data('tot')[0].cur_b : 0))) && isFinite(((length(data('tot')) ? data('tot')[0].cur_b : 0))) ? (abs(((length(data('tot')) ? data('tot')[0].cur_b : 0))) >= 1e6 ? format(((length(data('tot')) ? data('tot')[0].cur_b : 0)) / 1e6, abs(((length(data('tot')) ? data('tot')[0].cur_b : 0))) >= 1e7 ? '.0f' : '.1f') + 'M' : abs(((length(data('tot')) ? data('tot')[0].cur_b : 0))) >= 1e3 ? format(((length(data('tot')) ? data('tot')[0].cur_b : 0)) / 1e3, abs(((length(data('tot')) ? data('tot')[0].cur_b : 0))) >= 1e4 ? '.0f' : '.1f') + 'k' : format(((length(data('tot')) ? data('tot')[0].cur_b : 0)), '.0f')) : '–'), (isValid(((length(data('tot')) ? data('tot')[0].cur_s : 0))) && isFinite(((length(data('tot')) ? data('tot')[0].cur_s : 0))) ? (abs(((length(data('tot')) ? data('tot')[0].cur_s : 0))) >= 1e6 ? format(((length(data('tot')) ? data('tot')[0].cur_s : 0)) / 1e6, abs(((length(data('tot')) ? data('tot')[0].cur_s : 0))) >= 1e7 ? '.0f' : '.1f') + 'M' : abs(((length(data('tot')) ? data('tot')[0].cur_s : 0))) >= 1e3 ? format(((length(data('tot')) ? data('tot')[0].cur_s : 0)) / 1e3, abs(((length(data('tot')) ? data('tot')[0].cur_s : 0))) >= 1e4 ? '.0f' : '.1f') + 'k' : format(((length(data('tot')) ? data('tot')[0].cur_s : 0)), '.0f')) : '–')][datum.i]"
        },
        {
          "type": "formula",
          "as": "sub",
          "expr": "['cases attempted', (isValid(((length(data('tot')) ? data('tot')[0].cur_c : 0) / max(1, (length(data('tot')) ? data('tot')[0].cur_a : 0)))) && isFinite(((length(data('tot')) ? data('tot')[0].cur_c : 0) / max(1, (length(data('tot')) ? data('tot')[0].cur_a : 0)))) ? format(((length(data('tot')) ? data('tot')[0].cur_c : 0) / max(1, (length(data('tot')) ? data('tot')[0].cur_a : 0))) * 100, '.1f') + '%' : '–') + ' of intake', (isValid(((length(data('tot')) ? data('tot')[0].cur_b : 0) / max(1, (length(data('tot')) ? data('tot')[0].cur_a : 0)))) && isFinite(((length(data('tot')) ? data('tot')[0].cur_b : 0) / max(1, (length(data('tot')) ? data('tot')[0].cur_a : 0)))) ? format(((length(data('tot')) ? data('tot')[0].cur_b : 0) / max(1, (length(data('tot')) ? data('tot')[0].cur_a : 0))) * 100, '.1f') + '%' : '–') + ' of intake', (isValid(((length(data('tot')) ? data('tot')[0].cur_s : 0) / max(1, (length(data('tot')) ? data('tot')[0].cur_a : 0)))) && isFinite(((length(data('tot')) ? data('tot')[0].cur_s : 0) / max(1, (length(data('tot')) ? data('tot')[0].cur_a : 0)))) ? format(((length(data('tot')) ? data('tot')[0].cur_s : 0) / max(1, (length(data('tot')) ? data('tot')[0].cur_a : 0))) * 100, '.1f') + '%' : '–') + ' of intake'][datum.i]"
        },
        {
          "type": "formula",
          "as": "delta",
          "expr": "null"
        }
      ]
    }
  ],
  "marks": [
    {
      "type": "group",
      "name": "tile",
      "from": {
        "data": "tiles"
      },
      "encode": {
        "update": {
          "x": {
            "signal": "datum.i * ((width - 36) / 4 + 12)"
          },
          "y": {
            "value": 0
          },
          "width": {
            "signal": "(width - 36) / 4"
          },
          "height": {
            "signal": "height"
          },
          "fill": {
            "value": {
              "gradient": "linear",
              "x1": 0,
              "y1": 0,
              "x2": 0.2,
              "y2": 1,
              "stops": [
                {
                  "offset": 0,
                  "color": "#FAF7F2"
                },
                {
                  "offset": 1,
                  "color": "#F3EFE8"
                }
              ]
            }
          },
          "stroke": {
            "value": "#DCDCD7"
          },
          "cornerRadius": {
            "value": 12
          }
        }
      },
      "marks": [
        {
          "type": "rect",
          "encode": {
            "update": {
              "x": {
                "value": 0
              },
              "y": {
                "value": 0
              },
              "width": {
                "signal": "item.mark.group.width"
              },
              "height": {
                "value": 3
              },
              "fill": {
                "field": {
                  "parent": "accent"
                }
              },
              "cornerRadiusTopLeft": {
                "value": 12
              },
              "cornerRadiusTopRight": {
                "value": 12
              }
            }
          }
        },
        {
          "type": "text",
          "encode": {
            "update": {
              "x": {
                "value": 16
              },
              "y": {
                "value": 18
              },
              "baseline": {
                "value": "top"
              },
              "font": {
                "value": "'JetBrains Mono', 'Roboto Mono', Consolas, 'Courier New', monospace"
              },
              "fontSize": {
                "value": 11
              },
              "fontWeight": {
                "value": "bold"
              },
              "fill": {
                "value": "#5A7378"
              },
              "text": {
                "signal": "upper(parent.label)"
              },
              "limit": {
                "signal": "item.mark.group.width - 28"
              }
            }
          }
        },
        {
          "type": "text",
          "encode": {
            "update": {
              "x": {
                "value": 16
              },
              "y": {
                "value": 36
              },
              "baseline": {
                "value": "top"
              },
              "font": {
                "value": "Georgia, Gelasio, 'Times New Roman', serif"
              },
              "fontSize": {
                "signal": "item.mark.group.width < 170 ? 26 : 32"
              },
              "fontWeight": {
                "value": "bold"
              },
              "fill": {
                "value": "#0B3239"
              },
              "text": {
                "field": {
                  "parent": "value"
                }
              }
            }
          }
        },
        {
          "type": "text",
          "encode": {
            "update": {
              "x": {
                "value": 16
              },
              "y": {
                "value": 82
              },
              "baseline": {
                "value": "middle"
              },
              "font": {
                "value": "'JetBrains Mono', 'Roboto Mono', Consolas, 'Courier New', monospace"
              },
              "fontSize": {
                "value": 11.5
              },
              "fontWeight": {
                "value": "bold"
              },
              "fill": {
                "signal": "!isValid(parent.delta) || abs(parent.delta) < 0.001 ? '#5A7378' : ((parent.deltaGood === 'down' ? parent.delta <= 0 : parent.delta >= 0) ? '#0B3239' : '#FF222F')"
              },
              "text": {
                "signal": "isValid(parent.delta) ? (isValid((parent.delta)) && isFinite((parent.delta)) ? ((parent.delta) >= 0 ? '▲ ' : '▼ ') + format(abs((parent.delta)) * 100, '.1f') + '%' : '–') : ''"
              }
            }
          }
        },
        {
          "type": "text",
          "encode": {
            "update": {
              "x": {
                "signal": "isValid(parent.delta) ? 78 : 16"
              },
              "y": {
                "value": 82
              },
              "baseline": {
                "value": "middle"
              },
              "font": {
                "value": "Calibri, Carlito, 'Segoe UI', Inter, Arial, sans-serif"
              },
              "fontSize": {
                "value": 12
              },
              "fill": {
                "value": "#5A7378"
              },
              "text": {
                "field": {
                  "parent": "sub"
                }
              },
              "limit": {
                "signal": "item.mark.group.width - (isValid(parent.delta) ? 90 : 28)"
              }
            }
          }
        },
        {
          "type": "symbol",
          "encode": {
            "update": {
              "x": {
                "value": 19
              },
              "y": {
                "value": 101
              },
              "shape": {
                "value": "circle"
              },
              "size": {
                "value": 30
              },
              "fill": {
                "signal": "parent.met ? '#0B3239' : '#FF222F'"
              },
              "opacity": {
                "signal": "isValid(parent.target) && parent.target !== '' ? 1 : 0"
              }
            }
          }
        },
        {
          "type": "text",
          "encode": {
            "update": {
              "x": {
                "value": 27
              },
              "y": {
                "value": 101
              },
              "baseline": {
                "value": "middle"
              },
              "font": {
                "value": "'JetBrains Mono', 'Roboto Mono', Consolas, 'Courier New', monospace"
              },
              "fontSize": {
                "value": 10
              },
              "fontWeight": {
                "value": "bold"
              },
              "fill": {
                "signal": "parent.met ? '#0B3239' : '#FF222F'"
              },
              "text": {
                "signal": "isValid(parent.target) && parent.target !== '' ? (parent.met ? 'On' : 'Off') + ' target (' + parent.target + ')' : ''"
              },
              "limit": {
                "signal": "item.mark.group.width - 40"
              }
            }
          }
        }
      ]
    }
  ]
}
