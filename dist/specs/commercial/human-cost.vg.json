{
  "$schema": "https://vega.github.io/schema/vega/v5.json",
  "description": "IA · Commercial Performance · Human cost assumption. Generated by vega/build.mjs from vega/panels/commercial.mjs, do not edit by hand.",
  "autosize": {
    "type": "fit",
    "contains": "padding"
  },
  "padding": 0,
  "config": {
    "background": "#FAF7F2",
    "padding": 0,
    "font": "Calibri, Carlito, 'Segoe UI', Inter, Arial, sans-serif",
    "text": {
      "font": "Calibri, Carlito, 'Segoe UI', Inter, Arial, sans-serif",
      "fill": "#0B3239",
      "fontSize": 12
    },
    "axis": {
      "labelFont": "'JetBrains Mono', 'Roboto Mono', Consolas, 'Courier New', monospace",
      "labelFontSize": 10,
      "labelColor": "#5A7378",
      "titleFont": "'JetBrains Mono', 'Roboto Mono', Consolas, 'Courier New', monospace",
      "titleColor": "#5A7378",
      "titleFontSize": 10,
      "titleFontWeight": 400,
      "domain": false,
      "ticks": false,
      "gridColor": "#DCDCD7",
      "gridWidth": 1,
      "labelPadding": 6
    },
    "style": {
      "guide-label": {
        "font": "'JetBrains Mono', 'Roboto Mono', Consolas, 'Courier New', monospace"
      }
    },
    "view": {
      "stroke": null
    },
    "kibana": {
      "renderer": "svg",
      "hideWarnings": true
    }
  },
  "signals": [
    {
      "name": "ndays",
      "update": "length(data('win'))"
    },
    {
      "name": "lo",
      "update": "ndays ? data('win')[0].key : 0"
    },
    {
      "name": "hi",
      "update": "ndays ? data('win')[ndays - 1].key : 0"
    },
    {
      "name": "plo",
      "update": "lo - ndays * 86400000"
    },
    {
      "name": "phi",
      "update": "lo - 86400000"
    },
    {
      "name": "top",
      "value": 56
    },
    {
      "name": "cw",
      "update": "width - 32"
    },
    {
      "name": "ch",
      "update": "height - top - 16"
    },
    {
      "name": "rateOverride",
      "value": 0,
      "bind": {
        "input": "range",
        "min": 0,
        "max": 60,
        "step": 1,
        "name": "What-if £/hr (0 = grade rates) "
      }
    },
    {
      "name": "blended",
      "update": "(length(data('tot')) ? data('tot')[0].cur_h : 0) ? (length(data('tot')) ? data('tot')[0].cur_gb : 0) / (length(data('tot')) ? data('tot')[0].cur_h : 0) : 0"
    },
    {
      "name": "wiRate",
      "update": "rateOverride > 0 ? rateOverride : blended"
    },
    {
      "name": "wiGross",
      "update": "(length(data('tot')) ? data('tot')[0].cur_h : 0) * wiRate"
    },
    {
      "name": "wiNet",
      "update": "wiGross - (length(data('tot')) ? data('tot')[0].cur_ec : 0)"
    },
    {
      "name": "wiRoi",
      "update": "(length(data('tot')) ? data('tot')[0].cur_ec : 0) ? wiGross / (length(data('tot')) ? data('tot')[0].cur_ec : 0) : 0"
    },
    {
      "name": "sx0",
      "update": "16 + 190"
    },
    {
      "name": "sx1",
      "update": "width - 470"
    }
  ],
  "data": [
    {
      "name": "raw",
      "url": {
        "index": "ia-workqueue-items",
        "body": {
          "size": 0,
          "query": {
            "bool": {
              "must": [
                "%dashboard_context-must_clause%",
                {
                  "range": {
                    "@timestamp": {
                      "gte": {
                        "%timefilter%": "min",
                        "shift": -732,
                        "unit": "day"
                      },
                      "lte": {
                        "%timefilter%": "max"
                      },
                      "format": "epoch_millis"
                    }
                  }
                },
                {
                  "term": {
                    "mapped": true
                  }
                }
              ],
              "filter": [
                "%dashboard_context-filter_clause%"
              ],
              "must_not": [
                "%dashboard_context-must_not_clause%"
              ]
            }
          },
          "aggs": {
            "win": {
              "filter": {
                "range": {
                  "@timestamp": {
                    "%timefilter%": true
                  }
                }
              },
              "aggs": {
                "d": {
                  "date_histogram": {
                    "field": "@timestamp",
                    "fixed_interval": "1d",
                    "min_doc_count": 0,
                    "extended_bounds": {
                      "min": {
                        "%timefilter%": "min"
                      },
                      "max": {
                        "%timefilter%": "max"
                      }
                    }
                  }
                }
              }
            },
            "days": {
              "date_histogram": {
                "field": "@timestamp",
                "fixed_interval": "1d",
                "min_doc_count": 1
              },
              "aggs": {
                "h": {
                  "sum": {
                    "field": "value.hours_saved"
                  }
                },
                "gb": {
                  "sum": {
                    "field": "value.benefit_gbp"
                  }
                },
                "ec": {
                  "sum": {
                    "field": "cost.estate_gbp"
                  }
                }
              }
            }
          }
        }
      },
      "format": {
        "property": "aggregations"
      }
    },
    {
      "name": "win",
      "source": "raw",
      "transform": [
        {
          "type": "flatten",
          "fields": [
            "win.d.buckets"
          ],
          "as": [
            "_bk"
          ]
        },
        {
          "type": "formula",
          "as": "key",
          "expr": "datum._bk.key"
        },
        {
          "type": "formula",
          "as": "n",
          "expr": "datum._bk.doc_count"
        },
        {
          "type": "project",
          "fields": [
            "key",
            "n"
          ]
        }
      ]
    },
    {
      "name": "days",
      "source": "raw",
      "transform": [
        {
          "type": "flatten",
          "fields": [
            "days.buckets"
          ],
          "as": [
            "_bk"
          ]
        },
        {
          "type": "formula",
          "as": "key",
          "expr": "datum._bk.key"
        },
        {
          "type": "formula",
          "as": "n",
          "expr": "datum._bk.doc_count"
        },
        {
          "type": "formula",
          "as": "h",
          "expr": "datum._bk[\"h\"] ? (datum._bk[\"h\"].value || 0) : 0"
        },
        {
          "type": "formula",
          "as": "gb",
          "expr": "datum._bk[\"gb\"] ? (datum._bk[\"gb\"].value || 0) : 0"
        },
        {
          "type": "formula",
          "as": "ec",
          "expr": "datum._bk[\"ec\"] ? (datum._bk[\"ec\"].value || 0) : 0"
        },
        {
          "type": "project",
          "fields": [
            "key",
            "n",
            "h",
            "gb",
            "ec"
          ]
        }
      ]
    },
    {
      "name": "series",
      "source": "win",
      "transform": [
        {
          "type": "lookup",
          "from": "days",
          "key": "key",
          "fields": [
            "key"
          ],
          "as": [
            "d"
          ]
        },
        {
          "type": "formula",
          "as": "t",
          "expr": "datum.key"
        },
        {
          "type": "formula",
          "as": "h",
          "expr": "datum.d ? datum.d.h : 0"
        },
        {
          "type": "formula",
          "as": "gb",
          "expr": "datum.d ? datum.d.gb : 0"
        },
        {
          "type": "formula",
          "as": "ec",
          "expr": "datum.d ? datum.d.ec : 0"
        }
      ]
    },
    {
      "name": "tot",
      "source": "days",
      "transform": [
        {
          "type": "formula",
          "as": "cur_h",
          "expr": "datum.key >= lo && datum.key <= hi ? datum.h : 0"
        },
        {
          "type": "formula",
          "as": "prev_h",
          "expr": "datum.key >= plo && datum.key <= phi ? datum.h : 0"
        },
        {
          "type": "formula",
          "as": "cur_gb",
          "expr": "datum.key >= lo && datum.key <= hi ? datum.gb : 0"
        },
        {
          "type": "formula",
          "as": "prev_gb",
          "expr": "datum.key >= plo && datum.key <= phi ? datum.gb : 0"
        },
        {
          "type": "formula",
          "as": "cur_ec",
          "expr": "datum.key >= lo && datum.key <= hi ? datum.ec : 0"
        },
        {
          "type": "formula",
          "as": "prev_ec",
          "expr": "datum.key >= plo && datum.key <= phi ? datum.ec : 0"
        },
        {
          "type": "aggregate",
          "ops": [
            "sum",
            "sum",
            "sum",
            "sum",
            "sum",
            "sum"
          ],
          "fields": [
            "cur_h",
            "prev_h",
            "cur_gb",
            "prev_gb",
            "cur_ec",
            "prev_ec"
          ],
          "as": [
            "cur_h",
            "prev_h",
            "cur_gb",
            "prev_gb",
            "cur_ec",
            "prev_ec"
          ]
        }
      ]
    }
  ],
  "marks": [
    {
      "type": "text",
      "name": "frame_title",
      "encode": {
        "update": {
          "x": {
            "value": 16
          },
          "y": {
            "value": 16
          },
          "baseline": {
            "value": "top"
          },
          "font": {
            "value": "Georgia, Gelasio, 'Times New Roman', serif"
          },
          "fontSize": {
            "value": 16
          },
          "fontWeight": {
            "value": "bold"
          },
          "fill": {
            "value": "#0B3239"
          },
          "text": {
            "value": "Human cost assumption (SMV valuation)"
          },
          "limit": {
            "signal": "width - 32"
          }
        }
      }
    },
    {
      "type": "text",
      "encode": {
        "update": {
          "x": {
            "value": 16
          },
          "y": {
            "value": 38
          },
          "baseline": {
            "value": "top"
          },
          "font": {
            "value": "Calibri, Carlito, 'Segoe UI', Inter, Arial, sans-serif"
          },
          "fontSize": {
            "value": 12
          },
          "fill": {
            "value": "#5A7378"
          },
          "text": {
            "value": "Benefit uses the grade rate in force on the day the work completed. Drag the what-if slider below the panel to test a flat rate; the results show here."
          },
          "limit": {
            "signal": "width - 32"
          }
        }
      }
    },
    {
      "type": "text",
      "encode": {
        "update": {
          "x": {
            "value": 16
          },
          "y": {
            "signal": "top + 18"
          },
          "baseline": {
            "value": "alphabetic"
          },
          "font": {
            "value": "Georgia, Gelasio, 'Times New Roman', serif"
          },
          "fontSize": {
            "value": 22
          },
          "fontWeight": {
            "value": "bold"
          },
          "fill": {
            "value": "#0B3239"
          },
          "text": {
            "signal": "'£' + format(wiRate, '.2f')"
          }
        }
      }
    },
    {
      "type": "text",
      "encode": {
        "update": {
          "x": {
            "value": 108
          },
          "y": {
            "signal": "top + 18"
          },
          "font": {
            "value": "'JetBrains Mono', 'Roboto Mono', Consolas, 'Courier New', monospace"
          },
          "fontSize": {
            "value": 12
          },
          "fill": {
            "value": "#5A7378"
          },
          "text": {
            "value": "/hr"
          }
        }
      }
    },
    {
      "type": "text",
      "encode": {
        "update": {
          "x": {
            "value": 16
          },
          "y": {
            "signal": "top + 36"
          },
          "font": {
            "value": "'JetBrains Mono', 'Roboto Mono', Consolas, 'Courier New', monospace"
          },
          "fontSize": {
            "value": 10.5
          },
          "fontWeight": {
            "value": "bold"
          },
          "fill": {
            "signal": "rateOverride > 0 ? '#8A6FB0' : '#0F766E'"
          },
          "text": {
            "signal": "rateOverride > 0 ? 'FLAT WHAT-IF OVERRIDE' : 'GRADE RATE CARD (BLENDED)'"
          }
        }
      }
    },
    {
      "type": "rect",
      "encode": {
        "update": {
          "x": {
            "signal": "sx0"
          },
          "x2": {
            "signal": "sx1"
          },
          "y": {
            "signal": "top + 9"
          },
          "height": {
            "value": 5
          },
          "cornerRadius": {
            "value": 3
          },
          "fill": {
            "value": "#E4E3DE"
          }
        }
      }
    },
    {
      "type": "rect",
      "encode": {
        "update": {
          "x": {
            "signal": "sx0"
          },
          "x2": {
            "signal": "sx0 + (sx1 - sx0) * clamp((wiRate - 15) / 45, 0, 1)"
          },
          "y": {
            "signal": "top + 9"
          },
          "height": {
            "value": 5
          },
          "cornerRadius": {
            "value": 3
          },
          "fill": {
            "signal": "rateOverride > 0 ? '#8A6FB0' : '#0B3239'"
          }
        }
      }
    },
    {
      "type": "symbol",
      "encode": {
        "update": {
          "x": {
            "signal": "sx0 + (sx1 - sx0) * clamp((wiRate - 15) / 45, 0, 1)"
          },
          "y": {
            "signal": "top + 11.5"
          },
          "size": {
            "value": 150
          },
          "fill": {
            "signal": "rateOverride > 0 ? '#8A6FB0' : '#0B3239'"
          }
        }
      }
    },
    {
      "type": "symbol",
      "encode": {
        "update": {
          "x": {
            "signal": "sx0 + (sx1 - sx0) * clamp((blended - 15) / 45, 0, 1)"
          },
          "y": {
            "signal": "top + 24"
          },
          "shape": {
            "value": "triangle-up"
          },
          "size": {
            "value": 40
          },
          "fill": {
            "value": "#5A7378"
          },
          "opacity": {
            "signal": "rateOverride > 0 ? 1 : 0"
          }
        }
      }
    },
    {
      "type": "text",
      "encode": {
        "update": {
          "x": {
            "signal": "sx0"
          },
          "y": {
            "signal": "top + 34"
          },
          "font": {
            "value": "'JetBrains Mono', 'Roboto Mono', Consolas, 'Courier New', monospace"
          },
          "fontSize": {
            "value": 10.5
          },
          "fill": {
            "value": "#5A7378"
          },
          "text": {
            "value": "£15"
          }
        }
      }
    },
    {
      "type": "text",
      "encode": {
        "update": {
          "x": {
            "signal": "sx1"
          },
          "y": {
            "signal": "top + 34"
          },
          "align": {
            "value": "right"
          },
          "font": {
            "value": "'JetBrains Mono', 'Roboto Mono', Consolas, 'Courier New', monospace"
          },
          "fontSize": {
            "value": 10.5
          },
          "fill": {
            "value": "#5A7378"
          },
          "text": {
            "value": "£60"
          }
        }
      }
    },
    {
      "type": "text",
      "encode": {
        "update": {
          "x": {
            "signal": "width - 440 + 0"
          },
          "y": {
            "signal": "top + 6"
          },
          "baseline": {
            "value": "top"
          },
          "font": {
            "value": "'JetBrains Mono', 'Roboto Mono', Consolas, 'Courier New', monospace"
          },
          "fontSize": {
            "value": 10
          },
          "fontWeight": {
            "value": "bold"
          },
          "fill": {
            "value": "#5A7378"
          },
          "text": {
            "value": "GROSS AT THIS RATE"
          }
        }
      }
    },
    {
      "type": "text",
      "encode": {
        "update": {
          "x": {
            "signal": "width - 440 + 0"
          },
          "y": {
            "signal": "top + 34"
          },
          "font": {
            "value": "Georgia, Gelasio, 'Times New Roman', serif"
          },
          "fontSize": {
            "value": 18
          },
          "fontWeight": {
            "value": "bold"
          },
          "fill": {
            "value": "#0B3239"
          },
          "text": {
            "signal": "(isValid((wiGross)) && isFinite((wiGross)) ? ((wiGross) < 0 ? '-' : '') + '£' + (abs((wiGross)) >= 1e6 ? format(abs((wiGross)) / 1e6, '.2f') + 'M' : abs((wiGross)) >= 1e3 ? format(abs((wiGross)) / 1e3, '.1f') + 'k' : format(abs((wiGross)), '.2f')) : '–')"
          }
        }
      }
    },
    {
      "type": "text",
      "encode": {
        "update": {
          "x": {
            "signal": "width - 440 + 145"
          },
          "y": {
            "signal": "top + 6"
          },
          "baseline": {
            "value": "top"
          },
          "font": {
            "value": "'JetBrains Mono', 'Roboto Mono', Consolas, 'Courier New', monospace"
          },
          "fontSize": {
            "value": 10
          },
          "fontWeight": {
            "value": "bold"
          },
          "fill": {
            "value": "#5A7378"
          },
          "text": {
            "value": "NET AT THIS RATE"
          }
        }
      }
    },
    {
      "type": "text",
      "encode": {
        "update": {
          "x": {
            "signal": "width - 440 + 145"
          },
          "y": {
            "signal": "top + 34"
          },
          "font": {
            "value": "Georgia, Gelasio, 'Times New Roman', serif"
          },
          "fontSize": {
            "value": 18
          },
          "fontWeight": {
            "value": "bold"
          },
          "fill": {
            "value": "#0B3239"
          },
          "text": {
            "signal": "(isValid((wiNet)) && isFinite((wiNet)) ? ((wiNet) < 0 ? '-' : '') + '£' + (abs((wiNet)) >= 1e6 ? format(abs((wiNet)) / 1e6, '.2f') + 'M' : abs((wiNet)) >= 1e3 ? format(abs((wiNet)) / 1e3, '.1f') + 'k' : format(abs((wiNet)), '.2f')) : '–')"
          }
        }
      }
    },
    {
      "type": "text",
      "encode": {
        "update": {
          "x": {
            "signal": "width - 440 + 290"
          },
          "y": {
            "signal": "top + 6"
          },
          "baseline": {
            "value": "top"
          },
          "font": {
            "value": "'JetBrains Mono', 'Roboto Mono', Consolas, 'Courier New', monospace"
          },
          "fontSize": {
            "value": 10
          },
          "fontWeight": {
            "value": "bold"
          },
          "fill": {
            "value": "#5A7378"
          },
          "text": {
            "value": "ROI AT THIS RATE"
          }
        }
      }
    },
    {
      "type": "text",
      "encode": {
        "update": {
          "x": {
            "signal": "width - 440 + 290"
          },
          "y": {
            "signal": "top + 34"
          },
          "font": {
            "value": "Georgia, Gelasio, 'Times New Roman', serif"
          },
          "fontSize": {
            "value": 18
          },
          "fontWeight": {
            "value": "bold"
          },
          "fill": {
            "value": "#0B3239"
          },
          "text": {
            "signal": "format(wiRoi, '.1f') + '×'"
          }
        }
      }
    }
  ]
}
