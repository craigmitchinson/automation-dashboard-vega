{
  "$schema": "https://vega.github.io/schema/vega/v5.json",
  "description": "IA · Commercial Performance · Cost per completed case over time. Generated by vega/build.mjs from vega/panels/commercial.mjs, do not edit by hand.",
  "autosize": {
    "type": "fit",
    "contains": "padding"
  },
  "padding": 0,
  "config": {
    "background": "#FAF7F2",
    "padding": 0,
    "font": "Calibri, Carlito, 'Segoe UI', Inter, Arial, sans-serif",
    "text": {
      "font": "Calibri, Carlito, 'Segoe UI', Inter, Arial, sans-serif",
      "fill": "#0B3239",
      "fontSize": 12
    },
    "axis": {
      "labelFont": "'JetBrains Mono', 'Roboto Mono', Consolas, 'Courier New', monospace",
      "labelFontSize": 10,
      "labelColor": "#5A7378",
      "titleFont": "'JetBrains Mono', 'Roboto Mono', Consolas, 'Courier New', monospace",
      "titleColor": "#5A7378",
      "titleFontSize": 10,
      "titleFontWeight": 400,
      "domain": false,
      "ticks": false,
      "gridColor": "#DCDCD7",
      "gridWidth": 1,
      "labelPadding": 6
    },
    "style": {
      "guide-label": {
        "font": "'JetBrains Mono', 'Roboto Mono', Consolas, 'Courier New', monospace"
      }
    },
    "view": {
      "stroke": null
    },
    "kibana": {
      "renderer": "svg",
      "hideWarnings": true
    }
  },
  "signals": [
    {
      "name": "ndays",
      "update": "length(data('win'))"
    },
    {
      "name": "lo",
      "update": "ndays ? data('win')[0].key : 0"
    },
    {
      "name": "hi",
      "update": "ndays ? data('win')[ndays - 1].key : 0"
    },
    {
      "name": "plo",
      "update": "lo - ndays * 86400000"
    },
    {
      "name": "phi",
      "update": "lo - 86400000"
    },
    {
      "name": "oneSpoke",
      "update": "length(data('scope_spokes')) === 1 ? data('scope_spokes')[0].key : ''"
    },
    {
      "name": "tgt_completionPct",
      "update": "oneSpoke && indexof(pluck(data('tg'), 'k'), 'spoke|' + oneSpoke + '|completionPct') >= 0 ? data('tg')[indexof(pluck(data('tg'), 'k'), 'spoke|' + oneSpoke + '|completionPct')].v : (indexof(pluck(data('tg'), 'k'), 'global|completionPct') >= 0 ? data('tg')[indexof(pluck(data('tg'), 'k'), 'global|completionPct')].v : 0.95)"
    },
    {
      "name": "tgt_exceptionRate",
      "update": "oneSpoke && indexof(pluck(data('tg'), 'k'), 'spoke|' + oneSpoke + '|exceptionRate') >= 0 ? data('tg')[indexof(pluck(data('tg'), 'k'), 'spoke|' + oneSpoke + '|exceptionRate')].v : (indexof(pluck(data('tg'), 'k'), 'global|exceptionRate') >= 0 ? data('tg')[indexof(pluck(data('tg'), 'k'), 'global|exceptionRate')].v : 0.06)"
    },
    {
      "name": "tgt_systemRate",
      "update": "oneSpoke && indexof(pluck(data('tg'), 'k'), 'spoke|' + oneSpoke + '|systemRate') >= 0 ? data('tg')[indexof(pluck(data('tg'), 'k'), 'spoke|' + oneSpoke + '|systemRate')].v : (indexof(pluck(data('tg'), 'k'), 'global|systemRate') >= 0 ? data('tg')[indexof(pluck(data('tg'), 'k'), 'global|systemRate')].v : 0.03)"
    },
    {
      "name": "tgt_costPerCase",
      "update": "oneSpoke && indexof(pluck(data('tg'), 'k'), 'spoke|' + oneSpoke + '|costPerCase') >= 0 ? data('tg')[indexof(pluck(data('tg'), 'k'), 'spoke|' + oneSpoke + '|costPerCase')].v : (indexof(pluck(data('tg'), 'k'), 'global|costPerCase') >= 0 ? data('tg')[indexof(pluck(data('tg'), 'k'), 'global|costPerCase')].v : 9)"
    },
    {
      "name": "tgt_utilMin",
      "update": "oneSpoke && indexof(pluck(data('tg'), 'k'), 'spoke|' + oneSpoke + '|utilMin') >= 0 ? data('tg')[indexof(pluck(data('tg'), 'k'), 'spoke|' + oneSpoke + '|utilMin')].v : (indexof(pluck(data('tg'), 'k'), 'global|utilMin') >= 0 ? data('tg')[indexof(pluck(data('tg'), 'k'), 'global|utilMin')].v : 0.15)"
    },
    {
      "name": "tgt_utilMax",
      "update": "oneSpoke && indexof(pluck(data('tg'), 'k'), 'spoke|' + oneSpoke + '|utilMax') >= 0 ? data('tg')[indexof(pluck(data('tg'), 'k'), 'spoke|' + oneSpoke + '|utilMax')].v : (indexof(pluck(data('tg'), 'k'), 'global|utilMax') >= 0 ? data('tg')[indexof(pluck(data('tg'), 'k'), 'global|utilMax')].v : 0.6)"
    },
    {
      "name": "tgt_vdiStaleDays",
      "update": "oneSpoke && indexof(pluck(data('tg'), 'k'), 'spoke|' + oneSpoke + '|vdiStaleDays') >= 0 ? data('tg')[indexof(pluck(data('tg'), 'k'), 'spoke|' + oneSpoke + '|vdiStaleDays')].v : (indexof(pluck(data('tg'), 'k'), 'global|vdiStaleDays') >= 0 ? data('tg')[indexof(pluck(data('tg'), 'k'), 'global|vdiStaleDays')].v : 14)"
    },
    {
      "name": "cfg_fyStart",
      "update": "length(data('ref_config')) ? data('ref_config')[0]._source.fiscal_year_start_month : 4"
    },
    {
      "name": "cfg_warn",
      "update": "length(data('ref_config')) ? data('ref_config')[0]._source.warn_margin : 0.1"
    },
    {
      "name": "top",
      "value": 56
    },
    {
      "name": "cw",
      "update": "width - 32"
    },
    {
      "name": "ch",
      "update": "height - top - 16"
    },
    {
      "name": "chart_ymax",
      "update": "max(extent(pluck(data('cpp'), 'v'))[1] || 0, extent(pluck(data('cpp_fc'), 'hi'))[1] || 0, (indexof(pluck(data('tg'), 'k'), 'global|costPerCase') >= 0 ? data('tg')[indexof(pluck(data('tg'), 'k'), 'global|costPerCase')].v : 9))"
    }
  ],
  "data": [
    {
      "name": "raw",
      "url": {
        "index": "ia-workqueue-items",
        "body": {
          "size": 0,
          "query": {
            "bool": {
              "must": [
                "%dashboard_context-must_clause%",
                {
                  "range": {
                    "@timestamp": {
                      "gte": {
                        "%timefilter%": "min",
                        "shift": -732,
                        "unit": "day"
                      },
                      "lte": {
                        "%timefilter%": "max"
                      },
                      "format": "epoch_millis"
                    }
                  }
                },
                {
                  "term": {
                    "mapped": true
                  }
                }
              ],
              "filter": [
                "%dashboard_context-filter_clause%"
              ],
              "must_not": [
                "%dashboard_context-must_not_clause%"
              ]
            }
          },
          "aggs": {
            "win": {
              "filter": {
                "range": {
                  "@timestamp": {
                    "%timefilter%": true
                  }
                }
              },
              "aggs": {
                "d": {
                  "date_histogram": {
                    "field": "@timestamp",
                    "fixed_interval": "1d",
                    "min_doc_count": 0,
                    "extended_bounds": {
                      "min": {
                        "%timefilter%": "min"
                      },
                      "max": {
                        "%timefilter%": "max"
                      }
                    }
                  }
                }
              }
            },
            "days": {
              "date_histogram": {
                "field": "@timestamp",
                "fixed_interval": "1d",
                "min_doc_count": 1
              },
              "aggs": {
                "c": {
                  "sum": {
                    "field": "n.completed"
                  }
                },
                "a": {
                  "sum": {
                    "field": "n.attempt"
                  }
                },
                "ec": {
                  "sum": {
                    "field": "cost.estate_gbp"
                  }
                }
              }
            }
          }
        }
      },
      "format": {
        "property": "aggregations"
      }
    },
    {
      "name": "win",
      "source": "raw",
      "transform": [
        {
          "type": "flatten",
          "fields": [
            "win.d.buckets"
          ],
          "as": [
            "_bk"
          ]
        },
        {
          "type": "formula",
          "as": "key",
          "expr": "datum._bk.key"
        },
        {
          "type": "formula",
          "as": "n",
          "expr": "datum._bk.doc_count"
        },
        {
          "type": "project",
          "fields": [
            "key",
            "n"
          ]
        }
      ]
    },
    {
      "name": "days",
      "source": "raw",
      "transform": [
        {
          "type": "flatten",
          "fields": [
            "days.buckets"
          ],
          "as": [
            "_bk"
          ]
        },
        {
          "type": "formula",
          "as": "key",
          "expr": "datum._bk.key"
        },
        {
          "type": "formula",
          "as": "n",
          "expr": "datum._bk.doc_count"
        },
        {
          "type": "formula",
          "as": "c",
          "expr": "datum._bk[\"c\"] ? (datum._bk[\"c\"].value || 0) : 0"
        },
        {
          "type": "formula",
          "as": "a",
          "expr": "datum._bk[\"a\"] ? (datum._bk[\"a\"].value || 0) : 0"
        },
        {
          "type": "formula",
          "as": "ec",
          "expr": "datum._bk[\"ec\"] ? (datum._bk[\"ec\"].value || 0) : 0"
        },
        {
          "type": "project",
          "fields": [
            "key",
            "n",
            "c",
            "a",
            "ec"
          ]
        }
      ]
    },
    {
      "name": "series",
      "source": "win",
      "transform": [
        {
          "type": "lookup",
          "from": "days",
          "key": "key",
          "fields": [
            "key"
          ],
          "as": [
            "d"
          ]
        },
        {
          "type": "formula",
          "as": "t",
          "expr": "datum.key"
        },
        {
          "type": "formula",
          "as": "c",
          "expr": "datum.d ? datum.d.c : 0"
        },
        {
          "type": "formula",
          "as": "a",
          "expr": "datum.d ? datum.d.a : 0"
        },
        {
          "type": "formula",
          "as": "ec",
          "expr": "datum.d ? datum.d.ec : 0"
        }
      ]
    },
    {
      "name": "tot",
      "source": "days",
      "transform": [
        {
          "type": "formula",
          "as": "cur_c",
          "expr": "datum.key >= lo && datum.key <= hi ? datum.c : 0"
        },
        {
          "type": "formula",
          "as": "prev_c",
          "expr": "datum.key >= plo && datum.key <= phi ? datum.c : 0"
        },
        {
          "type": "formula",
          "as": "cur_a",
          "expr": "datum.key >= lo && datum.key <= hi ? datum.a : 0"
        },
        {
          "type": "formula",
          "as": "prev_a",
          "expr": "datum.key >= plo && datum.key <= phi ? datum.a : 0"
        },
        {
          "type": "formula",
          "as": "cur_ec",
          "expr": "datum.key >= lo && datum.key <= hi ? datum.ec : 0"
        },
        {
          "type": "formula",
          "as": "prev_ec",
          "expr": "datum.key >= plo && datum.key <= phi ? datum.ec : 0"
        },
        {
          "type": "aggregate",
          "ops": [
            "sum",
            "sum",
            "sum",
            "sum",
            "sum",
            "sum"
          ],
          "fields": [
            "cur_c",
            "prev_c",
            "cur_a",
            "prev_a",
            "cur_ec",
            "prev_ec"
          ],
          "as": [
            "cur_c",
            "prev_c",
            "cur_a",
            "prev_a",
            "cur_ec",
            "prev_ec"
          ]
        }
      ]
    },
    {
      "name": "ref_targets",
      "url": {
        "index": "ia-reference",
        "body": {
          "size": 200,
          "query": {
            "term": {
              "doc_type": "target"
            }
          }
        }
      },
      "format": {
        "property": "hits.hits"
      }
    },
    {
      "name": "tg",
      "source": "ref_targets",
      "transform": [
        {
          "type": "formula",
          "as": "k",
          "expr": "datum._source.scope === 'global' ? 'global|' + datum._source.metric : datum._source.scope + '|' + datum._source.scope_id + '|' + datum._source.metric"
        },
        {
          "type": "formula",
          "as": "v",
          "expr": "datum._source.value"
        }
      ]
    },
    {
      "name": "ref_config",
      "url": {
        "index": "ia-reference",
        "body": {
          "size": 1,
          "query": {
            "term": {
              "doc_type": "config"
            }
          }
        }
      },
      "format": {
        "property": "hits.hits"
      }
    },
    {
      "name": "scope_spokes",
      "url": {
        "%context%": true,
        "%timefield%": "@timestamp",
        "index": "ia-workqueue-items",
        "body": {
          "size": 0,
          "aggs": {
            "m": {
              "filter": {
                "term": {
                  "mapped": true
                }
              },
              "aggs": {
                "s": {
                  "terms": {
                    "field": "spoke.name",
                    "size": 2
                  }
                }
              }
            }
          }
        }
      },
      "format": {
        "property": "aggregations.m.s.buckets"
      }
    },
    {
      "name": "cpp",
      "source": "series",
      "transform": [
        {
          "type": "filter",
          "expr": "datum.a > 0"
        },
        {
          "type": "formula",
          "as": "v",
          "expr": "datum.ec / max(datum.c, datum.a * 0.5)"
        }
      ]
    },
    {
      "name": "cpp_fc_l7",
      "source": "cpp",
      "transform": [
        {
          "type": "window",
          "sort": {
            "field": "t",
            "order": "descending"
          },
          "ops": [
            "row_number"
          ],
          "as": [
            "rk"
          ]
        },
        {
          "type": "filter",
          "expr": "datum.rk <= 7"
        },
        {
          "type": "aggregate",
          "ops": [
            "mean",
            "stdevp"
          ],
          "fields": [
            "v",
            "v"
          ],
          "as": [
            "m",
            "sd"
          ]
        }
      ]
    },
    {
      "name": "cpp_fc",
      "transform": [
        {
          "type": "sequence",
          "start": 1,
          "stop": 15,
          "as": "k"
        },
        {
          "type": "formula",
          "as": "t",
          "expr": "hi + datum.k * 86400000"
        },
        {
          "type": "formula",
          "as": "t1",
          "expr": "datum.t - 604800000"
        },
        {
          "type": "lookup",
          "from": "cpp",
          "key": "t",
          "fields": [
            "t1"
          ],
          "values": [
            "v"
          ],
          "as": [
            "v1"
          ]
        },
        {
          "type": "formula",
          "as": "t2",
          "expr": "datum.t - 1209600000"
        },
        {
          "type": "lookup",
          "from": "cpp",
          "key": "t",
          "fields": [
            "t2"
          ],
          "values": [
            "v"
          ],
          "as": [
            "v2"
          ]
        },
        {
          "type": "formula",
          "as": "t3",
          "expr": "datum.t - 1814400000"
        },
        {
          "type": "lookup",
          "from": "cpp",
          "key": "t",
          "fields": [
            "t3"
          ],
          "values": [
            "v"
          ],
          "as": [
            "v3"
          ]
        },
        {
          "type": "formula",
          "as": "t4",
          "expr": "datum.t - 2419200000"
        },
        {
          "type": "lookup",
          "from": "cpp",
          "key": "t",
          "fields": [
            "t4"
          ],
          "values": [
            "v"
          ],
          "as": [
            "v4"
          ]
        },
        {
          "type": "formula",
          "as": "n",
          "expr": "(isValid(datum.v1) ? 1 : 0) + (isValid(datum.v2) ? 1 : 0) + (isValid(datum.v3) ? 1 : 0) + (isValid(datum.v4) ? 1 : 0)"
        },
        {
          "type": "formula",
          "as": "m",
          "expr": "datum.n >= 2 ? ((isValid(datum.v1) ? datum.v1 : 0) + (isValid(datum.v2) ? datum.v2 : 0) + (isValid(datum.v3) ? datum.v3 : 0) + (isValid(datum.v4) ? datum.v4 : 0)) / datum.n : (length(data('cpp_fc_l7')) ? data('cpp_fc_l7')[0].m : 0)"
        },
        {
          "type": "formula",
          "as": "sd",
          "expr": "datum.n >= 2 ? sqrt(((isValid(datum.v1) ? pow(datum.v1 - datum.m, 2) : 0) + (isValid(datum.v2) ? pow(datum.v2 - datum.m, 2) : 0) + (isValid(datum.v3) ? pow(datum.v3 - datum.m, 2) : 0) + (isValid(datum.v4) ? pow(datum.v4 - datum.m, 2) : 0)) / datum.n) : (length(data('cpp_fc_l7')) ? data('cpp_fc_l7')[0].sd : 0)"
        },
        {
          "type": "formula",
          "as": "band",
          "expr": "max(datum.sd, abs(datum.m) * 0.05)"
        },
        {
          "type": "formula",
          "as": "point",
          "expr": "datum.m || 0"
        },
        {
          "type": "formula",
          "as": "lo",
          "expr": "max(0, datum.m - datum.band) || 0"
        },
        {
          "type": "formula",
          "as": "hi",
          "expr": "(datum.m + datum.band) || 0"
        }
      ]
    }
  ],
  "scales": [
    {
      "name": "chart_x",
      "type": "utc",
      "domain": {
        "signal": "[lo, hi + 14 * 86400000]"
      },
      "range": [
        0,
        {
          "signal": "cw - 44"
        }
      ]
    },
    {
      "name": "chart_y",
      "type": "linear",
      "domain": {
        "signal": "[0, max(0, chart_ymax)]"
      },
      "range": [
        {
          "signal": "ch - 22"
        },
        0
      ],
      "nice": true,
      "zero": true
    }
  ],
  "marks": [
    {
      "type": "text",
      "name": "frame_title",
      "encode": {
        "update": {
          "x": {
            "value": 16
          },
          "y": {
            "value": 16
          },
          "baseline": {
            "value": "top"
          },
          "font": {
            "value": "Georgia, Gelasio, 'Times New Roman', serif"
          },
          "fontSize": {
            "value": 16
          },
          "fontWeight": {
            "value": "bold"
          },
          "fill": {
            "value": "#0B3239"
          },
          "text": {
            "value": "Cost per completed case over time"
          },
          "limit": {
            "signal": "width - 32"
          }
        }
      }
    },
    {
      "type": "text",
      "encode": {
        "update": {
          "x": {
            "value": 16
          },
          "y": {
            "value": 38
          },
          "baseline": {
            "value": "top"
          },
          "font": {
            "value": "Calibri, Carlito, 'Segoe UI', Inter, Arial, sans-serif"
          },
          "fontSize": {
            "value": 12
          },
          "fill": {
            "value": "#5A7378"
          },
          "text": {
            "value": "Apportioned estate cost ÷ completed cases, by day, with a 14-day forecast (same-weekday average of the last four weeks)"
          },
          "limit": {
            "signal": "width - 32"
          }
        }
      }
    },
    {
      "type": "group",
      "name": "chart",
      "encode": {
        "update": {
          "x": {
            "value": 60
          },
          "y": {
            "signal": "top"
          },
          "width": {
            "signal": "cw - 44"
          },
          "height": {
            "signal": "ch - 22"
          }
        }
      },
      "axes": [
        {
          "scale": "chart_y",
          "orient": "left",
          "grid": true,
          "tickCount": 5,
          "labelPadding": 8,
          "encode": {
            "labels": {
              "update": {
                "text": {
                  "signal": "'£' + format(datum.value, '.2f')"
                }
              }
            }
          },
          "zindex": 0
        },
        {
          "scale": "chart_x",
          "orient": "bottom",
          "tickCount": {
            "signal": "min(10, max(2, floor((cw - 44) / 70)))"
          },
          "labelOverlap": true,
          "labelPadding": 6,
          "encode": {
            "labels": {
              "update": {
                "text": {
                  "signal": "utcFormat((datum.value), '%d %b')"
                }
              }
            }
          }
        }
      ],
      "marks": [
        {
          "type": "rect",
          "encode": {
            "update": {
              "x": {
                "signal": "scale('chart_x', hi + 43200000)"
              },
              "x2": {
                "signal": "cw - 44"
              },
              "y": {
                "value": 0
              },
              "y2": {
                "signal": "ch - 22"
              },
              "fill": {
                "value": "#0B3239"
              },
              "fillOpacity": {
                "value": 0.04
              }
            }
          }
        },
        {
          "type": "rule",
          "encode": {
            "update": {
              "x": {
                "signal": "scale('chart_x', hi + 43200000)"
              },
              "y": {
                "value": 0
              },
              "y2": {
                "signal": "ch - 22"
              },
              "stroke": {
                "value": "#5A7378"
              },
              "strokeDash": {
                "value": [
                  2,
                  3
                ]
              }
            }
          }
        },
        {
          "type": "text",
          "encode": {
            "update": {
              "x": {
                "signal": "cw - 40"
              },
              "y": {
                "value": 8
              },
              "align": {
                "value": "right"
              },
              "baseline": {
                "value": "top"
              },
