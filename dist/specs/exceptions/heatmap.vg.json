{
  "$schema": "https://vega.github.io/schema/vega/v5.json",
  "description": "IA · Exceptions · Exception heatmap. Generated by vega/build.mjs from vega/panels/exceptions.mjs, do not edit by hand.",
  "autosize": {
    "type": "fit",
    "contains": "padding"
  },
  "padding": 0,
  "config": {
    "background": "#FFFFFF",
    "padding": 0,
    "font": "Inter, 'Segoe UI', system-ui, -apple-system, sans-serif",
    "text": {
      "font": "Inter, 'Segoe UI', system-ui, -apple-system, sans-serif",
      "fill": "#0F4D43",
      "fontSize": 12
    },
    "axis": {
      "gridColor": "#E6E8E2",
      "labelFont": "'Roboto Mono', Menlo, Consolas, monospace",
      "labelFontSize": 10,
      "labelColor": "#5F6E69",
      "titleFont": "'Roboto Mono', Menlo, Consolas, monospace",
      "titleColor": "#5F6E69",
      "titleFontSize": 10,
      "titleFontWeight": 400,
      "domain": false,
      "ticks": false,
      "gridWidth": 1,
      "labelPadding": 6
    },
    "style": {
      "guide-label": {
        "font": "'Roboto Mono', Menlo, Consolas, monospace"
      }
    },
    "view": {
      "stroke": null
    },
    "kibana": {
      "renderer": "svg",
      "hideWarnings": true
    }
  },
  "signals": [
    {
      "name": "headerRight",
      "value": 0
    },
    {
      "name": "top",
      "value": 42
    },
    {
      "name": "cw",
      "update": "width - 32"
    },
    {
      "name": "ch",
      "update": "height - top - 16"
    },
    {
      "name": "labelW",
      "value": 180
    },
    {
      "name": "totW",
      "value": 84
    },
    {
      "name": "rowH",
      "update": "clamp((ch - 46) / max(1, length(data('rows'))), 14, 24)"
    },
    {
      "name": "cellMax",
      "update": "max(1, extent(pluck(data('cells'), 'v'))[1])"
    },
    {
      "name": "rowMax",
      "update": "max(1, extent(pluck(data('rows'), 'total'))[1])"
    },
    {
      "name": "pick",
      "on": [
        {
          "events": "@hm_label:click",
          "update": "kibanaAddFilter({'match_phrase': {'process.name': datum.name}}, 'ia-workqueue-items*')"
        }
      ]
    },
    {
      "name": "pickReason",
      "on": [
        {
          "events": "@hm_col:click",
          "update": "kibanaAddFilter({'match_phrase': {'exception.reason_display': datum.reason}}, 'ia-workqueue-items*')"
        }
      ]
    }
  ],
  "data": [
    {
      "name": "procs_raw",
      "url": {
        "index": "ia-reference",
        "body": {
          "size": 500,
          "query": {
            "term": {
              "doc_type": "process"
            }
          }
        }
      },
      "format": {
        "property": "hits.hits"
      }
    },
    {
      "name": "procs",
      "source": "procs_raw",
      "transform": [
        {
          "type": "formula",
          "as": "name",
          "expr": "datum._source.process.name"
        },
        {
          "type": "formula",
          "as": "pid",
          "expr": "datum._source.process.id"
        },
        {
          "type": "formula",
          "as": "acronym",
          "expr": "datum._source.process.acronym"
        },
        {
          "type": "formula",
          "as": "spoke",
          "expr": "datum._source.spoke.name"
        },
        {
          "type": "formula",
          "as": "spokeColor",
          "expr": "datum._source.spoke.color"
        },
        {
          "type": "formula",
          "as": "proposition",
          "expr": "datum._source.proposition.name"
        },
        {
          "type": "formula",
          "as": "queue",
          "expr": "datum._source.primary_queue"
        },
        {
          "type": "formula",
          "as": "queues",
          "expr": "join(datum._source.queues, ' → ')"
        },
        {
          "type": "formula",
          "as": "description",
          "expr": "datum._source.process.description"
        },
        {
          "type": "formula",
          "as": "tags",
          "expr": "datum._source.process.tags"
        },
        {
          "type": "formula",
          "as": "smv",
          "expr": "datum._source.process.smv_minutes"
        },
        {
          "type": "formula",
          "as": "grade",
          "expr": "datum._source.process.grade"
        },
        {
          "type": "formula",
          "as": "gradeName",
          "expr": "datum._source.process.grade_name"
        },
        {
          "type": "formula",
          "as": "rate",
          "expr": "datum._source.process.current_rate_gbp"
        },
        {
          "type": "formula",
          "as": "rateOff",
          "expr": "datum._source.process.current_rate_offshore_gbp"
        },
        {
          "type": "formula",
          "as": "offShare",
          "expr": "datum._source.process.offshore_share || 0"
        },
        {
          "type": "formula",
          "as": "slaHours",
          "expr": "datum._source.process.sla_hours"
        }
      ]
    },
    {
      "name": "hm_raw",
      "url": {
        "index": "ia-workqueue-items",
        "body": {
          "size": 0,
          "query": {
            "bool": {
              "must": [
                "%dashboard_context-must_clause%",
                {
                  "range": {
                    "outcome_date": {
                      "gt": {
                        "%timefilter%": "min",
                        "shift": -23,
                        "unit": "hour"
                      },
                      "format": "epoch_millis"
                    }
                  }
                },
                {
                  "range": {
                    "@timestamp": {
                      "lte": {
                        "%timefilter%": "max"
                      },
                      "format": "epoch_millis"
                    }
                  }
                }
              ],
              "filter": [
                "%dashboard_context-filter_clause%"
              ],
              "must_not": [
                "%dashboard_context-must_not_clause%"
              ]
            }
          },
          "aggs": {
            "m": {
              "filter": {
                "term": {
                  "mapped": true
                }
              },
              "aggs": {
                "p": {
                  "terms": {
                    "field": "process.name",
                    "size": 100
                  },
                  "aggs": {
                    "a": {
                      "sum": {
                        "field": "n.attempt"
                      }
                    },
                    "x": {
                      "filter": {
                        "term": {
                          "outcome": "Exception"
                        }
                      },
                      "aggs": {
                        "r": {
                          "terms": {
                            "field": "exception.reason_display",
                            "size": 100
                          },
                          "aggs": {
                            "t": {
                              "terms": {
                                "field": "exception.type",
                                "size": 1
                              }
                            },
                            "k": {
                              "terms": {
                                "field": "exception.code",
                                "size": 1
                              }
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      },
      "format": {
        "property": "aggregations.m.p.buckets"
      }
    },
    {
      "name": "rows",
      "source": "hm_raw",
      "transform": [
        {
          "type": "formula",
          "as": "name",
          "expr": "datum.key"
        },
        {
          "type": "formula",
          "as": "attempts",
          "expr": "datum.a.value"
        },
        {
          "type": "formula",
          "as": "total",
          "expr": "datum.x.doc_count"
        },
        {
          "type": "lookup",
          "from": "procs",
          "key": "name",
          "fields": [
            "name"
          ],
          "as": [
            "ref"
          ]
        },
        {
          "type": "formula",
          "as": "spokeColor",
          "expr": "datum.ref ? datum.ref.spokeColor : '#5F6E69'"
        },
        {
          "type": "collect",
          "sort": {
            "field": "attempts",
            "order": "descending"
          }
        },
        {
          "type": "window",
          "ops": [
            "row_number"
          ],
          "as": [
            "ri"
          ]
        }
      ]
    },
    {
      "name": "rowsum",
      "source": "rows",
      "transform": [
        {
          "type": "aggregate",
          "ops": [
            "sum"
          ],
          "fields": [
            "total"
          ],
          "as": [
            "total"
          ]
        }
      ]
    },
    {
      "name": "cells",
      "source": "hm_raw",
      "transform": [
        {
          "type": "flatten",
          "fields": [
            "x.r.buckets"
          ],
          "as": [
            "c"
          ]
        },
        {
          "type": "formula",
          "as": "process",
          "expr": "datum.key"
        },
        {
          "type": "formula",
          "as": "reason",
          "expr": "datum.c.key"
        },
        {
          "type": "formula",
          "as": "v",
          "expr": "datum.c.doc_count"
        },
        {
          "type": "formula",
          "as": "type",
          "expr": "datum.c.t.buckets[0].key"
        },
        {
          "type": "formula",
          "as": "code",
          "expr": "datum.c.k.buckets[0].key"
        },
        {
          "type": "project",
          "fields": [
            "process",
            "reason",
            "v",
            "type",
            "code"
          ]
        }
      ]
    },
    {
      "name": "cols",
      "source": "cells",
      "transform": [
        {
          "type": "aggregate",
          "groupby": [
            "reason",
            "code",
            "type"
          ],
          "ops": [
            "sum"
          ],
          "fields": [
            "v"
          ],
          "as": [
            "total"
          ]
        },
        {
          "type": "formula",
          "as": "ord",
          "expr": "(datum.type === 'System' ? 0 : 1e9) - datum.total"
        },
        {
          "type": "collect",
          "sort": {
            "field": "ord"
          }
        }
      ]
    }
  ],
  "scales": [
    {
      "name": "hx",
      "type": "band",
      "domain": {
        "data": "cols",
        "field": "reason",
        "sort": {
          "field": "ord",
          "op": "min"
        }
      },
      "range": [
        0,
        {
          "signal": "cw - labelW - totW"
        }
      ],
      "paddingInner": 0.04
    },
    {
      "name": "hy",
      "type": "band",
      "domain": {
        "data": "rows",
        "field": "name",
        "sort": {
          "field": "ri",
          "op": "min"
        }
      },
      "range": [
        0,
        {
          "signal": "rowH * length(data('rows'))"
        }
      ],
      "paddingInner": 0.08
    }
  ],
  "marks": [
    {
      "type": "text",
      "name": "frame_title",
      "encode": {
        "update": {
          "x": {
            "value": 16
          },
          "y": {
            "value": 18
          },
          "baseline": {
            "value": "top"
          },
          "font": {
            "value": "'Roboto Mono', Menlo, Consolas, monospace"
          },
          "fontSize": {
            "value": 11
          },
          "fontWeight": {
            "value": 600
          },
          "fill": {
            "value": "#0F4D43"
          },
          "text": {
            "signal": "'EXCEPTION HEATMAP'"
          },
          "limit": {
            "signal": "width - 32"
          }
        }
      }
    },
    {
      "type": "text",
      "encode": {
        "update": {
          "x": {
            "signal": "16 + length('EXCEPTION HEATMAP') * 6.9 + 10"
          },
          "y": {
            "value": 17
          },
          "baseline": {
            "value": "top"
          },
          "font": {
            "value": "Inter, 'Segoe UI', system-ui, -apple-system, sans-serif"
          },
          "fontSize": {
            "value": 12
          },
          "fill": {
            "value": "#5F6E69"
          },
          "text": {
            "value": "Volume by process (rows) and exception reason (columns). Stronger colour means more; hover a cell for the full reason. Click a process or a reason code to filter."
          },
          "limit": {
            "signal": "width - 42 - length('EXCEPTION HEATMAP') * 6.9 - 0 - headerRight"
          }
        }
      }
    },
    {
      "type": "group",
      "encode": {
        "update": {
          "x": {
            "signal": "16 + labelW"
          },
          "y": {
            "signal": "top + 20"
          },
          "width": {
            "signal": "cw - labelW - totW"
          },
          "height": {
            "signal": "rowH * length(data('rows'))"
          }
        }
      },
      "marks": [
        {
          "type": "text",
          "name": "hm_col",
          "from": {
            "data": "cols"
          },
          "encode": {
            "update": {
              "cursor": {
                "value": "pointer"
              },
              "x": {
                "scale": "hx",
                "field": "reason",
                "band": 0.5
              },
              "y": {
                "value": -6
              },
              "align": {
                "value": "center"
              },
              "font": {
                "value": "'Roboto Mono', Menlo, Consolas, monospace"
              },
              "fontSize": {
                "value": 10
              },
              "fontWeight": {
                "value": 600
              },
              "fill": {
                "signal": "datum.type === 'System' ? '#B6462F' : '#B9852C'"
              },
              "text": {
                "field": "code"
              },
              "tooltip": {
                "signal": "datum.reason + ' (' + datum.type + ') · click to filter to this reason'"
              }
            }
          }
        },
        {
          "type": "rect",
          "from": {
            "data": "cells"
          },
          "encode": {
            "update": {
              "x": {
                "scale": "hx",
                "field": "reason"
              },
              "width": {
                "scale": "hx",
                "band": 1
              },
              "y": {
                "scale": "hy",
                "field": "process"
              },
              "height": {
                "scale": "hy",
                "band": 1
              },
              "cornerRadius": {
                "value": 3
              },
              "fill": {
                "signal": "datum.type === 'System' ? '#B6462F' : '#B9852C'"
              },
              "fillOpacity": {
                "signal": "datum.v ? 0.12 + 0.8 * datum.v / cellMax : 0"
              },
              "tooltip": {
                "signal": "{'Process': datum.process, 'Reason': datum.reason, 'Exceptions': (isValid((datum.v)) && isFinite((datum.v)) ? format((datum.v), ',.0f') : '–')}"
              }
            }
          }
        },
        {
          "type": "text",
          "interactive": false,
          "from": {
            "data": "cells"
          },
          "encode": {
            "update": {
              "x": {
                "scale": "hx",
                "field": "reason",
                "band": 0.5
              },
              "y": {
                "scale": "hy",
                "field": "process",
                "band": 0.5
              },
              "align": {
                "value": "center"
              },
              "baseline": {
                "value": "middle"
              },
              "font": {
                "value": "'Roboto Mono', Menlo, Consolas, monospace"
              },
              "fontSize": {
                "value": 10.5
              },
              "fontWeight": {
                "value": 600
              },
              "fill": {
                "signal": "datum.v / cellMax > 0.55 ? '#FFFFFF' : '#5F6E69'"
              },
              "text": {
                "signal": "datum.v > 0 ? (isValid((datum.v)) && isFinite((datum.v)) ? (abs((datum.v)) >= 1e6 ? format((datum.v) / 1e6, abs((datum.v)) >= 1e7 ? '.0f' : '.1f') + 'M' : abs((datum.v)) >= 1e3 ? format((datum.v) / 1e3, abs((datum.v)) >= 1e4 ? '.0f' : '.1f') + 'k' : format((datum.v), '.0f')) : '–') : ''"
              }
            }
          }
        }
      ]
    },
    {
      "type": "group",
      "name": "hm_label",
      "from": {
        "data": "rows"
      },
      "encode": {
        "update": {
          "x": {
            "value": 16
          },
          "y": {
            "signal": "top + 20 + scale('hy', datum.name)"
          },
          "width": {
            "signal": "labelW - 6"
          },
          "height": {
            "signal": "bandwidth('hy')"
          },
          "fill": {
            "value": "transparent"
          },
          "cursor": {
            "value": "pointer"
          }
        },
        "hover": {
          "fill": {
            "value": "#F7F6F2"
          }
        }
      },
      "marks": [
        {
          "type": "rect",
          "encode": {
            "update": {
              "x": {
                "value": 2
              },
              "y": {
                "signal": "item.mark.group.height / 2 - 4"
              },
              "width": {
                "value": 8
              },
              "height": {
                "value": 8
              },
              "cornerRadius": {
                "value": 2
              },
              "fill": {
                "field": {
                  "parent": "spokeColor"
                }
              }
            }
          }
        },
        {
          "type": "text",
          "encode": {
            "update": {
              "x": {
                "value": 16
              },
              "y": {
                "signal": "item.mark.group.height / 2"
              },
              "baseline": {
                "value": "middle"
              },
              "font": {
                "value": "Inter, 'Segoe UI', system-ui, -apple-system, sans-serif"
              },
              "fontSize": {
                "value": 12
              },
              "fill": {
                "value": "#0F4D43"
              },
              "text": {
                "field": {
                  "parent": "name"
                }
              },
              "limit": {
                "signal": "labelW - 24"
              }
            }
          }
        }
      ]
    },
    {
      "type": "group",
      "from": {
        "data": "rows"
      },
      "encode": {
        "update": {
          "x": {
            "signal": "16 + cw - totW + 8"
          },
          "y": {
            "signal": "top + 20 + scale('hy', datum.name)"
          },
          "width": {
            "signal": "totW - 8"
          },
          "height": {
            "signal": "bandwidth('hy')"
          }
        }
      },
      "marks": [
        {
          "type": "rect",
          "encode": {
            "update": {
              "x": {
                "value": 0
              },
              "y": {
                "signal": "item.mark.group.height / 2 - 3.5"
              },
              "width": {
                "signal": "item.mark.group.width - 34"
              },
              "height": {
                "value": 7
              },
              "cornerRadius": {
                "value": 3
              },
              "fill": {
                "value": "#E6E8E2"
              }
            }
          }
        },
        {
          "type": "rect",
          "encode": {
            "update": {
              "x": {
                "value": 0
              },
              "y": {
                "signal": "item.mark.group.height / 2 - 3.5"
              },
              "width": {
                "signal": "max(2, (item.mark.group.width - 34) * parent.total / rowMax)"
              },
              "height": {
                "value": 7
              },
              "cornerRadius": {
                "value": 3
              },
              "fill": {
                "value": "#0F4D43"
              }
            }
          }
        },
        {
          "type": "text",
          "encode": {
            "update": {
              "x": {
                "signal": "item.mark.group.width"
              },
              "y": {
                "signal": "item.mark.group.height / 2"
              },
              "align": {
                "value": "right"
              },
              "baseline": {
                "value": "middle"
              },
              "font": {
                "value": "'Roboto Mono', Menlo, Consolas, monospace"
              },
              "fontSize": {
                "value": 10.5
              },
              "fontWeight": {
                "value": 600
              },
              "fill": {
                "value": "#0F4D43"
              },
              "text": {
                "signal": "(isValid((parent.total)) && isFinite((parent.total)) ? (abs((parent.total)) >= 1e6 ? format((parent.total) / 1e6, abs((parent.total)) >= 1e7 ? '.0f' : '.1f') + 'M' : abs((parent.total)) >= 1e3 ? format((parent.total) / 1e3, abs((parent.total)) >= 1e4 ? '.0f' : '.1f') + 'k' : format((parent.total), '.0f')) : '–')"
              }
            }
          }
        }
      ]
    },
    {
      "type": "text",
      "encode": {
        "update": {
          "x": {
            "signal": "16 + cw"
          },
          "y": {
            "signal": "top + 14"
          },
          "align": {
            "value": "right"
          },
          "font": {
            "value": "'Roboto Mono', Menlo, Consolas, monospace"
          },
          "fontSize": {
            "value": 10
          },
          "fontWeight": {
            "value": 600
          },
          "fill": {
            "value": "#5F6E69"
          },
          "text": {
            "value": "TOTAL"
          }
        }
      }
    },
    {
      "type": "rule",
      "encode": {
        "update": {
          "x": {
            "value": 16
          },
          "x2": {
            "signal": "width - 16"
          },
          "y": {
            "signal": "top + 24 + rowH * length(data('rows'))"
          },
          "stroke": {
            "value": "#D6D9D2"
          }
        }
      }
    },
    {
      "type": "text",
      "encode": {
        "update": {
          "x": {
            "value": 20
          },
          "y": {
            "signal": "top + 38 + rowH * length(data('rows'))"
          },
          "baseline": {
            "value": "middle"
          },
          "font": {
            "value": "Inter, 'Segoe UI', system-ui, -apple-system, sans-serif"
          },
          "fontSize": {
            "value": 12
          },
          "fontWeight": {
            "value": 600
          },
          "fill": {
            "value": "#5F6E69"
          },
          "text": {
            "value": "Total"
          }
        }
      }
    },
    {
      "type": "text",
      "from": {
        "data": "cols"
      },
      "encode": {
        "update": {
          "x": {
            "signal": "16 + labelW + scale('hx', datum.reason) + bandwidth('hx') / 2"
          },
          "y": {
            "signal": "top + 38 + rowH * length(data('rows'))"
          },
          "align": {
            "value": "center"
          },
          "baseline": {
            "value": "middle"
          },
          "font": {
            "value": "'Roboto Mono', Menlo, Consolas, monospace"
          },
