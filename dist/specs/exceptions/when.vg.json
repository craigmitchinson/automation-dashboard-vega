{
  "$schema": "https://vega.github.io/schema/vega/v5.json",
  "description": "IA · Exceptions · When exceptions happen. Generated by vega/build.mjs from vega/panels/exceptions.mjs, do not edit by hand.",
  "autosize": {
    "type": "fit",
    "contains": "padding"
  },
  "padding": 0,
  "config": {
    "background": "#FFFFFF",
    "padding": 0,
    "font": "Inter, 'Segoe UI', system-ui, -apple-system, sans-serif",
    "text": {
      "font": "Inter, 'Segoe UI', system-ui, -apple-system, sans-serif",
      "fill": "#0F4D43",
      "fontSize": 12
    },
    "axis": {
      "gridColor": "#E6E8E2",
      "labelFont": "'Roboto Mono', Menlo, Consolas, monospace",
      "labelFontSize": 10,
      "labelColor": "#5F6E69",
      "titleFont": "'Roboto Mono', Menlo, Consolas, monospace",
      "titleColor": "#5F6E69",
      "titleFontSize": 10,
      "titleFontWeight": 400,
      "domain": false,
      "ticks": false,
      "gridWidth": 1,
      "labelPadding": 6
    },
    "style": {
      "guide-label": {
        "font": "'Roboto Mono', Menlo, Consolas, monospace"
      }
    },
    "view": {
      "stroke": null
    },
    "kibana": {
      "renderer": "svg",
      "hideWarnings": true
    }
  },
  "signals": [
    {
      "name": "headerRight",
      "value": 0
    },
    {
      "name": "top",
      "value": 42
    },
    {
      "name": "cw",
      "update": "width - 32"
    },
    {
      "name": "ch",
      "update": "height - top - 16"
    },
    {
      "name": "whenBy",
      "value": "hour",
      "on": [
        {
          "events": "@seg_whenBy_0:click",
          "update": "'hour'"
        },
        {
          "events": "@seg_whenBy_1:click",
          "update": "'weekday'"
        }
      ]
    },
    {
      "name": "labelW",
      "update": "clamp(cw * 0.24, 150, 260)"
    },
    {
      "name": "totW",
      "value": 70
    },
    {
      "name": "nRows",
      "update": "length(data('wr'))"
    },
    {
      "name": "rowH",
      "update": "nRows ? clamp((ch - 34) / nRows, 14, 30) : 20"
    },
    {
      "name": "pickW",
      "on": [
        {
          "events": "@wh_label:click",
          "update": "kibanaAddFilter({'match_phrase': {'exception.reason_display': datum.name}}, 'ia-workqueue-items*')"
        }
      ]
    }
  ],
  "data": [
    {
      "name": "wh_raw",
      "url": {
        "%context%": true,
        "%timefield%": "@timestamp",
        "index": "ia-workqueue-items",
        "body": {
          "size": 0,
          "aggs": {
            "m": {
              "filter": {
                "bool": {
                  "filter": [
                    {
                      "term": {
                        "mapped": true
                      }
                    },
                    {
                      "term": {
                        "n.exception": 1
                      }
                    }
                  ]
                }
              },
              "aggs": {
                "p": {
                  "terms": {
                    "field": "exception.reason_display",
                    "size": 12
                  },
                  "aggs": {
                    "ty": {
                      "terms": {
                        "field": "exception.type",
                        "size": 1
                      }
                    },
                    "hr": {
                      "terms": {
                        "field": "outcome_hour",
                        "size": 24
                      },
                      "aggs": {}
                    },
                    "dw": {
                      "terms": {
                        "field": "outcome_weekday",
                        "size": 7
                      },
                      "aggs": {}
                    }
                  }
                }
              }
            }
          }
        }
      },
      "format": {
        "property": "aggregations.m.p.buckets"
      }
    },
    {
      "name": "wr",
      "source": "wh_raw",
      "transform": [
        {
          "type": "formula",
          "as": "name",
          "expr": "datum.key"
        },
        {
          "type": "formula",
          "as": "tot",
          "expr": "datum.doc_count"
        },
        {
          "type": "formula",
          "as": "type",
          "expr": "length(datum.ty.buckets) ? datum.ty.buckets[0].key : ''"
        },
        {
          "type": "window",
          "ops": [
            "row_number"
          ],
          "as": [
            "ri"
          ]
        }
      ]
    },
    {
      "name": "wc",
      "source": "wr",
      "transform": [
        {
          "type": "formula",
          "as": "bk",
          "expr": "whenBy === 'hour' ? datum.hr.buckets : datum.dw.buckets"
        },
        {
          "type": "flatten",
          "fields": [
            "bk"
          ],
          "as": [
            "b"
          ]
        },
        {
          "type": "formula",
          "as": "col",
          "expr": "datum.b.key"
        },
        {
          "type": "formula",
          "as": "v",
          "expr": "datum.b.doc_count"
        },
        {
          "type": "project",
          "fields": [
            "name",
            "ri",
            "col",
            "v",
            "tot",
            "type"
          ]
        }
      ]
    },
    {
      "name": "wcols",
      "transform": [
        {
          "type": "sequence",
          "start": 0,
          "stop": 24,
          "as": "i"
        },
        {
          "type": "formula",
          "as": "col",
          "expr": "whenBy === 'hour' ? datum.i : datum.i + 1"
        },
        {
          "type": "filter",
          "expr": "whenBy === 'hour' || datum.i < 7"
        }
      ]
    },
    {
      "name": "wmax",
      "source": "wc",
      "transform": [
        {
          "type": "aggregate",
          "ops": [
            "max"
          ],
          "fields": [
            "v"
          ],
          "as": [
            "m"
          ]
        }
      ]
    }
  ],
  "scales": [
    {
      "name": "wx",
      "type": "band",
      "domain": {
        "data": "wcols",
        "field": "col",
        "sort": true
      },
      "range": [
        0,
        {
          "signal": "cw - labelW - totW"
        }
      ],
      "paddingInner": 0.06
    }
  ],
  "marks": [
    {
      "type": "text",
      "name": "frame_title",
      "encode": {
        "update": {
          "x": {
            "value": 16
          },
          "y": {
            "value": 18
          },
          "baseline": {
            "value": "top"
          },
          "font": {
            "value": "'Roboto Mono', Menlo, Consolas, monospace"
          },
          "fontSize": {
            "value": 11
          },
          "fontWeight": {
            "value": 600
          },
          "fill": {
            "value": "#0F4D43"
          },
          "text": {
            "signal": "'WHEN EXCEPTIONS HAPPEN'"
          },
          "limit": {
            "signal": "width - 32"
          }
        }
      }
    },
    {
      "type": "text",
      "encode": {
        "update": {
          "x": {
            "signal": "16 + length('WHEN EXCEPTIONS HAPPEN') * 6.9 + 10"
          },
          "y": {
            "value": 17
          },
          "baseline": {
            "value": "top"
          },
          "font": {
            "value": "Inter, 'Segoe UI', system-ui, -apple-system, sans-serif"
          },
          "fontSize": {
            "value": 12
          },
          "fill": {
            "value": "#5F6E69"
          },
          "text": {
            "signal": "'Top reasons by ' + (whenBy === 'hour' ? 'hour of day (UTC)' : 'day of week') + ' · system reasons bunched into a few hours usually mean a target system window · click a reason to filter'"
          },
          "limit": {
            "signal": "width - 42 - length('WHEN EXCEPTIONS HAPPEN') * 6.9 - 0 - headerRight"
          }
        }
      }
    },
    {
      "type": "group",
      "encode": {
        "update": {
          "x": {
            "signal": "16 + labelW"
          },
          "y": {
            "signal": "top + 20"
          },
          "width": {
            "signal": "cw - labelW - totW"
          },
          "height": {
            "signal": "rowH * nRows"
          }
        }
      },
      "marks": [
        {
          "type": "text",
          "from": {
            "data": "wcols"
          },
          "encode": {
            "update": {
              "x": {
                "scale": "wx",
                "field": "col",
                "band": 0.5
              },
              "y": {
                "value": -6
              },
              "align": {
                "value": "center"
              },
              "font": {
                "value": "'Roboto Mono', Menlo, Consolas, monospace"
              },
              "fontSize": {
                "value": 10
              },
              "fill": {
                "value": "#5F6E69"
              },
              "text": {
                "signal": "whenBy === 'hour' ? pad('' + datum.col, 2, '0', 'left') : ['Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat', 'Sun'][datum.col - 1]"
              }
            }
          }
        },
        {
          "type": "rect",
          "from": {
            "data": "wc"
          },
          "encode": {
            "update": {
              "x": {
                "scale": "wx",
                "field": "col"
              },
              "width": {
                "scale": "wx",
                "band": 1
              },
              "y": {
                "signal": "(datum.ri - 1) * rowH + 1"
              },
              "height": {
                "signal": "rowH - 2"
              },
              "cornerRadius": {
                "value": 3
              },
              "fill": {
                "signal": "datum.type === 'System' ? '#B6462F' : '#B9852C'"
              },
              "fillOpacity": {
                "signal": "length(data('wmax')) && data('wmax')[0].m ? 0.06 + 0.86 * datum.v / data('wmax')[0].m : 0"
              },
              "tooltip": {
                "signal": "{'': datum.name, 'When': whenBy === 'hour' ? pad('' + datum.col, 2, '0', 'left') + ':00 UTC' : ['Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat', 'Sun'][datum.col - 1], 'Exceptions': format(datum.v, ',.1f'), 'Share of its total': (isValid((datum.v / datum.tot)) && isFinite((datum.v / datum.tot)) ? format((datum.v / datum.tot) * 100, '.1f') + '%' : '–')}"
              }
            }
          }
        }
      ]
    },
    {
      "type": "rect",
      "from": {
        "data": "wr"
      },
      "encode": {
        "update": {
          "x": {
            "value": 16
          },
          "y": {
            "signal": "top + 20 + (datum.ri - 0.5) * rowH - 5"
          },
          "width": {
            "value": 10
          },
          "height": {
            "value": 10
          },
          "cornerRadius": {
            "value": 3
          },
          "fill": {
            "signal": "datum.type === 'System' ? '#B6462F' : '#B9852C'"
          }
        }
      }
    },
    {
      "type": "text",
      "name": "wh_label",
      "from": {
        "data": "wr"
      },
      "encode": {
        "update": {
          "x": {
            "value": 32
          },
          "y": {
            "signal": "top + 20 + (datum.ri - 0.5) * rowH"
          },
          "baseline": {
            "value": "middle"
          },
          "font": {
            "value": "Inter, 'Segoe UI', system-ui, -apple-system, sans-serif"
          },
          "fontSize": {
            "value": 12
          },
          "fill": {
            "value": "#0F4D43"
          },
          "text": {
            "field": "name"
          },
          "limit": {
            "signal": "labelW - 26"
          },
          "cursor": {
            "value": "pointer"
          },
          "tooltip": {
            "signal": "'Click to filter to ' + datum.name"
          }
        }
      }
    },
    {
      "type": "text",
      "from": {
        "data": "wr"
      },
      "encode": {
        "update": {
          "x": {
            "signal": "16 + cw"
          },
          "y": {
            "signal": "top + 20 + (datum.ri - 0.5) * rowH"
          },
          "align": {
            "value": "right"
          },
          "baseline": {
            "value": "middle"
          },
          "font": {
            "value": "'Roboto Mono', Menlo, Consolas, monospace"
          },
          "fontSize": {
            "value": 11
          },
          "fontWeight": {
            "value": 600
          },
          "fill": {
            "value": "#0F4D43"
          },
          "text": {
            "signal": "(isValid((datum.tot)) && isFinite((datum.tot)) ? format((datum.tot), ',.0f') : '–')"
          }
        }
      }
    },
    {
      "type": "text",
      "encode": {
        "update": {
          "x": {
            "signal": "16 + cw"
          },
          "y": {
            "signal": "top + 14"
          },
          "align": {
            "value": "right"
          },
          "font": {
            "value": "'Roboto Mono', Menlo, Consolas, monospace"
          },
          "fontSize": {
            "value": 10
          },
          "fontWeight": {
            "value": 600
          },
          "fill": {
            "value": "#5F6E69"
          },
          "text": {
            "value": "EXCEPTIONS"
          }
        }
      }
    },
    {
      "type": "text",
      "encode": {
        "update": {
          "x": {
            "signal": "width / 2"
          },
          "y": {
            "signal": "top + ch / 2"
          },
          "align": {
            "value": "center"
          },
          "baseline": {
            "value": "middle"
          },
          "font": {
            "value": "Inter, 'Segoe UI', system-ui, -apple-system, sans-serif"
          },
          "fontSize": {
            "value": 13
          },
          "fill": {
            "value": "#5F6E69"
          },
          "text": {
            "value": "Nothing in this selection"
          },
          "opacity": {
            "signal": "(!nRows) ? 1 : 0"
          }
        }
      }
    }
  ]
}
