{
  "$schema": "https://vega.github.io/schema/vega/v5.json",
  "description": "IA · Value & Finance · Masthead. Generated by vega/build.mjs from vega/panels/value-finance.mjs, do not edit by hand.",
  "autosize": {
    "type": "fit",
    "contains": "padding"
  },
  "padding": 0,
  "config": {
    "background": "#FFFFFF",
    "padding": 0,
    "font": "Inter, 'Segoe UI', system-ui, -apple-system, sans-serif",
    "text": {
      "font": "Inter, 'Segoe UI', system-ui, -apple-system, sans-serif",
      "fill": "#0F4D43",
      "fontSize": 12
    },
    "axis": {
      "gridColor": "#E6E8E2",
      "labelFont": "'Roboto Mono', Menlo, Consolas, monospace",
      "labelFontSize": 10,
      "labelColor": "#5F6E69",
      "titleFont": "'Roboto Mono', Menlo, Consolas, monospace",
      "titleColor": "#5F6E69",
      "titleFontSize": 10,
      "titleFontWeight": 400,
      "domain": false,
      "ticks": false,
      "gridWidth": 1,
      "labelPadding": 6
    },
    "style": {
      "guide-label": {
        "font": "'Roboto Mono', Menlo, Consolas, monospace"
      }
    },
    "view": {
      "stroke": null
    },
    "kibana": {
      "renderer": "svg",
      "hideWarnings": true
    }
  },
  "signals": [
    {
      "name": "mockNote",
      "value": ""
    },
    {
      "name": "mhB",
      "update": "length(data('mh')) ? data('mh')[0] : null"
    },
    {
      "name": "mhDays",
      "update": "mhB ? length(mhB.win.buckets) : 0"
    },
    {
      "name": "mhLo",
      "update": "mhDays ? mhB.win.buckets[0].key : 0"
    },
    {
      "name": "mhHi",
      "update": "mhDays ? mhB.win.buckets[mhDays - 1].key + 86399999 : 0"
    },
    {
      "name": "mhNow",
      "update": "mhB ? mhB.nowb.buckets[0].from : 0"
    },
    {
      "name": "mhLast",
      "update": "mhB && mhB.last.value ? mhB.last.value : null"
    },
    {
      "name": "mhAllSp",
      "update": "length(data('mh_spk')) ? data('mh_spk')[0].value : 0"
    },
    {
      "name": "mhNsp",
      "update": "mhB ? mhB.nsp.value : 0"
    },
    {
      "name": "mhScope",
      "update": "!mhB || !mhNsp ? 'Nothing in this selection' : length(mhB.pr.buckets) === 1 ? mhB.pr.buckets[0].key : mhNsp === 1 ? mhB.sp.buckets[0].key : mhNsp >= mhAllSp ? 'All ' + mhNsp + ' hubs' : mhNsp + ' hubs'"
    },
    {
      "name": "mhFyStart",
      "update": "length(data('mh_cfg')) ? data('mh_cfg')[0]._source.fiscal_year_start_month : 4"
    },
    {
      "name": "mhFyY",
      "update": "utcmonth(mhHi) >= mhFyStart - 1 ? utcyear(mhHi) : utcyear(mhHi) - 1"
    },
    {
      "name": "mhFy",
      "update": "mhFyStart === 1 ? '' + mhFyY : mhFyY + '/' + pad('' + ((mhFyY + 1) % 100), 2, '0', 'left')"
    },
    {
      "name": "chipW",
      "update": "clamp(width * 0.16, 150, 230)"
    },
    {
      "name": "chipX",
      "update": "width - 3 * chipW - 6"
    }
  ],
  "data": [
    {
      "name": "mh",
      "url": {
        "%context%": true,
        "%timefield%": "@timestamp",
        "index": "ia-workqueue-items",
        "body": {
          "size": 0,
          "aggs": {
            "last": {
              "max": {
                "field": "@timestamp"
              }
            },
            "sp": {
              "terms": {
                "field": "spoke.name",
                "size": 3
              }
            },
            "nsp": {
              "cardinality": {
                "field": "spoke.name"
              }
            },
            "pr": {
              "terms": {
                "field": "process.name",
                "size": 2
              }
            },
            "nowb": {
              "date_range": {
                "field": "@timestamp",
                "ranges": [
                  {
                    "key": "now",
                    "from": {
                      "%timefilter%": "max"
                    }
                  }
                ]
              }
            },
            "win": {
              "date_histogram": {
                "field": "@timestamp",
                "fixed_interval": "1d",
                "min_doc_count": 0,
                "extended_bounds": {
                  "min": {
                    "%timefilter%": "min"
                  },
                  "max": {
                    "%timefilter%": "max"
                  }
                }
              }
            }
          }
        }
      },
      "format": {
        "property": "aggregations"
      }
    },
    {
      "name": "mh_spk",
      "url": {
        "index": "ia-reference",
        "body": {
          "size": 0,
          "query": {
            "term": {
              "doc_type": "spoke"
            }
          }
        }
      },
      "format": {
        "property": "hits.total"
      }
    },
    {
      "name": "mh_cfg",
      "url": {
        "index": "ia-reference",
        "body": {
          "size": 1,
          "query": {
            "term": {
              "doc_type": "config"
            }
          }
        }
      },
      "format": {
        "property": "hits.hits"
      }
    }
  ],
  "marks": [
    {
      "type": "rect",
      "encode": {
        "update": {
          "x": {
            "value": 0
          },
          "y": {
            "value": 0
          },
          "width": {
            "signal": "width"
          },
          "height": {
            "signal": "height"
          },
          "cornerRadius": {
            "value": 16
          },
          "fill": {
            "value": "#0F4D43"
          }
        }
      }
    },
    {
      "type": "group",
      "encode": {
        "update": {
          "x": {
            "value": 0
          },
          "y": {
            "value": 0
          },
          "width": {
            "signal": "width"
          },
          "height": {
            "signal": "height"
          },
          "clip": {
            "value": true
          }
        }
      },
      "marks": [
        {
          "type": "arc",
          "encode": {
            "update": {
              "x": {
                "signal": "width - 60"
              },
              "y": {
                "signal": "height + 30"
              },
              "innerRadius": {
                "signal": "height * 1.1"
              },
              "outerRadius": {
                "signal": "height * 1.1 + 1.2"
              },
              "startAngle": {
                "value": -1.5707963267948966
              },
              "endAngle": {
                "value": 0
              },
              "fill": {
                "value": "#FFFFFF"
              },
              "fillOpacity": {
                "value": 0.07
              }
            }
          }
        },
        {
          "type": "arc",
          "encode": {
            "update": {
              "x": {
                "signal": "width - 100"
              },
              "y": {
                "signal": "height + 40"
              },
              "innerRadius": {
                "signal": "height * 1.6500000000000001"
              },
              "outerRadius": {
                "signal": "height * 1.6500000000000001 + 1.2"
              },
              "startAngle": {
                "value": -1.5707963267948966
              },
              "endAngle": {
                "value": 0
              },
              "fill": {
                "value": "#FFFFFF"
              },
              "fillOpacity": {
                "value": 0.07
              }
            }
          }
        }
      ]
    },
    {
      "type": "rect",
      "encode": {
        "update": {
          "x": {
            "value": 24
          },
          "y": {
            "signal": "height / 2 - 31"
          },
          "width": {
            "value": 18
          },
          "height": {
            "value": 3
          },
          "cornerRadius": {
            "value": 1.5
          },
          "fill": {
            "value": "#B9852C"
          }
        }
      }
    },
    {
      "type": "text",
      "encode": {
        "update": {
          "x": {
            "value": 50
          },
          "y": {
            "signal": "height / 2 - 30"
          },
          "baseline": {
            "value": "middle"
          },
          "font": {
            "value": "'Roboto Mono', Menlo, Consolas, monospace"
          },
          "fontSize": {
            "value": 10
          },
          "fontWeight": {
            "value": 600
          },
          "fill": {
            "value": "#8FB3A6"
          },
          "text": {
            "value": "MONEY · 10 OF 10"
          }
        }
      }
    },
    {
      "type": "text",
      "encode": {
        "update": {
          "x": {
            "value": 24
          },
          "y": {
            "signal": "height / 2 - 4"
          },
          "baseline": {
            "value": "middle"
          },
          "font": {
            "value": "Inter, 'Segoe UI', system-ui, -apple-system, sans-serif"
          },
          "fontSize": {
            "value": 26
          },
          "fontWeight": {
            "value": 650
          },
          "fill": {
            "value": "#FFFFFF"
          },
          "text": {
            "value": "Value & Finance"
          },
          "limit": {
            "signal": "chipX - 60"
          }
        }
      }
    },
    {
      "type": "text",
      "encode": {
        "update": {
          "x": {
            "value": 24
          },
          "y": {
            "signal": "height / 2 + 24"
          },
          "baseline": {
            "value": "middle"
          },
          "font": {
            "value": "Inter, 'Segoe UI', system-ui, -apple-system, sans-serif"
          },
          "fontSize": {
            "value": 13
          },
          "fill": {
            "value": "#BFD6CC"
          },
          "text": {
            "value": "What the automation is worth, what it costs and where the value comes from"
          },
          "limit": {
            "signal": "chipX - 60"
          }
        }
      }
    },
    {
      "type": "text",
      "encode": {
        "update": {
          "x": {
            "signal": "width - 24"
          },
          "y": {
            "value": 18
          },
          "align": {
            "value": "right"
          },
          "baseline": {
            "value": "middle"
          },
          "font": {
            "value": "'Roboto Mono', Menlo, Consolas, monospace"
          },
          "fontSize": {
            "value": 9.5
          },
          "fontWeight": {
            "value": 600
          },
          "fill": {
            "value": "#B9852C"
          },
          "text": {
            "signal": "mockNote"
          }
        }
      }
    },
    {
      "type": "text",
      "encode": {
        "update": {
          "x": {
            "signal": "chipX + 0 * chipW"
          },
          "y": {
            "signal": "height / 2 - 10"
          },
          "baseline": {
            "value": "middle"
          },
          "font": {
            "value": "'Roboto Mono', Menlo, Consolas, monospace"
          },
          "fontSize": {
            "value": 9.5
          },
          "fontWeight": {
            "value": 600
          },
          "fill": {
            "value": "#8FB3A6"
          },
          "text": {
            "value": "PERIOD"
          }
        }
      }
    },
    {
      "type": "text",
      "encode": {
        "update": {
          "x": {
            "signal": "chipX + 0 * chipW"
          },
          "y": {
            "signal": "height / 2 + 9"
          },
          "baseline": {
            "value": "middle"
          },
          "font": {
            "value": "Inter, 'Segoe UI', system-ui, -apple-system, sans-serif"
          },
          "fontSize": {
            "value": 13.5
          },
          "fontWeight": {
            "value": 600
          },
          "fill": {
            "value": "#FFFFFF"
          },
          "text": {
            "signal": "utcFormat(mhLo, '%-d %b') + ' to ' + utcFormat(mhHi, '%-d %b %Y') + ' · ' + mhDays + ' days'"
          },
          "limit": {
            "signal": "chipW - 16"
          }
        }
      }
    },
    {
      "type": "text",
      "encode": {
        "update": {
          "x": {
            "signal": "chipX + 1 * chipW"
          },
          "y": {
            "signal": "height / 2 - 10"
          },
          "baseline": {
            "value": "middle"
          },
          "font": {
            "value": "'Roboto Mono', Menlo, Consolas, monospace"
          },
          "fontSize": {
            "value": 9.5
          },
          "fontWeight": {
            "value": 600
          },
          "fill": {
            "value": "#8FB3A6"
          },
          "text": {
            "value": "SCOPE"
          }
        }
      }
    },
    {
      "type": "text",
      "encode": {
        "update": {
          "x": {
            "signal": "chipX + 1 * chipW"
          },
          "y": {
            "signal": "height / 2 + 9"
          },
          "baseline": {
            "value": "middle"
          },
          "font": {
            "value": "Inter, 'Segoe UI', system-ui, -apple-system, sans-serif"
          },
          "fontSize": {
            "value": 13.5
          },
          "fontWeight": {
            "value": 600
          },
          "fill": {
            "value": "#FFFFFF"
          },
          "text": {
            "signal": "mhScope"
          },
          "limit": {
            "signal": "chipW - 16"
          }
        }
      }
    },
    {
      "type": "rule",
      "encode": {
        "update": {
          "x": {
            "signal": "chipX + 1 * chipW - 14"
          },
          "x2": {
            "signal": "chipX + 1 * chipW - 14"
          },
          "y": {
            "signal": "height / 2 - 18"
          },
          "y2": {
            "signal": "height / 2 + 18"
          },
          "stroke": {
            "value": "#FFFFFF"
          },
          "strokeOpacity": {
            "value": 0.16
          }
        }
      }
    },
    {
      "type": "text",
      "encode": {
        "update": {
          "x": {
            "signal": "chipX + 2 * chipW"
          },
          "y": {
            "signal": "height / 2 - 10"
          },
          "baseline": {
            "value": "middle"
          },
          "font": {
            "value": "'Roboto Mono', Menlo, Consolas, monospace"
          },
          "fontSize": {
            "value": 9.5
          },
          "fontWeight": {
            "value": 600
          },
          "fill": {
            "value": "#8FB3A6"
          },
          "text": {
            "value": "LATEST ITEM"
          }
        }
      }
    },
    {
      "type": "text",
      "encode": {
        "update": {
          "x": {
            "signal": "chipX + 2 * chipW"
          },
          "y": {
            "signal": "height / 2 + 9"
          },
          "baseline": {
            "value": "middle"
          },
          "font": {
            "value": "Inter, 'Segoe UI', system-ui, -apple-system, sans-serif"
          },
          "fontSize": {
            "value": 13.5
          },
          "fontWeight": {
            "value": 600
          },
          "fill": {
            "value": "#FFFFFF"
          },
          "text": {
            "signal": "isValid(mhLast) ? utcFormat(mhLast, '%-d %b, %H:%M UTC') : 'none in the period'"
          },
          "limit": {
            "signal": "chipW - 16"
          }
        }
      }
    },
    {
      "type": "rule",
      "encode": {
        "update": {
          "x": {
            "signal": "chipX + 2 * chipW - 14"
          },
          "x2": {
            "signal": "chipX + 2 * chipW - 14"
          },
          "y": {
            "signal": "height / 2 - 18"
          },
          "y2": {
            "signal": "height / 2 + 18"
          },
          "stroke": {
            "value": "#FFFFFF"
          },
          "strokeOpacity": {
            "value": 0.16
          }
        }
      }
    }
  ]
}
