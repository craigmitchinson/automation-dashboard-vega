    {
      "type": "rect",
      "encode": {
        "update": {
          "x": {
            "signal": "202"
          },
          "y": {
            "value": 58
          },
          "width": {
            "value": 11
          },
          "height": {
            "value": 11
          },
          "cornerRadius": {
            "value": 3
          },
          "fill": {
            "value": "#4A3AA7"
          }
        }
      }
    },
    {
      "type": "text",
