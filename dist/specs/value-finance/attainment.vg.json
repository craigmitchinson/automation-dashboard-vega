{
  "$schema": "https://vega.github.io/schema/vega/v5.json",
  "description": "IA · Value & Finance · FY target attainment. Generated by vega/build.mjs from vega/panels/value-finance.mjs, do not edit by hand.",
  "autosize": {
    "type": "fit",
    "contains": "padding"
  },
  "padding": 0,
  "config": {
    "background": "#FFFFFF",
    "padding": 0,
    "font": "Inter, 'Segoe UI', Carlito, Calibri, Arial, sans-serif",
    "text": {
      "font": "Inter, 'Segoe UI', Carlito, Calibri, Arial, sans-serif",
      "fill": "#0F4D43",
      "fontSize": 12
    },
    "axis": {
      "gridColor": "#E6E8E2",
      "labelFont": "'JetBrains Mono', Consolas, 'Roboto Mono', monospace",
      "labelFontSize": 10,
      "labelColor": "#5F6E69",
      "titleFont": "'JetBrains Mono', Consolas, 'Roboto Mono', monospace",
      "titleColor": "#5F6E69",
      "titleFontSize": 10,
      "titleFontWeight": 400,
      "domain": false,
      "ticks": false,
      "gridWidth": 1,
      "labelPadding": 6
    },
    "style": {
      "guide-label": {
        "font": "'JetBrains Mono', Consolas, 'Roboto Mono', monospace"
      }
    },
    "view": {
      "stroke": null
    },
    "kibana": {
      "renderer": "svg",
      "hideWarnings": true
    }
  },
  "signals": [
    {
      "name": "ndays",
      "update": "length(data('win'))"
    },
    {
      "name": "lo",
      "update": "ndays ? data('win')[0].key : 0"
    },
    {
      "name": "hi",
      "update": "ndays ? data('win')[ndays - 1].key : 0"
    },
    {
      "name": "plo",
      "update": "lo - ndays * 86400000"
    },
    {
      "name": "phi",
      "update": "lo - 86400000"
    },
    {
      "name": "oneSpoke",
      "update": "length(data('scope_spokes')) === 1 ? data('scope_spokes')[0].key : ''"
    },
    {
      "name": "tgt_completionPct",
      "update": "oneSpoke && indexof(pluck(data('tg'), 'k'), 'spoke|' + oneSpoke + '|completionPct') >= 0 ? data('tg')[indexof(pluck(data('tg'), 'k'), 'spoke|' + oneSpoke + '|completionPct')].v : (indexof(pluck(data('tg'), 'k'), 'global|completionPct') >= 0 ? data('tg')[indexof(pluck(data('tg'), 'k'), 'global|completionPct')].v : 0.95)"
    },
    {
      "name": "tgt_exceptionRate",
      "update": "oneSpoke && indexof(pluck(data('tg'), 'k'), 'spoke|' + oneSpoke + '|exceptionRate') >= 0 ? data('tg')[indexof(pluck(data('tg'), 'k'), 'spoke|' + oneSpoke + '|exceptionRate')].v : (indexof(pluck(data('tg'), 'k'), 'global|exceptionRate') >= 0 ? data('tg')[indexof(pluck(data('tg'), 'k'), 'global|exceptionRate')].v : 0.06)"
    },
    {
      "name": "tgt_systemRate",
      "update": "oneSpoke && indexof(pluck(data('tg'), 'k'), 'spoke|' + oneSpoke + '|systemRate') >= 0 ? data('tg')[indexof(pluck(data('tg'), 'k'), 'spoke|' + oneSpoke + '|systemRate')].v : (indexof(pluck(data('tg'), 'k'), 'global|systemRate') >= 0 ? data('tg')[indexof(pluck(data('tg'), 'k'), 'global|systemRate')].v : 0.03)"
    },
    {
      "name": "tgt_costPerCase",
      "update": "oneSpoke && indexof(pluck(data('tg'), 'k'), 'spoke|' + oneSpoke + '|costPerCase') >= 0 ? data('tg')[indexof(pluck(data('tg'), 'k'), 'spoke|' + oneSpoke + '|costPerCase')].v : (indexof(pluck(data('tg'), 'k'), 'global|costPerCase') >= 0 ? data('tg')[indexof(pluck(data('tg'), 'k'), 'global|costPerCase')].v : 9)"
    },
    {
      "name": "tgt_utilMin",
      "update": "oneSpoke && indexof(pluck(data('tg'), 'k'), 'spoke|' + oneSpoke + '|utilMin') >= 0 ? data('tg')[indexof(pluck(data('tg'), 'k'), 'spoke|' + oneSpoke + '|utilMin')].v : (indexof(pluck(data('tg'), 'k'), 'global|utilMin') >= 0 ? data('tg')[indexof(pluck(data('tg'), 'k'), 'global|utilMin')].v : 0.15)"
    },
    {
      "name": "tgt_utilMax",
      "update": "oneSpoke && indexof(pluck(data('tg'), 'k'), 'spoke|' + oneSpoke + '|utilMax') >= 0 ? data('tg')[indexof(pluck(data('tg'), 'k'), 'spoke|' + oneSpoke + '|utilMax')].v : (indexof(pluck(data('tg'), 'k'), 'global|utilMax') >= 0 ? data('tg')[indexof(pluck(data('tg'), 'k'), 'global|utilMax')].v : 0.6)"
    },
    {
      "name": "tgt_vdiStaleDays",
      "update": "oneSpoke && indexof(pluck(data('tg'), 'k'), 'spoke|' + oneSpoke + '|vdiStaleDays') >= 0 ? data('tg')[indexof(pluck(data('tg'), 'k'), 'spoke|' + oneSpoke + '|vdiStaleDays')].v : (indexof(pluck(data('tg'), 'k'), 'global|vdiStaleDays') >= 0 ? data('tg')[indexof(pluck(data('tg'), 'k'), 'global|vdiStaleDays')].v : 14)"
    },
    {
      "name": "cfg_fyStart",
      "update": "length(data('ref_config')) ? data('ref_config')[0]._source.fiscal_year_start_month : 4"
    },
    {
      "name": "cfg_warn",
      "update": "length(data('ref_config')) ? data('ref_config')[0]._source.warn_margin : 0.1"
    },
    {
      "name": "fyY",
      "update": "utcmonth(hi) >= cfg_fyStart - 1 ? utcyear(hi) : utcyear(hi) - 1"
    },
    {
      "name": "fyStart",
      "update": "utc(fyY, cfg_fyStart - 1, 1)"
    },
    {
      "name": "fyEnd",
      "update": "utc(fyY + 1, cfg_fyStart - 1, 1)"
    },
    {
      "name": "pfyStart",
      "update": "utc(fyY - 1, cfg_fyStart - 1, 1)"
    },
    {
      "name": "pfyHi",
      "update": "pfyStart + (hi - fyStart)"
    },
    {
      "name": "fytdNet",
      "update": "length(data('fy')) ? data('fy')[0].cur : 0"
    },
    {
      "name": "pfytdNet",
      "update": "length(data('fy')) ? data('fy')[0].prev : 0"
    },
    {
      "name": "daysLeft",
      "update": "max(0, round((fyEnd - hi) / 86400000) - 1)"
    },
    {
      "name": "runRate",
      "update": "ndays ? ((length(data('tot')) ? data('tot')[0].cur_gb : 0) - (length(data('tot')) ? data('tot')[0].cur_ec : 0)) / ndays : 0"
    },
    {
      "name": "projected",
      "update": "fytdNet + runRate * daysLeft"
    },
    {
      "name": "fyLabel",
      "update": "cfg_fyStart === 1 ? 'FY ' + fyY : 'FY ' + fyY + '/' + pad('' + ((fyY + 1) % 100), 2, '0', 'left')"
    },
    {
      "name": "estateTarget",
      "update": "indexof(pluck(data('ftg'), 'spoke'), 'ESTATE') >= 0 ? data('ftg')[indexof(pluck(data('ftg'), 'spoke'), 'ESTATE')].target : null"
    },
    {
      "name": "top",
      "value": 56
    },
    {
      "name": "cw",
      "update": "width - 32"
    },
    {
      "name": "ch",
      "update": "height - top - 16"
    },
    {
      "name": "att",
      "update": "isValid(estateTarget) && estateTarget ? projected / estateTarget : null"
    },
    {
      "name": "onTrack",
      "update": "isValid(estateTarget) ? projected >= estateTarget : false"
    }
  ],
  "data": [
    {
      "name": "raw",
      "url": {
        "index": "ia-workqueue-items",
        "body": {
          "size": 0,
          "query": {
            "bool": {
              "must": [
                "%dashboard_context-must_clause%",
                {
                  "range": {
                    "@timestamp": {
                      "gte": {
                        "%timefilter%": "min",
                        "shift": -732,
                        "unit": "day"
                      },
                      "lte": {
                        "%timefilter%": "max"
                      },
                      "format": "epoch_millis"
                    }
                  }
                },
                {
                  "term": {
                    "mapped": true
                  }
                }
              ],
              "filter": [
                "%dashboard_context-filter_clause%"
              ],
              "must_not": [
                "%dashboard_context-must_not_clause%"
              ]
            }
          },
          "aggs": {
            "win": {
              "filter": {
                "range": {
                  "@timestamp": {
                    "%timefilter%": true
                  }
                }
              },
              "aggs": {
                "d": {
                  "date_histogram": {
                    "field": "@timestamp",
                    "fixed_interval": "1d",
                    "min_doc_count": 0,
                    "extended_bounds": {
                      "min": {
                        "%timefilter%": "min"
                      },
                      "max": {
                        "%timefilter%": "max"
                      }
                    }
                  }
                }
              }
            },
            "days": {
              "date_histogram": {
                "field": "@timestamp",
                "fixed_interval": "1d",
                "min_doc_count": 1
              },
              "aggs": {
                "gb": {
                  "sum": {
                    "field": "value.benefit_gbp"
                  }
                },
                "ec": {
                  "sum": {
                    "field": "cost.estate_gbp"
                  }
                }
              }
            }
          }
        }
      },
      "format": {
        "property": "aggregations"
      }
    },
    {
      "name": "win",
      "source": "raw",
      "transform": [
        {
          "type": "flatten",
          "fields": [
            "win.d.buckets"
          ],
          "as": [
            "_bk"
          ]
        },
        {
          "type": "formula",
          "as": "key",
          "expr": "datum._bk.key"
        },
        {
          "type": "formula",
          "as": "n",
          "expr": "datum._bk.doc_count"
        },
        {
          "type": "project",
          "fields": [
            "key",
            "n"
          ]
        }
      ]
    },
    {
      "name": "days",
      "source": "raw",
      "transform": [
        {
          "type": "flatten",
          "fields": [
            "days.buckets"
          ],
          "as": [
            "_bk"
          ]
        },
        {
          "type": "formula",
          "as": "key",
          "expr": "datum._bk.key"
        },
        {
          "type": "formula",
          "as": "n",
          "expr": "datum._bk.doc_count"
        },
        {
          "type": "formula",
          "as": "gb",
          "expr": "datum._bk[\"gb\"] ? (datum._bk[\"gb\"].value || 0) : 0"
        },
        {
          "type": "formula",
          "as": "ec",
          "expr": "datum._bk[\"ec\"] ? (datum._bk[\"ec\"].value || 0) : 0"
        },
        {
          "type": "project",
          "fields": [
            "key",
            "n",
            "gb",
            "ec"
          ]
        }
      ]
    },
    {
      "name": "series",
      "source": "win",
      "transform": [
        {
          "type": "lookup",
          "from": "days",
          "key": "key",
          "fields": [
            "key"
          ],
          "as": [
            "d"
          ]
        },
        {
          "type": "formula",
          "as": "t",
          "expr": "datum.key"
        },
        {
          "type": "formula",
          "as": "gb",
          "expr": "datum.d ? datum.d.gb : 0"
        },
        {
          "type": "formula",
          "as": "ec",
          "expr": "datum.d ? datum.d.ec : 0"
        }
      ]
    },
    {
      "name": "tot",
      "source": "days",
      "transform": [
        {
          "type": "formula",
          "as": "cur_gb",
          "expr": "datum.key >= lo && datum.key <= hi ? datum.gb : 0"
        },
        {
          "type": "formula",
          "as": "prev_gb",
          "expr": "datum.key >= plo && datum.key <= phi ? datum.gb : 0"
        },
        {
          "type": "formula",
          "as": "cur_ec",
          "expr": "datum.key >= lo && datum.key <= hi ? datum.ec : 0"
        },
        {
          "type": "formula",
          "as": "prev_ec",
          "expr": "datum.key >= plo && datum.key <= phi ? datum.ec : 0"
        },
        {
          "type": "aggregate",
          "ops": [
            "sum",
            "sum",
            "sum",
            "sum"
          ],
          "fields": [
            "cur_gb",
            "prev_gb",
            "cur_ec",
            "prev_ec"
          ],
          "as": [
            "cur_gb",
            "prev_gb",
            "cur_ec",
            "prev_ec"
          ]
        }
      ]
    },
    {
      "name": "ref_targets",
      "url": {
        "index": "ia-reference",
        "body": {
          "size": 200,
          "query": {
            "term": {
              "doc_type": "target"
            }
          }
        }
      },
      "format": {
        "property": "hits.hits"
      }
    },
    {
      "name": "tg",
      "source": "ref_targets",
      "transform": [
        {
          "type": "formula",
          "as": "k",
          "expr": "datum._source.scope === 'global' ? 'global|' + datum._source.metric : datum._source.scope + '|' + datum._source.scope_id + '|' + datum._source.metric"
        },
        {
          "type": "formula",
          "as": "v",
          "expr": "datum._source.value"
        }
      ]
    },
    {
      "name": "ref_config",
      "url": {
        "index": "ia-reference",
        "body": {
          "size": 1,
          "query": {
            "term": {
              "doc_type": "config"
            }
          }
        }
      },
      "format": {
        "property": "hits.hits"
      }
    },
    {
      "name": "scope_spokes",
      "url": {
        "%context%": true,
        "%timefield%": "@timestamp",
        "index": "ia-workqueue-items",
        "body": {
          "size": 0,
          "aggs": {
            "m": {
              "filter": {
                "term": {
                  "mapped": true
                }
              },
              "aggs": {
                "s": {
                  "terms": {
                    "field": "spoke.name",
                    "size": 2
                  }
                }
              }
            }
          }
        }
      },
      "format": {
        "property": "aggregations.m.s.buckets"
      }
    },
    {
      "name": "fy",
      "source": "days",
      "transform": [
        {
          "type": "formula",
          "as": "net",
          "expr": "datum.gb - datum.ec"
        },
        {
          "type": "formula",
          "as": "cur",
          "expr": "datum.key >= fyStart && datum.key <= hi ? datum.net : 0"
        },
        {
          "type": "formula",
          "as": "prev",
          "expr": "datum.key >= pfyStart && datum.key <= pfyHi ? datum.net : 0"
        },
        {
          "type": "aggregate",
          "ops": [
            "sum",
            "sum"
          ],
          "fields": [
            "cur",
            "prev"
          ],
          "as": [
            "cur",
            "prev"
          ]
        }
      ]
    },
    {
      "name": "ref_ft",
      "url": {
        "index": "ia-reference",
        "body": {
          "size": 100,
          "query": {
            "term": {
              "doc_type": "finance_target"
            }
          }
        }
      },
      "format": {
        "property": "hits.hits"
      }
    },
    {
      "name": "ftg",
      "source": "ref_ft",
      "transform": [
        {
          "type": "formula",
          "as": "spoke",
          "expr": "datum._source.spoke"
        },
        {
          "type": "formula",
          "as": "target",
          "expr": "datum._source.annual_net_benefit_target_gbp"
        }
      ]
    }
  ],
  "marks": [
    {
      "type": "text",
      "name": "frame_title",
      "encode": {
        "update": {
          "x": {
            "value": 16
          },
          "y": {
            "value": 16
          },
          "baseline": {
            "value": "top"
          },
          "font": {
            "value": "Fraunces, Cambria, Georgia, Gelasio, serif"
          },
          "fontSize": {
            "value": 16
          },
          "fontWeight": {
            "value": "bold"
          },
          "fill": {
            "value": "#0F4D43"
          },
          "text": {
            "value": "FY target attainment"
          },
          "limit": {
            "signal": "width - 32"
          }
        }
      }
    },
    {
      "type": "text",
      "encode": {
        "update": {
          "x": {
            "value": 16
          },
          "y": {
            "value": 38
          },
          "baseline": {
            "value": "top"
          },
          "font": {
            "value": "Inter, 'Segoe UI', Carlito, Calibri, Arial, sans-serif"
          },
          "fontSize": {
            "value": 12
          },
          "fill": {
            "value": "#5F6E69"
          },
          "text": {
            "signal": "'Fiscal-year-to-date net benefit against the estate\\'s annual target, projected to year end at the current run-rate · ' + fyLabel"
          },
          "limit": {
            "signal": "width - 32"
          }
        }
      }
    },
    {
      "type": "text",
      "encode": {
        "update": {
          "x": {
            "signal": "16 + 0 * (cw / 5)"
          },
          "y": {
            "signal": "top + 4"
          },
          "baseline": {
            "value": "top"
          },
          "font": {
            "value": "'JetBrains Mono', Consolas, 'Roboto Mono', monospace"
          },
          "fontSize": {
            "value": 10
          },
          "fontWeight": {
            "value": "bold"
          },
          "fill": {
            "value": "#5F6E69"
          },
          "text": {
            "value": "FY-TO-DATE NET"
          }
        }
      }
    },
    {
      "type": "text",
      "encode": {
        "update": {
          "x": {
            "signal": "16 + 0 * (cw / 5)"
          },
          "y": {
            "signal": "top + 20"
          },
          "baseline": {
            "value": "top"
          },
          "font": {
            "value": "Fraunces, Cambria, Georgia, Gelasio, serif"
          },
          "fontSize": {
            "value": 20
          },
          "fontWeight": {
            "value": "bold"
          },
          "fill": {
            "signal": "'#0F4D43'"
          },
          "text": {
            "signal": "(isValid((fytdNet)) && isFinite((fytdNet)) ? ((fytdNet) < 0 ? '-' : '') + '£' + (abs((fytdNet)) >= 1e6 ? format(abs((fytdNet)) / 1e6, '.2f') + 'M' : abs((fytdNet)) >= 1e3 ? format(abs((fytdNet)) / 1e3, '.1f') + 'k' : format(abs((fytdNet)), '.2f')) : '–')"
          }
        }
      }
    },
    {
      "type": "text",
      "encode": {
        "update": {
          "x": {
            "signal": "16 + 1 * (cw / 5)"
          },
          "y": {
            "signal": "top + 4"
          },
          "baseline": {
            "value": "top"
          },
          "font": {
            "value": "'JetBrains Mono', Consolas, 'Roboto Mono', monospace"
          },
          "fontSize": {
            "value": 10
          },
          "fontWeight": {
            "value": "bold"
          },
          "fill": {
            "value": "#5F6E69"
          },
          "text": {
            "value": "PROJECTED FY-END"
          }
        }
      }
    },
    {
      "type": "text",
      "encode": {
        "update": {
          "x": {
            "signal": "16 + 1 * (cw / 5)"
          },
          "y": {
            "signal": "top + 20"
          },
          "baseline": {
            "value": "top"
          },
          "font": {
            "value": "Fraunces, Cambria, Georgia, Gelasio, serif"
          },
          "fontSize": {
            "value": 20
          },
          "fontWeight": {
            "value": "bold"
          },
          "fill": {
            "signal": "'#0F4D43'"
          },
          "text": {
            "signal": "(isValid((projected)) && isFinite((projected)) ? ((projected) < 0 ? '-' : '') + '£' + (abs((projected)) >= 1e6 ? format(abs((projected)) / 1e6, '.2f') + 'M' : abs((projected)) >= 1e3 ? format(abs((projected)) / 1e3, '.1f') + 'k' : format(abs((projected)), '.2f')) : '–')"
          }
        }
      }
    },
    {
      "type": "text",
      "encode": {
        "update": {
          "x": {
            "signal": "16 + 2 * (cw / 5)"
          },
          "y": {
            "signal": "top + 4"
          },
          "baseline": {
            "value": "top"
          },
          "font": {
            "value": "'JetBrains Mono', Consolas, 'Roboto Mono', monospace"
          },
          "fontSize": {
            "value": 10
          },
          "fontWeight": {
            "value": "bold"
          },
          "fill": {
            "value": "#5F6E69"
          },
          "text": {
            "value": "ANNUAL TARGET"
          }
        }
      }
    },
    {
      "type": "text",
      "encode": {
        "update": {
          "x": {
            "signal": "16 + 2 * (cw / 5)"
          },
          "y": {
            "signal": "top + 20"
          },
          "baseline": {
            "value": "top"
          },
          "font": {
            "value": "Fraunces, Cambria, Georgia, Gelasio, serif"
          },
          "fontSize": {
            "value": 20
          },
          "fontWeight": {
            "value": "bold"
          },
          "fill": {
            "signal": "'#0F4D43'"
          },
          "text": {
            "signal": "isValid(estateTarget) ? (isValid((estateTarget)) && isFinite((estateTarget)) ? ((estateTarget) < 0 ? '-' : '') + '£' + (abs((estateTarget)) >= 1e6 ? format(abs((estateTarget)) / 1e6, '.2f') + 'M' : abs((estateTarget)) >= 1e3 ? format(abs((estateTarget)) / 1e3, '.1f') + 'k' : format(abs((estateTarget)), '.2f')) : '–') : 'Not set'"
          }
        }
      }
    },
    {
      "type": "text",
      "encode": {
        "update": {
          "x": {
            "signal": "16 + 3 * (cw / 5)"
          },
          "y": {
            "signal": "top + 4"
          },
          "baseline": {
            "value": "top"
          },
          "font": {
            "value": "'JetBrains Mono', Consolas, 'Roboto Mono', monospace"
          },
          "fontSize": {
            "value": 10
          },
          "fontWeight": {
            "value": "bold"
