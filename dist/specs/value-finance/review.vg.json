{
  "$schema": "https://vega.github.io/schema/vega/v5.json",
  "description": "IA · Value & Finance · Review candidates. Generated by vega/build.mjs from vega/panels/value-finance.mjs, do not edit by hand.",
  "autosize": {
    "type": "fit",
    "contains": "padding"
  },
  "padding": 0,
  "config": {
    "background": "#FFFFFF",
    "padding": 0,
    "font": "Inter, 'Segoe UI', Carlito, Calibri, Arial, sans-serif",
    "text": {
      "font": "Inter, 'Segoe UI', Carlito, Calibri, Arial, sans-serif",
      "fill": "#0F4D43",
      "fontSize": 12
    },
    "axis": {
      "gridColor": "#E6E8E2",
      "labelFont": "'JetBrains Mono', Consolas, 'Roboto Mono', monospace",
      "labelFontSize": 10,
      "labelColor": "#5F6E69",
      "titleFont": "'JetBrains Mono', Consolas, 'Roboto Mono', monospace",
      "titleColor": "#5F6E69",
      "titleFontSize": 10,
      "titleFontWeight": 400,
      "domain": false,
      "ticks": false,
      "gridWidth": 1,
      "labelPadding": 6
    },
    "style": {
      "guide-label": {
        "font": "'JetBrains Mono', Consolas, 'Roboto Mono', monospace"
      }
    },
    "view": {
      "stroke": null
    },
    "kibana": {
      "renderer": "svg",
      "hideWarnings": true
    }
  },
  "signals": [
    {
      "name": "oneSpoke",
      "update": "length(data('scope_spokes')) === 1 ? data('scope_spokes')[0].key : ''"
    },
    {
      "name": "tgt_completionPct",
      "update": "oneSpoke && indexof(pluck(data('tg'), 'k'), 'spoke|' + oneSpoke + '|completionPct') >= 0 ? data('tg')[indexof(pluck(data('tg'), 'k'), 'spoke|' + oneSpoke + '|completionPct')].v : (indexof(pluck(data('tg'), 'k'), 'global|completionPct') >= 0 ? data('tg')[indexof(pluck(data('tg'), 'k'), 'global|completionPct')].v : 0.95)"
    },
    {
      "name": "tgt_exceptionRate",
      "update": "oneSpoke && indexof(pluck(data('tg'), 'k'), 'spoke|' + oneSpoke + '|exceptionRate') >= 0 ? data('tg')[indexof(pluck(data('tg'), 'k'), 'spoke|' + oneSpoke + '|exceptionRate')].v : (indexof(pluck(data('tg'), 'k'), 'global|exceptionRate') >= 0 ? data('tg')[indexof(pluck(data('tg'), 'k'), 'global|exceptionRate')].v : 0.06)"
    },
    {
      "name": "tgt_systemRate",
      "update": "oneSpoke && indexof(pluck(data('tg'), 'k'), 'spoke|' + oneSpoke + '|systemRate') >= 0 ? data('tg')[indexof(pluck(data('tg'), 'k'), 'spoke|' + oneSpoke + '|systemRate')].v : (indexof(pluck(data('tg'), 'k'), 'global|systemRate') >= 0 ? data('tg')[indexof(pluck(data('tg'), 'k'), 'global|systemRate')].v : 0.03)"
    },
    {
      "name": "tgt_costPerCase",
      "update": "oneSpoke && indexof(pluck(data('tg'), 'k'), 'spoke|' + oneSpoke + '|costPerCase') >= 0 ? data('tg')[indexof(pluck(data('tg'), 'k'), 'spoke|' + oneSpoke + '|costPerCase')].v : (indexof(pluck(data('tg'), 'k'), 'global|costPerCase') >= 0 ? data('tg')[indexof(pluck(data('tg'), 'k'), 'global|costPerCase')].v : 9)"
    },
    {
      "name": "tgt_utilMin",
      "update": "oneSpoke && indexof(pluck(data('tg'), 'k'), 'spoke|' + oneSpoke + '|utilMin') >= 0 ? data('tg')[indexof(pluck(data('tg'), 'k'), 'spoke|' + oneSpoke + '|utilMin')].v : (indexof(pluck(data('tg'), 'k'), 'global|utilMin') >= 0 ? data('tg')[indexof(pluck(data('tg'), 'k'), 'global|utilMin')].v : 0.15)"
    },
    {
      "name": "tgt_utilMax",
      "update": "oneSpoke && indexof(pluck(data('tg'), 'k'), 'spoke|' + oneSpoke + '|utilMax') >= 0 ? data('tg')[indexof(pluck(data('tg'), 'k'), 'spoke|' + oneSpoke + '|utilMax')].v : (indexof(pluck(data('tg'), 'k'), 'global|utilMax') >= 0 ? data('tg')[indexof(pluck(data('tg'), 'k'), 'global|utilMax')].v : 0.6)"
    },
    {
      "name": "tgt_vdiStaleDays",
      "update": "oneSpoke && indexof(pluck(data('tg'), 'k'), 'spoke|' + oneSpoke + '|vdiStaleDays') >= 0 ? data('tg')[indexof(pluck(data('tg'), 'k'), 'spoke|' + oneSpoke + '|vdiStaleDays')].v : (indexof(pluck(data('tg'), 'k'), 'global|vdiStaleDays') >= 0 ? data('tg')[indexof(pluck(data('tg'), 'k'), 'global|vdiStaleDays')].v : 14)"
    },
    {
      "name": "cfg_fyStart",
      "update": "length(data('ref_config')) ? data('ref_config')[0]._source.fiscal_year_start_month : 4"
    },
    {
      "name": "cfg_warn",
      "update": "length(data('ref_config')) ? data('ref_config')[0]._source.warn_margin : 0.1"
    },
    {
      "name": "top",
      "value": 56
    },
    {
      "name": "cw",
      "update": "width - 32"
    },
    {
      "name": "ch",
      "update": "height - top - 16"
    },
    {
      "name": "tb_fit",
      "update": "max(0, floor((ch - 30 - 0 - 14) / 34))"
    }
  ],
  "data": [
    {
      "name": "procs_raw",
      "url": {
        "index": "ia-reference",
        "body": {
          "size": 500,
          "query": {
            "term": {
              "doc_type": "process"
            }
          }
        }
      },
      "format": {
        "property": "hits.hits"
      }
    },
    {
      "name": "procs",
      "source": "procs_raw",
      "transform": [
        {
          "type": "formula",
          "as": "name",
          "expr": "datum._source.process.name"
        },
        {
          "type": "formula",
          "as": "pid",
          "expr": "datum._source.process.id"
        },
        {
          "type": "formula",
          "as": "acronym",
          "expr": "datum._source.process.acronym"
        },
        {
          "type": "formula",
          "as": "spoke",
          "expr": "datum._source.spoke.name"
        },
        {
          "type": "formula",
          "as": "spokeColor",
          "expr": "datum._source.spoke.color"
        },
        {
          "type": "formula",
          "as": "proposition",
          "expr": "datum._source.proposition.name"
        },
        {
          "type": "formula",
          "as": "queue",
          "expr": "datum._source.primary_queue"
        },
        {
          "type": "formula",
          "as": "queues",
          "expr": "join(datum._source.queues, ' → ')"
        },
        {
          "type": "formula",
          "as": "description",
          "expr": "datum._source.process.description"
        },
        {
          "type": "formula",
          "as": "tags",
          "expr": "datum._source.process.tags"
        },
        {
          "type": "formula",
          "as": "smv",
          "expr": "datum._source.process.smv_minutes"
        },
        {
          "type": "formula",
          "as": "grade",
          "expr": "datum._source.process.grade"
        },
        {
          "type": "formula",
          "as": "gradeName",
          "expr": "datum._source.process.grade_name"
        },
        {
          "type": "formula",
          "as": "rate",
          "expr": "datum._source.process.current_rate_gbp"
        }
      ]
    },
    {
      "name": "ref_targets",
      "url": {
        "index": "ia-reference",
        "body": {
          "size": 200,
          "query": {
            "term": {
              "doc_type": "target"
            }
          }
        }
      },
      "format": {
        "property": "hits.hits"
      }
    },
    {
      "name": "tg",
      "source": "ref_targets",
      "transform": [
        {
          "type": "formula",
          "as": "k",
          "expr": "datum._source.scope === 'global' ? 'global|' + datum._source.metric : datum._source.scope + '|' + datum._source.scope_id + '|' + datum._source.metric"
        },
        {
          "type": "formula",
          "as": "v",
          "expr": "datum._source.value"
        }
      ]
    },
    {
      "name": "ref_config",
      "url": {
        "index": "ia-reference",
        "body": {
          "size": 1,
          "query": {
            "term": {
              "doc_type": "config"
            }
          }
        }
      },
      "format": {
        "property": "hits.hits"
      }
    },
    {
      "name": "scope_spokes",
      "url": {
        "%context%": true,
        "%timefield%": "@timestamp",
        "index": "ia-workqueue-items",
        "body": {
          "size": 0,
          "aggs": {
            "m": {
              "filter": {
                "term": {
                  "mapped": true
                }
              },
              "aggs": {
                "s": {
                  "terms": {
                    "field": "spoke.name",
                    "size": 2
                  }
                }
              }
            }
          }
        }
      },
      "format": {
        "property": "aggregations.m.s.buckets"
      }
    },
    {
      "name": "bp_raw",
      "url": {
        "%context%": true,
        "%timefield%": "@timestamp",
        "index": "ia-workqueue-items",
        "body": {
          "size": 0,
          "aggs": {
            "m": {
              "filter": {
                "term": {
                  "mapped": true
                }
              },
              "aggs": {
                "p": {
                  "terms": {
                    "field": "process.name",
                    "size": 100
                  },
                  "aggs": {
                    "gb": {
                      "sum": {
                        "field": "value.benefit_gbp"
                      }
                    },
                    "ec": {
                      "sum": {
                        "field": "cost.estate_gbp"
                      }
                    },
                    "c": {
                      "sum": {
                        "field": "n.completed"
                      }
                    },
                    "rw": {
                      "sum": {
                        "field": "value.rework_gbp"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      },
      "format": {
        "property": "aggregations.m.p.buckets"
      }
    },
    {
      "name": "bp",
      "source": "bp_raw",
      "transform": [
        {
          "type": "formula",
          "as": "name",
          "expr": "datum.key"
        },
        {
          "type": "formula",
          "as": "gb",
          "expr": "datum['gb'].value"
        },
        {
          "type": "formula",
          "as": "ec",
          "expr": "datum['ec'].value"
        },
        {
          "type": "formula",
          "as": "c",
          "expr": "datum['c'].value"
        },
        {
          "type": "formula",
          "as": "rw",
          "expr": "datum['rw'].value"
        },
        {
          "type": "lookup",
          "from": "procs",
          "key": "name",
          "fields": [
            "name"
          ],
          "as": [
            "ref"
          ]
        },
        {
          "type": "formula",
          "as": "spoke",
          "expr": "datum.ref ? datum.ref.spoke : ''"
        },
        {
          "type": "formula",
          "as": "spokeColor",
          "expr": "datum.ref ? datum.ref.spokeColor : '#5F6E69'"
        },
        {
          "type": "formula",
          "as": "queue",
          "expr": "datum.ref ? datum.ref.queue : ''"
        },
        {
          "type": "formula",
          "as": "proposition",
          "expr": "datum.ref ? datum.ref.proposition : ''"
        }
      ]
    },
    {
      "name": "loss",
      "source": "bp",
      "transform": [
        {
          "type": "formula",
          "as": "net",
          "expr": "datum.gb - datum.ec"
        },
        {
          "type": "filter",
          "expr": "datum.net < 0"
        },
        {
          "type": "collect",
          "sort": {
            "field": "net"
          }
        },
        {
          "type": "formula",
          "as": "why",
          "expr": "datum.c < 30 ? 'Low volume: only ' + datum.c + ' completions this period, too few to amortise fixed cost.' : datum.rw > datum.ec * 0.3 ? 'High exception cost: rework is costing more than 30% of this process\\'s automation spend.' : datum.ec / max(1, datum.c) > (indexof(pluck(data('tg'), 'k'), 'global|costPerCase') >= 0 ? data('tg')[indexof(pluck(data('tg'), 'k'), 'global|costPerCase')].v : 9) * 1.5 ? 'High unit cost: £' + format(datum.c ? datum.ec / datum.c : datum.ec, '.2f') + '/case, over 1.5× the target cost per case (£' + format((indexof(pluck(data('tg'), 'k'), 'global|costPerCase') >= 0 ? data('tg')[indexof(pluck(data('tg'), 'k'), 'global|costPerCase')].v : 9), '.2f') + ').' : 'Cost exceeds benefit at the current volume and rate mix.'"
        }
      ]
    },
    {
      "name": "tb_rows",
      "source": "loss",
      "transform": [
        {
          "type": "window",
          "ops": [
            "row_number"
          ],
          "as": [
            "rank"
          ]
        },
        {
          "type": "filter",
          "expr": "datum.rank <= tb_fit"
        }
      ]
    }
  ],
  "marks": [
    {
      "type": "text",
      "name": "frame_title",
      "encode": {
        "update": {
          "x": {
            "value": 16
          },
          "y": {
            "value": 16
          },
          "baseline": {
            "value": "top"
          },
          "font": {
            "value": "Fraunces, Cambria, Georgia, Gelasio, serif"
          },
          "fontSize": {
            "value": 16
          },
          "fontWeight": {
            "value": "bold"
          },
          "fill": {
            "value": "#0F4D43"
          },
          "text": {
            "value": "Review candidates"
          },
          "limit": {
            "signal": "width - 32"
          }
        }
      }
    },
    {
      "type": "text",
      "encode": {
        "update": {
          "x": {
            "value": 16
          },
          "y": {
            "value": 38
          },
          "baseline": {
            "value": "top"
          },
          "font": {
            "value": "Inter, 'Segoe UI', Carlito, Calibri, Arial, sans-serif"
          },
          "fontSize": {
            "value": 12
          },
          "fill": {
            "value": "#5F6E69"
          },
          "text": {
            "value": "Processes running at a net loss, worst first · hover Why for the full reason"
          },
          "limit": {
            "signal": "width - 32"
          }
        }
      }
    },
    {
      "type": "text",
      "encode": {
        "update": {
          "x": {
            "signal": "width / 2"
          },
          "y": {
            "signal": "top + ch / 2"
          },
          "align": {
            "value": "center"
          },
          "baseline": {
            "value": "middle"
          },
          "font": {
            "value": "Inter, 'Segoe UI', Carlito, Calibri, Arial, sans-serif"
          },
          "fontSize": {
            "value": 13
          },
          "fill": {
            "value": "#0B8A6B"
          },
          "text": {
            "value": "No processes are running at a loss for the current filters."
          },
          "opacity": {
            "signal": "(length(data('loss')) === 0) ? 1 : 0"
          }
        }
      }
    },
    {
      "type": "group",
      "encode": {
        "update": {
          "x": {
            "value": 16
          },
          "y": {
            "signal": "top"
          },
          "width": {
            "signal": "cw"
          },
          "height": {
            "value": 30
          }
        }
      },
      "marks": [
        {
          "type": "rule",
          "encode": {
            "update": {
              "x": {
                "value": 0
              },
              "x2": {
                "signal": "cw"
              },
              "y": {
                "value": 29.5
              },
              "stroke": {
                "value": "#D6D9D2"
              }
            }
          }
        },
        {
          "type": "text",
          "encode": {
            "update": {
              "x": {
                "signal": "0 + 10"
              },
              "y": {
                "value": 15
              },
              "align": {
                "value": "left"
              },
              "baseline": {
                "value": "middle"
              },
              "font": {
                "value": "'JetBrains Mono', Consolas, 'Roboto Mono', monospace"
              },
              "fontSize": {
                "value": 10
              },
              "fontWeight": {
                "value": "bold"
              },
              "fill": {
                "value": "#5F6E69"
              },
              "text": {
                "value": "PROCESS"
              },
              "limit": {
                "signal": "190 - 12"
              }
            }
          }
        },
        {
          "type": "text",
          "encode": {
            "update": {
              "x": {
                "signal": "0 + 190 + 76 - 10"
              },
              "y": {
                "value": 15
              },
              "align": {
                "value": "right"
              },
              "baseline": {
                "value": "middle"
              },
              "font": {
                "value": "'JetBrains Mono', Consolas, 'Roboto Mono', monospace"
              },
              "fontSize": {
                "value": 10
              },
              "fontWeight": {
                "value": "bold"
              },
              "fill": {
                "value": "#5F6E69"
              },
              "text": {
                "value": "NET"
              },
              "limit": {
                "signal": "76 - 12"
              }
            }
          }
        },
        {
          "type": "text",
          "encode": {
            "update": {
              "x": {
                "signal": "0 + 190 + 76 + 76 - 10"
              },
              "y": {
                "value": 15
              },
              "align": {
                "value": "right"
              },
              "baseline": {
                "value": "middle"
              },
              "font": {
                "value": "'JetBrains Mono', Consolas, 'Roboto Mono', monospace"
              },
              "fontSize": {
                "value": 10
              },
              "fontWeight": {
                "value": "bold"
              },
              "fill": {
                "value": "#5F6E69"
              },
              "text": {
                "value": "COST"
              },
              "limit": {
                "signal": "76 - 12"
              }
            }
          }
        },
        {
          "type": "text",
          "encode": {
            "update": {
              "x": {
                "signal": "0 + 190 + 76 + 76 + 86 - 10"
              },
              "y": {
                "value": 15
              },
              "align": {
                "value": "right"
              },
              "baseline": {
                "value": "middle"
              },
              "font": {
                "value": "'JetBrains Mono', Consolas, 'Roboto Mono', monospace"
              },
              "fontSize": {
                "value": 10
              },
              "fontWeight": {
                "value": "bold"
              },
              "fill": {
                "value": "#5F6E69"
              },
              "text": {
                "value": "COMPLETED"
              },
              "limit": {
                "signal": "86 - 12"
              }
            }
          }
        },
        {
          "type": "text",
          "encode": {
            "update": {
              "x": {
                "signal": "0 + 190 + 76 + 76 + 86 + 108 - 10"
              },
              "y": {
                "value": 15
              },
              "align": {
                "value": "right"
              },
              "baseline": {
                "value": "middle"
              },
              "font": {
                "value": "'JetBrains Mono', Consolas, 'Roboto Mono', monospace"
              },
              "fontSize": {
                "value": 10
              },
              "fontWeight": {
                "value": "bold"
              },
              "fill": {
                "value": "#5F6E69"
              },
              "text": {
                "value": "EXCEPTION COST"
              },
              "limit": {
                "signal": "108 - 12"
              }
            }
          }
        },
        {
          "type": "text",
          "encode": {
            "update": {
              "x": {
                "signal": "0 + 190 + 76 + 76 + 86 + 108 + 10"
              },
              "y": {
                "value": 15
              },
              "align": {
                "value": "left"
              },
              "baseline": {
                "value": "middle"
              },
              "font": {
                "value": "'JetBrains Mono', Consolas, 'Roboto Mono', monospace"
              },
              "fontSize": {
                "value": 10
              },
              "fontWeight": {
                "value": "bold"
              },
              "fill": {
                "value": "#5F6E69"
              },
              "text": {
                "value": "WHY"
              },
              "limit": {
                "signal": "((cw - 536) / 1) - 12"
              }
            }
          }
        }
      ]
    },
    {
      "type": "group",
      "name": "tb_row",
      "from": {
        "data": "tb_rows"
      },
      "encode": {
        "update": {
          "x": {
            "value": 16
          },
          "y": {
            "signal": "top + 30 + (datum.rank - 1) * 34"
          },
          "width": {
            "signal": "cw"
          },
          "height": {
            "value": 34
          },
          "fill": {
            "signal": "datum.rank % 2 === 0 ? '#F7F6F2' : 'transparent'"
          },
          "cursor": {
            "value": "default"
          }
        }
      },
      "marks": [
        {
          "type": "rule",
          "encode": {
            "update": {
              "x": {
                "value": 0
              },
              "x2": {
                "signal": "cw"
              },
              "y": {
                "value": 33.5
              },
              "stroke": {
                "value": "#D6D9D2"
              },
              "strokeOpacity": {
                "value": 0.7
              }
            }
          }
        },
        {
          "type": "text",
          "encode": {
            "update": {
              "x": {
                "signal": "0 + 10"
              },
              "y": {
                "value": 17
              },
              "align": {
                "value": "left"
              },
              "baseline": {
                "value": "middle"
              },
              "font": {
                "value": "Inter, 'Segoe UI', Carlito, Calibri, Arial, sans-serif"
              },
              "fontSize": {
                "value": 12.5
              },
              "fontWeight": {
                "value": "normal"
              },
              "fill": {
                "value": "#0F4D43"
              },
              "text": {
                "signal": "parent.name"
              },
              "limit": {
                "signal": "190 - 16"
              }
            }
          }
        },
        {
          "type": "text",
          "encode": {
            "update": {
              "x": {
                "signal": "0 + 190 + 76 - 10"
              },
              "y": {
                "value": 17
              },
              "align": {
                "value": "right"
              },
              "baseline": {
                "value": "middle"
              },
              "font": {
                "value": "Inter, 'Segoe UI', Carlito, Calibri, Arial, sans-serif"
              },
              "fontSize": {
