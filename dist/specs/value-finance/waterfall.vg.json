          "y": {
            "signal": "top"
          },
          "width": {
            "signal": "cw"
          },
          "height": {
            "signal": "ch"
          }
        }
      },
      "marks": [
        {
          "type": "rule",
          "encode": {
            "update": {
              "x": {
                "value": 0
              },
              "x2": {
                "signal": "cw"
              },
              "y": {
                "scale": "wy",
                "value": 0
              },
              "stroke": {
                "value": "#5A7378"
              }
            }
          }
        },
        {
          "type": "rect",
          "from": {
            "data": "steps"
          },
          "encode": {
            "update": {
              "x": {
                "scale": "wx",
                "field": "label"
              },
              "width": {
                "scale": "wx",
                "band": 1
              },
              "y": {
                "scale": "wy",
                "field": "y0"
              },
              "y2": {
                "signal": "abs(scale('wy', datum.y1) - scale('wy', datum.y0)) < 3 ? scale('wy', datum.y0) + (datum.y1 < datum.y0 ? 3 : -3) : scale('wy', datum.y1)"
              },
              "fill": {
                "field": "col"
              },
              "fillOpacity": {
                "signal": "datum.i === 4 ? 0.35 : 1"
              },
              "stroke": {
                "signal": "datum.i === 4 ? '#E87BA4' : null"
              },
              "strokeDash": {
                "value": [
                  3,
                  2
                ]
              },
              "cornerRadius": {
                "value": 2
              },
              "tooltip": {
                "signal": "{'Step': datum.label, 'Value': (isValid((datum.v)) && isFinite((datum.v)) ? ((datum.v) < 0 ? '-' : '') + '£' + format(round(abs((datum.v))), ',') : '–')}"
              }
            }
          }
        },
        {
          "type": "text",
          "from": {
            "data": "steps"
          },
          "encode": {
            "update": {
              "x": {
                "scale": "wx",
                "field": "label",
                "band": 0.5
              },
              "y": {
                "signal": "min(scale('wy', datum.y0), scale('wy', datum.y1)) - 6"
              },
              "align": {
                "value": "center"
              },
              "font": {
                "value": "'JetBrains Mono', 'Roboto Mono', Consolas, 'Courier New', monospace"
              },
              "fontSize": {
                "value": 12
              },
              "fontWeight": {
                "value": "bold"
              },
              "fill": {
                "value": "#0B3239"
              },
              "text": {
                "signal": "(isValid((datum.v)) && isFinite((datum.v)) ? ((datum.v) < 0 ? '-' : '') + '£' + (abs((datum.v)) >= 1e6 ? format(abs((datum.v)) / 1e6, '.2f') + 'M' : abs((datum.v)) >= 1e3 ? format(abs((datum.v)) / 1e3, '.1f') + 'k' : format(abs((datum.v)), '.2f')) : '–') + (datum.i === 4 ? ' (memo)' : '')"
              }
            }
          }
        },
        {
          "type": "text",
          "from": {
            "data": "steps"
          },
          "encode": {
            "update": {
              "x": {
                "scale": "wx",
                "field": "label",
                "band": 0.5
              },
              "y": {
                "signal": "max(scale('wy', datum.y0), scale('wy', datum.y1)) + 14"
              },
              "align": {
                "value": "center"
              },
              "font": {
                "value": "'JetBrains Mono', 'Roboto Mono', Consolas, 'Courier New', monospace"
              },
              "fontSize": {
                "value": 10
              },
              "fill": {
                "value": "#5A7378"
              },
              "text": {
                "signal": "isValid(datum.pct) ? format(datum.pct * 100, '.1f') + '% of gross' : ''"
              }
            }
          }
        },
        {
          "type": "text",
          "from": {
            "data": "steps"
          },
          "encode": {
            "update": {
              "x": {
                "scale": "wx",
                "field": "label",
                "band": 0.5
              },
              "y": {
                "signal": "ch - 40"
              },
              "align": {
                "value": "center"
              },
              "font": {
                "value": "'JetBrains Mono', 'Roboto Mono', Consolas, 'Courier New', monospace"
              },
              "fontSize": {
                "value": 10.5
              },
              "fill": {
                "value": "#5A7378"
              },
              "text": {
