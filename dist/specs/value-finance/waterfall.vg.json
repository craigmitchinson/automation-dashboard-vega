{
  "$schema": "https://vega.github.io/schema/vega/v5.json",
  "description": "IA · Value & Finance · Benefit waterfall. Generated by vega/build.mjs from vega/panels/value-finance.mjs, do not edit by hand.",
  "autosize": {
    "type": "fit",
    "contains": "padding"
  },
  "padding": 0,
  "config": {
    "background": "#FAF7F2",
    "padding": 0,
    "font": "Calibri, Carlito, 'Segoe UI', Inter, Arial, sans-serif",
    "text": {
      "font": "Calibri, Carlito, 'Segoe UI', Inter, Arial, sans-serif",
      "fill": "#0B3239",
      "fontSize": 12
    },
    "axis": {
      "labelFont": "'JetBrains Mono', 'Roboto Mono', Consolas, 'Courier New', monospace",
      "labelFontSize": 10,
      "labelColor": "#5A7378",
      "titleFont": "'JetBrains Mono', 'Roboto Mono', Consolas, 'Courier New', monospace",
      "titleColor": "#5A7378",
      "titleFontSize": 10,
      "titleFontWeight": 400,
      "domain": false,
      "ticks": false,
      "gridColor": "#DCDCD7",
      "gridWidth": 1,
      "labelPadding": 6
    },
    "style": {
      "guide-label": {
        "font": "'JetBrains Mono', 'Roboto Mono', Consolas, 'Courier New', monospace"
      }
    },
    "view": {
      "stroke": null
    },
    "kibana": {
      "renderer": "svg",
      "hideWarnings": true
    }
  },
  "signals": [
    {
      "name": "ndays",
      "update": "length(data('win'))"
    },
    {
      "name": "lo",
      "update": "ndays ? data('win')[0].key : 0"
    },
    {
      "name": "hi",
      "update": "ndays ? data('win')[ndays - 1].key : 0"
    },
    {
      "name": "plo",
      "update": "lo - ndays * 86400000"
    },
    {
      "name": "phi",
      "update": "lo - 86400000"
    },
    {
      "name": "top",
      "value": 78
    },
    {
      "name": "cw",
      "update": "width - 32"
    },
    {
      "name": "ch",
      "update": "height - top - 16"
    }
  ],
  "data": [
    {
      "name": "raw",
      "url": {
        "index": "ia-workqueue-items",
        "body": {
          "size": 0,
          "query": {
            "bool": {
              "must": [
                "%dashboard_context-must_clause%",
                {
                  "range": {
                    "@timestamp": {
                      "gte": {
                        "%timefilter%": "min",
                        "shift": -732,
                        "unit": "day"
                      },
                      "lte": {
                        "%timefilter%": "max"
                      },
                      "format": "epoch_millis"
                    }
                  }
                },
                {
                  "term": {
                    "mapped": true
                  }
                }
              ],
              "filter": [
                "%dashboard_context-filter_clause%"
              ],
              "must_not": [
                "%dashboard_context-must_not_clause%"
              ]
            }
          },
          "aggs": {
            "win": {
              "filter": {
                "range": {
                  "@timestamp": {
                    "%timefilter%": true
                  }
                }
              },
              "aggs": {
                "d": {
                  "date_histogram": {
                    "field": "@timestamp",
                    "fixed_interval": "1d",
                    "min_doc_count": 0,
                    "extended_bounds": {
                      "min": {
                        "%timefilter%": "min"
                      },
                      "max": {
                        "%timefilter%": "max"
                      }
                    }
                  }
                }
              }
            },
            "days": {
              "date_histogram": {
                "field": "@timestamp",
                "fixed_interval": "1d",
                "min_doc_count": 1
              },
              "aggs": {
                "gb": {
                  "sum": {
                    "field": "value.benefit_gbp"
                  }
                },
                "ec": {
                  "sum": {
                    "field": "cost.estate_gbp"
                  }
                },
                "cp": {
                  "sum": {
                    "field": "cost.people_gbp"
                  }
                },
                "ci": {
                  "sum": {
                    "field": "cost.infra_gbp"
                  }
                }
              }
            }
          }
        }
      },
      "format": {
        "property": "aggregations"
      }
    },
    {
      "name": "win",
      "source": "raw",
      "transform": [
        {
          "type": "flatten",
          "fields": [
            "win.d.buckets"
          ],
          "as": [
            "_bk"
          ]
        },
        {
          "type": "formula",
          "as": "key",
          "expr": "datum._bk.key"
        },
        {
          "type": "formula",
          "as": "n",
          "expr": "datum._bk.doc_count"
        },
        {
          "type": "project",
          "fields": [
            "key",
            "n"
          ]
        }
      ]
    },
    {
      "name": "days",
      "source": "raw",
      "transform": [
        {
          "type": "flatten",
          "fields": [
            "days.buckets"
          ],
          "as": [
            "_bk"
          ]
        },
        {
          "type": "formula",
          "as": "key",
          "expr": "datum._bk.key"
        },
        {
          "type": "formula",
          "as": "n",
          "expr": "datum._bk.doc_count"
        },
        {
          "type": "formula",
          "as": "gb",
          "expr": "datum._bk[\"gb\"] ? (datum._bk[\"gb\"].value || 0) : 0"
        },
        {
          "type": "formula",
          "as": "ec",
          "expr": "datum._bk[\"ec\"] ? (datum._bk[\"ec\"].value || 0) : 0"
        },
        {
          "type": "formula",
          "as": "cp",
          "expr": "datum._bk[\"cp\"] ? (datum._bk[\"cp\"].value || 0) : 0"
        },
        {
          "type": "formula",
          "as": "ci",
          "expr": "datum._bk[\"ci\"] ? (datum._bk[\"ci\"].value || 0) : 0"
        },
        {
          "type": "project",
          "fields": [
            "key",
            "n",
            "gb",
            "ec",
            "cp",
            "ci"
          ]
        }
      ]
    },
    {
      "name": "series",
      "source": "win",
      "transform": [
        {
          "type": "lookup",
          "from": "days",
          "key": "key",
          "fields": [
            "key"
          ],
          "as": [
            "d"
          ]
        },
        {
          "type": "formula",
          "as": "t",
          "expr": "datum.key"
        },
        {
          "type": "formula",
          "as": "gb",
          "expr": "datum.d ? datum.d.gb : 0"
        },
        {
          "type": "formula",
          "as": "ec",
          "expr": "datum.d ? datum.d.ec : 0"
        },
        {
          "type": "formula",
          "as": "cp",
          "expr": "datum.d ? datum.d.cp : 0"
        },
        {
          "type": "formula",
          "as": "ci",
          "expr": "datum.d ? datum.d.ci : 0"
        }
      ]
    },
    {
      "name": "tot",
      "source": "days",
      "transform": [
        {
          "type": "formula",
          "as": "cur_gb",
          "expr": "datum.key >= lo && datum.key <= hi ? datum.gb : 0"
        },
        {
          "type": "formula",
          "as": "prev_gb",
          "expr": "datum.key >= plo && datum.key <= phi ? datum.gb : 0"
        },
        {
          "type": "formula",
          "as": "cur_ec",
          "expr": "datum.key >= lo && datum.key <= hi ? datum.ec : 0"
        },
        {
          "type": "formula",
          "as": "prev_ec",
          "expr": "datum.key >= plo && datum.key <= phi ? datum.ec : 0"
        },
        {
          "type": "formula",
          "as": "cur_cp",
          "expr": "datum.key >= lo && datum.key <= hi ? datum.cp : 0"
        },
        {
          "type": "formula",
          "as": "prev_cp",
          "expr": "datum.key >= plo && datum.key <= phi ? datum.cp : 0"
        },
        {
          "type": "formula",
          "as": "cur_ci",
          "expr": "datum.key >= lo && datum.key <= hi ? datum.ci : 0"
        },
        {
          "type": "formula",
          "as": "prev_ci",
          "expr": "datum.key >= plo && datum.key <= phi ? datum.ci : 0"
        },
        {
          "type": "aggregate",
          "ops": [
            "sum",
            "sum",
            "sum",
            "sum",
            "sum",
            "sum",
            "sum",
            "sum"
          ],
          "fields": [
            "cur_gb",
            "prev_gb",
            "cur_ec",
            "prev_ec",
            "cur_cp",
            "prev_cp",
            "cur_ci",
            "prev_ci"
          ],
          "as": [
            "cur_gb",
            "prev_gb",
            "cur_ec",
            "prev_ec",
            "cur_cp",
            "prev_cp",
            "cur_ci",
            "prev_ci"
          ]
        }
      ]
    },
    {
      "name": "unatt_raw",
      "url": {
        "index": "ia-cost-daily",
        "body": {
          "size": 0,
          "query": {
            "bool": {
              "filter": [
                {
                  "range": {
                    "@timestamp": {
                      "%timefilter%": true
                    }
                  }
                },
                {
                  "term": {
                    "estate_worktime_sec": 0
                  }
                }
              ]
            }
          },
          "aggs": {
            "t": {
              "sum": {
                "field": "total_gbp"
              }
            }
          }
        }
      },
      "format": {
        "property": "aggregations.t"
      }
    },
    {
      "name": "steps",
      "values": [
        {
          "i": 0,
          "label": "Gross"
        },
        {
          "i": 1,
          "label": "Teams"
        },
        {
          "i": 2,
          "label": "Machines (VDIs)"
        },
        {
          "i": 3,
          "label": "Net"
        },
        {
          "i": 4,
          "label": "Unattributed idle (memo)"
        }
      ],
      "transform": [
        {
          "type": "formula",
          "as": "g",
          "expr": "(length(data('tot')) ? data('tot')[0].cur_gb : 0)"
        },
        {
          "type": "formula",
          "as": "tm",
          "expr": "(length(data('tot')) ? data('tot')[0].cur_cp : 0)"
        },
        {
          "type": "formula",
          "as": "mc",
          "expr": "(length(data('tot')) ? data('tot')[0].cur_ci : 0)"
        },
        {
          "type": "formula",
          "as": "un",
          "expr": "length(data('unatt_raw')) ? data('unatt_raw')[0].value : 0"
        },
        {
          "type": "formula",
          "as": "y0",
          "expr": "[0, datum.g, datum.g - datum.tm, 0, 0][datum.i]"
        },
        {
          "type": "formula",
          "as": "y1",
          "expr": "[datum.g, datum.g - datum.tm, datum.g - datum.tm - datum.mc, datum.g - datum.tm - datum.mc, -datum.un][datum.i]"
        },
        {
          "type": "formula",
          "as": "v",
          "expr": "[datum.g, -datum.tm, -datum.mc, datum.g - datum.tm - datum.mc, -datum.un][datum.i]"
        },
        {
          "type": "formula",
          "as": "col",
          "expr": "[datum.g >= 0 ? '#0F766E' : '#FF222F', '#5F6F72', '#8A6FB0', datum.y1 >= 0 ? '#0F766E' : '#FF222F', '#E87BA4'][datum.i]"
        },
        {
          "type": "formula",
          "as": "pct",
          "expr": "datum.i === 1 || datum.i === 2 ? (datum.g ? -datum.v / datum.g : 0) : null"
        }
      ]
    }
  ],
  "scales": [
    {
      "name": "wx",
      "type": "band",
      "domain": {
        "data": "steps",
        "field": "label",
        "sort": {
          "field": "i",
          "op": "min"
        }
      },
      "range": [
        0,
        {
          "signal": "cw"
        }
      ],
      "paddingInner": 0.12,
      "paddingOuter": 0.05
    },
    {
      "name": "wy",
      "type": "linear",
      "domain": {
        "fields": [
          {
            "data": "steps",
            "field": "y0"
          },
          {
            "data": "steps",
            "field": "y1"
          }
        ]
      },
      "range": [
        {
          "signal": "ch - 70"
        },
        30
      ],
      "nice": true,
      "zero": true
    }
  ],
  "marks": [
    {
      "type": "text",
      "name": "frame_title",
      "encode": {
        "update": {
          "x": {
            "value": 16
          },
          "y": {
            "value": 16
          },
          "baseline": {
            "value": "top"
          },
          "font": {
            "value": "Georgia, Gelasio, 'Times New Roman', serif"
          },
          "fontSize": {
            "value": 16
          },
          "fontWeight": {
            "value": "bold"
          },
          "fill": {
            "value": "#0B3239"
          },
          "text": {
            "value": "Benefit waterfall"
          },
          "limit": {
            "signal": "width - 32"
          }
        }
      }
    },
    {
      "type": "text",
      "encode": {
        "update": {
          "x": {
            "value": 16
          },
          "y": {
            "value": 38
          },
          "baseline": {
            "value": "top"
          },
          "font": {
            "value": "Calibri, Carlito, 'Segoe UI', Inter, Arial, sans-serif"
          },
          "fontSize": {
            "value": 12
          },
          "fill": {
            "value": "#5A7378"
          },
          "text": {
            "value": "Gross benefit less the apportioned estate cost (Teams, Machines), reconciling to net benefit"
          },
          "limit": {
            "signal": "width - 32"
          }
        }
      }
    },
