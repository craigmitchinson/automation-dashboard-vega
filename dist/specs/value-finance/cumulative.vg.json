      "update": "max(extent(pluck(data('cum'), 'cb'))[1] || 0, extent(pluck(data('cum'), 'cc'))[1] || 0, extent(pluck(data('cum_fc'), 'bH'))[1] || 0, extent(pluck(data('cum_fc'), 'cH'))[1] || 0, 0)"
