          "expr": "datum.n >= 2 ? ((isValid(datum.v1) ? datum.v1 : 0) + (isValid(datum.v2) ? datum.v2 : 0) + (isValid(datum.v3) ? datum.v3 : 0) + (isValid(datum.v4) ? datum.v4 : 0)) / datum.n : (length(data('fb_l7')) ? data('fb_l7')[0].m : 0)"
        },
