{
  "$schema": "https://vega.github.io/schema/vega/v5.json",
  "description": "IA · Value & Finance · Process value league. Generated by vega/build.mjs from vega/panels/value-finance.mjs, do not edit by hand.",
  "autosize": {
    "type": "fit",
    "contains": "padding"
  },
  "padding": 0,
  "config": {
    "background": "#FFFFFF",
    "padding": 0,
    "font": "Inter, 'Segoe UI', Carlito, Calibri, Arial, sans-serif",
    "text": {
      "font": "Inter, 'Segoe UI', Carlito, Calibri, Arial, sans-serif",
      "fill": "#0F4D43",
      "fontSize": 12
    },
    "axis": {
      "gridColor": "#E6E8E2",
      "labelFont": "'JetBrains Mono', Consolas, 'Roboto Mono', monospace",
      "labelFontSize": 10,
      "labelColor": "#5F6E69",
      "titleFont": "'JetBrains Mono', Consolas, 'Roboto Mono', monospace",
      "titleColor": "#5F6E69",
      "titleFontSize": 10,
      "titleFontWeight": 400,
      "domain": false,
      "ticks": false,
      "gridWidth": 1,
      "labelPadding": 6
    },
    "style": {
      "guide-label": {
        "font": "'JetBrains Mono', Consolas, 'Roboto Mono', monospace"
      }
    },
    "view": {
      "stroke": null
    },
    "kibana": {
      "renderer": "svg",
      "hideWarnings": true
    }
  },
  "signals": [
    {
      "name": "top",
      "value": 78
    },
    {
      "name": "cw",
      "update": "width - 32"
    },
    {
      "name": "ch",
      "update": "height - top - 16"
    },
    {
      "name": "posTotal",
      "update": "length(data('postot')) ? data('postot')[0].total : 0"
    },
    {
      "name": "posN",
      "update": "length(data('postot')) ? data('postot')[0].n : 0"
    },
    {
      "name": "thrK",
      "update": "length(data('thr')) ? data('thr')[0].k : 0"
    },
    {
      "name": "pick",
      "on": [
        {
          "events": "@pareto_bar:click",
          "update": "kibanaAddFilter({'match_phrase': {'process.name': datum.name}}, 'ia-workqueue-items*')"
        }
      ]
    }
  ],
  "data": [
    {
      "name": "procs_raw",
      "url": {
        "index": "ia-reference",
        "body": {
          "size": 500,
          "query": {
            "term": {
              "doc_type": "process"
            }
          }
        }
      },
      "format": {
        "property": "hits.hits"
      }
    },
    {
      "name": "procs",
      "source": "procs_raw",
      "transform": [
        {
          "type": "formula",
          "as": "name",
          "expr": "datum._source.process.name"
        },
        {
          "type": "formula",
          "as": "pid",
          "expr": "datum._source.process.id"
        },
        {
          "type": "formula",
          "as": "acronym",
          "expr": "datum._source.process.acronym"
        },
        {
          "type": "formula",
          "as": "spoke",
          "expr": "datum._source.spoke.name"
        },
        {
          "type": "formula",
          "as": "spokeColor",
          "expr": "datum._source.spoke.color"
        },
        {
          "type": "formula",
          "as": "proposition",
          "expr": "datum._source.proposition.name"
        },
        {
          "type": "formula",
          "as": "queue",
          "expr": "datum._source.primary_queue"
        },
        {
          "type": "formula",
          "as": "queues",
          "expr": "join(datum._source.queues, ' → ')"
        },
        {
          "type": "formula",
          "as": "description",
          "expr": "datum._source.process.description"
        },
        {
          "type": "formula",
          "as": "tags",
          "expr": "datum._source.process.tags"
        },
        {
          "type": "formula",
          "as": "smv",
          "expr": "datum._source.process.smv_minutes"
        },
        {
          "type": "formula",
          "as": "grade",
          "expr": "datum._source.process.grade"
        },
        {
          "type": "formula",
          "as": "gradeName",
          "expr": "datum._source.process.grade_name"
        },
        {
          "type": "formula",
          "as": "rate",
          "expr": "datum._source.process.current_rate_gbp"
        }
      ]
    },
    {
      "name": "bp_raw",
      "url": {
        "%context%": true,
        "%timefield%": "@timestamp",
        "index": "ia-workqueue-items",
        "body": {
          "size": 0,
          "aggs": {
            "m": {
              "filter": {
                "term": {
                  "mapped": true
                }
              },
              "aggs": {
                "p": {
                  "terms": {
                    "field": "process.name",
                    "size": 100
                  },
                  "aggs": {
                    "gb": {
                      "sum": {
                        "field": "value.benefit_gbp"
                      }
                    },
                    "ec": {
                      "sum": {
                        "field": "cost.estate_gbp"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      },
      "format": {
        "property": "aggregations.m.p.buckets"
      }
    },
    {
      "name": "bp",
      "source": "bp_raw",
      "transform": [
        {
          "type": "formula",
          "as": "name",
          "expr": "datum.key"
        },
        {
          "type": "formula",
          "as": "gb",
          "expr": "datum['gb'].value"
        },
        {
          "type": "formula",
          "as": "ec",
          "expr": "datum['ec'].value"
        },
        {
          "type": "lookup",
          "from": "procs",
          "key": "name",
          "fields": [
            "name"
          ],
          "as": [
            "ref"
          ]
        },
        {
          "type": "formula",
          "as": "spoke",
          "expr": "datum.ref ? datum.ref.spoke : ''"
        },
        {
          "type": "formula",
          "as": "spokeColor",
          "expr": "datum.ref ? datum.ref.spokeColor : '#5F6E69'"
        },
        {
          "type": "formula",
          "as": "queue",
          "expr": "datum.ref ? datum.ref.queue : ''"
        },
        {
          "type": "formula",
          "as": "proposition",
          "expr": "datum.ref ? datum.ref.proposition : ''"
        }
      ]
    },
    {
      "name": "pos",
      "source": "bp",
      "transform": [
        {
          "type": "formula",
          "as": "net",
          "expr": "datum.gb - datum.ec"
        },
        {
          "type": "filter",
          "expr": "datum.net > 0"
        },
        {
          "type": "collect",
          "sort": {
            "field": "net",
            "order": "descending"
          }
        },
        {
          "type": "window",
          "ops": [
            "row_number",
            "sum"
          ],
          "fields": [
            null,
            "net"
          ],
          "as": [
            "r",
            "cum"
          ]
        }
      ]
    },
    {
      "name": "postot",
      "source": "pos",
      "transform": [
        {
          "type": "aggregate",
          "ops": [
            "sum",
            "count"
          ],
          "fields": [
            "net",
            "net"
          ],
          "as": [
            "total",
            "n"
          ]
        }
      ]
    },
    {
      "name": "shown",
      "source": "pos",
      "transform": [
        {
          "type": "filter",
          "expr": "datum.r <= 15"
        }
      ]
    },
    {
      "name": "thr",
      "source": "pos",
      "transform": [
        {
          "type": "filter",
          "expr": "datum.cum - datum.net < 0.8 * posTotal"
        },
        {
          "type": "aggregate",
          "ops": [
            "count"
          ],
          "as": [
            "k"
          ]
        }
      ]
    }
  ],
  "scales": [
    {
      "name": "px",
      "type": "band",
      "domain": {
        "data": "shown",
        "field": "name",
        "sort": {
          "field": "r",
          "op": "min"
        }
      },
      "range": [
        0,
        {
          "signal": "cw - 60"
        }
      ],
      "paddingInner": 0.3,
      "paddingOuter": 0.1
    },
    {
      "name": "py",
      "type": "linear",
      "domain": [
        0,
        {
          "signal": "max(1, posTotal)"
        }
      ],
      "range": [
        {
          "signal": "ch - 110"
        },
        0
      ],
      "nice": true
    }
  ],
  "marks": [
    {
      "type": "text",
      "name": "frame_title",
      "encode": {
        "update": {
          "x": {
            "value": 16
          },
          "y": {
            "value": 16
          },
          "baseline": {
            "value": "top"
          },
          "font": {
            "value": "Fraunces, Cambria, Georgia, Gelasio, serif"
          },
          "fontSize": {
            "value": 16
          },
          "fontWeight": {
            "value": "bold"
          },
          "fill": {
            "value": "#0F4D43"
          },
          "text": {
            "value": "Process value league"
          },
          "limit": {
            "signal": "width - 32"
          }
        }
      }
    },
    {
      "type": "text",
      "encode": {
        "update": {
          "x": {
            "value": 16
          },
          "y": {
            "value": 38
          },
          "baseline": {
            "value": "top"
          },
          "font": {
            "value": "Inter, 'Segoe UI', Carlito, Calibri, Arial, sans-serif"
          },
          "fontSize": {
            "value": 12
          },
          "fill": {
            "value": "#5F6E69"
          },
          "text": {
            "value": "Top processes by net benefit (Pareto) · click a bar to filter"
          },
          "limit": {
            "signal": "width - 32"
          }
        }
      }
    },
    {
      "type": "rect",
      "encode": {
        "update": {
          "x": {
            "signal": "16"
          },
          "y": {
            "value": 58
          },
          "width": {
            "value": 11
          },
          "height": {
            "value": 11
          },
          "cornerRadius": {
            "value": 3
          },
          "fill": {
            "value": "#2A6A5F"
          }
        }
      }
    },
    {
      "type": "text",
      "encode": {
        "update": {
          "x": {
            "signal": "16 + 17"
          },
          "y": {
            "value": 63.5
          },
          "baseline": {
            "value": "middle"
          },
          "font": {
            "value": "Inter, 'Segoe UI', Carlito, Calibri, Arial, sans-serif"
          },
          "fontSize": {
            "value": 12
          },
          "fill": {
            "value": "#5F6E69"
          },
          "text": {
            "value": "Value"
          }
        }
      }
    },
    {
      "type": "rect",
      "encode": {
        "update": {
          "x": {
            "signal": "79"
          },
          "y": {
            "value": 58
          },
          "width": {
            "value": 11
          },
          "height": {
            "value": 11
          },
          "cornerRadius": {
            "value": 3
          },
          "fill": {
            "value": "#B9852C"
          }
        }
      }
    },
    {
      "type": "text",
      "encode": {
        "update": {
          "x": {
            "signal": "79 + 17"
          },
          "y": {
            "value": 63.5
          },
          "baseline": {
            "value": "middle"
          },
          "font": {
            "value": "Inter, 'Segoe UI', Carlito, Calibri, Arial, sans-serif"
          },
          "fontSize": {
            "value": 12
          },
          "fill": {
            "value": "#5F6E69"
          },
          "text": {
            "value": "Cumulative"
          }
        }
      }
    },
    {
      "type": "text",
      "encode": {
        "update": {
          "x": {
            "value": 16
          },
          "y": {
            "signal": "top + 2"
          },
          "baseline": {
            "value": "top"
          },
          "font": {
            "value": "Inter, 'Segoe UI', Carlito, Calibri, Arial, sans-serif"
          },
          "fontSize": {
            "value": 12
          },
          "fill": {
            "value": "#5F6E69"
          },
          "text": {
            "signal": "posN ? '80% of positive net comes from ' + thrK + ' of ' + posN + ' processes' + (posN > 15 ? ' (top 15 shown)' : '') + '.' : 'No process delivers positive net benefit for these filters.'"
          }
        }
      }
    },
    {
      "type": "group",
      "encode": {
        "update": {
          "x": {
            "signal": "16 + 60"
          },
          "y": {
            "signal": "top + 22"
          },
          "width": {
            "signal": "cw - 60"
          },
          "height": {
            "signal": "ch - 110"
          }
        }
      },
      "axes": [
        {
          "scale": "py",
          "orient": "left",
          "grid": true,
          "tickCount": 4,
          "labelPadding": 8,
          "encode": {
            "labels": {
              "update": {
                "text": {
                  "signal": "(isValid((datum.value)) && isFinite((datum.value)) ? ((datum.value) < 0 ? '-' : '') + '£' + (abs((datum.value)) >= 1e6 ? format(abs((datum.value)) / 1e6, '.2f') + 'M' : abs((datum.value)) >= 1e3 ? format(abs((datum.value)) / 1e3, '.1f') + 'k' : format(abs((datum.value)), '.2f')) : '–')"
                }
              }
            }
          }
        },
        {
          "scale": "px",
          "orient": "bottom",
          "labelPadding": 6,
          "labelLimit": 110,
          "labelAngle": -28,
          "labelAlign": "right",
          "labelBaseline": "top"
        }
      ],
      "marks": [
        {
          "type": "rect",
          "name": "pareto_bar",
          "from": {
            "data": "shown"
          },
          "encode": {
            "update": {
              "x": {
                "scale": "px",
                "field": "name"
              },
              "width": {
                "scale": "px",
                "band": 1
              },
              "y": {
                "scale": "py",
                "field": "net"
              },
              "y2": {
                "scale": "py",
                "value": 0
              },
              "fill": {
                "value": "#2A6A5F"
              },
              "cursor": {
                "value": "pointer"
              },
              "tooltip": {
                "signal": "{'Process': datum.name, 'Net': (isValid((datum.net)) && isFinite((datum.net)) ? ((datum.net) < 0 ? '-' : '') + '£' + format(round(abs((datum.net))), ',') : '–'), 'Cumulative': (isValid((datum.cum / posTotal)) && isFinite((datum.cum / posTotal)) ? format((datum.cum / posTotal) * 100, '.1f') + '%' : '–')}"
              }
            }
          }
        },
        {
          "type": "rule",
          "encode": {
            "update": {
              "x": {
                "value": 0
              },
              "x2": {
                "signal": "cw - 60"
              },
              "y": {
                "scale": "py",
                "signal": "0.8 * posTotal"
              },
              "stroke": {
                "value": "#B6462F"
              },
              "strokeDash": {
                "value": [
                  5,
                  4
                ]
              }
            }
          }
        },
        {
          "type": "text",
          "encode": {
            "update": {
              "x": {
                "signal": "cw - 62"
              },
              "y": {
                "scale": "py",
                "signal": "0.8 * posTotal",
                "offset": -4
              },
              "align": {
                "value": "right"
              },
              "font": {
                "value": "'JetBrains Mono', Consolas, 'Roboto Mono', monospace"
              },
              "fontSize": {
                "value": 10
              },
              "fontWeight": {
                "value": "bold"
              },
              "fill": {
                "value": "#B6462F"
              },
              "text": {
                "value": "80% of positive net"
              }
            }
          }
        },
        {
          "type": "line",
          "from": {
            "data": "shown"
          },
          "encode": {
            "update": {
              "x": {
                "scale": "px",
                "field": "name",
                "band": 0.5
              },
              "y": {
                "scale": "py",
                "field": "cum"
              },
              "stroke": {
                "value": "#B9852C"
              },
              "strokeWidth": {
                "value": 2
              }
            }
          }
        },
        {
          "type": "symbol",
          "from": {
            "data": "shown"
          },
          "encode": {
            "update": {
              "x": {
                "scale": "px",
                "field": "name",
                "band": 0.5
              },
              "y": {
                "scale": "py",
                "field": "cum"
              },
              "size": {
                "value": 28
              },
              "fill": {
                "value": "#FFFFFF"
              },
              "stroke": {
                "value": "#B9852C"
              },
              "strokeWidth": {
                "value": 1.5
              }
            }
          }
        }
      ]
    }
  ]
}
