    "sv_unmapped": {
      "index": "ia-workqueue-items",
      "body": {
        "size": 0,
        "query": {
          "bool": {
            "filter": [
              {
                "term": {
                  "mapped": false
                }
              },
              {
                "range": {
                  "@timestamp": {
                    "gte": {
                      "%timefilter%": "max",
                      "shift": -24,
                      "unit": "hour"
                    },
                    "lte": {
                      "%timefilter%": "max"
                    },
                    "format": "epoch_millis"
                  }
                }
              }
            ]
          }
        },
        "aggs": {
          "q": {
            "terms": {
              "field": "queue.name",
              "size": 50,
              "missing": "(no queue name)"
            }
          }
        }
      }
    },
    "sv_pending": {
      "index": "ia-workqueue-items",
      "ctx": true,
      "body": {
        "size": 0,
        "query": {
          "bool": {
            "must": [
              "%dashboard_context-must_clause%",
              {
                "term": {
                  "mapped": true
                }
              },
              {
                "term": {
                  "n.pending": 1
                }
              },
              {
                "range": {
                  "@timestamp": {
                    "gte": {
                      "%timefilter%": "max",
                      "shift": -2880,
                      "unit": "hour"
