{
  "_generated": "with the dashboards, so the job and the Service page agree; do not edit",
  "service": {
    "serviceHoursUtc": [
      7,
      19
    ],
    "freshnessMin": {
      "warn": 60,
      "act": 180
    },
    "costLagDays": {
      "warn": 2,
      "act": 4
    },
    "slaSoonHours": 2,
    "lockMinutes": 60,
    "workerGapHours": {
      "warn": 2,
      "act": 4
    },
    "gapMinExpected": 5,
    "usualFloor": 10,
    "belowUsual": {
      "warn": 0.5,
      "act": 0.25
    },
    "sysSpike": {
      "warnItems": 5,
      "warnX": 2,
      "actItems": 10,
      "actX": 3,
      "rateFloor": 0.005
    },
    "newReasonMin": 3,
    "runEveryMinutes": 15,
    "jobSilentMinutes": 45
  },
  "checks": [
    {
      "id": "freshness",
      "group": "Pipeline",
      "name": "Data arriving",
      "runbook": "Check the Logstash pipeline is running and can reach the Blue Prism database. If Blue Prism itself has stopped, raise it with platform support."
    },
    {
      "id": "cost_job",
      "group": "Pipeline",
      "name": "Cost job up to date",
      "runbook": "Re-run stamp_costs.py and read its log for the day that failed. Value and cost figures are understated until it catches up."
    },
    {
      "id": "unmapped",
      "group": "Pipeline",
      "name": "All queues mapped",
      "runbook": "A queue is producing items that reference data doesn't know, so they are missing from every figure. Add it to queueMap in reference.json (or retire the queue) and reload."
    },
    {
      "id": "sla",
      "group": "Queues",
      "name": "Nothing past its SLA",
      "runbook": "Open the queue in Control Room. Check its schedule is running and has a worker; prioritise the items closest to their SLA or add capacity."
    },
    {
      "id": "locks",
      "group": "Queues",
      "name": "No items stuck on a lock",
      "runbook": "A session probably died holding the lock. Confirm nothing is running against the item, then unlock it in Control Room."
    },
    {
      "id": "workers",
      "group": "Digital workers",
      "name": "Workers running",
      "runbook": "Log on to the VDI. Check the runtime resource is up, the session isn't stuck on a dialog and the schedule fired."
    },
    {
      "id": "processes",
      "group": "Processes",
      "name": "Processes running as usual",
      "runbook": "Check the schedule fired and that items were loaded upstream. An empty queue usually means the feed or the trigger failed."
    },
    {
      "id": "sys_spike",
      "group": "Exceptions",
      "name": "System exceptions normal",
      "runbook": "Read the top reason for the process. It is usually a target system outage, a credential change or a screen change; pause the schedule if items are failing in bulk."
    },
    {
      "id": "new_reasons",
      "group": "Exceptions",
      "name": "No new exception reasons",
      "runbook": "A reason not seen in 28 days usually means the target system changed. Check with its owners; if the reason is genuine, add a pattern to reference data."
    }
  ],
  "statusRank": {
    "quiet": 0,
    "ok": 1,
    "warn": 2,
    "act": 3
  },
  "statusLabel": {
    "quiet": "Out of hours",
    "ok": "OK",
    "warn": "Warning",
    "act": "Action"
  },
  "queries": {
    "sv_fresh": {
      "index": "ia-workqueue-items",
      "body": {
        "size": 0,
        "query": {
          "range": {
            "item.last_updated_at": {
              "gte": {
                "%timefilter%": "max",
                "shift": -168,
                "unit": "hour"
              },
              "lte": {
                "%timefilter%": "max"
              },
              "format": "epoch_millis"
            }
          }
        },
        "aggs": {
          "last": {
            "max": {
              "field": "item.last_updated_at"
            }
          },
          "nowb": {
            "date_range": {
              "field": "@timestamp",
              "ranges": [
                {
                  "key": "now",
                  "from": {
                    "%timefilter%": "max"
                  }
                }
              ]
            }
          }
        }
      }
    },
    "sv_cost": {
