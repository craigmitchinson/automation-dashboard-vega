                  "field": "spoke.name",
                  "size": 1
                }
              },
              "pr": {
                "terms": {
                  "field": "process.name",
                  "size": 1
                }
              },
              "live": {
                "filter": {
                  "bool": {
                    "must_not": [
                      {
                        "range": {
                          "item.deferred_at": {
                            "gt": {
                              "%timefilter%": "max"
                            },
                            "format": "epoch_millis"
                          }
                        }
                      }
                    ]
                  }
                },
                "aggs": {
                  "oldest": {
                    "min": {
                      "field": "item.loaded_at"
                    }
                  },
                  "past": {
                    "filter": {
                      "range": {
                        "item.sla_due_at": {
                          "lte": {
                            "%timefilter%": "max"
                          },
                          "format": "epoch_millis"
                        }
                      }
                    }
                  },
                  "soon": {
                    "filter": {
                      "range": {
                        "item.sla_due_at": {
                          "gt": {
                            "%timefilter%": "max"
                          },
                          "lte": {
                            "%timefilter%": "max",
                            "shift": 2,
                            "unit": "hour"
                          },
                          "format": "epoch_millis"
                        }
                      }
                    }
                  }
                }
              },
              "stuck": {
                "filter": {
                  "range": {
                    "item.locked_at": {
                      "lte": {
                        "%timefilter%": "max",
                        "shift": -60,
                        "unit": "minute"
                      },
                      "format": "epoch_millis"
                    }
                  }
                },
                "aggs": {
                  "oldest": {
                    "min": {
                      "field": "item.locked_at"
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
